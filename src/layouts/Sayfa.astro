---
// İçerik sayfası çatısı: DESIGN.md "İçerik sayfaları" bölümüne bağlıdır.
// Aydınlık atlas dünyası: krem-adaçayı zemin, koyu mürekkep, Cormorant + Manrope.
// MENÜ BİRLEŞTİRME (27.07 ADIM 3): UstMenu import'u kaldırıldı — dosya
// duruyor (M10, silme kararı kullanıcıda). Tek menü: PaylasilanMenu.
import PaylasilanMenu from '../components/PaylasilanMenu.astro';
import AltBilgi from '../components/AltBilgi.astro';
import GorselSlot from '../components/GorselSlot.astro';
import { SITE_ADI, YAZAR, EPOSTA, OG_GORSEL } from '../data/site';
// Hareket sözlüğü + giriş koreografisi TEK KAYNAK (ödül-üstü Faz 1).
import '../styles/hareket.css';

interface Props {
  baslik: string;
  aciklama: string;
  // Sayfaya özgü ek JSON-LD nesneleri (Article, FAQPage, Person...).
  // Organization + WebSite + BreadcrumbList burada otomatik üretilir.
  sema?: Record<string, unknown>[];
  // Görsel slot sözleşmesi (DESIGN.md §14): doluysa üstteki su bandının
  // YERİNE o slot render edilir (görsel yokken degrade placeholder —
  // görünüm su bandıyla aynı aileden; iki bant üst üste asla binmez).
  heroSlot?: 'rehber-hero' | 'bolum-vinyeti';
}

const { baslik, aciklama, sema = [], heroSlot } = Astro.props;
const yol = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const canonical = new URL(yol, Astro.site).href;
const ogGorselTam = new URL(OG_GORSEL, Astro.site).href;
const kok = new URL('/', Astro.site).href;

// — Kırıntı zinciri: /rehberler/kuyu-ruhsati/ → Ana sayfa > Rehberler > başlık
const bolumAdlari: Record<string, string> = {
  harita: 'Harita',
  havzalar: 'Havzalar',
  rehberler: 'Rehberler',
  'su-kanunu': 'Su Kanunu',
  hakkinda: 'Hakkında',
  'kuyu-ruhsati': 'Kuyu ruhsatı — iller',
  arac: 'Araçlar',
};
// HANGİ ARA HALKA LİNK OLABİLİR — otomatik türetilir.
// Hata kaydı (27 Tem 2026): breadcrumb her ara parçayı link yapıyordu; ama
// `arac` bölümünün index sayfası YOK → /arac/il-rejimi/ sayfası canlıda
// /arac/ diye 404'e link verdi ve sağlık sistemi 🔴 kırık link verdi.
// Elle "istisna listesi" tutmak bu hatanın ikizini doğurur; bunun yerine
// gerçek sayfa dosyalarından türetiyoruz — yarın /arac/index.astro eklenirse
// link kendiliğinden çalışır, kimsenin listeyi güncellemesi gerekmez.
const bolumDosyalari = import.meta.glob('../pages/**/index.astro');
const varOlanBolum = new Set(
  Object.keys(bolumDosyalari).map((f) =>
    f.replace('../pages/', '').replace(/\/?index\.astro$/, '')
  )
);
const parcalar = yol.split('/').filter(Boolean);
const kirintilar = parcalar.map((p, i) => {
  const dizin = parcalar.slice(0, i + 1).join('/');
  const sonuncu = i === parcalar.length - 1;
  return {
    // Son parça sayfanın kendisi: başlığını kullan (slug'ı değil).
    ad: sonuncu ? baslik : (bolumAdlari[p] ?? p),
    // Son halka zaten link değil; ara halka yalnız sayfası VARSA link olur.
    url: sonuncu || varOlanBolum.has(dizin)
      ? new URL(dizin + '/', Astro.site).href
      : null,
  };
});
kirintilar.unshift({ ad: 'Ana sayfa', url: kok });

const kurum = {
  '@type': 'Organization',
  '@id': `${kok}#kurum`,
  name: SITE_ADI,
  url: kok,
  description:
    "Türkiye'nin su verisi, havzaları ve su mevzuatını tek haritada birleştiren bağımsız bilgi portalı.",
  email: EPOSTA,
  founder: { '@id': `${kok}#yazar` },
  knowsAbout: ['Su hukuku', 'Yeraltı suyu ruhsatı', 'Su tahsisi', 'Su havzaları', 'İdari yargı'],
};

const yazarSema = {
  '@type': 'Person',
  '@id': `${kok}#yazar`,
  name: YAZAR.adSade,
  jobTitle: YAZAR.unvan,
  url: `${kok}hakkinda/`,
  description: YAZAR.uzmanlik,
  worksFor: { '@type': 'Organization', name: YAZAR.buro, url: YAZAR.buroUrl },
  knowsAbout: ['Su hukuku', 'İdari yargı', 'Şirketler hukuku'],
};

const semalar = [
  kurum,
  yazarSema,
  {
    '@type': 'WebSite',
    '@id': `${kok}#site`,
    name: SITE_ADI,
    url: kok,
    inLanguage: 'tr-TR',
    publisher: { '@id': `${kok}#kurum` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: kirintilar.map((k, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: k.ad,
      // Sayfası olmayan ara halka `item` TAŞIMAZ — aksi halde şema 404'e
      // işaret eder. schema.org yalnız `name` taşıyan ListItem'a izin verir.
      ...(k.url ? { item: k.url } : {}),
    })),
  },
  ...sema,
];

// Künye alanları HTML içerdiğinden (kaynak linkleri) JSON gövdesinde "<"
// kaçırılır: aksi halde içerikteki bir </script> etiketi bloğu erken kapatır.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': semalar,
}).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="tr" data-sv-ton="krem">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{baslik} — Su Haritası</title>
<meta name="description" content={aciklama} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={`${baslik} — Su Haritası`} />
<meta property="og:description" content={aciklama} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="article" />
<meta property="og:site_name" content={SITE_ADI} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:image" content={ogGorselTam} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Su Haritası — Türkiye'nin su verisi ve mevzuatı" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogGorselTam} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<script type="application/ld+json" is:inline set:html={jsonLd} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap&subset=latin-ext" rel="stylesheet" />
<style is:global>
  :root {
    /* — Primitifler: SU-DİLİ derinlik skalası (DESIGN.md §2 — aday C,
         22.07 kullanıcı kararı). Değişken ADLARI Faz 1'den korunur (tek
         kaynak sözleşmesi); taşıdıkları TON su-mavisi ailesine geçti. — */
    --krem: #E9F0F4;            /* YÜZEY — açık su-mavisi zemin */
    --adacayi-krem: #DFE9F0;    /* YÜZEY-kart */
    --murekkep-900: #132A3F;    /* metin — koyu lacivert */
    --murekkep-500: #48627A;    /* ikincil metin */
    --su-700: #0C5A7C;          /* DERİN — vurgu sesi (okyanus mavisi) */
    --su-400: #2E7EA0;          /* SIĞ — dekoratif hairline */
    --kehribar: #C0883A;        /* plato — yalnız hairline */
    --kehribar-metin: #875518;  /* plato — metin türevi (mavi zeminde koyulaştırıldı) */
    --yesil-kara: #2C5570;      /* süreç ailesi (artık lacivert-çelik) */
    --deniz: #0A2740;           /* DİP */
    --akuamarin: #57BAE0;       /* koyu dünyada ışıma (SIĞ'ın parlak türevi) */
    --kopuk: #DBEAF4;

    /* — Anlamsal tokenlar — */
    --zemin: var(--krem);
    --zemin-kart: var(--adacayi-krem);
    --metin: var(--murekkep-900);
    --metin-soluk: var(--murekkep-500);
    --baglanti: var(--su-700);
    --vurgu: var(--su-700);
    --cizgi: rgba(19, 42, 63, 0.14);

    --serif: "Cormorant", Georgia, serif;
    --sans: "Manrope", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;

    /* — Akış: suyun ivmesi (DESIGN.md §3) — sözlük src/styles/hareket.css'te
       tek kaynaktan gelir (--e-suzul/--e-kabar/--e-akinti/--e-cekil). — */
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--zemin);
    color: var(--metin);
    font-family: var(--sans);
    font-size: 1.02rem;
    line-height: 1.75;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  a { color: var(--baglanti); transition: color 120ms var(--e-akinti); }

  /* Focus: DERİN çerçeve — hiçbir yerde outline:none (DESIGN.md §9) */
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--su-700);
    outline-offset: 3px;
  }

  /* Hero şeridi: nav altında tam genişlik su-degrade bandı; salt dekor.
     Başlık negatif margin ile bandın alt yarısına biner (CLS üretmez: statik). */
  .sv-hero {
    width: 100%;
    height: clamp(180px, 24vh, 240px);
    /* Su bandı, derinlik skalasının kendisi: yüzeyden sığa inen degrade +
       kontur halkaları (SIĞ tonundan). İlk bakışta fark edilir, bağırmaz. */
    background:
      repeating-radial-gradient(circle at 82% 130%,
        rgba(12, 90, 124, 0.12) 0 1.5px, transparent 1.5px 46px),
      repeating-radial-gradient(circle at 6% -40%,
        rgba(46, 126, 160, 0.12) 0 1.5px, transparent 1.5px 64px),
      radial-gradient(60vw 130% at 78% 108%,
        rgba(46, 126, 160, 0.30) 0%, rgba(46, 126, 160, 0) 62%),
      linear-gradient(168deg,
        #D3E2ED 0%,
        rgba(46, 126, 160, 0.20) 48%,
        var(--krem) 100%);
    box-shadow: inset 0 -1px 0 rgba(46, 126, 160, 0.45);
  }

  /* Sayfa yolu (breadcrumb) — site-architecture: "breadcrumbs = her sayfada
     bedava iç link" + 3-tık kuralı. ui-ux-pro-max Navigation/Breadcrumbs:
     3+ seviyeli sitelerde kullan. BURADAKİ ASIL GEREKÇE ŞEMA DÜRÜSTLÜĞÜ:
     BreadcrumbList JSON-LD 171 sayfada zaten yayınlanıyordu ama sayfada
     görünür karşılığı YOKTU. Metin ve sıra JSON-LD ile AYNI `kirintilar`
     dizisinden gelir — iki kaynak ayrışamaz. Ana sayfada çıkmaz. */
  .kirinti {
    margin: 0 0 1.4rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--metin-soluk);
  }
  .kirinti ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
    margin: 0;
    padding: 0;
  }
  .kirinti li { display: flex; align-items: center; gap: 0.5rem; }
  .kirinti li + li::before {
    content: "\203A";
    color: var(--su-400);
    font-size: 0.85rem;
  }
  .kirinti a {
    color: var(--metin-soluk);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    /* dokunma hedefi: 0.72rem metin + dikey iç boşluk ≈ 34 px satır */
    padding: 0.45rem 0;
  }
  .kirinti a:hover,
  .kirinti a:focus-visible { color: var(--baglanti); border-bottom-color: var(--baglanti); }
  .kirinti [aria-current="page"] {
    color: var(--metin);
    padding: 0.45rem 0;
    max-width: 46ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media print { .kirinti { display: none; } }

  main.govde {
    flex: 1;
    width: 100%;
    max-width: 46rem;
    margin: calc(-1 * clamp(120px, 16vh, 158px)) auto 0;
    padding: 0 clamp(1.25rem, 4vw, 2rem) clamp(3rem, 8vh, 5rem);
    /* Banda binen başlık, hero scrim'inin ÜSTÜNDE kalır */
    position: relative;
    z-index: 1;
  }

  .sv-hero-slot { background: none; box-shadow: none; position: relative; }
  .sv-hero-slot :global(.gorsel-slot) { height: 100%; }

  /* Gerçek görsel geldiğinde başlık okunurluğu: bandın alt yarısı YÜZEY
     tonuna erir (anayasa §13 scrim kuralı — kutu değil, eriyen geçiş).
     Placeholder degrade'de de zararsız. */
  .sv-hero-slot::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg,
      rgba(233, 240, 244, 0) 45%, rgba(233, 240, 244, 0.9) 100%);
  }

  @media print {
    .sv-hero { display: none; }
    main.govde { margin-top: 0; padding-top: 1.5rem; }

    /* Scroll reveal yazdırmayı boş bırakmasın: ekranda görünmemiş tablolar,
       havza kartları ve başlıklar kâğıda/PDF'e dolu basılır (rapor KOD-5).
       CSS tek başına yeterli değil — sayfa.js beforeprint'te sınıfları da
       açar; ikisi birlikte no-JS ve JS'li yolu birden kapatır. */
    .sv-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* Sayfa başı: kicker imzası + başlık + su hattı (DESIGN.md §7) */
  .sayfa-basi { margin-bottom: clamp(1.8rem, 4vh, 2.6rem); }

  .sayfa-etiket {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--su-700);
  }

  .sayfa-etiket::before {
    content: "";
    width: 1.6rem;
    height: 1px;
    background: var(--su-400);
  }

  .sayfa-basi h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2rem, 4.6vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-top: 0.6rem;
    text-wrap: balance;
  }

  /* Işık kırılması vurgusu (DESIGN.md §4): başlıkta tek italik kelime */
  .sayfa-basi h1 em,
  .icerik h1 em, h2 em {
    font-style: italic;
    background: linear-gradient(105deg, #0C5A7C 0%, #2E7EA0 45%, #186789 60%, #0C5A7C 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Başlık altı su hattı: tam genişliğe akan, iki ucu degrade eriyen çizgi */
  .su-hatti {
    width: 100%;
    height: 1px;
    margin: 1.15rem 0 0;
    border: 0;
    background: linear-gradient(90deg,
      rgba(78, 134, 168, 0) 0%,
      var(--su-400) 14%,
      var(--su-400) 62%,
      rgba(78, 134, 168, 0) 100%);
  }

  .sayfa-ozet {
    margin-top: 1rem;
    color: var(--metin-soluk);
    max-width: 58ch;
  }

  /* Markdown gövdesi — bölümler CSS sayaçla kicker imzası alır (§7):
     numara içerikten türer, süs metni uydurulmaz. */
  .icerik { margin-top: 0.5rem; counter-reset: bolum; }

  .icerik h2 {
    counter-increment: bolum;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.65rem;
    line-height: 1.25;
    margin: clamp(2.6rem, 6vh, 4rem) 0 0.8rem;
  }

  .icerik h2::before {
    content: "BÖLÜM " counter(bolum, decimal-leading-zero);
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--su-700);
    margin-bottom: 0.55rem;
  }

  .icerik h2::after {
    content: "";
    display: block;
    width: 2.6rem;
    height: 1px;
    background: var(--su-400);
    margin-top: 0.55rem;
  }

  .icerik h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.3rem;
    margin: 1.8rem 0 0.6rem;
  }

  .icerik p { margin: 0.9rem 0; max-width: 68ch; }

  .icerik ul, .icerik ol { margin: 0.9rem 0 0.9rem 1.3rem; max-width: 66ch; }

  .icerik li { margin: 0.35rem 0; }

  .icerik a {
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 120ms var(--e-akinti),
      text-decoration-thickness 120ms var(--e-akinti);
  }

  .icerik a:hover { text-decoration-thickness: 2px; }

  /* Birebir madde metinleri: SIĞ kenar + hafif zemin farkı.
     Uzun mevzuat metninde okunabilirlik: italik zorlanmaz. */
  .icerik blockquote {
    margin: 1.4rem 0;
    padding: 0.85rem 1.1rem;
    border-left: 3px solid var(--su-400);
    background: rgba(19, 42, 63, 0.035);
    color: var(--metin-soluk);
    font-family: var(--serif);
    font-size: 1.1rem;
    font-style: normal;
  }

  .icerik table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4rem 0;
    font-size: 0.95rem;
  }

  .icerik th, .icerik td {
    text-align: left;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--cizgi);
    vertical-align: top;
  }

  .icerik th {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    background: var(--adacayi-krem);
    border-bottom: 2px solid var(--su-700);
  }

  .icerik tbody tr { transition: background-color 120ms var(--e-akinti); }

  .icerik tbody tr:hover { background: rgba(12, 90, 124, 0.05); }

  .veri-yok { color: var(--metin-soluk); font-style: italic; }

  /* Scroll reveal: sınıfları sayfa.js ekler; no-JS'te içerik hiç gizlenmez.
     Yalnız transform/opacity — CLS üretmez. */
  .sv-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.42s var(--e-akinti), transform 0.42s var(--e-suzul);
  }

  .sv-reveal.sv-goster {
    opacity: 1;
    transform: translateY(0);
  }
</style>
</head>
<body>
  <PaylasilanMenu />
  {heroSlot
    ? <div class="sv-hero sv-hero-slot" aria-hidden="true"><GorselSlot ad={heroSlot} yukseklik="100%" /></div>
    : <div class="sv-hero" aria-hidden="true"></div>}
  <main class="govde">
    {kirintilar.length > 1 && (
      <nav class="kirinti" aria-label="Sayfa yolu">
        <ol>
          {kirintilar.map((k, i) => (
            <li>
              {i === kirintilar.length - 1
                ? <span aria-current="page">{k.ad}</span>
                : k.url
                  ? <a href={new URL(k.url).pathname}>{k.ad}</a>
                  : <span>{k.ad}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
  </main>
  <AltBilgi />
  <script type="module" src="/s/imlec.js" is:inline></script>
  <script type="module" src="/s/sayfa.js" is:inline></script>
  <script type="module" src="/s/menu.js" is:inline></script>
</body>
</html>
