---
// İçerik sayfası çatısı: DESIGN.md "İçerik sayfaları" bölümüne bağlıdır.
// Aydınlık atlas dünyası: krem-adaçayı zemin, koyu mürekkep, Cormorant + Manrope.
import UstMenu from '../components/UstMenu.astro';

interface Props {
  baslik: string;
  aciklama: string;
}

const { baslik, aciklama } = Astro.props;
const yol = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const canonical = new URL(yol, Astro.site).href;
---
<!DOCTYPE html>
<html lang="tr" data-sv-ton="krem">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{baslik} — Su Haritası</title>
<meta name="description" content={aciklama} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={`${baslik} — Su Haritası`} />
<meta property="og:description" content={aciklama} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="article" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500;600&display=swap&subset=latin-ext" rel="stylesheet" />
<style is:global>
  :root {
    /* — Pirimitif tokenlar (DESIGN.md paleti) — */
    --krem: #F3EEE2;
    --adacayi-krem: #E8EDE6;
    --murekkep-900: #232E2B;
    --murekkep-500: #5C6B66;
    --su-700: #2F5D59;
    --su-400: #5E8A87;
    --kehribar: #D9A05B;
    --deniz: #04121F;
    --akuamarin: #4FC3D0;

    /* — Anlamsal tokenlar — */
    --zemin: var(--krem);
    --zemin-kart: var(--adacayi-krem);
    --metin: var(--murekkep-900);
    --metin-soluk: var(--murekkep-500);
    --baglanti: var(--su-700);
    --vurgu: var(--kehribar);
    --cizgi: rgba(35, 46, 43, 0.14);

    --serif: "Cormorant", Georgia, serif;
    --sans: "Manrope", system-ui, sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--zemin);
    color: var(--metin);
    font-family: var(--sans);
    font-size: 1.02rem;
    line-height: 1.75;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  a { color: var(--baglanti); }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--su-400);
    outline-offset: 3px;
  }

  /* Hero şeridi: nav altında tam genişlik su-degrade bandı; salt dekor.
     Başlık negatif margin ile bandın alt yarısına biner (CLS üretmez: statik). */
  .sv-hero {
    width: 100%;
    height: clamp(180px, 24vh, 240px);
    /* İlk bakışta fark edilir su bandı: belirgin akuamarin degrade +
       kontur halkaları; karartma yok, krem dünyası korunur. */
    background:
      repeating-radial-gradient(circle at 82% 130%,
        rgba(47, 138, 151, 0.13) 0 1.5px, transparent 1.5px 46px),
      repeating-radial-gradient(circle at 6% -40%,
        rgba(79, 195, 208, 0.11) 0 1.5px, transparent 1.5px 64px),
      radial-gradient(60vw 130% at 78% 108%,
        rgba(79, 195, 208, 0.28) 0%, rgba(79, 195, 208, 0) 62%),
      linear-gradient(168deg,
        #DCE7E0 0%,
        rgba(79, 195, 208, 0.20) 48%,
        var(--krem) 100%);
    box-shadow: inset 0 -1px 0 rgba(79, 195, 208, 0.45);
  }

  main.govde {
    flex: 1;
    width: 100%;
    max-width: 46rem;
    margin: calc(-1 * clamp(120px, 16vh, 158px)) auto 0;
    padding: 0 clamp(1.25rem, 4vw, 2rem) clamp(3rem, 8vh, 5rem);
  }

  @media print {
    .sv-hero { display: none; }
    main.govde { margin-top: 0; padding-top: 1.5rem; }
  }

  /* Sayfa başı: başlık + su hattı (landing'deki imza-damarın aydınlık kardeşi) */
  .sayfa-basi { margin-bottom: clamp(1.8rem, 4vh, 2.6rem); }

  .sayfa-etiket {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--metin-soluk);
  }

  .sayfa-basi h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2rem, 4.6vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-top: 0.5rem;
    text-wrap: balance;
  }

  /* Başlık altı su hattı: tam genişliğe akan, iki ucu degrade eriyen çizgi */
  .su-hatti {
    width: 100%;
    height: 1px;
    margin: 1.15rem 0 0;
    border: 0;
    background: linear-gradient(90deg,
      rgba(94, 138, 135, 0) 0%,
      var(--su-400) 14%,
      var(--su-400) 62%,
      rgba(94, 138, 135, 0) 100%);
  }

  .sayfa-ozet {
    margin-top: 1rem;
    color: var(--metin-soluk);
    max-width: 58ch;
  }

  /* Markdown gövdesi */
  .icerik { margin-top: 0.5rem; }

  .icerik h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.65rem;
    line-height: 1.25;
    margin: 2.4rem 0 0.8rem;
  }

  /* Bölüm ritmi: h2 öncesi degrade uçlu ince ayraç (mevcut çizgi dili) */
  .icerik h2::before {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    margin-bottom: 1.3rem;
    background: linear-gradient(90deg,
      rgba(35, 46, 43, 0.14) 0%,
      rgba(35, 46, 43, 0.14) 55%,
      rgba(35, 46, 43, 0) 100%);
  }

  .icerik h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.3rem;
    margin: 1.8rem 0 0.6rem;
  }

  .icerik p { margin: 0.9rem 0; max-width: 68ch; }

  .icerik ul, .icerik ol { margin: 0.9rem 0 0.9rem 1.3rem; max-width: 66ch; }

  .icerik li { margin: 0.35rem 0; }

  .icerik a { text-decoration-thickness: 1px; text-underline-offset: 3px; }

  /* Birebir madde metinleri: akuamarin kenar + hafif zemin farkı.
     Uzun mevzuat metninde okunabilirlik: italik zorlanmaz. */
  .icerik blockquote {
    margin: 1.4rem 0;
    padding: 0.85rem 1.1rem;
    border-left: 3px solid var(--akuamarin);
    background: rgba(35, 46, 43, 0.035);
    color: var(--metin-soluk);
    font-family: var(--serif);
    font-size: 1.1rem;
    font-style: normal;
  }

  .icerik table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4rem 0;
    font-size: 0.95rem;
  }

  .icerik th, .icerik td {
    text-align: left;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--cizgi);
    vertical-align: top;
  }

  .icerik th {
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    background: var(--adacayi-krem);
  }

  .veri-yok { color: var(--metin-soluk); font-style: italic; }

  footer.alt {
    border-top: 1px solid var(--cizgi);
    padding: 1.4rem clamp(1.25rem, 4vw, 2rem);
    text-align: center;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    color: var(--metin-soluk);
  }

  footer.alt a {
    color: var(--metin-soluk);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  footer.alt a:hover { color: var(--metin); }

  /* Scroll reveal: sınıfları sayfa.js ekler; no-JS'te içerik hiç gizlenmez.
     Yalnız transform/opacity — CLS üretmez. */
  .sv-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sv-reveal.sv-goster {
    opacity: 1;
    transform: translateY(0);
  }
</style>
</head>
<body>
  <UstMenu />
  <div class="sv-hero" aria-hidden="true"></div>
  <main class="govde">
    <slot />
  </main>
  <footer class="alt">
    <a href="https://arslanhukuk.tr" target="_blank" rel="noopener">suharitasi.com · Arslan Hukuk Bürosu güvencesiyle · 2026</a>
  </footer>
  <script type="module" src="/s/imlec.js" is:inline></script>
  <script type="module" src="/s/sayfa.js" is:inline></script>
  <script type="module" src="/s/menu.js" is:inline></script>
</body>
</html>
