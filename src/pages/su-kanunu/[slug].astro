---
import { getCollection, render } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import Bulten from '../../components/Bulten.astro';

export async function getStaticPaths() {
  const girisler = await getCollection('su-kanunu');
  return girisler.map((g) => ({ params: { slug: g.id }, props: { giris: g } }));
}

const { giris } = Astro.props;
const { Content } = await render(giris);

// Kardeş-sayfa bağı (gsc-mcp turu 25.08.2026): taslak-takibi sitede yalnız
// 1 gelen bağla "keşfedildi — dizine eklenmedi" ölçüldü (URL denetimi);
// bölümün sayfaları birbirine satır-içi metin bağıyla bağlanır (gezinme,
// hukuki içerik değil; başlık koleksiyon verisinden).
const kardesler = (await getCollection('su-kanunu')).filter((g) => g.id !== giris.id);

// Bülten yalnız taslak takibi sayfasında: mevzuat kütüphanesi durağan bir
// referans, bildirime konu değil.
const bultenli = giris.id === 'taslak-takibi';

// Damga (kalanlar paketi 25.08.2026): son gerçek içerik değişikliği —
// frontmatter guncelleme (git geçmişinden ölçülmüş); yoksa yayım tarihi.
// Sayfada başka WebPage düğümü yok; dateModified bu düğümde taşınır.
const damga = giris.data.guncelleme ?? giris.data.tarih;
const canonical = new URL(`/su-kanunu/${giris.id}/`, Astro.site).href;
const sema = [{
  '@type': 'WebPage',
  '@id': canonical,
  name: giris.data.baslik,
  description: giris.data.ozet,
  datePublished: giris.data.tarih.toISOString(),
  dateModified: damga.toISOString(),
  inLanguage: 'tr-TR',
}];
---
<Sayfa baslik={giris.data.baslik} aciklama={giris.data.ozet} sema={sema}>
  <SayfaBasi
    etiket="Su Kanunu"
    baslik={giris.data.baslik}
    ozet={giris.data.ozet}
    tarih={damga}
    ozCevap
  />
  <div class="icerik">
    <Content />
    {kardesler.length > 0 && (
      <p>
        Su Kanunu bölümünün diğer sayfası:{' '}
        {kardesler.map((k) => <a href={`/su-kanunu/${k.id}/`}>{k.data.baslik}</a>)}
      </p>
    )}
  </div>
  {bultenli && <Bulten etiket="taslak-takibi" />}
</Sayfa>
