---
import { getCollection } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import Bulten from '../../components/Bulten.astro';

const girisler = (await getCollection('su-kanunu')).sort(
  (a, b) => b.data.tarih.valueOf() - a.data.tarih.valueOf()
);
const tarihYaz = (t: Date) =>
  t.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' });
const noYaz = (i: number) => String(i + 1).padStart(2, '0');
---
<Sayfa
  baslik="Su Kanunu"
  aciklama="Su mevzuatı kütüphanesi ve Su Kanunu taslağının güncel takibi: kaynak linkli, spekülasyonsuz."
>
  <SayfaBasi
    baslik="Su Kanunu"
    ozet="Yürürlükteki su mevzuatının kütüphanesi ve Su Kanunu taslağının tarih + kaynak bağlantılı takibi."
  />
  <ul class="sv-liste">
    {girisler.map((g, i) => (
      <li>
        <a href={`/su-kanunu/${g.id}/`}>
          <span class="sv-no" aria-hidden="true">{noYaz(i)}</span>
          <span class="sv-metin">
            <span class="sv-tarih">{tarihYaz(g.data.tarih)}</span>
            <span class="sv-baslik">{g.data.baslik}</span>
            <span class="sv-ozet">{g.data.ozet}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <Bulten etiket="su-kanunu" />
</Sayfa>

<style>
  .sv-liste { list-style: none; }

  .sv-liste li + li { border-top: 1px solid var(--cizgi); }

  .sv-liste a {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    align-items: baseline;
    gap: 0 1rem;
    padding: 1.25rem 0.4rem;
    text-decoration: none;
    color: inherit;
    transition: transform 240ms var(--e-suzul), background-color 240ms var(--e-akinti);
    will-change: transform;
  }

  .sv-liste a:hover { transform: translateY(-2px); background: rgba(23, 94, 86, 0.05); }

  .sv-liste a:active { transform: translateY(0) scale(0.995); transition-duration: 120ms; }

  .sv-no {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1;
    color: rgba(90, 107, 98, 0.45);
    transition: color 120ms var(--e-akinti);
  }

  .sv-liste a:hover .sv-no { color: var(--su-700); }

  .sv-tarih {
    display: block;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metin-soluk);
  }

  .sv-baslik {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .sv-liste a:hover .sv-baslik { color: var(--su-700); }

  .sv-ozet {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.92rem;
    color: var(--metin-soluk);
    max-width: 62ch;
  }

  @media (max-width: 640px) {
    .sv-liste a { grid-template-columns: 2.6rem 1fr; }
    .sv-no { font-size: 1.3rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-liste a { transition: none; }
    .sv-liste a:hover { transform: none; }
  }
</style>
