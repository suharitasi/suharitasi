---
// /emsal-kararlar/ — EMSAL KARAR VERİTABANI (13.09.2026).
//
// Künyeler rehberlerde yayımlanmış hâliyle data/kamu/emsal-kararlar.json'dan
// gelir; buraya rehberlerde geçmeyen künye EKLENMEZ (uydurma yasağı).
// 10.10.2026 (sahip kararı DURAK 1 A-d): dizinde YALNIZ resmî karar arama sunucusunda
// doğrulanan künyeler; doğrulanamayanlar /emsal-kararlar/dogrulanamadi/ (noindex) sayfasında.
import Sayfa from '../layouts/Sayfa.astro';
import { TARIH } from '../data/guncellik.js';
import SayfaBasi from '../components/SayfaBasi.astro';
import OzCevap from '../components/OzCevap.astro';
import HukukSerhi from '../components/HukukSerhi.astro';
import CtaBlok from '../components/CtaBlok.astro';
import {
  EMSAL_DOGRULANAN, EMSAL_DOGRULANAMAYAN, EMSAL_SERH, EMSAL_DOGRULAMA_TARIHI, MADDE_BY_EMSAL,
  emsalYol, emsalAlinti, alintiMetni, tamMerci, mahkemeAdi, kararTarihiIso,
} from '../data/emsal.js';

const maddeByEmsal = MADDE_BY_EMSAL;
const mahkemeler = [...new Set(EMSAL_DOGRULANAN.map(mahkemeAdi))].join(' ve ');

const OZ_CEVAP =
  `Su hukukuna ilişkin ${mahkemeler} kararlarından derlenmiş emsal dizini: yeraltı suyu belgeleri, ` +
  'izin ve tarife uyuşmazlıkları, kaynak suyu kiralama ve jeotermal geçiş rejimi. Listedeki her künye ' +
  'resmî karar arama sunucusunda doğrulanmıştır ve karar metnine bağlanır.';

const kok = new URL('/', Astro.site).href;
const canonical = new URL('/emsal-kararlar/', Astro.site).href;

const kararlar = [...EMSAL_DOGRULANAN].sort((a, b) => b.yil - a.yil || a.merci.localeCompare(b.merci, 'tr'));

const sema = [
  {
    '@type': 'ItemList',
    '@id': `${canonical}#kararlar`,
    name: 'Su hukuku emsal kararları',
    numberOfItems: kararlar.length,
    itemListElement: kararlar.map((k, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'CreativeWork',
        name: `${tamMerci(k)} ${k.esas} E., ${k.karar} K.`,
        about: k.konu,
        url: new URL(emsalYol(k), Astro.site).href,
        sameAs: k.resmi_dogrulama.url,
        dateCreated: kararTarihiIso(k),
      },
    })),
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#sayfa`,
    url: canonical,
    name: 'Su hukuku emsal kararları',
    description: OZ_CEVAP,
    inLanguage: 'tr-TR',
    ...(TARIH.emsal ? { dateModified: TARIH.emsal } : {}),
    isPartOf: { '@id': `${kok}#site` },
  },
];
---
<Sayfa
  baslik="Su hukuku emsal kararları"
  aciklama={OZ_CEVAP}
  tarayiciBaslik="Su Hukuku Emsal Kararları: Danıştay ve Yargıtay"
  sema={sema}
>
  <SayfaBasi etiket="Emsal kararlar" baslik="Su hukuku emsal kararları" ozet={`${mahkemeler} kararlarından derlenmiş dizin; her künyenin kendi sayfası, resmî metin bağlantısı ve ilgili rehberi var.`} />
  <OzCevap metin={OZ_CEVAP} etiket="Kanun özeti" />

  <p class="em-serh">{EMSAL_SERH}</p>
  <p class="em-serh">Bu listedeki {kararlar.length} künyenin her biri {EMSAL_DOGRULAMA_TARIHI} tarihinde resmî karar arama
    sunucusunda (karararama.danistay.gov.tr) esas ve karar numarasıyla aranmış ve karar metninde doğrulanmıştır.
    Doğrulanamayan {EMSAL_DOGRULANAMAYAN.length} künye ayrı sayfada, gerekçesiyle:
    <a href="/emsal-kararlar/dogrulanamadi/">doğrulanamayan künyeler</a>.</p>

  <label class="em-arama">
    <span>Karar ara</span>
    <input type="search" id="em-filtre" placeholder="ör. 5686, kiralama, ihale, jeotermal…" autocomplete="off" />
  </label>
  <label class="em-konu">
    <span>Uyuşmazlık konusu seç (emsal eşleştirici)</span>
    <select id="em-konu-sec">
      <option value="">— Konu seçin —</option>
      {[...new Set(kararlar.map((k) => k.konu))].sort((a, b) => a.localeCompare(b, 'tr')).map((k) => <option value={k}>{k}</option>)}
    </select>
  </label>
  <p class="em-sayac" id="em-sayac" aria-live="polite">{kararlar.length} karar</p>

  <div class="em-kaydir" tabindex="0" role="region">
    <table id="em-tablo">
      <caption>Merci · esas/karar no · konu · dava konusu (karar metninden alıntı) · ilgili rehber · resmî metin.</caption>
      <thead>
        <tr>
          <th scope="col">Merci</th>
          <th scope="col">Esas / Karar</th>
          <th scope="col">Konu</th>
          <th scope="col">Dava konusu (karar metninden)</th>
          <th scope="col">İlgili rehber</th>
          <th scope="col">İlgili maddeler</th>
          <th scope="col">Doğrulama</th>
        </tr>
      </thead>
      <tbody>
        {kararlar.map((k) => (
          <tr data-karar={k.id} data-konu={k.konu}>
            <th scope="row">{tamMerci(k)}</th>
            <td class="em-kunye"><a href={emsalYol(k)}>{k.esas} E.<br />{k.karar} K.</a><br /><span class="em-yil">karar tarihi {k.resmi_dogrulama.karar_tarihi}</span></td>
            <td>{k.konu}</td>
            <td>{alintiMetni(emsalAlinti(k)?.uyusmazlik)}</td>
            <td>{k.rehberler.map((r, i) => (<>{i > 0 && ' · '}<a href={`/rehberler/${r}/`}>{r}</a></>))}</td>
            <td>{(maddeByEmsal[k.id] ?? []).map((m, i) => (<>{i > 0 && ' · '}<a href={m.yol}>{m.ad}</a></>))}{!(maddeByEmsal[k.id] ?? []).length && <span class="em-kunye-bekliyor">—</span>}</td>
            <td>
              <a href={k.resmi_dogrulama.url} target="_blank" rel="noopener" class="em-ok">resmî metin</a>
              <span class="em-yil">doğrulandı {k.resmi_dogrulama.tarih.split('-').reverse().join('.')}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="em-anonim">"Dava konusu" sütunu karar metnindeki dava konusu istem cümlesinin birebir
      alıntısıdır. "…" ve "..." işaretleri Danıştay'ın yayımladığı karar metnindeki
      anonimleştirmelerdir (kişi, yer ve tutar bilgisi kaynakta gizlenmiştir); bu sitenin
      kesmesi değildir. Gerekçe ve hüküm alıntısı için künyeye, tam metin için "resmî metin" bağlantısına tıklayın.</p>
  </div>
  <p class="em-bos" id="em-bos" hidden>Bu süzgeçle eşleşen karar bulunamadı.</p>

  <nav class="em-capraz" aria-label="İlgili bölümler">
    <a href="/su-hukuku/">→ Su hukuku omurga sayfası</a>
    <a href="/rehberler/">→ Tüm rehberler</a>
    <a href="/su-kanunu/mevzuat-kutuphanesi/">→ Mevzuat kütüphanesi</a>
  </nav>

  <CtaBlok konu="Emsal kararlar" baslik="Dosyanız bu emsallerden biriyle mi örtüşüyor?" metin="Somut uyuşmazlığınızı anlatın; hangi emsal çizginin uygulanabileceğini değerlendirelim." />
  <HukukSerhi />
<script slot="ek-script" type="module" src="/s/emsal-filtre.js" is:inline></script>
</Sayfa>


<style>
  .em-anonim { margin: 0.8rem 0 0; font-size: 0.86rem; color: var(--metin-soluk); max-width: 80ch; }
  .em-serh {
    margin: 0 0 1.2rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--cizgi);
    border-left: 3px solid var(--kehribar);
    font-size: 0.9rem;
    color: var(--metin-soluk);
    max-width: 72ch;
  }

  .em-arama { display: flex; flex-direction: column; gap: 0.3rem; max-width: 30rem; margin-bottom: 0.6rem; }
  .em-konu { display: flex; flex-direction: column; gap: 0.3rem; max-width: 30rem; margin-bottom: 0.6rem; }
  .em-konu select { font: inherit; padding: 0.6rem 0.8rem; min-height: 44px; border: 1px solid var(--cizgi); background: var(--zemin-kart); color: var(--metin); }
  .em-konu span {
    font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--metin-soluk);
  }
  .em-arama span {
    font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--metin-soluk);
  }
  .em-arama input {
    font: inherit; padding: 0.6rem 0.8rem; min-height: 44px; border: 1px solid var(--cizgi);
    background: var(--zemin-kart); color: var(--metin);
  }
  .em-arama input:focus-visible { outline: 2px solid var(--su-700); outline-offset: 2px; }

  .em-sayac { font-family: var(--mono); font-size: 0.7rem; color: var(--metin-soluk); margin-bottom: 0.9rem; }

  .em-kaydir { overflow-x: auto; }
  .em-kaydir table { width: 100%; border-collapse: collapse; font-size: 0.84rem; min-width: 56rem; }
  .em-kaydir caption { caption-side: top; text-align: left; font-size: 0.78rem; color: var(--metin-soluk); padding-bottom: 0.5rem; }
  .em-kaydir th, .em-kaydir td { text-align: left; vertical-align: top; padding: 0.55rem 0.65rem; border-bottom: 1px solid var(--cizgi); }
  .em-kaydir thead th {
    font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--metin-soluk); background: var(--zemin); border-bottom: 2px solid var(--su-700); white-space: nowrap;
  }
  .em-kaydir tbody th { font-family: var(--serif); font-size: 0.95rem; font-weight: 500; white-space: nowrap; }
  .em-kaydir tbody tr:hover { background: rgba(12, 90, 124, 0.04); }

  .em-kunye { font-family: var(--mono); font-size: 0.78rem; white-space: nowrap; }
  .em-yil { color: var(--metin-soluk); }
  .em-not { color: var(--kehribar-metin); font-size: 0.82rem; }
  .em-ok { color: var(--yesil-kara); }
  .em-kunye-bekliyor { color: var(--metin-soluk); font-family: var(--mono); font-size: 0.72rem; }

  .em-bos { margin-top: 0.8rem; color: var(--metin-soluk); font-style: italic; }

  .em-capraz { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-top: 1.6rem; padding-top: 1rem; border-top: 1px solid var(--cizgi); }
  .em-capraz a { color: var(--baglanti); text-decoration: none; }
  .em-capraz a:hover { text-decoration: underline; }
</style>
