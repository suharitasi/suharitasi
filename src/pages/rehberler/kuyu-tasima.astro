  ['Teknik', 'Foto/video', 'Fiili durumu gösterir', 'Hepsinde yardımcı'],
  ['Teknik', 'Mühendis raporu', 'Bilimsel destek sağlar', 'Hepsinde'],
  ['Teknik', 'Sayaç / ölçüm sistemi bilgisi', 'Kullanma belgesinin şartı', 'Yeni kullanma belgesi'],
];

// §VIII tam akış tablo (4 kolon × 8 satır) — katmanda
const akisBas = ['Sıra', 'İşlem', 'Amaç', 'Sonuç'];
const akisSatir = [
  ['1', 'Mevcut kuyunun durumunu tespit et', 'Kuruma / çökme / kirlilik / teknik bozulma ayrımı', 'Sorun türü netleşir'],
  ['2', 'Teknik rapor al', 'Sorunun niteliğini belgele', 'DSİ’ye sunulabilir delil oluşur'],
  ['3', 'Eski kuyuyu ayır / terk et', 'Eski kuyunun işletmeye uygun olmadığını göster', 'Yeni süreç başlar'],
  ['4', 'Islah-tadil mümkün mü bak', 'Aynı kuyu üzerinde müdahale imkânı', 'Uygunsa yeni kuyu gerekmez'],
  ['5', 'Uygun değilse yeni arama başvurusu yap', 'Yeni yer için izin al', 'Yeni sondaj yolu açılır'],
  ['6', 'Yeni kuyu aç', 'DSİ onayına uygun şekilde', 'Fiziki kuyu oluşur'],
  ['7', 'Ölçüm sistemi kur', 'Kullanma belgesi için şart', 'Belgeye geçiş sağlanır'],
  ['8', 'Kullanma belgesi al', 'Yeraltı suyunu hukuka uygun kullan', 'Nihai işletme başlar'],
];

// İçindekiler (görünür bölümler + katmanlar "EK")
const icindekiler = [
  { no: '01', ad: 'Kavramsal ayrım: kuruma, çökme, kirlilik, taşınma', href: '#kavramsal-ayrim' },
  { no: '02', ad: 'Hangi hâlde hangi hukuki yol', href: '#karar' },
  { no: '03', ad: 'Yeni başvuru şeması: yedi adım', href: '#adimlar' },
  { no: '04', ad: 'İdari para cezası (m.18)', href: '#ceza' },
  { no: '05', ad: 'DSİ başvurusunda dikkat', href: '#dikkat' },
  { no: '06', ad: 'Kısa hukuki sonuç', href: '#sonuc' },
  { no: 'EK', ad: 'Madde metinleri (birebir)', href: '#madde-metinleri' },
  { no: 'EK', ad: 'Karşılaştırmalı tablo', href: '#karsilastirma' },
  { no: 'EK', ad: 'Evrak listesi (tam)', href: '#evrak' },
  { no: 'EK', ad: 'Tam akış tablosu', href: '#tam-akis' },
];

// /durumum/ ilgili personalar (çapraz bağ — B6)
const personaBaglar = [
  { yol: '/durumum/sondaj-aritma-firmasi/', ad: 'Sektör: Sondaj / arıtma firması' },
  { yol: '/durumum/gayrimenkul-gelistirici/', ad: 'Sektör: Gayrimenkul geliştirici' },
];

// ——— JSON-LD ———
// FAQPage: sorular YALNIZ kaynak bölüm başlıklarından; cevaplar kaynak metinden özet.
const sss = [
  {
    s: 'Hangi hâlde hangi hukuki yol gerekir?',
    c: 'Kuruma ve çökmede önce ıslah-tadil, giderilemezse yeni arama/kullanma; kirlilikte sağlık-çevre incelemesi ve çoğu kez yeni izin; taşınmada aynı ruhsat otomatik taşınmaz, çoğu halde yeni kuyu açma gerekir; kuyu aynı yerde korunuyorsa ıslah-tadil belgesi yeterlidir.',
  },
  {
    s: 'Kuyu taşınması aynı ruhsatla mı yapılır?',
    c: 'Hayır. Kuyu taşınması, halk arasında “aynı ruhsatla başka yere alma” sanılsa da hukuken çoğu durumda otomatik hak değildir; yeni sondaj, yeni koordinat veya farklı hidrojeolojik birim söz konusuysa işlem yeni kuyu açma niteliği taşır ve yeni arama + yeni kullanma belgesi gerektirir.',
  },
  {
    s: 'Islah-tadil ile taşınma aynı şey midir?',
    c: 'Değildir. Islah-tadil, mevcut kuyu üzerinde yapılan teknik müdahaledir (derinleştirme, kapasite artırma, amaç değişikliği). Taşınma ise yeni noktada yeni kuyu demektir ve çoğu kez yeni izin gerektirir; ıslah-tadil belgesi yeni lokasyona taşınma belgesi değildir.',
  },
  {
    s: 'Yeni arama ve kullanma belgesi için başvuru nasıl yürür?',
    c: 'Önce kuyu sorunu ve eski kuyunun statüsü tespit edilir, yeni yer seçilir; 167 m.8 ve Tüzük m.13 uyarınca arama belgesi başvurusu yapılır, sondaj yapılıp ölçüm sistemi kurulur; ardından 167 m.10 uyarınca kullanma belgesi başvurusu yapılır. Belgeler m.12 gereği harca tabi değildir.',
  },
];

const sema = [
  {
    '@type': 'Article',
    headline: d.baslik,
    description: d.ozCevap,
    datePublished: tarihISO,
    dateModified: guncellemeISO,
    inLanguage: 'tr-TR',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    image: new URL(OG_GORSEL, Astro.site).href,
    // K5 (27.08): yazar kimligi tek @id altinda — zengin Person dugumu
    // Sayfa.astro'daki graph'ta (`${kok}#yazar`). Burada yalniz REFERANS
    // verilir; ikinci, celisen url'li Person dugumu uretilmez.
    author: { '@id': `${kok}#yazar` },
    publisher: { '@id': `${kok}#kurum` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: sss.map((q) => ({
      '@type': 'Question',
      name: q.s,
      acceptedAnswer: { '@type': 'Answer', text: q.c },
    })),
  },
  // Madde 13 (geo-schema): "yedi adım" gerçek bir prosedür — HowTo olarak da
  // işaretlenir. Adım metinleri adimlar[] dizisinden birebir gelir; şemaya
  // sayfada olmayan tek kelime girmez.
  {
    '@type': 'HowTo',
    name: `${d.baslik} — yeni başvuru şeması`,
    description: d.ozCevap,
    inLanguage: 'tr-TR',
    step: adimlar.map((a, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: a.asama,
      text: `${adimEtiket.dayanak}: ${a.dayanak} · ${adimEtiket.belge}: ${a.belge} · ${adimEtiket.cikti}: ${a.cikti}`,
    })),
  },
];
---
<Sayfa baslik={d.baslik} tarayiciBaslik={d.seoBaslik} aciklama={d.ozCevap} sema={sema} heroSlot="rehber-hero">
  <div class="gk gk-baslik" style="--gk:0">
    <SayfaBasi etiket="Rehber · Süreç" baslik={d.baslik} tarih={d.guncelleme ?? d.tarih} yazarli />
  </div>

  <div class="gk" style="--gk:1">
    <OzCevap metin={d.ozCevap} etiket="Kanun özeti" />
  </div>

  {d.karar && (
    <KararMatrisi satirlar={d.karar} />
  )}

  <section class="cozer gk" style="--gk:2" aria-label="Bu rehber ne çözer">
    <p class="blok-etiket">Bu rehber ne çözer</p>
    <ul>
      <li>Kuyunuz kuruduğunda, çöktüğünde veya kirlendiğinde hangi hukuki yolun (ıslah-tadil mi, yeni ruhsat mı) gerektiği</li>
      <li>Kuyu taşımanın neden çoğu kez yeni arama + yeni kullanma belgesi anlamına geldiği</li>
      <li>Yeni başvuruda DSİ’ye sunulacak teknik ve hukuki evrakın tam listesi ve adım sırası</li>
    </ul>
  </section>

  <nav class="icindekiler gk" style="--gk:3" aria-label="İçindekiler">
    <p class="blok-etiket">İçindekiler</p>
    <ul>
      {icindekiler.map((b) => (
        <li>
          <a href={b.href}>
            <span class="ic-no" aria-hidden="true">{b.no}</span>
            <span class="ic-ad">{b.ad}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="icerik">
    <p class="giris">
      Kuruyan, çöken veya kirlenen bir yeraltı suyu kuyusunda hangi hukuki
      yolun izleneceği; kuyunun aynı yerde onarımı ile yeni bir noktada
      kuyu açılması arasındaki ayrıma bağlıdır. Bu ayrım, 167 sayılı
      Yeraltı Suları Hakkında Kanun (m.8, 10, 11, 12, 13, 18) ile Yeraltı
      Suları Tüzüğü (m.2, 4, 11, 13, 15, 16) çerçevesinde kurulur.
    </p>

    <h2 id="kavramsal-ayrim">Kuruma, çökme, kirlilik ve taşınma nasıl ayrılır?</h2>
    <p>
      Kuyu kullanılamaz hale geldiğinde tercih edilecek hukuki yol, sorunun
      niteliğine göre değişir. Dört hâl ayrı ayrı değerlendirilmelidir.
    </p>
    <div class="haller">
      {haller.map((h) => (
        <section class="hal">
          <h3>{h.ad}</h3>
          <p>{h.metin}</p>
          <p class="hal-etiket">{h.etiket}</p>
          <ul class="hal-liste">
            {h.liste.map((x) => <li>{x}</li>)}
          </ul>
          <p class="hal-sonuc">{h.sonuc}</p>
        </section>
      ))}
    </div>

    <h2 id="karar">Hangi hâlde hangi hukuki yol izlenir?</h2>
    <p>
      Aşağıdaki beş durum, kuyu kullanılamaz hale geldiğinde hangi yolun
      tercih edileceğini gösterir. En kritik ayrım taşınmadadır: aynı ruhsat
      otomatik olarak yeni yere taşınmaz.
    </p>
    <div class="kararlar">
      {kararlar.map((k) => (
        <article class={`karar${k.vurgu ? ' karar-vurgu' : ''}`}>
          <p class="karar-durum">{k.durum}</p>
          <dl>
            <div><dt>{kararKolon.nitelik}</dt><dd>{k.nitelik}</dd></div>
            <div><dt>{kararKolon.yol}</dt><dd>{k.yol}</dd></div>
            <div><dt>{kararKolon.talep}</dt><dd>{k.talep}</dd></div>
            <div><dt>{kararKolon.sonuc}</dt><dd>{k.sonuc}</dd></div>
          </dl>
        </article>
      ))}
    </div>

    <h2 id="adimlar">Yeni başvuru yedi adımda nasıl yapılır?</h2>
    <p>
      Mevcut kuyunun aynı yerde onarımla sürdürülemediği ve yeni noktada yeni
      sondaj gerektiği hallerde başvuru süreci aşağıdaki sırayla yürür.
    </p>
    <ol class="adimlar" aria-label="Yeni başvuru şeması adımları">
      {adimlar.map((a, i) => (
        <li class="adim">
          <span class="adim-no" aria-hidden="true">{i + 1}</span>
          <div class="adim-govde">
            <p class="adim-asama">{a.asama}</p>
            <p class="adim-alt">
              <span class="adim-c"><span class="adim-et">{adimEtiket.dayanak}</span> {a.dayanak}</span>
              <span class="adim-c"><span class="adim-et">{adimEtiket.belge}</span> {a.belge}</span>
              <span class="adim-c"><span class="adim-et">{adimEtiket.cikti}</span> {a.cikti}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>

    <h2 id="ceza">İdari para cezası (167 m.18)</h2>
    <div class="ceza">
      <p>
        167 sayılı Kanun’un 18. maddesine göre (23/1/2008-5728 s.K. ile
        değişik): belge almadan m.8’deki işleri yapanlar ya da kasten yanlış
        bilgi verenler <strong>bin Türk Lirasından beşbin Türk Lirasına
        kadar</strong>; m.10-11’e aykırı hareket edenler veya arama, kullanma,
        ıslah-tadil şartlarına uymayanlar <strong>beşyüz Türk Lirasından
        ikibin Türk Lirasına kadar</strong> idari para cezası ile
        cezalandırılır. Ayrıca kuyu kapatılır ve masrafı açtırandan alınır;
        ceza mahallî mülkî amir tarafından verilir.
      </p>
      <p class="apilex-not">
        Yukarıdaki tutarlar <strong>kanun metnindeki (2008) tutarlardır</strong>; idari
        para cezaları her takvim yılı başında yeniden değerleme oranında artırılarak
        uygulanır (5326 sayılı Kabahatler Kanunu m.17/7). 2026 yılı için yeniden değerleme
        oranı %25,49'dur (VUK Genel Tebliği Sıra No 585, RG 27.11.2025/33090). Uygulanan
        güncel tutarı DSİ bölge müdürlüğünden ya da kararı veren mülkî amirlikten teyit edin.
      </p>
    </div>

    <h2 id="dikkat">DSİ başvurusunda nelere dikkat edilmeli?</h2>
    <ol class="numara-liste">
      {dikkat.map((x) => <li>{x}</li>)}
    </ol>

    <h2 id="sonuc">Kısa hukuki sonuç</h2>
    <ul class="sonuc-liste">
      {sonucList.map((x) => <li>{x}</li>)}
    </ul>
  </div>

  {/* Referans blokları katmanda, varsayılan kapalı (§17b). Tam metin DOM'da
      eksiksiz ve JS'siz erişilebilir. */}
  <div id="madde-metinleri" class="katman-capa">
    <Katman baslik="Madde metinleri" ipucu="167 s. Kanun · Yeraltı Suları Tüzüğü — birebir">
      <div class="katman-icerik">
        {maddeler.map((m) => (
          <blockquote class="madde">
            <p class="madde-b">{m.baslik}</p>
            <p>{m.metin}</p>
          </blockquote>
        ))}
      </div>
    </Katman>
  </div>

  <div id="karsilastirma" class="katman-capa">
    <Katman baslik="Karşılaştırmalı tablo — kuruma, çökme, kirlilik" ipucu="Tanım · sebep · talep · yol · risk" ton="murekkep">
      <div class="tablo-kap">
        <table>
          <thead><tr>{karsBas.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{karsSatir.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </Katman>
  </div>

  <div id="evrak" class="katman-capa">
    <Katman baslik="DSİ’ye sunulacak evrak (tam liste)" ipucu="Hukuki + teknik belgeler · sistematik tablo" ton="murekkep">
      <div class="katman-icerik">
        <h3 class="evrak-h">A. Hukuki belgeler</h3>
        <dl class="evrak-liste">
          {evrakHukuki.map(([b, a]) => <div><dt>{b}</dt><dd>{a}</dd></div>)}
        </dl>
        <h3 class="evrak-h">B. Teknik belgeler</h3>
        <dl class="evrak-liste">
          {evrakTeknik.map(([b, a]) => <div><dt>{b}</dt><dd>{a}</dd></div>)}
        </dl>
        <h3 class="evrak-h">Sistematik tablo</h3>
        <div class="tablo-kap">
          <table>
            <thead><tr>{evrakBas.map((h) => <th>{h}</th>)}</tr></thead>
            <tbody>{evrakSatir.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
          </table>
        </div>
      </div>
    </Katman>
  </div>

  <div id="tam-akis" class="katman-capa">
    <Katman baslik="Yeni başvuru şeması — tam akış" ipucu="Sekiz adım · işlem · amaç · sonuç" ton="murekkep">
      <div class="tablo-kap">
        <table>
          <thead><tr>{akisBas.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{akisSatir.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </Katman>
  </div>

  {/* Risk çerçevesi (/durumum/ onaylı dil tonu) */}
  <aside class="risk" aria-label="Neden şimdi">
    <span class="risk-b">Neden şimdi</span>
    <p>
      Kuyu kuruması, çökmesi veya kirliliği fark edildiğinde izlenecek yol
      —ıslah-tadil mi, yeni ruhsat mı— baştan doğru kurulmazsa, yanlış
      başvuru yeni kuyu sayılabilir ve süreç uzar. Sorunu teknik raporla
      belgeleyip doğru hukuki yolu erken seçmek, hem uyum maliyetini hem
      denetim riskini yönetilebilir kılar.
      <span class="apilex"> Somut yaptırım/tutar için ilgili mevzuat maddesi esastır.</span>
    </p>
  </aside>

  <section class="iletisim" aria-label="İletişim">
    <p class="il-b">Kuyu sürecinizi doğru kurgulamak için iletişim</p>
    <p class="il-a">Kuyunuzun durumuna göre ıslah-tadil mi yoksa yeni ruhsat mı gerektiği ve başvuru dosyasının kurgusu için ulaşın.</p>
    <p class="il-l">
      <a href={`mailto:${EPOSTA}?subject=${encodeURIComponent('Kuyu taşıma / ıslah-tadil — su hukuku')}`}>{EPOSTA}</a>
      <span class="il-ayr">·</span>
      <a href="/hakkinda/">Künye ve yöntem</a>
    </p>
    <p class="il-not">Hukuki içerik {YAZAR.buro} tarafından hazırlanır.</p>
  </section>

  <nav class="capraz" aria-label="İlgili sektör sayfaları">
    {personaBaglar.map((b) => <a href={b.yol}>→ {b.ad}</a>)}
  </nav>

  <CtaBlok konu="Kuyu taşıma" />
  <Sss maddeler={sss.map((q) => ({ soru: q.s, cevap: q.c }))} />
  <RehberKapanis />
  <YazarKutusu />
  <SonrakiAdim konu="Kuyu taşıma" personalar={ilgiliPersonalar} />
  <IlgiliRehberler slugler={d.ilgili} haric={giris.id} />
  <HukukDanismanlik konu="Kuyu taşıma" />

  {/* 27.08 denetimi K9: hukuki şerh (kullanıcı onaylı) */}
  <HukukSerhi />
</Sayfa>

<style>
  .blok-etiket {
    display: flex; align-items: center; gap: 0.7rem;
    font-family: var(--mono); font-size: 0.66rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--su-700);
  }
  .blok-etiket::before { content: ""; width: 1.6rem; height: 1px; background: var(--su-400); }

  .cozer {
    margin: 0 0 1.3rem; padding: 1.05rem 1.3rem 1.15rem;
    background: var(--zemin-kart); border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
  }
  .cozer ul { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem 1.4rem; margin: 0.75rem 0 0; padding: 0; }
  .cozer li { font-size: 0.9rem; line-height: 1.55; padding-left: 0.8rem; border-left: 2px solid var(--su-400); }

  .icindekiler { margin: 0 0 2.4rem; }
  .icindekiler ul { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.55rem; margin: 0.75rem 0 0; padding: 0; }
  .icindekiler a {
    display: flex; align-items: baseline; gap: 0.6rem; min-height: 44px;
    padding: 0.55rem 0.8rem; background: var(--zemin-kart); border: 1px solid var(--cizgi);
    text-decoration: none; color: var(--metin);
    transition: transform 240ms var(--e-suzul), background-color 240ms var(--e-akinti), border-color 240ms var(--e-akinti);
  }
  .icindekiler a:hover { transform: translateY(-2px); background: var(--kopuk); border-color: var(--su-400); }
  .ic-no { flex: none; font-family: var(--mono); font-size: 0.62rem; font-weight: 500; letter-spacing: 0.08em; color: var(--su-700); }
  .ic-ad { font-family: var(--serif); font-size: 1.02rem; font-weight: 500; line-height: 1.25; }

  .icerik .giris { font-size: 1.02rem; }

  /* Dört hâl kartları */
  .haller { display: grid; gap: 1rem; margin: 1.1rem 0 0; }
  .hal { padding: 1.1rem 1.3rem 1.2rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); border-top: 2px solid var(--su-700); }
  .hal h3 { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; margin: 0 0 0.4rem; }
  .hal p { margin: 0; max-width: 68ch; }
  .hal-etiket { margin-top: 0.8rem !important; font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--metin-soluk); }
  .hal-liste { margin: 0.4rem 0 0; padding-left: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem 0.5rem; }
  .hal-liste li { font-family: var(--mono); font-size: 0.74rem; padding: 0.2rem 0.55rem; background: var(--kopuk, rgba(46,126,160,0.06)); border: 1px solid var(--cizgi); }
  .hal-sonuc { margin-top: 0.85rem !important; padding-top: 0.7rem; border-top: 1px solid var(--cizgi); font-size: 0.95rem; }

  /* Karar kartları (5-durum karar akışı) */
  .kararlar { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.9rem; margin: 1.1rem 0 0; }
