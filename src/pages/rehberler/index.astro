---
import { getCollection } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';

// İki küme: izin/başvuru süreci arayan okur (P3) ile yaptırım/dava ekseninde
// okuyan (P1) aynı düz listede kaybolmasın. Küme içi sıralama başlığa göre;
// 9 rehber de aynı tarihli olduğundan tarih listede sıralama ölçütü değil
// (tarih rehberin kendi sayfasında künye satırında durur).
const girisler = await getCollection('rehberler');
const kumele = (k: 'surec' | 'uyusmazlik') =>
  girisler
    .filter((g) => g.data.kume === k)
    .sort((a, b) => a.data.baslik.localeCompare(b.data.baslik, 'tr'));

const kumeler = [
  {
    anahtar: 'surec' as const,
    ad: 'Süreç rehberleri',
    ozet: 'İzin, başvuru ve belge süreçleri: hangi belge, kimden, hangi sürede.',
    girisler: kumele('surec'),
  },
  {
    anahtar: 'uyusmazlik' as const,
    ad: 'Uyuşmazlık rehberleri',
    ozet: 'Yaptırım, dava ve ihtilaf ekseni: ceza, iptal davası, kamulaştırma.',
    girisler: kumele('uyusmazlik'),
  },
];

const noYaz = (i: number) => String(i + 1).padStart(2, '0');
---
<Sayfa
  baslik="Rehberler"
  aciklama="Su hukuku rehberleri: kuyu ruhsatı, su tahsisi, ruhsatsız kuyu cezaları, kuyu belgesi iptal davaları ve daha fazlası."
>
  <SayfaBasi
    baslik="Rehberler"
    ozet="Su hukukunun pratik soruları için adım adım rehberler. Her rehber mevzuata tam metin bağlantısıyla atıf verir."
  />
  {kumeler.map((k) => (
    <section class="kume">
      <p class="kume-kicker">Rehber · {k.anahtar === 'surec' ? 'Süreç' : 'Uyuşmazlık'}</p>
      <h2 class="kume-ad">{k.ad}</h2>
      <p class="kume-ozet">{k.ozet}</p>
      <ul class="sv-liste">
        {k.girisler.map((g, i) => (
          <li>
            <a href={`/rehberler/${g.id}/`}>
              <span class="sv-no" aria-hidden="true">{noYaz(i)}</span>
              <span class="sv-metin">
                <span class="sv-baslik">{g.data.baslik}</span>
                <span class="sv-ozet">{g.data.ozet}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Sayfa>

<style>
  .kume + .kume { margin-top: 2.8rem; }

  /* Küme kicker'ı: tür ailesinin sesi (süreç=yeşil kara, uyuşmazlık=plato) */
  .kume-kicker {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .kume-kicker::before { content: ""; width: 1.6rem; height: 1px; background: currentColor; opacity: 0.55; }

  .kume:nth-of-type(1) .kume-kicker { color: var(--yesil-kara); }
  .kume:nth-of-type(2) .kume-kicker { color: var(--kehribar-metin); }

  .kume-ad {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.65rem;
    line-height: 1.25;
    margin-top: 0.45rem;
  }

  .kume-ozet {
    margin-top: 0.35rem;
    margin-bottom: 0.6rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--metin-soluk);
  }

  .sv-liste { list-style: none; }

  .sv-liste li + li { border-top: 1px solid var(--cizgi); }

  .sv-liste a {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    align-items: baseline;
    gap: 0 1rem;
    padding: 1.25rem 0.4rem;
    text-decoration: none;
    color: inherit;
    transition: transform 240ms var(--e-suzul), background-color 240ms var(--e-akinti);
  }

  .sv-liste a:hover { transform: translateY(-2px); }

  .kume:nth-of-type(1) .sv-liste a:hover { background: rgba(62, 92, 68, 0.06); }
  .kume:nth-of-type(2) .sv-liste a:hover { background: rgba(184, 134, 59, 0.07); }

  .sv-liste a:active { transform: translateY(0) scale(0.995); transition-duration: 120ms; }

  .sv-no {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1;
    color: rgba(90, 107, 98, 0.45);
    transition: color 120ms var(--e-akinti);
  }

  .sv-liste a:hover .sv-no { color: var(--su-400); }

  .sv-baslik {
    display: block;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.3;
    transition: color 120ms var(--e-akinti);
  }

  .sv-liste a:hover .sv-baslik { color: var(--su-700); }

  .sv-ozet {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.92rem;
    color: var(--metin-soluk);
    max-width: 62ch;
  }

  @media (max-width: 640px) {
    .sv-liste a { grid-template-columns: 2.6rem 1fr; }
    .sv-no { font-size: 1.3rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-liste a { transition: none; }
    .sv-liste a:hover { transform: none; }
  }
</style>
