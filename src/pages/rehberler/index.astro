---
import { getCollection } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';

const girisler = (await getCollection('rehberler')).sort(
  (a, b) => b.data.tarih.valueOf() - a.data.tarih.valueOf()
);
const tarihYaz = (t: Date) =>
  t.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Sayfa
  baslik="Rehberler"
  aciklama="Su hukuku rehberleri: kuyu ruhsatı, tahsis, içme suyu koruma alanları ve daha fazlası."
>
  <SayfaBasi
    baslik="Rehberler"
    ozet="Su hukukunun pratik soruları için adım adım rehberler. Her rehber mevzuata tam metin bağlantısıyla atıf verir."
  />
  <ul class="liste">
    {girisler.map((g) => (
      <li>
        <a href={`/rehberler/${g.id}/`}>
          <span class="liste-tarih">{tarihYaz(g.data.tarih)}</span>
          <span class="liste-baslik">{g.data.baslik}</span>
          <span class="liste-ozet">{g.data.ozet}</span>
        </a>
      </li>
    ))}
  </ul>
</Sayfa>

<style>
  .liste { list-style: none; }

  .liste li + li { border-top: 1px solid var(--cizgi); }

  .liste a {
    display: block;
    padding: 1.1rem 0;
    text-decoration: none;
    color: inherit;
  }

  .liste-tarih {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metin-soluk);
  }

  .liste-baslik {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .liste a:hover .liste-baslik { color: var(--baglanti); }

  .liste-ozet {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.92rem;
    color: var(--metin-soluk);
    max-width: 62ch;
  }
</style>
