---
import { getCollection, render } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import OzCevap from '../../components/OzCevap.astro';
import IlKurumTablosu from '../../components/IlKurumTablosu.astro';
import YazarKutusu from '../../components/YazarKutusu.astro';
import IlgiliRehberler from '../../components/IlgiliRehberler.astro';
import Katman from '../../components/Katman.astro';
import { YAZAR, OG_GORSEL } from '../../data/site';
import SonrakiAdim from '../../components/SonrakiAdim.astro';

export async function getStaticPaths() {
  const girisler = await getCollection('rehberler');
  // kuyu-tasima kendi özel sayfasıyla render edilir (src/pages/rehberler/
  // kuyu-tasima.astro); farklı yapısı (5-durum karar akışı, 7-adım, katmanlı
  // karşılaştırma/evrak tabloları) kalıp-2 iskeletine oturmaz. Buradan HARİÇ
  // tutulur → rota çakışması olmaz. Diğer rehberlerin render'ı DEĞİŞMEZ.
  return girisler
    .filter((g) => g.id !== 'kuyu-tasima')
    .map((g) => ({ params: { slug: g.id }, props: { giris: g } }));
}

const { giris } = Astro.props;
const { Content, headings } = await render(giris);

const kok = new URL('/', Astro.site).href;
const canonical = new URL(`/rehberler/${giris.id}/`, Astro.site).href;
const tarihISO = giris.data.tarih.toISOString();

// Article: YMYL (hukuk) içerikte yazar kimliği en güçlü E-E-A-T sinyali.
// FAQPage bilinçli olarak YOK: rehberlerde görünür soru-cevap bölümü
// bulunmuyor; olmayan içeriği işaretlemek Google yapılandırılmış veri
// kurallarına aykırıdır. Rehberlere gerçek SSS bölümü eklenirse eklenir.
const sema = [
  {
    '@type': 'Article',
    headline: giris.data.baslik,
    // AI-arama alıntı yüzeyi de öz cevaptan beslenir (CLAUDE.md)
    description: giris.data.ozCevap,
    datePublished: tarihISO,
    dateModified: tarihISO,
    inLanguage: 'tr-TR',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    image: new URL(OG_GORSEL, Astro.site).href,
    author: {
      '@type': 'Person',
      '@id': `${kok}hakkinda/#yazar`,
      name: YAZAR.adSade,
      jobTitle: YAZAR.unvan,
      url: YAZAR.buroUrl,
      worksFor: { '@type': 'Organization', name: YAZAR.buro, url: YAZAR.buroUrl },
    },
    publisher: { '@id': `${kok}#kurum` },
  },
];

// ——— KALIP 2 (DESIGN.md §17, pilot) build-time hazırlığı ———
// Gövde markdown'ı DOSYADA TEK PARÇA kalır (içerik tek kaynak); bölümleme
// derlenmiş HTML'in h2 sınırlarından build sırasında yapılır. Her varsayım
// assert edilir: içerik yapısı değişirse build SESSİZCE bozulmaz, düşer
// (sessiz hata yasağı). Tam metin DOM'da eksiksiz kalır (SEO/GEO dokunulmazı).
const kalip2 = giris.data.kalip === 2;
let girisHtml = '';
let bolum = new Map<string, string>();
let adimlar: { asama: string; aciklama: string; unsur: string; risk: string }[] = [];
let adimEtiket = { unsur: '', risk: '' };
let icindekiler: { no: string; ad: string; href: string }[] = [];

if (kalip2) {
  const html = (giris as any).rendered?.html as string | undefined;
  if (!html) throw new Error(`rehber "${giris.id}": rendered.html yok — kalıp 2 bölümlemesi yapılamaz.`);

  const parcalar = html.split(/(?=<h2\s)/);
  girisHtml = parcalar[0];
  for (const p of parcalar.slice(1)) {
    const id = p.match(/^<h2\s+id="([^"]+)"/)?.[1];
    if (!id) throw new Error(`rehber "${giris.id}": id'siz h2 — kalıp 2 bölümlemesi güvensiz.`);
    bolum.set(id, p);
  }
  const beklenen = [
    'rejimin-mantığı', 'üç-belge-tek-zincir', 'belge-yapısı', 'başvuru-akışı',
    'madde-metni', 'dikkat', 'dayanak', 'emsal-kararlar',
  ];
  for (const id of beklenen) {
    if (!bolum.has(id)) throw new Error(`rehber "${giris.id}": beklenen bölüm "${id}" yok.`);
  }

  // Başvuru akışı tablosu → numaralı adım kartları (§17d: gerçek prosedür
  // görsel sıra dilini hak eder). Hücre metinleri ham markdown tablosundan
  // birebir alınır; hiçbir metin atılmaz (etiketler dahil tablodan gelir).
  const akisMd = (giris.body ?? '').split(/^## /m).find((b) => b.startsWith('Başvuru akışı'));
  if (!akisMd) throw new Error(`rehber "${giris.id}": ham gövdede "Başvuru akışı" bölümü yok.`);
  const tabloSatir = akisMd.split('\n').filter((s) => s.trim().startsWith('|'));
  if (tabloSatir.length < 3) throw new Error(`rehber "${giris.id}": başvuru akışı tablosu bulunamadı.`);
  const hucre = (s: string) => s.split('|').map((x) => x.trim()).filter(Boolean);
  const basliklar = hucre(tabloSatir[0]);
  if (basliklar.length !== 4) throw new Error(`rehber "${giris.id}": başvuru akışı tablosu 4 kolon değil.`);
  adimEtiket = { unsur: basliklar[2], risk: basliklar[3] };
  adimlar = tabloSatir.slice(2).map((s) => {
    const h = hucre(s);
    if (h.length !== 4) throw new Error(`rehber "${giris.id}": başvuru akışı satırı 4 hücre değil: ${s}`);
    return { asama: h[0], aciklama: h[1], unsur: h[2], risk: h[3] };
  });
  if (adimlar.length !== 4) throw new Error(`rehber "${giris.id}": başvuru akışında 4 adım bekleniyordu.`);

  // Derlenmiş bölümdeki ham tabloyu çıkar — metni artık adım kartları taşıyor.
  const akisHtml = bolum.get('başvuru-akışı')!;
  if (!/<table>[\s\S]*?<\/table>/.test(akisHtml))
    throw new Error(`rehber "${giris.id}": başvuru akışı bölümünde tablo yok.`);
  bolum.set('başvuru-akışı', akisHtml.replace(/<table>[\s\S]*?<\/table>/, ''));

  // İçindekiler kartları: görünür bölümler BÖLÜM sayacıyla aynı sırada
  // numaralanır; katmana inen referans blokları "EK" etiketiyle listelenir.
  const gorunur = headings.filter((h) => h.depth === 2 && h.slug !== 'madde-metni');
  icindekiler = [
    ...gorunur.map((h, i) => ({
      no: String(i + 1).padStart(2, '0'),
      ad: h.text,
      href: `#${h.slug}`,
    })),
    { no: 'EK', ad: 'Madde metinleri (birebir)', href: '#madde-metinleri' },
    { no: 'EK', ad: '81 il için yetkili kurumlar', href: '#il-tablosu' },
  ];
}
---
<Sayfa baslik={giris.data.baslik} aciklama={giris.data.ozCevap} sema={sema} heroSlot="rehber-hero">
{kalip2 ? (
  <Fragment>
    {/* ——— KALIP 2 (DESIGN.md §17, pilot): ilk ekran = öz cevap + "ne çözer"
        + içindekiler kartları. Çifte özet yasağı: SayfaBasi'ya ozet GEÇİLMEZ —
        görünür tek özet OzCevap'tır (ozet, liste kartları + og metni olarak
        yaşar). Giriş koreografisi: .gk sıralı fadeUp (transitions-dev
        uyarlaması; su-ivmesi --e-suzul, reduced-motion korumalı). */}
    <div class="gk gk-baslik" style="--gk:0">
      <SayfaBasi
        etiket={giris.data.kume === 'surec' ? 'Rehber · Süreç' : 'Rehber · Uyuşmazlık'}
        baslik={giris.data.baslik}
        tarih={giris.data.tarih}
        yazarli
      />
    </div>

    <div class="gk" style="--gk:1">
      <OzCevap metin={giris.data.ozCevap} />
    </div>

    {giris.data.cozer && (
      <section class="cozer gk" style="--gk:2" aria-label="Bu rehber ne çözer">
        <p class="blok-etiket">Bu rehber ne çözer</p>
        <ul>
          {giris.data.cozer.map((c) => <li>{c}</li>)}
        </ul>
      </section>
    )}

    <nav class="icindekiler gk" style="--gk:3" aria-label="İçindekiler">
      <p class="blok-etiket">İçindekiler</p>
      <ul>
        {icindekiler.map((b) => (
          <li>
            <a href={b.href}>
              <span class="ic-no" aria-hidden="true">{b.no}</span>
              <span class="ic-ad">{b.ad}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="icerik kalip2-icerik">
      <Fragment set:html={girisHtml} />
      <Fragment set:html={bolum.get('rejimin-mantığı')} />
      <Fragment set:html={bolum.get('üç-belge-tek-zincir')} />
      <Fragment set:html={bolum.get('belge-yapısı')} />
      <Fragment set:html={bolum.get('başvuru-akışı')} />
      <ol class="adimlar" aria-label="Başvuru akışı adımları">
        {adimlar.map((a, i) => (
          <li class="adim">
            <span class="adim-no" aria-hidden="true">{i + 1}</span>
            <div class="adim-govde">
              <p class="adim-asama">{a.asama}</p>
              <p class="adim-aciklama">{a.aciklama}</p>
              <p class="adim-alt">
                <span class="adim-unsur">{adimEtiket.unsur}: {a.unsur}</span>
                <span class="adim-risk">{adimEtiket.risk}: {a.risk}</span>
              </p>
            </div>
          </li>
        ))}
      </ol>
      <Fragment set:html={bolum.get('dikkat')} />
      <Fragment set:html={bolum.get('dayanak')} />
      <Fragment set:html={bolum.get('emsal-kararlar')} />
    </div>

    {/* Referans blokları katmanda, varsayılan kapalı (§17b). Tam metin DOM'da
        eksiksiz ve JS'siz erişilebilir — katman yalnız göz hiyerarşisini yönetir. */}
    <div id="madde-metinleri" class="katman-capa">
      <Katman baslik="Madde metinleri" ipucu="167 s. Kanun m.8, 10, 11 · Yeraltı Suları Tüzüğü m.3, 4 — birebir">
        <div class="icerik katman-icerik">
          <Fragment set:html={bolum.get('madde-metni')} />
        </div>
      </Katman>
    </div>

    {giris.data.ilKurumTablosu && (
      <div id="il-tablosu" class="katman-capa">
        <Katman baslik="81 il için yetkili kurumlar" ipucu="DSİ bölgeleri · havzalar · su idareleri" ton="murekkep">
          <IlKurumTablosu />
        </Katman>
      </div>
    )}

    <YazarKutusu />
    <SonrakiAdim konu={giris.data.baslik} />
    <IlgiliRehberler slugler={giris.data.ilgili} haric={giris.id} />
  </Fragment>
) : (
  <Fragment>
  <SayfaBasi
    etiket={giris.data.kume === 'surec' ? 'Rehber · Süreç' : 'Rehber · Uyuşmazlık'}
    baslik={giris.data.baslik}
    ozet={giris.data.ozet}
    tarih={giris.data.tarih}
    yazarli
  />
  <OzCevap metin={giris.data.ozCevap} />
  <div class="icerik">
    <Content />
  </div>
  {giris.data.ilKurumTablosu && <IlKurumTablosu />}
  <YazarKutusu />
  <SonrakiAdim konu={giris.data.baslik} />
    <IlgiliRehberler slugler={giris.data.ilgili} haric={giris.id} />
  </Fragment>
)}
</Sayfa>

<style>
  /* Giriş koreografisi (.gk) TEK KAYNAK: src/styles/hareket.css
     (Sayfa layout import eder). Önce burada birebir kopyaydı — B3 bulgusu. */

  /* Blok kicker'ı: sayfa-etiket ailesiyle aynı imza (DESIGN.md §7) */
  .blok-etiket {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--su-700);
  }

  .blok-etiket::before {
    content: "";
    width: 1.6rem;
    height: 1px;
    background: var(--su-400);
  }

  /* "Bu rehber ne çözer": veri bandı ailesinden kart (§8) — DERİN hairline */
  .cozer {
    margin: 0 0 1.3rem;
    padding: 1.05rem 1.3rem 1.15rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
  }

  .cozer ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem 1.4rem;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .cozer li {
    font-size: 0.9rem;
    line-height: 1.55;
    padding-left: 0.8rem;
    border-left: 2px solid var(--su-400);
  }

  /* İçindekiler kartları (§17d kart dili): numara = BÖLÜM sayacıyla aynı */
  .icindekiler { margin: 0 0 2.4rem; }

  .icindekiler ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .icindekiler a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.55rem 0.8rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    text-decoration: none;
    color: var(--metin);
    transition: transform 240ms var(--e-suzul),
      background-color 240ms var(--e-akinti),
      border-color 240ms var(--e-akinti);
  }

  .icindekiler a:hover {
    transform: translateY(-2px);
    background: var(--kopuk);
    border-color: var(--su-400);
  }

  .ic-no {
    flex: none;
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--su-700);
  }

  .ic-ad {
    font-family: var(--serif);
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.25;
  }

  /* Başvuru akışı adım kartları: dikey ray + numaralı düğüm — gerçek
     prosedür sırası (§17d), süs numarası değil */
  .adimlar {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    position: relative;
    max-width: 66ch;
  }

  .adimlar::before {
    content: "";
    position: absolute;
    left: 1.15rem;
    top: 1rem;
    bottom: 1rem;
    width: 1px;
    background: linear-gradient(180deg,
      var(--su-400) 0%, var(--su-400) 78%, rgba(46, 126, 160, 0) 100%);
  }

  .adim {
    position: relative;
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    gap: 0 1.1rem;
    padding: 0.85rem 0;
    margin: 0;
  }

  .adim-no {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--su-700);
    background: var(--zemin-kart);
    border: 1px solid var(--su-400);
    border-radius: 50%;
  }

  .adim-govde > p { margin: 0; max-width: none; }

  .adim-asama {
    font-family: var(--serif);
    font-size: 1.18rem;
    font-weight: 500;
    line-height: 1.3;
    padding-top: 0.3rem;
  }

  .adim-aciklama {
    font-size: 0.94rem;
    margin-top: 0.15rem !important;
  }

  .adim-alt {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.4rem;
    margin-top: 0.45rem !important;
    font-family: var(--mono);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  .adim-unsur { color: var(--metin-soluk); }
  .adim-risk { color: var(--kehribar-metin); }

  /* Geniş tablo kendi kabında kayar (§17e: sayfa gövdesi yatay kaymaz).
     set:html içeriği scoped kimlik almadığından :global ile hedeflenir;
     yalnız kalıp 2 sarmalayıcısına bağlıdır — diğer sayfalar etkilenmez. */
  :global(.kalip2-icerik table) {
    display: block;
    overflow-x: auto;
  }

  /* Katman içi markdown: başlığı summary taşıyor — h2 göz katmanından
     çıkar ama DOM'da durur (SEO/GEO); Sakarya kalıbıyla aynı teknik. */
  :global(.katman-icerik) { margin-top: 0 !important; }
  :global(.katman-icerik > h2:first-child) { display: none; }

  .katman-capa { scroll-margin-top: 5rem; }

  @media (max-width: 700px) {
    .cozer ul { grid-template-columns: 1fr; gap: 0.7rem; }
    .icindekiler ul { grid-template-columns: repeat(2, 1fr); }
    .ic-ad { font-size: 0.95rem; }
  }
</style>
