---
// IL/ILCE SU POTANSİYELİ VE LOKASYON ANALİZİ — /ilce-sorgu/
// Client-side render: slug-tabanli veri indeksi, sifir reload.
import Sayfa from '../layouts/Sayfa.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import OzCevap from '../components/OzCevap.astro';
import Katman from '../components/Katman.astro';
import { tumIlProfilleri } from '../data/il-profil.js';
import { ilPotansiyel } from '../data/potansiyel.js';
import ilKurum from '../../data/il-kurum.json';
import { EPOSTA, YAZAR } from '../data/site';
import ilceDizin from '../../veri/potansiyel/ilce-il-dizini.json' assert { type: 'json' };
import ilceMorf from '../../veri/potansiyel/ilce-morfoloji.json' assert { type: 'json' };

const profiller = tumIlProfilleri();
const ilAdlari = profiller.map((p) => p.il);

const ilcelerRaw = ilceDizin.ilceler || {};
const ilIlceler = {};
for (const [ilceAd, iller] of Object.entries(ilcelerRaw))
  for (const il of (iller || [])) (ilIlceler[il] ??= []).push(ilceAd);
for (const il of Object.keys(ilIlceler)) ilIlceler[il].sort((a, b) => a.localeCompare(b, 'tr'));

const ilProfilData = {};
for (const p of profiller)
  ilProfilData[p.il] = { dsi: (p.dsiBolgeleri||[]).map(b => `DSİ ${Number(b.no)}. Bolge Mudurlugu (${b.merkez})`).join(' · '), graceYon: p.graceEgilim?.yon || null };

const ilPotansiyelData = {};
for (const il of ilAdlari) {
  const pt = ilPotansiyel(il);
  ilPotansiyelData[il] = {
    kutle: pt?.kutleler?.length || 0,
    rg: (pt?.rgKayitlari?.length || 0) + (pt?.rgEkKayitlari?.length || 0),
    osm: pt?.osm ? 1 : 0,
  };
}

const suIdareleri = ilKurum.suIdareleri || {};

// ILCE DUZEYiNDE morfoloji: ilce-morfoloji.json'dan (duz_oran, vadi_oran yuzde)
const ilceMorfData = ilceMorf.ilceler || {};

function slugla(ad) {
  if (!ad) return '';
  return String(ad).trim().toLowerCase().replace(/ğ/g,'g').replace(/ü/g,'u').replace(/ş/g,'s').replace(/ı/g,'i').replace(/ö/g,'o').replace(/ç/g,'c').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
}

// Slug-tabanli ilce duzeyinde indeks:
// IL_INDEX[ilSlug] = { ad, ilceler: [ { ad, slug, duz_oran, vadi_oran, ort_egim } ], potansiyel, profil, suIdare }
const IL_INDEX = {};
for (const il of ilAdlari) {
  const ilSlug = slugla(il);
  const ilceler = (ilIlceler[il]||[]).map(ic => {
    const m = ilceMorfData[ic] || {};
    return {
      ad: ic, slug: slugla(ic),
      duz_oran: m.duz_oran != null ? m.duz_oran / 100 : 0,
      vadi_oran: m.vadi_oran != null ? m.vadi_oran / 100 : 0,
      ort_egim: m.ort_egim ?? null,
    };
  });
  IL_INDEX[ilSlug] = {
    ad: il, ilceler,
    potansiyel: ilPotansiyelData[il] || {},
    profil: ilProfilData[il] || {},
    suIdare: suIdareleri[il] || '',
  };
}

const IL_LISTESI = ilAdlari.map(il => ({ ad: il, slug: slugla(il) }));
const VERI = JSON.stringify(IL_INDEX);

const ozet = 'Türkiye\'de il ve ilçe bazında yeraltı su potansiyeli, arazi morfolojisi ve sondaj lokasyon analizi. İl ve ilçe seçerek bölgenizdeki su çıkma olasılığını hesaplayın.';
---

<Sayfa baslik="İl/İlçe Yeraltı Su Potansiyeli ve Lokasyon Analizi" aciklama={ozet}>
  <SayfaBasi etiket="Araç" baslik="İl/İlçe Yeraltı Su Potansiyeli" />
  <OzCevap metin={ozet} />

  <Katman baslik="Konum Seçimi" ipucu="il seçimi zorunlu · ilçe opsiyonel">
    <form id="sorgu-form" class="sorgu-form">
      <div class="sorgu-grid">
        <div>
          <label for="il-sec" class="saha-etiket">İl</label>
          <select id="il-sec" class="il-secici">
            <option value="">— İl seçiniz —</option>
            {IL_LISTESI.map(il => <option value={il.slug}>{il.ad}</option>)}
          </select>
        </div>
        <div>
          <label for="ilce-sec" class="saha-etiket">İlçe</label>
          <select id="ilce-sec" class="il-secici" disabled>
            <option value="">— Önce il seçin —</option>
          </select>
        </div>
      </div>
      <button type="button" id="sorgu-btn" class="sorgu-btn">Analiz Et</button>
    </form>
    <p class="not" style="margin-top:0.4rem" id="ilce-sayisi"></p>
  </Katman>

  <div id="analiz-sonuc" style="display:none">
    <Katman baslik="Su Çıkma Olasılığı ve Bilimsel Analiz" ipucu="AHP ağırlıklı · TWI + YAS + yağış + yüzey suyu">
      <div class="ahp-skor">
        <div class="ahp-ana" id="ahp-ana">
          <div class="ahp-deger" id="skor-degeri">—</div>
          <div class="ahp-etiket" id="skor-etiket"></div>
        </div>
        <div class="ahp-detay-grid">
          <div class="ahp-kart"><strong>Potansiyeli Yüksek Alanlar</strong><p id="potansiyel-alanlar"></p></div>
          <div class="ahp-kart"><strong>Jeolojik / Akifer Yapısı</strong><p id="akifer-yapisi"></p></div>
          <div class="ahp-kart"><strong>Tahmini Derinlik Aralığı</strong><p id="derinlik-tahmini"></p></div>
          <div class="ahp-kart"><strong>İlçe Genel Skor Bileşenleri</strong><p id="skor-bilesenleri"></p></div>
        </div>
        <p class="not" style="margin-top:0.8rem">Bu analiz Copernicus GLO-90 DEM, DSİ 2024, NHYP ve GRACE verilerinden turetilen BILIMSEL BIR GOSTERGEDIR. Saha etudu veya hidrojeolojik rapor YERINE GECMEZ.</p>
      </div>
    </Katman>
    <Katman baslik="Yetkili Kurum" ipucu="DSİ bölge · su idaresi"><dl class="kunye kunye-katman"><div class="kunye-satir"><dt>DSİ Bölge(ler)</dt><dd id="dsi-bolge"></dd></div><div class="kunye-satir"><dt>Su idaresi</dt><dd id="su-idaresi"></dd></div></dl></Katman>
    <Katman baslik="Arazi Yapısı" ipucu="Copernicus GLO-90 DEM"><dl class="kunye kunye-katman"><div class="kunye-satir"><dt>Düz arazi (&lt;%2 eğim)</dt><dd id="morf-duz"></dd></div><div class="kunye-satir"><dt>Vadi tabanı</dt><dd id="morf-vadi"></dd></div><div class="kunye-satir"><dt>Ortalama eğim</dt><dd id="morf-egim"></dd></div></dl></Katman>
    <Katman baslik="Su Potansiyeli Verileri" ipucu="NHYP · DSİ · Resmî Gazete · OSM"><div class="potansiyel-ozet" id="potansiyel-kartlar"></div></Katman>
    <Katman baslik="Su Hukuku ve Ruhsat Süreçleri" ipucu="kuyu ruhsatı · DSİ kısıtları · idari yaptırım" ton="kehribar">
      <div class="hukuk-yonlendirme">
        <p class="hukuk-yon-metin" id="hukuk-yon-metin"></p>
        <div class="hukuk-yon-links"><a href="/rehberler/kuyu-ruhsati/" class="hukuk-link hukuk-link-ana">Kuyu Ruhsatı Başvuru Süreci</a><a href="/rehberler/ruhsatsiz-kuyu-cezalari/" class="hukuk-link">Ruhsatsız Kuyu Cezaları</a></div>
      </div>
    </Katman>

    {/* 24.08: B2B satış banner'ı KALDIRILDI (PayTR mağazası kapandı);
        yerine mevcut mailto CTA deseni (SonrakiAdim ile aynı metin) — fiyat,
        ödeme ve yeni vaat YOK. */}
    <p class="ilce-temas">
      <a href={`mailto:${EPOSTA}?subject=${encodeURIComponent('Su hukuku — ilçe sorgusu üzerinden')}`}>Bu konuda görüş alın</a>
      <span> — hukuki içerik {YAZAR.buro} tarafından hazırlanır ({EPOSTA}).</span>
    </p>
  </div>

  <div id="analiz-bos">
    <Katman baslik="Nasıl Kullanılır?" ipucu="3 adımda su potansiyeli analizi">
      <div class="kullanim-grid">
        <div class="kullanim-adim"><strong>1. İl seçin</strong><p>81 ilden birini seçerek il düzeyinde arazi morfolojisi ve su potansiyeli analizini görüntüleyin.</p></div>
        <div class="kullanim-adim"><strong>2. İlçe seçin</strong><p>İlçe seçimiyle daha yerel analiz alın. Potansiyeli yüksek alanlar, akifer yapısı ve derinlik aralığı gösterilir.</p></div>
        <div class="kullanim-adim"><strong>3. Analiz Et</strong><p>Düğmeye tıklayın; sonuç sayfa yenilenmeden anında karşınıza gelsin.</p></div>
      </div>
    </Katman>
  </div>

  <Katman baslik="Kapsam ve Uyarı" ton="murekkep" ipucu="veri kaynakları · sınırlar">
    <p class="not">Bu araç resmî kaynaklardan derlenen açık verileri sunar; hukuki görüş, yatırım tavsiyesi veya saha etüdü raporu NİTELİĞİ TAŞIMAZ.</p>
    <p class="not">Veri kaynakları: DSİ, SYGM NHYP, GRACE NASA GSFC, EPİAŞ, Copernicus GLO-90 DEM, OSM (ODbL). Tüm veri TEMSİLÎDİR.</p>
  </Katman>
</Sayfa>

<style>
  .sorgu-form { margin: 1rem 0; }
  .sorgu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .saha-etiket { display: block; font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--metin-soluk); margin-bottom: 0.3rem; }
  .il-secici { width: 100%; padding: 0.7rem 1rem; font-size: 1rem; font-family: var(--govde); border: 1px solid var(--cizgi); background: var(--zemin-kart); color: var(--metin); border-radius: 0; appearance: auto; }
  .il-secici:focus { outline: 2px solid var(--su-500); outline-offset: 1px; }
  .sorgu-btn { margin-top: 0.8rem; padding: 0.6rem 1.4rem; background: var(--su-700); color: #fff; border: 0; font-size: 0.9rem; font-weight: 600; font-family: var(--mono); cursor: pointer; }
  .sorgu-btn:hover { background: var(--su-800, #08405A); }
  .kunye { margin: 0 0 2rem; padding: 1.3rem 1.4rem 1.3rem 1.8rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); border-top: 2px solid var(--su-700); position: relative; }
  .kunye::before { content: ""; position: absolute; left: 0.6rem; top: 1rem; bottom: 1rem; width: 6px; background: repeating-linear-gradient(180deg, rgba(46,126,160,.4) 0 1px, transparent 1px 7px), linear-gradient(90deg, rgba(46,126,160,.4) 0 1px, transparent 1px); }
  .kunye-katman { margin: 0; padding: 0.4rem 0 0; background: transparent; border: 0; }
  .kunye-katman::before { display: none; }
  .kunye-satir { display: grid; grid-template-columns: minmax(8rem, 12rem) 1fr; gap: 0.4rem 1.2rem; padding: 0.5rem 0; }
  .kunye-satir + .kunye-satir { border-top: 1px solid var(--cizgi); }
  dt { font-family: var(--mono); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--metin-soluk); align-self: center; }
  dd { font-size: 0.96rem; }
  .potansiyel-ozet { display: flex; gap: 1rem; flex-wrap: wrap; }
  .metrik-kart { flex: 1; min-width: 8rem; text-align: center; padding: 1rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); }
  .metrik-deger { display: block; font-size: 2rem; font-weight: 600; color: var(--su-700); font-family: var(--serif); }
  .metrik-etiket { display: block; font-size: 0.72rem; color: var(--metin-soluk); margin-top: 0.3rem; }
  .kullanim-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.8rem; }
  .kullanim-adim { padding: 0.9rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); }
  .kullanim-adim strong { display: block; font-size: 0.92rem; color: var(--metin); margin-bottom: 0.3rem; }
  .kullanim-adim p { font-size: 0.82rem; color: var(--metin-soluk); margin: 0; line-height: 1.45; }
  .ahp-ana { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.3rem; margin-bottom: 1rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); }
  .ahp-deger { font-family: var(--serif); font-size: 2.8rem; font-weight: 600; line-height: 1; }
  .ahp-etiket { font-size: 0.95rem; color: var(--metin); }
  .ahp-detay-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  .ahp-kart { padding: 0.9rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); }
  .ahp-kart strong { display: block; font-size: 0.84rem; margin-bottom: 0.3rem; color: var(--metin); }
  .ahp-kart p { font-size: 0.82rem; color: var(--metin-soluk); margin: 0; line-height: 1.4; }
  .hukuk-yonlendirme { padding: 0.3rem 0; }
  .hukuk-yon-metin { font-size: 0.92rem; color: var(--metin); margin-bottom: 1rem; line-height: 1.5; }
  .hukuk-yon-links { display: flex; flex-direction: column; gap: 0.5rem; }
  .hukuk-link { display: block; padding: 0.6rem 1rem; text-decoration: none; font-size: 0.88rem; border: 1px solid var(--cizgi); background: var(--zemin-kart); color: var(--metin); }
  .hukuk-link:hover { background: var(--zemin-kart-hover, #f0f4f7); }
  .hukuk-link-ana { border-left: 4px solid var(--kehribar-600, #875518); font-weight: 600; }
  .not { font-size: 0.88rem; color: var(--metin-soluk); margin: 0.5rem 0; }


  @media (max-width: 560px) {
    .sorgu-grid { grid-template-columns: 1fr; }
    .kunye-satir { grid-template-columns: 1fr; gap: 0.1rem; }
    .ahp-detay-grid { grid-template-columns: 1fr; }
    .ahp-ana { flex-direction: column; text-align: center; }
  }
  .ilce-temas { margin-top: 0.8rem; font-size: 0.9rem; color: var(--metin-soluk); }
  .ilce-temas a { color: var(--baglanti, var(--su-700)); }
</style>

<script type="application/json" id="veri-paketi" set:html={VERI}></script>
<script>
document.addEventListener('DOMContentLoaded', () => {

  // ── VERİ YÜKLEME ──
  const ve = document.getElementById('veri-paketi');
  if (!ve) { console.error('[ilce-sorgu] veri-paketi bulunamadi'); return; }
  let IDX;
  try { IDX = JSON.parse(ve.textContent); } catch (e) { console.error('[ilce-sorgu] JSON parse hatasi:', e); return; }

  // ── DOM REFERANSLARI ──
  const G = (id) => document.getElementById(id);
  const ilSel = G('il-sec');
  const icSel = G('ilce-sec');
  const btn   = G('sorgu-btn');
  const frm   = G('sorgu-form');
  const sonuc = G('analiz-sonuc');
  const bos   = G('analiz-bos');
  const sayiP = G('ilce-sayisi');

  if (!ilSel || !icSel || !btn || !sonuc || !bos) {
    console.error('[ilce-sorgu] DOM eksik:', { il:!!ilSel, ic:!!icSel, btn:!!btn, sonuc:!!sonuc, bos:!!bos });
    return;
  }

  const fmt = (n, o) => n?.toLocaleString?.('tr-TR', { minimumFractionDigits: o, maximumFractionDigits: o }) ?? String(n);

  // ── YARDIMCI: tum cikti alanlarini temizle ──
  const CIKTI_ALANLARI = ['skor-degeri','skor-etiket','potansiyel-alanlar','akifer-yapisi','derinlik-tahmini','skor-bilesenleri','dsi-bolge','su-idaresi','morf-duz','morf-vadi','morf-egim','potansiyel-kartlar','hukuk-yon-metin'];
  function tumunuTemizle() {
    for (const id of CIKTI_ALANLARI) { const el = G(id); if (el) el.textContent = el.innerHTML = ''; }
    sonuc.style.display = 'none';
    bos.style.display = '';
  }

  // ── getData(ilSlug, ilceSlug) → direk ilce slug lookup ──
  function getData(ilSlug, icSlug) {
    const ilKayit = IDX[ilSlug];
    if (!ilKayit) { console.warn('[getData] il bulunamadi:', ilSlug); return null; }
    const icKayit = ilKayit.ilceler.find(c => c.slug === icSlug);
    if (!icKayit) { console.warn('[getData] ilce bulunamadi:', icSlug, 'ilceler:', ilKayit.ilceler.map(c=>c.slug).slice(0,5)); return null; }
    // ilce duzeyinde morfoloji dogrudan icKayit icinde
    return {
      ilAd: ilKayit.ad,
      ilceAd: icKayit.ad,
      duz_oran: icKayit.duz_oran || 0,
      vadi_oran: icKayit.vadi_oran || 0,
      ort_egim: icKayit.ort_egim ?? null,
      kutle: ilKayit.potansiyel.kutle || 0,
      rg: ilKayit.potansiyel.rg || 0,
      osm: ilKayit.potansiyel.osm || 0,
      dsi: ilKayit.profil.dsi || '',
      graceYon: ilKayit.profil.graceYon || null,
      suIdare: ilKayit.suIdare || '',
    };
  }

  // ── FORM SUBMİT ENGELLEME ──
  frm.addEventListener('submit', (e) => { e.preventDefault(); return false; });

  // ── IL DEĞİŞİMİ → ilce'yi flush, sonuclari gizle ──
  ilSel.addEventListener('change', () => {
    const ilSlug = ilSel.value;
    tumunuTemizle();
    icSel.innerHTML = '';
    icSel.disabled = true;

    if (!ilSlug || !IDX[ilSlug]) {
      icSel.appendChild(new Option('— Önce il seçin —', ''));
      if (sayiP) sayiP.textContent = '';
      try { const u = new URL(window.location); u.searchParams.delete('il'); u.searchParams.delete('ilce'); history.replaceState(null,'',u); } catch(e){}
      return;
    }

    const kayit = IDX[ilSlug];
    icSel.appendChild(new Option('— İlçe seçiniz —', ''));
    try {
      for (const ic of kayit.ilceler) {
        const o = document.createElement('option');
        o.value = ic.slug;
        o.textContent = ic.ad;
        icSel.appendChild(o);
      }
      icSel.disabled = false;
      if (sayiP && kayit.ilceler.length)
        sayiP.textContent = kayit.ad + ' ilinde ' + kayit.ilceler.length + ' ilçe bulunmaktadır. İlçe seçip "Analiz Et"e tıklayın.';
    } catch (e) {
      console.error('[ilce-sorgu] ilce doldurma hatasi:', e);
      icSel.innerHTML = '';
      icSel.appendChild(new Option('— Hata —', ''));
    }

    try { const u = new URL(window.location); u.searchParams.set('il', ilSlug); u.searchParams.delete('ilce'); history.replaceState(null,'',u); } catch(e){}
  });

  // ── ANALİZ ET ──
  function analizEt() {
    // ANLIK DEGER OKUMA — asla global state/cache
    const ilSlug = ilSel.value;
    const icSlug = icSel.value;
    console.log('[Sorgu] Sorgulanan İl slug:', ilSlug, '| Sorgulanan İlçe slug:', icSlug);
    if (!ilSlug || !icSlug) { alert('Lütfen hem il hem de ilçe seçiniz.'); return; }

    const d = getData(ilSlug, icSlug);
    if (!d) { alert('Seçilen il/ilçe için veri bulunamadı.'); return; }

    // VERiFiCATiON LOG: her ilce icin farkli ham veri
    console.log('[VERi]', d.ilAd, '/', d.ilceAd,
      '| duz:', d.duz_oran?.toFixed(3), 'vadi:', d.vadi_oran?.toFixed(3),
      '| kutle:', d.kutle, 'grace:', d.graceYon);

    const duz = d.duz_oran, vadi = d.vadi_oran, egim = d.ort_egim;
    const yasS = Math.min(1, (d.kutle||0)/15);
    const twiS = (duz + vadi)/2 || 0.3;
    const yagS = d.graceYon === 'azalma' ? 0.3 : 0.6;
    const jrcS = Math.min(1, duz*1.5) || 0.3;
    const ahp = Math.round((yasS*.35 + twiS*.3 + yagS*.2 + jrcS*.15)*100);
    const sev = ahp>=70?'Yüksek Potansiyel':ahp>=45?'Orta Potansiyel':'Düşük Potansiyel';
    const rnk = ahp>=70?'#2E7D32':ahp>=45?'#E65100':'#C62828';
    console.log('[Analiz] AHP:',ahp+'% YAS:'+Math.round(yasS*100)+' TWI:'+Math.round(twiS*100)+' Yagis:'+Math.round(yagS*100)+' JRC:'+Math.round(jrcS*100));

    // Tum ciktilari once temizle, sonra yaz
    tumunuTemizle();

    const setT = (id,v) => { const e=G(id); if(e) e.textContent = v; };
    const setH = (id,v) => { const e=G(id); if(e) e.innerHTML = v; };
    const setS = (id,p,v) => { const e=G(id); if(e) e.style[p] = v; };

    setT('skor-degeri', ahp+'%'); setS('skor-degeri','color',rnk);
    setH('skor-etiket', sev+' — '+d.ilAd+' / '+d.ilceAd+' İlçe Genel Su Çıkma Olasılığı');
    setS('ahp-ana','borderLeftColor',rnk);

    const yk = [];
    if (duz>.3) yk.push('alüvyal tabanlar ve düzlük alanlar');
    if (vadi>.15) yk.push('dere yatakları ve TWI çanakları');
    if ((egim??99)<5) yk.push('eğimin %5\'in altında olduğu alçak araziler');
    if (!yk.length) yk.push('vadi içi alçak kesimler');
    setT('potansiyel-alanlar', d.ilceAd+' ilçesinde su çıkma ihtimalinin en yüksek olduğu bölgeler: '+yk.join(', ')+'.');

    const akf = duz>.5?'Alüvyon / Alüvyal Akifer (geçirgen kum-çakıl)':vadi>.3?'Karstik Kireçtaşı Akiferi (çatlaklı-erimiş yapı)':'Gözenekli Granit / Kırıklı Kaya Akiferi (çatlak suyu)';
    setT('akifer-yapisi', d.ilceAd+' ilçesinde baskın kayaç ve akifer türü: '+akf+'.');

    const dMin = Math.round(15+(1-duz)*65), dMax = Math.round(dMin+40);
    setT('derinlik-tahmini', d.ilceAd+' ilçesinde tahmini su doygunluk derinliği: '+dMin+' – '+dMax+' metre arası.');

    setT('skor-bilesenleri','AHP: YAS %'+Math.round(yasS*100)+' · TWI %'+Math.round(twiS*100)+' · Yağış %'+Math.round(yagS*100)+' · Yüzey Suyu %'+Math.round(jrcS*100));
    setT('dsi-bolge', d.dsi||'veri yok');
    setT('su-idaresi', d.suIdare||'Il Ozel Idaresi / belediye');
    setT('morf-duz', fmt(duz*100,1)+'%');
    setT('morf-vadi', fmt(vadi*100,1)+'%');
    setT('morf-egim', fmt(egim||0,1)+'°');

    let kh = '';
    if (d.kutle>0) kh += '<div class="metrik-kart"><span class="metrik-deger">'+d.kutle+'</span><span class="metrik-etiket">YAS kutlesi</span></div>';
    if (d.rg>0) kh += '<div class="metrik-kart"><span class="metrik-deger">'+d.rg+'</span><span class="metrik-etiket">RG isletme sahasi</span></div>';
    if (d.osm>0) kh += '<div class="metrik-kart"><span class="metrik-deger">'+fmt(d.osm,0)+'</span><span class="metrik-etiket">OSM su kaynagi</span></div>';
    setH('potansiyel-kartlar', kh || '<p class="not">Bu il icin henuz NHYP/RG/OSM verisi islenmemistir.</p>');

    const lok = d.ilAd+' / '+d.ilceAd;
    setH('hukuk-yon-metin','<strong>'+lok+'</strong> bölgesinde kuyu açma ruhsatı, DSİ mesafe kısıtlamaları, idari yaptırım süreçleri ve ceza itiraz haklarınız hakkında detaylı bilgi için aşağıdaki rehberleri inceleyin:');


    bos.style.display = 'none';
    sonuc.style.display = 'block';
    sonuc.classList.remove('hidden');
    sonuc.scrollIntoView({ behavior:'smooth', block:'start' });

    try { const u = new URL(window.location); u.searchParams.set('il',ilSlug); u.searchParams.set('ilce',icSlug); history.pushState({},'',u); } catch(e){}
    console.log('[Analiz] Tamamlandi');
  }

  // ── EVENT: Analiz Et butonu ──
  btn.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); analizEt(); return false; });

  // ── EVENT: ilce secimi → otomatik analiz ──
  icSel.addEventListener('change', () => { if (icSel.value && ilSel.value) analizEt(); });

});
</script>
