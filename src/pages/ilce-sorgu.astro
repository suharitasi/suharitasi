---
// İL / İLÇE YERALTI SUYU VERİSİ — /ilce-sorgu/
// 10.10.2026 (brif 1.9): il verisine ±%15 "deterministik varyasyon" eklenerek
// üretilen ilçe arazi değerleri (sentetik) KALDIRILDI. Artık yalnız gerçek,
// kaynaklı veri gösterilir: ildeki yeraltı suyu kütleleri (NHYP), Resmî Gazete
// işletme sahası / kapatma kayıtları ve il için açık erişim yayın künyeleri.
// İlçe seçimi konumu netleştirmek içindir; ilçe düzeyinde ayrı veri yoktur ve
// bu açıkça yazılır. Client-side render: slug tabanlı indeks.
import Sayfa from '../layouts/Sayfa.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import { TARIH } from '../data/guncellik.js';
import OzCevap from '../components/OzCevap.astro';
import Katman from '../components/Katman.astro';
import { tumIlProfilleri } from '../data/il-profil.js';
import { ilPotansiyel } from '../data/potansiyel.js';
import ilKurum from '../../data/il-kurum.json';
import { EPOSTA, YAZAR } from '../data/site';
import ilceDizin from '../../veri/potansiyel/ilce-il-dizini.json' assert { type: 'json' };
import HukukSerhi from '../components/HukukSerhi.astro';

const profiller = tumIlProfilleri();
const ilAdlari = profiller.map((p) => p.il);

const ilcelerRaw = ilceDizin.ilceler || {};
const ilIlceler = {};
for (const [ilceAd, iller] of Object.entries(ilcelerRaw))
  for (const il of (iller || [])) (ilIlceler[il] ??= []).push(ilceAd);
for (const il of Object.keys(ilIlceler)) ilIlceler[il].sort((a, b) => a.localeCompare(b, 'tr'));

const suIdareleri = ilKurum.suIdareleri || {};

function slugla(ad) {
  if (!ad) return '';
  return String(ad).trim().toLowerCase().replace(/ğ/g,'g').replace(/ü/g,'u').replace(/ş/g,'s').replace(/ı/g,'i').replace(/ö/g,'o').replace(/ç/g,'c').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
}
const kirp = (s, n) => (s ? String(s).replace(/\s+/g, ' ').trim().slice(0, n) : '');

// IL_INDEX[ilSlug] = { ad, slug, ilceler:[{ad,slug}], kutleler:[…], rg:[…], akademik:[…], akademikNot, dsi, suIdare }
const IL_INDEX = {};
for (const p of profiller) {
  const il = p.il;
  const pt = ilPotansiyel(il) || {};
  const rg = [...(pt.rgKayitlari || []), ...(pt.rgEkKayitlari || [])]
    .map((k) => ({ metin: kirp(k.metin, 140), durum: k.durum || '', tarih: k.tarih || '', url: k.url || '' }));
  IL_INDEX[slugla(il)] = {
    ad: il, slug: slugla(il),
    ilceler: (ilIlceler[il] || []).map((ic) => ({ ad: ic, slug: slugla(ic) })),
    kutleler: (pt.kutleler || []).map((k) => ({ ad: k.ad, kod: k.kod, havza: k.havza, miktar: k.miktar, kimyasal: k.kimyasal, cokIlli: k.cokIlli })),
    rg,
    akademik: (pt.akademik || []).slice(0, 12).map((a) => ({ baslik: kirp(a.baslik, 160), yil: a.yil ?? null, doi: a.doi || a.url || '' })),
    akademikNot: pt.akademikEksikNedeni || '',
    dsi: (p.dsiBolgeleri || []).map((b) => `DSİ ${Number(b.no)}. Bölge Müdürlüğü (${b.merkez})`).join(' · '),
    suIdare: suIdareleri[il] || '',
  };
}
const IL_LISTESI = ilAdlari.map((il) => ({ ad: il, slug: slugla(il) }));
const VERI = JSON.stringify(IL_INDEX);
const TOPLAM_KUTLE = Object.values(IL_INDEX).reduce((t, v) => t + v.kutleler.length, 0);
const TOPLAM_RG = Object.values(IL_INDEX).reduce((t, v) => t + v.rg.length, 0);

const ozet = `Türkiye'de il bazında yeraltı suyu verisi: ${TOPLAM_KUTLE} il–kütle eşlemesi (NHYP yeraltı suyu kütleleri, miktar ve kimyasal durumuyla), ${TOPLAM_RG} Resmî Gazete işletme sahası / kapatma kaydı ve il için açık erişim yayın künyeleri; yetkili DSİ bölgesi ve su idaresi. İlçe düzeyinde ayrı veri yoktur.`;
---

{/* B1 (25.08): <title> 60 karakter sınırı. 10.10.2026: başlık içerikle eşitlendi (sentetik ilçe "potansiyeli" yok). */}
<Sayfa baslik="İl Bazında Yeraltı Suyu Verisi" aciklama={ozet}
  guncelleme={TARIH.potansiyel ? new Date(TARIH.potansiyel) : undefined}
  sema={[
    {
      '@type': 'SoftwareApplication',
      name: 'İl Bazında Yeraltı Suyu Verisi Sorgu Aracı',
      applicationCategory: 'WebApplication',
      operatingSystem: 'Web',
      url: new URL('/ilce-sorgu/', Astro.site).href,
      inLanguage: 'tr-TR',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
      publisher: { '@id': 'https://suharitasi.com/#kurum' },
    },
  ]}
>
  <SayfaBasi etiket="Araç" baslik="İl Bazında Yeraltı Suyu Verisi" tarih={TARIH.potansiyel ? new Date(TARIH.potansiyel) : undefined} />
  <OzCevap metin={ozet} />

  <Katman baslik="Konum Seçimi" ipucu="il seçimi zorunlu · ilçe konumu netleştirir">
    <form id="sorgu-form" class="sorgu-form">
      <div class="sorgu-grid">
        <div>
          <label for="il-sec" class="saha-etiket">İl</label>
          <select id="il-sec" class="il-secici">
            <option value="">— İl seçiniz —</option>
            {IL_LISTESI.map(il => <option value={il.slug}>{il.ad}</option>)}
          </select>
        </div>
        <div>
          <label for="ilce-sec" class="saha-etiket">İlçe (isteğe bağlı)</label>
          <select id="ilce-sec" class="il-secici" disabled>
            <option value="">— Önce il seçin —</option>
          </select>
        </div>
      </div>
      <button type="button" id="sorgu-btn" class="sorgu-btn">Göster</button>
    </form>
    <p class="not" style="margin-top:0.4rem" id="ilce-sayisi"></p>
  </Katman>

  <div id="analiz-sonuc" style="display:none">
    <p class="not" id="ilce-notu"></p>
    <Katman baslik="Yetkili Kurum" ipucu="DSİ bölge · su idaresi"><dl class="kunye kunye-katman"><div class="kunye-satir"><dt>DSİ Bölge(ler)</dt><dd id="dsi-bolge"></dd></div><div class="kunye-satir"><dt>Su idaresi</dt><dd id="su-idaresi"></dd></div></dl></Katman>
    <Katman baslik="Yeraltı Suyu Kütleleri" ipucu="NHYP · il ile eşleşen kütleler · miktar ve kimyasal durum"><div id="kutle-liste"></div></Katman>
    <Katman baslik="Resmî Gazete İşletme Sahası ve Kapatma Kayıtları" ipucu="il ile eşlenmiş kayıtlar · resmî bağlantı"><div id="rg-liste"></div></Katman>
    <Katman baslik="Açık Erişim Yayınlar" ipucu="OpenAlex · il ve su konulu künyeler"><div id="akademik-liste"></div></Katman>
    <Katman baslik="Su Hukuku ve Ruhsat Süreçleri" ipucu="kuyu ruhsatı · DSİ kısıtları · idari yaptırım" ton="kehribar">
      <div class="hukuk-yonlendirme">
        <p class="hukuk-yon-metin" id="hukuk-yon-metin"></p>
        <div class="hukuk-yon-links"><a href="/rehberler/kuyu-ruhsati/" class="hukuk-link hukuk-link-ana">Kuyu Ruhsatı Başvuru Süreci</a><a href="/rehberler/ruhsatsiz-kuyu-cezalari/" class="hukuk-link">Ruhsatsız Kuyu Cezaları</a><a id="il-sayfa-link" href="/kuyu-ruhsati/" class="hukuk-link">İl sayfası</a></div>
      </div>
    </Katman>
    <p class="ilce-temas">
      <a href={`mailto:${EPOSTA}?subject=${encodeURIComponent('Su hukuku — il sorgusu üzerinden')}`}>Bu konuda görüş alın</a>
      <span> — hukuki içerik {YAZAR.buro} tarafından hazırlanır ({EPOSTA}).</span>
    </p>
  </div>
  <div id="analiz-bos">
    <Katman baslik="Nasıl Kullanılır?" ipucu="2 adımda il verisi">
      <div class="kullanim-grid">
        <div class="kullanim-adim"><strong>1. İl seçin</strong><p>81 ilden birini seçin; ildeki yeraltı suyu kütleleri, Resmî Gazete kayıtları ve yayınlar listelenir.</p></div>
        <div class="kullanim-adim"><strong>2. İlçe (isteğe bağlı)</strong><p>İlçe seçimi konumu netleştirir; ilçe düzeyinde ayrı veri yoktur, il verisi gösterilir.</p></div>
      </div>
    </Katman>
  </div>
  <Katman baslik="Kapsam ve Uyarı" ton="murekkep" ipucu="veri kaynakları · sınırlar">
    <p class="not">Bu araç resmî kaynaklardan derlenen açık verileri sunar; hukuki görüş, yatırım tavsiyesi veya saha etüdü raporu NİTELİĞİ TAŞIMAZ.</p>
    <p class="not">Veri kaynakları: SYGM NHYP (yeraltı suyu kütleleri; il eşlemesi kütle çokgeni ile il sınırının kesişiminden), DSİ bölge dizini, Resmî Gazete işletme sahası ve kapatma ilanları, OpenAlex (açık erişim yayın künyeleri).</p>
    <p class="not">10.10.2026: önceki sürümdeki ilçe "düz arazi / vadi tabanı" oranları il verisinden türetilmiş sentetik değerlerdi; kaldırıldı. Burada yalnız kaynağı gösterilen gerçek veri vardır.</p>
  </Katman>
  <HukukSerhi />
<script slot="ek-script" type="application/json" id="veri-paketi" set:html={VERI}></script>
<script slot="ek-script">
document.addEventListener('DOMContentLoaded', () => {
  const ve = document.getElementById('veri-paketi');
  if (!ve) return;
  let IDX;
  try { IDX = JSON.parse(ve.textContent); } catch (e) { console.error('[ilce-sorgu] JSON parse hatasi:', e); return; }
  const G = (id) => document.getElementById(id);
  const ilSel = G('il-sec'), icSel = G('ilce-sec'), btn = G('sorgu-btn'), frm = G('sorgu-form');
  const sonuc = G('analiz-sonuc'), bos = G('analiz-bos'), sayiP = G('ilce-sayisi');
  if (!ilSel || !icSel || !btn || !sonuc || !bos) return;
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
  const setT = (id, v) => { const e = G(id); if (e) e.textContent = v; };
  const setH = (id, v) => { const e = G(id); if (e) e.innerHTML = v; };
  function temizle() { ['ilce-notu','dsi-bolge','su-idaresi','kutle-liste','rg-liste','akademik-liste','hukuk-yon-metin'].forEach((id) => { const e = G(id); if (e) e.innerHTML = ''; }); sonuc.style.display = 'none'; bos.style.display = ''; }
  frm.addEventListener('submit', (e) => { e.preventDefault(); return false; });
  ilSel.addEventListener('change', () => {
    const ilSlug = ilSel.value; temizle(); icSel.innerHTML = ''; icSel.disabled = true;
    if (!ilSlug || !IDX[ilSlug]) { icSel.appendChild(new Option('— Önce il seçin —', '')); if (sayiP) sayiP.textContent = ''; return; }
    const k = IDX[ilSlug];
    icSel.appendChild(new Option('— İlçe (isteğe bağlı) —', ''));
    for (const ic of k.ilceler) icSel.appendChild(new Option(ic.ad, ic.slug));
    icSel.disabled = false;
    if (sayiP) sayiP.textContent = k.ad + ' ilinde ' + k.ilceler.length + ' ilçe. "Göster"e tıklayın ya da ilçe seçin.';
    try { const u = new URL(window.location); u.searchParams.set('il', ilSlug); u.searchParams.delete('ilce'); history.replaceState(null, '', u); } catch (e) {}
  });
  function goster() {
    const ilSlug = ilSel.value, icSlug = icSel.value;
    const k = IDX[ilSlug]; if (!k) { alert('Lütfen il seçiniz.'); return; }
    const ic = k.ilceler.find((c) => c.slug === icSlug);
    temizle();
    setT('ilce-notu', ic ? (ic.ad + ' ilçesi için ayrı veri yoktur; ' + k.ad + ' ili verisi gösteriliyor.') : (k.ad + ' ili verisi.'));
    setT('dsi-bolge', k.dsi || 'veri yok'); setT('su-idaresi', k.suIdare || 'İl özel idaresi / belediye (büyükşehir dışı)');
    setH('kutle-liste', k.kutleler.length ? '<ul class="veri-liste">' + k.kutleler.map((x) => '<li><strong>' + esc(x.ad) + '</strong> <span class="kod">' + esc(x.kod) + '</span> · ' + esc(x.havza || '') + ' · miktar: ' + esc(x.miktar || 'veri yok') + ' · kimyasal: ' + esc(x.kimyasal || 'veri yok') + (x.cokIlli ? ' · çok illi kütle (' + esc(x.cokIlli.join(', ')) + ')' : '') + '</li>').join('') + '</ul>' : '<p class="not">Bu il ile eşleşen yeraltı suyu kütlesi kaydı yok (NHYP il eşlemesi).</p>');
    setH('rg-liste', k.rg.length ? '<ul class="veri-liste">' + k.rg.map((r) => '<li>' + (r.tarih ? '<span class="kod">' + esc(r.tarih) + '</span> · ' : '') + esc(r.metin) + (r.durum ? ' · <em>' + esc(r.durum) + '</em>' : '') + (r.url ? ' · <a href="' + esc(r.url) + '" rel="noopener" target="_blank">Resmî Gazete</a>' : '') + '</li>').join('') + '</ul>' : '<p class="not">Bu il ile eşlenmiş Resmî Gazete işletme sahası / kapatma kaydı yok.</p>');
    setH('akademik-liste', k.akademik.length ? '<ul class="veri-liste">' + k.akademik.map((a) => '<li>' + esc(a.baslik) + (a.yil ? ' (' + esc(a.yil) + ')' : '') + (a.doi ? ' · <a href="' + esc(a.doi) + '" rel="noopener" target="_blank">yayın</a>' : '') + '</li>').join('') + '</ul>' : '<p class="not">' + esc(k.akademikNot || 'Bu il için su konulu açık erişim yayın künyesi bulunamadı.') + '</p>');
    setH('hukuk-yon-metin', '<strong>' + esc(k.ad + (ic ? ' / ' + ic.ad : '')) + '</strong> için kuyu ruhsatı, DSİ kısıtları ve idari yaptırım süreçleri hakkında rehberler ve il sayfası:');
    const l = G('il-sayfa-link'); if (l) { l.href = '/kuyu-ruhsati/' + k.slug + '/'; l.textContent = k.ad + ' kuyu ruhsatı sayfası'; }
    bos.style.display = 'none'; sonuc.style.display = 'block'; sonuc.scrollIntoView({ behavior: 'smooth', block: 'start' });
    try { const u = new URL(window.location); u.searchParams.set('il', ilSlug); if (icSlug) u.searchParams.set('ilce', icSlug); else u.searchParams.delete('ilce'); history.pushState({}, '', u); } catch (e) {}
  }
  btn.addEventListener('click', (e) => { e.preventDefault(); goster(); });
  icSel.addEventListener('change', () => { if (ilSel.value) goster(); });
  try { const u = new URL(window.location); const il = u.searchParams.get('il'); if (il && IDX[il]) { ilSel.value = il; ilSel.dispatchEvent(new Event('change')); const ic = u.searchParams.get('ilce'); if (ic) icSel.value = ic; goster(); } } catch (e) {}
});
</script>
</Sayfa>
<style>
  .veri-liste { margin: 0; padding-left: 1.1rem; font-size: 0.9rem; line-height: 1.55; }
  .veri-liste li { margin: 0.35rem 0; }
  .kod { font-family: var(--mono); font-size: 0.72rem; color: var(--metin-soluk); }
  .sorgu-form { margin: 1rem 0; }
  .sorgu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .saha-etiket { display: block; font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--metin-soluk); margin-bottom: 0.3rem; }
  .il-secici { width: 100%; padding: 0.7rem 1rem; font-size: 1rem; font-family: var(--govde); border: 1px solid var(--cizgi); background: var(--zemin-kart); color: var(--metin); border-radius: 0; appearance: auto; }
  .il-secici:focus { outline: 2px solid var(--su-500); outline-offset: 1px; }
  .sorgu-btn { margin-top: 0.8rem; padding: 0.6rem 1.4rem; background: var(--su-700); color: #fff; border: 0; font-size: 0.9rem; font-weight: 600; font-family: var(--mono); cursor: pointer; }
  .sorgu-btn:hover { background: var(--su-800, #08405A); }
  .kunye { margin: 0 0 2rem; padding: 1.3rem 1.4rem 1.3rem 1.8rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); border-top: 2px solid var(--su-700); position: relative; }
  .kunye::before { content: ""; position: absolute; left: 0.6rem; top: 1rem; bottom: 1rem; width: 6px; background: repeating-linear-gradient(180deg, rgba(46,126,160,.4) 0 1px, transparent 1px 7px), linear-gradient(90deg, rgba(46,126,160,.4) 0 1px, transparent 1px); }
  .kunye-katman { margin: 0; padding: 0.4rem 0 0; background: transparent; border: 0; }
  .kunye-katman::before { display: none; }
  .kunye-satir { display: grid; grid-template-columns: minmax(8rem, 12rem) 1fr; gap: 0.4rem 1.2rem; padding: 0.5rem 0; }
  .kunye-satir + .kunye-satir { border-top: 1px solid var(--cizgi); }
  dt { font-family: var(--mono); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--metin-soluk); align-self: center; }
  dd { font-size: 0.96rem; }
  .potansiyel-ozet { display: flex; gap: 1rem; flex-wrap: wrap; }
  .metrik-kart { flex: 1; min-width: 8rem; text-align: center; padding: 1rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); }
  .metrik-deger { display: block; font-size: 2rem; font-weight: 600; color: var(--su-700); font-family: var(--serif); }
  .metrik-etiket { display: block; font-size: 0.72rem; color: var(--metin-soluk); margin-top: 0.3rem; }
  .kullanim-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.8rem; }
  .kullanim-adim { padding: 0.9rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); }
  .kullanim-adim strong { display: block; font-size: 0.92rem; color: var(--metin); margin-bottom: 0.3rem; }
  .kullanim-adim p { font-size: 0.82rem; color: var(--metin-soluk); margin: 0; line-height: 1.45; }
  .alan-metin { font-size: 0.94rem; color: var(--metin); margin: 0; line-height: 1.55; padding: 0.9rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); }
  .hukuk-yonlendirme { padding: 0.3rem 0; }
  .hukuk-yon-metin { font-size: 0.92rem; color: var(--metin); margin-bottom: 1rem; line-height: 1.5; }
  .hukuk-yon-links { display: flex; flex-direction: column; gap: 0.5rem; }
  .hukuk-link { display: block; padding: 0.6rem 1rem; text-decoration: none; font-size: 0.88rem; border: 1px solid var(--cizgi); background: var(--zemin-kart); color: var(--metin); }
  .hukuk-link:hover { background: var(--zemin-kart-hover, #f0f4f7); }
  .hukuk-link-ana { border-left: 4px solid var(--kehribar-metin); font-weight: 600; }
  .not { font-size: 0.88rem; color: var(--metin-soluk); margin: 0.5rem 0; }


  @media (max-width: 560px) {
    .sorgu-grid { grid-template-columns: 1fr; }
    .kunye-satir { grid-template-columns: 1fr; gap: 0.1rem; }
  }
  .ilce-temas { margin-top: 0.8rem; font-size: 0.9rem; color: var(--metin-soluk); }
  .ilce-temas a { color: var(--baglanti, var(--su-700)); }
</style>

