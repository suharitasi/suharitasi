---
// Nehir detay sayfası: /nehirler/[slug]/
// Veri kaynağı: tr-nehirler.json (OpenStreetMap, erişim 04.08.2026).
// 24.08.2026 (agustos-uyum M4+M5): aksansız şablon Türkçesi düzeltildi;
// FAQ sorusu verinin CEVAPLAYAMADIĞI "hangi havzaya aittir?"ten, geometrik
// eşlemeyle cevaplanabilen "hangi havzadan geçer?"e çevrildi; verisiz dolgu
// cümlesi kaldırıldı; künye kapsam+erişim+lisans taşır; havza/il iç bağları
// gol-nehir-cografya.js eşlemesinden.
import Sayfa from '../../layouts/Sayfa.astro';
import { tumIlProfilleri } from '../../data/il-profil.js';
import SayfaBasi from '../../components/SayfaBasi.astro';
import { TARIH } from '../../data/guncellik.js';
import NehirSnippet from '../../components/NehirSnippet.astro';
import Katman from '../../components/Katman.astro';
import GeoOnizleme from '../../components/GeoOnizleme.astro';
import GeoDisaAktar from '../../components/GeoDisaAktar.astro';
// eeat-audit (27.09.2026): yazar kutusu içerik sayfalarına bağlandı —
// künye sayfa düzeyinde görünür (yalnız SSS + veri vardı).
import YazarKutusu from '../../components/YazarKutusu.astro';
import { tumNehirler, nehirOzet,
         GOLNEHIR_ERISIM, GOLNEHIR_KAPSAM_NEHIR, GOLNEHIR_LISANS, kaynakBagi } from '../../data/gol-nehir.js';

export async function getStaticPaths() {
  return tumNehirler().map((n) => ({ params: { slug: n.slug }, props: { nehir: n } }));
}

const { nehir } = Astro.props;
const ozet = nehirOzet(nehir);
const havzalar = nehir.cografya.havzalar;
const il = nehir.cografya.il;
const iller = nehir.cografya.iller ?? (il ? [il] : []);
const illerMetni = iller.map((x) => x.ad).join(', ');
// P2 (24.09.2026): "İlgili Havza Varlıkları" tablosu — bağlı havza(lar) ve
// aynı havzadaki diğer akarsular. Yalnız gerçek eşlemeden türetilir; havzada
// daha az kardeş varsa eldeki kadar gösterilir (uydurma yok).
// 05.10.2026 (P2/T2): kardeş bağı 2 → 8; GSC quick-wins'te nehir ailesinin
// iç-bağ omurgası yoğunlaştırılır (statik link, görsel değişiklik yok).
const anaHavza = havzalar[0] ?? null;
const kardesNehirler = anaHavza
  ? tumNehirler()
      .filter((x) => x.slug !== nehir.slug && x.cografya.havzalar.some((h) => h.slug === anaHavza.slug))
      .slice(0, 8)
  : [];
const dsiBolge = il ? (tumIlProfilleri().find((x) => x.slug === il.slug)?.dsiBolgeleri ?? []) : [];
const kok = new URL('/', Astro.site).href;

// C1 (V5, 10.09.2026): <title> arama niyetiyle hizalanır. YALNIZ sayfanın
// CEVAPLAYABİLDİĞİ niyet yazılır: "nerede" (koordinat + geçtiği havza/il).
// "kolu/dökülür" niyeti VERİSİZ (basitleştirilmiş OSM geometrisi; C2 null) —
// title'a girmez (uydurma yasağı). H1 ve og:title DEĞİŞMEZ (baslik korunur).
// VERİ-KOŞULLU (2026-09-21): yalnız DOLU veri başlığa girer; null ise mevcut
// başlık AYNEN korunur (uydurma yasağı). Öncelik: dökülür > kolu > mevcut.
const dokulur = nehir.dokuldugu_yer || null;
const kolu = nehir.kolu_oldugu_akarsu || null;
// NOT: değere EK (apostrofly) otomatik eklenmez — Türkçe ünlü uyumu addan
// ada değişir ("Dicle'ye" vs "Fırat'a"); yanlış ek üretmemek için ek
// gerektirmeyen soru kalıbı seçildi (niyet: "nereye dökülür/kolu").
// P3 (24.09.2026): niyet AYRIMI (desambiguasyon) — akarsu hidrografisi,
// havza sayfasından net ayrışsın. Yalnız ölçülmüş yamyamlık vakası (gediz:
// /havzalar/gediz ↔ /nehirler/gediz-nehri) için meta başlık sabitlenir;
// diğer 94 nehir başlığı DEĞİŞMEZ (regresyon yok). NOT: istenen başlıktaki
// "Debi" BİLEREK konmadı — sitede nehir bazlı debi verisi YOK; başlığa
// yazmak tıklama tuzağı olurdu (NEHIRLER-SERP-TESHISI §5.2, uydurma yasağı).
// 28.09.2026 (GSC-CTR, FREEZE-İSTİSNA): mobil SERP tıklaması için soru
// formatlı title deseni. VERİ-KOŞULLU: "Hangi Akarsuyun Kolu?" ifadesi YALNIZ
// `kolu_oldugu_akarsu` doluysa kullanılır — Eşen/Kelkit/Bakırçay/Zap/Köprüçay
// için bu alan veride YOKTUR; yanlış öncül kurmak tıklama tuzağı olurdu
// (uydurma yasağı). Latin dışı ebeveyn adı (ör. Arapça) başlığa girmez.
// 05.10.2026 (P2): SERP kırpılmasını önlemek için UZUNLUK-FARKINDA zincir —
// ≤60 krk olan İLK aday seçilir; hiçbiri sığmazsa build DÜŞER (kalıcı kapı).
const LATIN_BASLIK = /^[A-Za-zÇĞİÖŞÜçğıöşü0-9\s'’.\-()]+$/;
const koluLatin = (kolu && LATIN_BASLIK.test(kolu)) ? kolu : null;
const SUF = ' | Su Haritası';
// 10.10.2026 (brif 1.10): "Nereye Dökülür?" yalnız döküldüğü yer VERİDE varsa vaat edilir.
const dokulduguVar = Boolean(nehir.dokuldugu_yer);
const titleAdaylari = (koluLatin
  ? [`${nehir.ad} Hangi Akarsuyun Kolu${dokulduguVar ? ', Nereye Dökülür' : ''}?`,
     `${nehir.ad} Hangi Akarsuyun Kolu?`]
  : (dokulduguVar
     ? [`${nehir.ad} Nerede ve Nereye Dökülür?`, `${nehir.ad} Nerede, Nereye Dökülür?`]
     : [`${nehir.ad} Nerede, Hangi İllerden Geçer?`])
).concat([`${nehir.ad} Nerede?`]).map((t) => t + SUF);
const tarayiciBaslik = titleAdaylari.find((t) => t.length <= 60) ?? `${nehir.ad}${SUF}`;
if (tarayiciBaslik.length > 60)
  throw new Error(`nehir "${nehir.slug}": title ${tarayiciBaslik.length} karakter (>60)`);

// C5 (V5): FAQ soruları ölçülen sorgu kalıplarına ("nerede", "hangi havzadan
// geçer") ayrıştırılır; her cevap veriden. "kolu/kapalı havza" sorusu VERİSİZ
// olduğundan eklenmez (uydurma yasağı).
const konumCevabi = `${nehir.ad} hattı ${iller.length ? `${illerMetni} ${iller.length > 1 ? 'illerinden' : 'ili sınırlarından'} geçer` : 'Türkiye sınırları içinde akar'} (merkez koordinatı ${nehir.merkez[1].toFixed(4)}°K, ${nehir.merkez[0].toFixed(4)}°D).`;
const havzaCevabi = havzalar.length === 0
  ? 'Örneklenmiş hat noktaları 25 havza çokgeninden hiçbiriyle kesişmedi; bu geometrik örneklemedir, hidrografik tescil değildir.'
  : havzalar.length === 1
    ? `${havzalar[0].ad}'ndan geçer.`
    : `${havzalar.map((x) => x.ad).join(', ')} havzalarından geçer.`;

// Meta açıklama: dolu veri varsa somut olgu (konum + dökülür/kolu) + öz-cevap;
// yoksa yalnız mevcut öz-cevap (uydurma yok).
const konumCumlesi = iller.length ? `${illerMetni} ${iller.length > 1 ? 'illerinden' : 'ilinden'} geçer` : 'Türkiye sınırları içinde akar';
const aciklamaZengin = dokulur
  ? `${nehir.ad}, ${konumCumlesi}; döküldüğü yer: ${dokulur}. ${ozet}`
  : (kolu
    ? `${nehir.ad}, ${konumCumlesi}; kolu olduğu akarsu: ${kolu}. ${ozet}`
    : ozet);

// FAQPage: yalnız DOLU veri için ek soru; cevap metni veriden (görünür).
const sorular: any[] = [{
  '@type': 'Question',
  name: `${nehir.ad} nerededir?`,
  acceptedAnswer: { '@type': 'Answer', text: konumCevabi },
}, {
  '@type': 'Question',
  name: `${nehir.ad} hangi havzadan geçer?`,
  acceptedAnswer: { '@type': 'Answer', text: havzaCevabi },
}];
if (dokulur) sorular.push({
  '@type': 'Question',
  name: `${nehir.ad} nereye dökülür?`,
  acceptedAnswer: { '@type': 'Answer', text: `${nehir.ad} — döküldüğü yer: ${dokulur}.` },
});
if (kolu) sorular.push({
  '@type': 'Question',
  name: `${nehir.ad} hangi akarsuyun kolu?`,
  acceptedAnswer: { '@type': 'Answer', text: `${nehir.ad} — kolu olduğu akarsu: ${kolu}.` },
});

const sema = [{
  '@type': 'BodyOfWater',
  name: nehir.ad,
  description: ozet,
  // C3 (V5): merkez GeoCoordinates + bbox GeoShape (çokgen) — koordinat ve
  // çokgen bazlı uzamsal kapsam birlikte. `spatialCoverage` CreativeWork
  // özelliğidir; Place (BodyOfWater) için geo doğru alandır.
  geo: [
    { '@type': 'GeoCoordinates', latitude: nehir.merkez[1], longitude: nehir.merkez[0] },
    { '@type': 'GeoShape', box: `${nehir.bbox[1]} ${nehir.bbox[0]} ${nehir.bbox[3]} ${nehir.bbox[2]}` },
  ],
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Veri kaynağı', value: nehir.kaynak },
    ...(nehir.kolu_oldugu_akarsu
      ? [{ '@type': 'PropertyValue', name: 'Kolu olduğu akarsu', value: nehir.kolu_oldugu_akarsu }] : []),
  ],
  containedInPlace: iller.length ? iller.map((x) => ({ '@type': 'Place', name: `${x.ad}, Türkiye` })) : { '@type': 'Place', name: 'Türkiye' },
}, {
  '@type': 'FAQPage',
  // Damga (25.08.2026): OSM/Natural Earth çekim tarihi (gol-nehir.js künyesi).
  ...(TARIH.golNehir ? { dateModified: TARIH.golNehir } : {}),
  // C3 (V5): FAQPage CreativeWork'tür — publisher + license burada geçerli.
  publisher: { '@id': `${kok}#kurum` },
  license: GOLNEHIR_LISANS,
  mainEntity: sorular,
}];
---

<Sayfa baslik={`${nehir.ad} — Türkiye Nehirleri`} tarayiciBaslik={tarayiciBaslik} aciklama={aciklamaZengin} sema={sema}>
  <SayfaBasi etiket="Nehir" baslik={nehir.ad} tarih={TARIH.golNehir ? new Date(TARIH.golNehir) : undefined} />

  <NehirSnippet nehir={nehir} havza={anaHavza} ozet={ozet} />

  <GeoOnizleme geometry={nehir.geometry} bbox={nehir.bbox} ad={nehir.ad} tur="nehir" havza={anaHavza} />

  <GeoDisaAktar slug={nehir.slug} ad={nehir.ad} tur="nehir" merkez={nehir.merkez} kaynak={nehir.kaynak} />

  <Katman baslik="Nehir profili" ipucu="koordinat · havza · veri kaynağı">
    <dl class="kunye kunye-katman">
      <div class="kunye-satir">
        <dt>Tür</dt>
        <dd>Akarsu (nehir)</dd>
      </div>
      <div class="kunye-satir">
        <dt>Koordinat (merkez)</dt>
        <dd><data value={`${nehir.merkez[1].toFixed(4)},${nehir.merkez[0].toFixed(4)}`}>{nehir.merkez[1].toFixed(4)}°K, {nehir.merkez[0].toFixed(4)}°D</data></dd>
      </div>
      {havzalar.length > 0 && (
        <div class="kunye-satir">
          <dt>{havzalar.length === 1 ? 'Havza' : 'Geçtiği havzalar'}</dt>
          <dd>
            {havzalar.map((h, i) => (
              <>
                {i > 0 && ' · '}
                <a href={`/havzalar/${h.slug}/`}>{h.ad}</a>
              </>
            ))}
          </dd>
        </div>
      )}
      {il && (
        <div class="kunye-satir">
          <dt>Geçtiği iller (örneklem)</dt>
          <dd>{iller.map((x, i) => <>{i > 0 && ', '}<a href={`/kuyu-ruhsati/${x.slug}/`}>{x.ad}</a></>)}</dd>
        </div>
      )}
      {kolu && (
        <div class="kunye-satir">
          <dt>Kolu olduğu akarsu</dt>
          <dd>{kolu}</dd>
        </div>
      )}
      {dokulur && (
        <div class="kunye-satir">
          <dt>Döküldüğü yer</dt>
          <dd>{dokulur}</dd>
        </div>
      )}
      {dsiBolge.length > 0 && (
        <div class="kunye-satir">
          <dt>İdari Yetki Mercii</dt>
          <dd>{dsiBolge.map((b) => `DSİ ${b.no}. Bölge Müdürlüğü (${b.merkez})`).join(' · ')}</dd>
        </div>
      )}
    </dl>
  </Katman>

  <Katman baslik="Konum ve ölçek şerhi" ipucu="yaklaşık merkez · geometrik eşleme · bilgi amaçlıdır" ton="murekkep">
    <p class="not">
      Koordinat, akarsu hattının sınır kutusunun geometrik merkezidir;
      hidrografik referans veya ölçüm noktası DEĞİLDİR. Havza ve il eşlemesi
      hat geometrisinin örneklenmiş noktalarından türetilmiştir; akarsu birden
      çok il ve havzadan geçebilir — idari/hidrografik tescil yerine geçmez.
    </p>
    <p class="not">
      {havzalar.length > 0 && (
        <>İlgili resmî veriler: <a href={`/havzalar/${havzalar[0].slug}/`}>{havzalar[0].ad}{' '}
        rezerv ve doluluk verisi</a> · </>
      )}
      <a href="/nerede-su-cikar/">ilinizin su potansiyeli</a>.
    </p>
  </Katman>

  <p class="veri-kunyesi">
    {/* K19 (27.08): kaynak adı artık resmî adresine bağlanıyor;
        adres bilinmiyorsa düz metin kalır (uydurma yasağı). */}
    {nehir.ad_kaynakta && nehir.ad_kaynakta !== nehir.ad && (
      <>Kaynaktaki tam ad: {nehir.ad_kaynakta}. </>
    )}
    Veri künyesi: {kaynakBagi(nehir.kaynak)
      ? <a href={kaynakBagi(nehir.kaynak)} rel="nofollow noopener" target="_blank">{nehir.kaynak}</a>
      : nehir.kaynak} — kapsam: {GOLNEHIR_KAPSAM_NEHIR}; erişim
    {' '}{GOLNEHIR_ERISIM}. {GOLNEHIR_LISANS}. Bu sayfa hukuki görüş değildir.
  </p>

  {/* P2 (24.09.2026): GÖVDE SSS — JSON-LD FAQPage ile AYNI `sorular`
      dizisinden görünür semantik HTML (h3 soru + doğrudan yanıt). AI Overview
      ve RAG istemcileri yanıtı gövdeden çekebilir; yeni metin üretilmez. */}
  <section class="sss" aria-label="Sık sorulan sorular">
    <h2>Sık sorulan sorular</h2>
    {sorular.map((q) => (
      <div class="sss-madde">
        <h3>{q.name}</h3>
        <p>{q.acceptedAnswer.text}</p>
      </div>
    ))}
  </section>

  {/* P2 (24.09.2026): İlgili Havza Varlıkları tablosu — bağlı havza + aynı
      havzadaki diğer akarsular (statik iç link omurgası). */}
  <section class="havza-varlik" aria-label="İlgili havza varlıkları">
    <h2>İlgili Havza Varlıkları</h2>
    <table>
      <thead>
        <tr><th scope="col">Varlık</th><th scope="col">Bağ</th></tr>
      </thead>
      <tbody>
        <tr><td>{nehir.ad}</td><td>Bu sayfa (akarsu)</td></tr>
        {anaHavza && (
          <tr><td>{anaHavza.ad}</td><td><a href={`/havzalar/${anaHavza.slug}/`}>Havza verisi</a></td></tr>
        )}
        {kardesNehirler.map((k) => (
          <tr><td>{k.ad}</td><td><a href={`/nehirler/${k.slug}/`}>Aynı havzadaki akarsu</a></td></tr>
        ))}
      </tbody>
    </table>
  </section>

  {/* C6 (V5, 10.09.2026): hub çapraz link bloğu — PageRank akışını havza/il
      ve dönüşüm sayfalarına (rehberler, /nerede-su-cikar/) yönlendirir.
      Yalnız gerçek iç bağlar (uydurma yok). P2: tek-link sınırı (slice 3)
      KALDIRILDI — akarsuyun geçtiği tüm havzalar bağlanır. */}
  <nav class="ilgili" aria-label="İlgili içerik">
    <h2>İlgili su verisi ve mevzuat</h2>
    <div class="capraz">
      {havzalar.map((h) => <a href={`/havzalar/${h.slug}/`}>{h.ad} verisi</a>)}
      {iller.map((x) => <a href={`/kuyu-ruhsati/${x.slug}/`}>{x.ad} kuyu ruhsatı</a>)}
      <a href="/nerede-su-cikar/">İlinizde su nerede çıkar</a>
      <a href="/rehberler/">Su hukuku rehberleri</a>
    </div>
  </nav>

  <YazarKutusu />
</Sayfa>

<style>
  .kunye {
    margin: 0 0 2rem;
    padding: 1.3rem 1.4rem 1.3rem 1.8rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
    position: relative;
  }
  .kunye::before {
    content: "";
    position: absolute;
    left: 0.6rem;
    top: 1rem;
    bottom: 1rem;
    width: 6px;
    background:
      repeating-linear-gradient(180deg,
        rgba(46, 126, 160, 0.4) 0 1px, transparent 1px 7px),
      linear-gradient(90deg, rgba(46, 126, 160, 0.4) 0 1px, transparent 1px);
  }
  .kunye-katman {
    margin: 0;
    padding: 0.4rem 0 0;
    background: transparent;
    border: 0;
  }
  .kunye-katman::before { display: none; }
  .kunye-satir {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 0.4rem 1.2rem;
    padding: 0.5rem 0;
  }
  .kunye-satir + .kunye-satir { border-top: 1px solid var(--cizgi); }
  dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    align-self: center;
  }
  dd { font-size: 0.96rem; }
  dd a { color: var(--baglanti, var(--su-700)); }
  .not {
    font-size: 0.9rem;
    color: var(--metin-soluk);
    margin: 0.6rem 0;
  }
  .not a { color: var(--baglanti, var(--su-700)); }
  .veri-kunyesi {
    font-size: 0.8rem;
    color: var(--metin-soluk);
    margin: 1.2rem 0 0;
  }
  @media (max-width: 560px) {
    .kunye-satir { grid-template-columns: 1fr; gap: 0.1rem; }
  }

  /* C6 (V5): hub çapraz link bloğu — havza/il sayfalarındaki .capraz dili. */
  .ilgili { margin-top: 2.4rem; }
  .ilgili h2 { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 0.8rem; }
  .capraz { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.2rem 0 0; }
  .capraz a { font-family: var(--mono); font-size: 0.8rem; color: var(--su-700); border: 1px solid var(--cizgi); padding: 0.4rem 0.7rem; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .capraz a:hover { background: var(--zemin-kart); }

  /* P2: gövde SSS (semantik h3 soru + doğrudan yanıt). radius 0, gölge yok. */
  .sss { margin-top: 2rem; }
  .sss h2 { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 0.8rem; }
  .sss-madde { border-top: 1px solid var(--cizgi); padding: 0.7rem 0; }
  .sss-madde h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.3rem; }
  .sss-madde p { color: var(--metin-soluk); }

  /* P2: İlgili Havza Varlıkları tablosu. */
  .havza-varlik { margin-top: 2rem; }
  .havza-varlik h2 { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 0.8rem; }
  .havza-varlik table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .havza-varlik th, .havza-varlik td {
    text-align: left; padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--cizgi); vertical-align: top;
  }
  .havza-varlik th {
    font-family: var(--mono); font-weight: 500; font-size: 0.68rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--metin-soluk); background: var(--adacayi-krem);
    border-bottom: 2px solid var(--su-700);
  }
  .havza-varlik a { color: var(--baglanti); text-decoration: none; }
  .havza-varlik a:hover { text-decoration: underline; }
</style>
