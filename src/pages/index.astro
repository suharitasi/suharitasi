  /* Alt bilgi de sabit sahne katmanının ÜSTÜNE biner. AltBilgi'nin kendi
     margin-top'u SIFIRLANIR (boşluk padding'e taşınır): margin boşluğu opak
     değildir, arkasındaki sabit sahne katmanı oradan sızıyordu — denetim
     ekranında koyu bant olarak yakalandı. */
  .alt-kap {
