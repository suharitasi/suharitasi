      #081D30 46%);
    border-top: 1px solid rgba(87, 186, 224, 0.28);
  }

  @supports (backdrop-filter: blur(1px)) {
    .guverte { backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); }
  }

  .g-kicker {
