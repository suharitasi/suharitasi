<style is:global>
  /* — SU-DİLİ derinlik skalası (DESIGN.md §2 — aday C). İniş bölümü, şerit
       ve alt bilgi bu tokenlardan beslenir; koyu menü şeridi kendi kabında
       tokenları ezer (aşağıda .ust-sabit). — */
  :root {
    --krem: #E9F0F4;
    --adacayi-krem: #DFE9F0;
    --murekkep-900: #132A3F;
    --murekkep-500: #48627A;
    --su-700: #0C5A7C;
    --su-400: #2E7EA0;
    --kehribar: #C0883A;
    --kehribar-metin: #875518;
    /* Yalnız ana sayfa soru şeridi hedef satırı (DESIGN.md §2, 23.07 kararı).
       kritik-vurgu #875518 DEĞİŞMEZ. */
    --kehribar-koyu: #6B4412;
    --deniz: #0A2740;
    --akuamarin: #57BAE0;
    --kopuk: #DBEAF4;

    --zemin: var(--krem);
    --zemin-kart: var(--adacayi-krem);
    --metin: var(--murekkep-900);
    --metin-soluk: var(--murekkep-500);
    --baglanti: var(--su-700);
    --cizgi: rgba(19, 42, 63, 0.14);

    --serif: "Cormorant", Georgia, serif;
    --sans: "Manrope", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;

    /* Şerit geometrisi — rev1 ölçümüyle aynı bant (31px), iki yuva arası
       ≥8px (ui-ux-pro-max "Touch Spacing"); burada 20px. */
    --serit-yuk: 31px;
    --serit-ara: 20px;
  }

  /* Motor teması: @layer sw varsayılanlarını ezer (unlayered kazanır).
     .sw-root AYRICA hedeflenir — motor kendi kabına layered `.sw-root{--sw-bg}`
     yazar; yalnız :root yazmak yetmez, kabın kendi bildirimi kalıtımı keser
     (denetimde krem letterbox olarak yakalandı). */
  :root, .sw-root {
    --sw-bg: #0A2740;          /* DİP — sahne zemini + letterbox */
    --sw-ink: #DBEAF4;         /* Köpük */
    --sw-ink-soft: #8FB2C4;
    --sw-accent: #57BAE0;
    --sw-font-display: "Cormorant", Georgia, serif;
    --sw-font-body: "Manrope", system-ui, sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--zemin);
    color: var(--metin);
    font-family: var(--sans);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  a:focus-visible, button:focus-visible {
    outline: 2px solid var(--akuamarin);
    outline-offset: 3px;
  }

  /* KIRPMASIZ (brief T-1): kaynak 832×464 kompozisyonu bozulmasın — contain,
     letterbox DİP tonunda. */
  .sw-scene__video, .sw-scene__still {
    object-fit: contain !important;
    background: var(--sw-bg);
  }

  /* Sahne metni yok → motorun kopya katmanı ve vinyet degradesi kadrajdan
     çıkar. Motorun kendi üst şeridi de kullanılmaz (tek kaynak UstMenu). */
  .sw-copylayer, .sw-topbar { display: none !important; }

  /* Akış bitince sahne katmanı iniş bölümünün altında kalır: yüzen motor
     öğeleri, soru şeridi ve KOYU menü şeridi kapanır.
     Menü şeridi "akış boyunca SABİT"tir (brief) — akış bitince kapanmalıdır:
     sabit şerit aydınlık iniş bölümünün üst 85px'ini örtüyordu (denetimde
     footer başlıkları şeridin altında kalırken yakalandı). İniş bölümünde
     gezinme yüzeyi alt bilgidir (Bölümler kolonu = aynı 5 rota). */
  html.akis-bitti .sw-route,
  html.akis-bitti .sw-hint,
  html.akis-bitti .sw-scrollbar,
  html.akis-bitti .soru-serit,
  html.akis-bitti .ust-sabit { opacity: 0; pointer-events: none; }

  .sw-route, .sw-hint, .sw-scrollbar, .soru-serit, .ust-sabit {
    transition: opacity 240ms var(--e-akinti);
  }


  /* Kaydırma ipucu şeridin ÜSTÜNDE durur (çakışma yok). Sahne parlaklığı
     kareden kareye değiştiği için ipucu kendi DİP plakasını taşır — çıplak
     hâlinde açık sahnede kontrast 4.5:1'in altına düşüyordu. */
  .sw-hint {
    bottom: calc(3.2vh + var(--serit-yuk) + 22px) !important;
    padding: 5px 11px 8px;
    border-radius: 2px;
    background: rgba(10, 39, 64, 0.78);
    color: var(--kopuk);
  }

  .sw-hint i { border-color: rgba(219, 234, 244, 0.55); }

  /* SAHNE ADI HAPI GÖRÜNMEZ (23.07 canlı testi: "sağda göl kasabası gibi
     sahne adları görünüyor"). Motor aktif noktanın etiketini kalıcı olarak
     açıyor (`.sw-route__dot.is-active .sw-route__label{opacity:1}`) — sahne
     kahramanken kadranın yanında ad etiketi gürültüdür.
     SİLİNMEZ, GÖRSEL KATMANDAN ÇEKİLİR: etiket <button>'ın erişilebilir adıdır;
     display:none yapılırsa rota noktaları adsız kalır (ekran okuyucu "buton"
     der). Bu yüzden clip tekniğiyle gizlenir — a11y korunur, göz görmez. */
  .sw-route__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    background: none;
    backdrop-filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sw-route, .sw-hint, .sw-scrollbar, .soru-serit, .ust-sabit { transition: none; }
  }

  @media print {
    #world, .sw-sky, .sw-stage, .sw-route, .sw-hint, .sw-scrollbar { display: none !important; }
  }
</style>
<script type="module" src="/s/menu.js" is:inline></script>
</head>
<body>

  <!-- Menü şeridi akış boyunca SABİT (brief). Koyu dünya tokenları yalnız
       bu kapta ezilir; scrim olmadan video üzerinde AA tutmaz. -->
  <div class="ust-sabit">
    <UstMenu tema="koyu" />
  </div>

  <div id="world"></div>

  <!-- 7 SÜZÜLEN SORU — DOM'da gerçek <a>. JS yoksa / reduced-motion'da
       şerit statik listedir; 7'si de görünür ve tıklanabilir. -->
  <nav class="soru-serit" aria-label="Sık sorulan sorular">
    {SORULAR.map((s) => (
      <a class="soru" href={s.hedef}>
        <span class="soru-metin">{s.soru}</span>
        <span class="soru-hedef" aria-hidden="true">
          <span class="hedef-genis">{s.etiket}</span>
          <span class="hedef-dar">{s.etiketMobil}</span>
          <span class="ok"> →</span>
        </span>
      </a>
    ))}
  </nav>

  <!-- AKIŞ SONU İNİŞ BÖLÜMÜ -->
  <section class="inis">
    <p class="inis-kicker">Su Haritası</p>
    <h1>Su, yerin altında <em>konuşur.</em></h1>
    <p class="oz-cevap" role="doc-abstract">{ozCevap}</p>
    <p class="davet">Otelden madene, sanayiden sulama kooperatifine — hangi kapıdan
      girdiğiniz suyla ilişkinizi belirler.</p>

    <div class="izgara">
      {ilkAltiPersona.map((p) => (
        <a class="pk" href={`/durumum/${p.slug}/`}>
          <span class="pk-k">{kicker(p.ad)}</span>
          <span class="pk-ad">{p.ad}</span>
          {p.sonTarihMetni && <span class="pk-t">Son başvuru {p.sonTarihMetni}</span>}
        </a>
      ))}
    </div>

    <p class="tumu"><a href="/durumum/">Tüm sektörleri gör →</a></p>
  </section>

  <div class="alt-kap"><AltBilgi /></div>

<script type="application/json" id="sahne-veri" is:inline set:html={JSON.stringify(sahneVeri)}></script>
<script>
  import { mountScrollWorld } from '../scripts/scrub-engine.js';

  const sahneler = JSON.parse(document.getElementById('sahne-veri').textContent);

  mountScrollWorld(document.getElementById('world'), {
    brand: null,        // üst şerit tek kaynak: UstMenu
    nav: false,
    hint: 'kaydırarak in',
    atmosphere: true,
    // 1.6 (deneyim'deki 1.4 değil): motorun klip ön-yükleme penceresi
    // `y > start - 1.6vh`. 1.4'te sahne 2'nin klibi daha y=0'da iniyordu
    // (ölçüm: ilk yükte 2 mp4). 1.6'da sahne 2 ancak KAYDIRINCA iner —
    // brief T-1'in "kalanlar kaydırdıkça" şartı. Sahne başına oyalanma
    // farkı %14; vendor'a dokunulmadı.
    diveScroll: 1.6,
    crossfade: 0.14,
    sections: sahneler,
    connectors: [],     // connector video YOK — sahneler doğrudan crossfade
  });

  /* POSTER ERTELEME (brief T-1) — motorun tüm sahne <img>'leri sabit ve
     kadraj içindedir, bu yüzden loading="lazy" iş görmez: 6 poster de ilk
     yükte iniyordu (ölçüm). Sahne 1 dışındakilerin src'si alınır ve klip
     penceresiyle AYNI eşikte (start - 1.6vh) geri verilir.
     VENDOR'A DOKUNULMADI — bu sayfa katmanında çalışır. */
  const sahneKaplari = [...document.querySelectorAll('#world .sw-scene')];
  const bekleyenPoster = sahneKaplari.map((el, i) => {
    const img = el.querySelector('.sw-scene__still');
    if (i === 0 || !img || !img.getAttribute('src')) return null;
    const src = img.getAttribute('src');
    img.removeAttribute('src');
    return { img, src, sira: i };
  }).filter(Boolean);

  function posterleriAc() {
    for (let j = bekleyenPoster.length - 1; j >= 0; j--) {
      const p = bekleyenPoster[j];
      if (scrollY > (p.sira * 1.6 - 1.6) * innerHeight) {
        p.img.setAttribute('src', p.src);
        bekleyenPoster.splice(j, 1);
      }
    }
  }

  /* — SORU ŞERİDİ SÜRÜCÜSÜ —
     Ritim: akış (0-100%) 7 eşit dilime bölünür; dilim i'de yuvalar
     (i, i+1 mod 7) sorularını taşır. Zamanlayıcı/karusel YOK — konum
     yalnız kaydırma yüzdesinden türer.
     reduced-motion: sürücü HİÇ kurulmaz → şerit statik liste kalır. */
  const kok = document.documentElement;
  const serit = document.querySelector('.soru-serit');
  const ogeler = [...serit.querySelectorAll('.soru')];
  const azHareket = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dar = matchMedia('(max-width: 860px)');
  const N = ogeler.length;

  if (!azHareket) kok.classList.add('js-serit');

  let iz = null;
  function akisUzunlugu() {
    // Motorun kaydırma iskeleti: track yüksekliği = akış + 1vh (son uçuş).
    if (!iz) iz = document.querySelector('#world .sw-track');
    return iz ? Math.max(1, iz.offsetHeight - innerHeight) : 1;
  }

  let sonDilim = -1;
  function guncelle() {
    if (bekleyenPoster.length) posterleriAc();
    const uz = akisUzunlugu();
    const p = Math.min(1, Math.max(0, scrollY / uz));
    kok.classList.toggle('akis-bitti', scrollY > uz - 8);
    if (azHareket) return;
    const dilim = Math.min(N - 1, Math.floor(p * N));
    if (dilim === sonDilim) return;
    sonDilim = dilim;
    const sag = (dilim + 1) % N;
    ogeler.forEach((a, i) => {
      const sagda = i === sag && !dar.matches;
      a.classList.toggle('sag', sagda);
      a.classList.toggle('gorunur', i === dilim || sagda);
    });
  }

  addEventListener('scroll', () => requestAnimationFrame(guncelle), { passive: true });
  addEventListener('resize', () => { sonDilim = -1; guncelle(); });
  addEventListener('load', () => { sonDilim = -1; guncelle(); });
  guncelle();
</script>

<style>
  /* ——— MENÜ ŞERİDİ (sabit, koyu) ———
     Video üzerinde AA için DİP scrim'i: üstte α.82, aşağı doğru erir. */
  .ust-sabit {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
    /* Koyu dünya tokenları — UstMenu tema="koyu" bunları okur */
    --metin: #DCE9ED;
    --metin-soluk: #DBEAF4;
    --kopuk: #FFFFFF;
    --akuamarin: #57BAE0;
    background: linear-gradient(180deg,
      rgba(10, 39, 64, 0.82) 0%,
      rgba(10, 39, 64, 0.62) 52%,
      rgba(10, 39, 64, 0) 100%);
  }

  /* ——— SORU ŞERİDİ — R2 ALT ŞERİT ———
     Varsayılan (JS YOK / reduced-motion): statik liste, 7 soru da görünür.
     .js-serit: iki yuvalı tek satır bandı + çapraz geçiş. */
  .soru-serit {
    position: fixed;
    left: 4%; right: 4%;
    bottom: 3.2vh;
    z-index: 45;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 44vh;
    overflow-y: auto;
    padding: 6px 14px;
    border-radius: 2px;
    /* Şerit zemini α.80 (kullanıcı kararı 23.07) */
    background: rgba(233, 240, 244, 0.80);
    border-left: 2px solid var(--kehribar);
    box-shadow: 0 8px 22px rgba(10, 39, 64, 0.26);
  }

  @supports (backdrop-filter: blur(1px)) {
    .soru-serit { backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
  }

  /* Etiket soruya BİTİŞİK durur (space-between DEĞİL): iki yuva yan yanayken
     "soru … etiket | soru … etiket" okunuşu belirsizleşiyordu — denetim
     ekranında yakalandı. Şimdi her yuva tek okuma birimi, yuvalar arası
     boşluk + hairline ayraç ayırır. */
  .soru {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    gap: 12px;
    min-height: 30px;
    text-decoration: none;
    color: var(--murekkep-900);
  }

  .soru-metin {
    flex: 0 1 auto;
    min-width: 0;
    font-family: var(--serif);
    font-size: 0.95rem;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .soru-hedef {
    font-family: var(--mono);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    /* Koyu kehribar: α.80 plakada AA üstü (rev1 ölçümü 4,64:1) */
    color: var(--kehribar-koyu);
  }

  .hedef-dar { display: none; }

  .soru:hover .soru-metin { color: var(--su-700); }
  .soru:focus-visible { outline: 2px solid var(--su-700); outline-offset: 2px; }

  /* — JS'li kip: tek satır bandı, iki yuva — */
  :global(html.js-serit) .soru-serit {
    display: block;
    position: fixed;
    height: var(--serit-yuk);
    max-height: none;
    overflow: visible;
    padding: 0 14px;
  }

  /* Yuva ayracı: yalnız iki yuvalı kipte, salt yapısal hairline (imza değil —
     imza şeridin sol kehribar kenarıdır). */
  :global(html.js-serit) .soru-serit::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: var(--cizgi);
  }

  @media (max-width: 860px) {
    :global(html.js-serit) .soru-serit::before { display: none; }
  }

  /* transitions-dev "text states swap" grameri (süzülme + bulanıklık),
     easing DESIGN.md §3 sözlüğüne uyarlandı: konum --e-suzul, yüzey
     --e-akinti; süre 240ms (standart). Skill'in kendi cubic-bezier'i
     KULLANILMADI — proje sözlüğü üstündür. */
  :global(html.js-serit) .soru {
    position: absolute;
    top: 0;
    left: 14px;
    width: calc(50% - 14px - var(--serit-ara) / 2);
    height: var(--serit-yuk);
    align-items: center;
    opacity: 0;
    filter: blur(2px);
    transform: translateX(0) translateY(6px);
    pointer-events: none;
    transition:
      transform 240ms var(--e-suzul),
      opacity 240ms var(--e-akinti),
      filter 240ms var(--e-akinti);
  }

  :global(html.js-serit) .soru.sag {
    transform: translateX(calc(100% + var(--serit-ara))) translateY(6px);
  }

  :global(html.js-serit) .soru.gorunur {
    opacity: 1;
    filter: blur(0);
    transform: translateX(0) translateY(0);
    pointer-events: auto;
  }

  :global(html.js-serit) .soru.gorunur.sag {
    transform: translateX(calc(100% + var(--serit-ara))) translateY(0);
  }

  /* Dokunma hedefi ≥44px: görünür bant 31px kalır, saydam ::after tıklamayı
     taşır. (rev1 ölçümü: ::before{z-index:-1} hit-test'te ÇALIŞMIYOR.) */
  .soru::after {
    content: "";
    position: absolute;
    left: 0; right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: max(44px, 100%);
  }

  :global(html:not(.js-serit)) .soru { position: relative; }

  @media (max-width: 860px) {
    .soru-serit { left: 3%; right: 3%; bottom: 2.6vh; }
    .soru-metin { font-size: 0.82rem; }
    .hedef-genis { display: none; }
    .hedef-dar { display: inline; }
    /* 375: TEK yuva — sağ yuva yoktur (sürücü de atamaz) */
    :global(html.js-serit) .soru { width: calc(100% - 28px); }
    :global(html.js-serit) .soru.sag { transform: translateX(0) translateY(6px); }
    :global(html.js-serit) .soru.gorunur.sag { transform: translateX(0) translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .soru { transition: none; }
  }

  /* ——— İNİŞ BÖLÜMÜ ———
     Akıştan sonra gelir; sabit sahne katmanının ÜSTÜNE biner (z-index 30). */
  .inis {
