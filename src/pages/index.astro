---
// ANA SAYFA v2 — v0 spesifikasyonu (brief 2026-07-27, emilkowalski/skills).
// Yapı: Üst bar → Hero → [mobil sorular] → Hizmetler → Süreç → Hakkında →
// İletişim → Footer (paylaşılan AltBilgi, dokunulmadı).
// KORUNANLAR (eski sayfadan AYNEN — brief 1.8):
//   · 280 karakterlik öz-cevap (hero alt metni, K-3)
//   · JSON-LD @graph (Organization + Person + WebSite)
//   · <noscript> sahne yedeği (K3-2C)
//   · sahneVeri dizisi (poster + klip kaynakları)
// Eski sayfa SİLİNMEDİ: arsiv/anasayfa-guverte-v3/index.astro (M10).
// Etkileşim animasyonları emil-design-eng kurallarına uyar; atmosfer
// süreleri v0'dan korunur (K-1). Kütüphane eklenmedi (K-2, M5).
import AltBilgi from '../components/AltBilgi.astro';
// MENÜ BİRLEŞTİRME (27.07 ADIM 4): sayfa-özel UstBar yerini paylaşılan
// menüye bıraktı (dosya durur, M10). Ana sayfada davranış birebir:
// fixed + şeffaf başlar, scroll>40 koyu, çapalar # biçiminde.
import PaylasilanMenu from '../components/PaylasilanMenu.astro';
import Hero from '../components/anasayfa/Hero.astro';
import MobilSorular from '../components/anasayfa/MobilSorular.astro';
import KanitBandi from '../components/anasayfa/KanitBandi.astro';
import Hizmetler from '../components/anasayfa/Hizmetler.astro';
import Surec from '../components/anasayfa/Surec.astro';
import Hakkinda from '../components/anasayfa/Hakkinda.astro';
import Iletisim from '../components/anasayfa/Iletisim.astro';
import { YAZAR, EPOSTA } from '../data/site';
import '../styles/anasayfa-v2.css';

// U1 (satis-uygula 28.07): eski öz-cevap alt metni ve beş-sayılı envanter
// cümlesi KALDIRILDI — R3-Line2 alternatifi de düştü, yerini R3 master
// cümlesi (HERO_ALT) aldı; head katmanı (title/description/OG/WebSite)
// yeni H1+alt satırla uyumlandı. Envanter sayıları kanıt bandında yaşıyor.
// Ana sayfanın öz-cevap MUAFİYETİ (28.07 kullanıcı kararı) değişmedi.
import { HERO_ALT } from '../data/anasayfa-satis.js';
import WhatsAppDugme from '../components/WhatsAppDugme.astro';

// Sahne kaynakları (poster + klip) — eski sayfadan AYNEN (video/poster
// dosyalarına DOKUNULMADI, M6).
const V = '/deneyim/video';
const SAHNELER = [
  { id: 'sondaj', label: 'Sondaj', n: 1, accent: '#57BAE0' },
  { id: 'akifer', label: 'Akifer', n: 2, accent: '#2E7EA0' },
  { id: 'baraj', label: 'Baraj', n: 3, accent: '#0C5A7C' },
  { id: 'sehir', label: 'Şehir', n: 4, accent: '#C0883A' },
  { id: 'hukuk', label: 'Hukuk', n: 5, accent: '#2C5570' },
  { id: 'gol-kasabasi', label: 'Göl kasabası', n: 6, accent: '#57BAE0' },
];
const sahneVeri = SAHNELER.map((s) => ({
  id: s.id,
  label: s.label,
  still: `${V}/sahne${s.n}.jpg`,
  clip: `${V}/sahne${s.n}.mp4`,
  accent: s.accent,
}));
---
<html lang="tr" class="v2-sayfa">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Kuyunuz için ruhsat mı lazım, ceza mı geldi? — Su Haritası</title>
<meta name="description" content={HERO_ALT} />
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
<meta name="bingbot" content="index, follow" />
<link rel="canonical" href="https://suharitasi.com/" />
<meta property="og:title" content="Kuyunuz için ruhsat mı lazım, ceza mı geldi? — Su Haritası" />
<meta property="og:description" content={HERO_ALT} />
<meta property="og:url" content="https://suharitasi.com" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Su Haritası" />
<meta property="og:locale" content="tr_TR" />
<meta property="og:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Su Haritası — Türkiye'nin su verisi ve mevzuatı" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LegalService"],
      "@id": "https://suharitasi.com/#kurum",
      "name": "Su Haritası",
      "url": "https://suharitasi.com",
      "areaServed": { "@type": "Country", "name": "Türkiye" },
      "email": EPOSTA,
      "telephone": "+90 532 449 71 44",
      "description": "Türkiye'nin su verisi, havzaları ve su mevzuatını tek haritada birleştiren bağımsız bilgi portalı.",
      "founder": { "@id": "https://suharitasi.com/#yazar" },
      "knowsAbout": ["Su hukuku", "Yeraltı suyu ruhsatı", "Su tahsisi", "Su havzaları", "İdari yargı"]
    },
    {
      "@type": "Person",
      "@id": "https://suharitasi.com/#yazar",
      "name": YAZAR.adSade,
      "jobTitle": YAZAR.unvan,
      "url": "https://suharitasi.com/hakkinda/",
      "description": YAZAR.uzmanlik,
      "image": "https://suharitasi.com/og-suharitasi.v1.png",
      "worksFor": { "@type": "Organization", "name": YAZAR.buro, "url": YAZAR.buroUrl },
      "knowsAbout": ["Su hukuku", "Yeraltı suyu mevzuatı", "İdari yargı", "Kamulaştırma hukuku", "Şirketler hukuku"]
    },
    {
      "@type": "WebSite",
      "@id": "https://suharitasi.com/#site",
      "name": "Su Haritası",
      "url": "https://suharitasi.com",
      "inLanguage": "tr",
      "publisher": { "@id": "https://suharitasi.com/#kurum" },
      "description": HERO_ALT
    }
  ]
})} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- LCP: hero ilk karesi = sahne 1 posteri -->
<link rel="preload" as="image" href="/deneyim/video/sahne1.jpg" fetchpriority="high" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap&subset=latin-ext" rel="stylesheet" />
<style is:global>
  /* KONTRAST ARIZASI DÜZELTMESİ (27.07): bu blok Vite ortak chunk'ına
     girip PaylasilanMenu'lu TÜM sayfalara sızıyordu — body koyu zemini
     173 içerik sayfasını kararttı. Her kural html.v2-sayfa (yalnız bu
     sayfanın kök etiketi) kapsamına alındı; sızsa da etkisiz. */
  .v2-sayfa {
    --serif: "Cormorant", Georgia, serif;
    --sans: "Manrope", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) { .v2-sayfa { scroll-behavior: auto; } }
  /* Ş3 KÖK DÜZELTMESİ (hero-gorsel 28.07, ölçümle): bu reset 0-2-0
     özgüllükle TÜM tekil-sınıf kurallarını eziyordu — v0'ın 6rem bölüm
     padding'i, .v2-bolum-bas ortalaması, hero padding'i hiç uygulanmamıştı
     ("sayfanın aşağısı dağılmış"ın kökü). :where() özgüllüğü sıfırlar:
     reset yalnız kural OLMAYAN yerde çalışır, hiçbir kuralı ezemez. */
  .v2-sayfa * { box-sizing: border-box; }
  :where(.v2-sayfa) body { margin: 0; padding: 0; }
  :where(.v2-sayfa *) { margin: 0; padding: 0; }
  .v2-sayfa body {
    background: #061824;
    color: var(--murekkep-900, #12293a); /* K34: palet dışı → token (Δ5, görsel fark yok) */
    font-family: var(--sans);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .v2-sayfa a:focus-visible, .v2-sayfa button:focus-visible,
  .v2-sayfa summary:focus-visible {
    /* K30 (27.08): DESIGN.md §9 — koyu dünyada KÖPÜK. */
    outline: 2px solid var(--kopuk, #DBEAF4);
    outline-offset: 3px;
  }
  /* Paylaşılan AltBilgi (M8: dokunulmadı) SU-DİLİ tokenlarını bekler —
     aydınlık kap burada tanımlanır, footer eski görünümüyle çıkar. */
  .v2-altkap {
    --metin: #132A3F;
    /* #48627A → #3C5266 (İş B, 29.07): bu yerel kap SU-DİLİ tokenlarını
       ELLE kopyalıyordu ve 29.07'deki --murekkep-500 koyulaştırması buraya
       ULAŞMAMIŞTI (ölçüm: altbilgi gövdesi 5,52). Kopya token = sapma
       kaynağı; değer paletteki --murekkep-500 ile eşitlendi. 5,52 → 7,04. */
    --metin-soluk: #3C5266;
    --cizgi: rgba(19, 42, 63, 0.14);
    background: #E9F0F4;
  }

  /* K23 (27.08): skip-link — Sayfa.astro'daki global kuralın eşi
     (bu sayfa o layout'u kullanmıyor). Değerler birebir aynı. */
  .atla-baglantisi { position: fixed; top: 0.5rem; left: 0.5rem; z-index: 999; transform: translateY(calc(-100% - 1rem)); padding: 0.75rem 1rem; min-height: 44px; display: inline-flex; align-items: center; background: var(--su-700); color: #fff; font-family: var(--mono); font-size: 0.8rem; text-decoration: none; border: 1px solid var(--su-700); transition: transform 0.18s var(--e-suzul, cubic-bezier(0.22, 1, 0.36, 1)); }
  .atla-baglantisi:focus { transform: translateY(0); outline: 2px solid var(--kopuk); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .atla-baglantisi { transition: none; } }
  #ana-icerik:focus { outline: none; }
</style>
</head>
<body>

  {/* K23 (27.08): "içeriğe atla" — WCAG 2.4.1 (A). Stil `Sayfa.astro`
      global bloğunda; bu sayfa o layout'u kullanmadığı için bağlantı
      elle eklendi. */}
  <a href="#ana-icerik" class="atla-baglantisi">İçeriğe atla</a>

  <PaylasilanMenu />

  {/* 27.08 denetimi U7: ana sayfa 518 iç sayfanın aksine <main> landmark'ı
      taşımıyordu (WCAG 1.3.1 / ARIA landmark). Sarmalayıcı SINIFSIZ ve
      stilsizdir — .govde iç sayfa düzeni içindir, buraya uygulanmaz;
      görünür metin ve JSON-LD değişmez (bit-eşitlik ölçümü raporda). */}
  <main id="ana-icerik" tabindex="-1">

  {/* .v2-ust-akis: U2 mobil istisnasının taşıyıcısı — masaüstünde DOM
      sırası (kanıt bandı hero'dan hemen sonra), mobilde CSS order ile
      eski sıra (sorular önce). Kural: anasayfa-v2.css sonu. */}
  <div class="v2-ust-akis">

  <Hero sahneVeri={sahneVeri} />

  {/* 04.08 refactor'unun 2 CTA kartı — 24.08 uyum turunda: emoji ikonlar
      KALDIRILDI (BRIEF.md "emoji yasak"; md13 ölçümü: ihlali üreten, span'ın
      renk kuralı olmayışıydı — varsayılan link mavisi 1.92:1), satış bandı
      kaldırıldı (M1), mobil sırası S1 kuralına bağlandı (M2). */}
  <section class="v2-cta-ikili" aria-label="Hizli erisim">
    <a href="/ilce-sorgu/" class="v2-cta-kart v2-cta-sol">
      <span class="v2-cta-baslik">Su Nerede Çıkar?</span>
      <span class="v2-cta-alt">İl/ilçe seçin, su potansiyeli ve yetkili kurum bilgisi alın</span>
    </a>
    {/* 25.08: /su-hukuku/ rota kapanışı (arsiv/su-hukuku-rota/NOT.md) —
        kart /rehberler/ dizinine bağlandı; metin hedef sayfanın kendi
        meta-description'ından türetildi. */}
    <a href="/rehberler/" class="v2-cta-kart v2-cta-sag">
      <span class="v2-cta-baslik">Su Hukuku Rehberleri</span>
      <span class="v2-cta-alt">Kuyu ruhsatı, su tahsisi, ruhsatsız kuyu cezaları ve iptal davaları</span>
    </a>
  </section>

  {/* K3-2C (eski sayfadan AYNEN): JS çalıştırmayan istemci için 6 sahnenin
      durağan kareleri. JS açıkken <noscript> hiç render edilmez. */}
  <noscript>
    <section class="akis-yedek" aria-label="Açılış akışı — sahneler">
      <p class="akis-yedek-not">Açılış akışı JavaScript ile oynatılır. Aşağıda
        akışın altı sahnesinin durağan kareleri yer alıyor.</p>
      <ul class="akis-yedek-liste">
        {sahneVeri.map((s, i) => (
          <li>
            <img src={s.still} width="640" height="360" loading="lazy" decoding="async"
                 alt={`${s.label} — açılış akışının ${i + 1}. sahnesi`} />
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </section>
  </noscript>

  {/* U2 (satis-uygula 28.07): kanıt bandı hero-sonrası İLK blok (R1
      High-Impact-1: kanıt iddianın yanında). MOBİL İSTİSNASI ölçümle:
      düz taşımada 375'te ilk soru kadrajdan çıkıyor (ölçüm raporda) —
      bu yüzden sarmalayıcı flex, mobilde sırayı eski hâline döndürür
      (aşağıdaki .v2-ust-akis kuralları); S1 kazanımı korunur. */}
  <KanitBandi />

  <MobilSorular />

  </div>

  <Hizmetler />

  <Surec />

  <Hakkinda />

  <Iletisim />

  </main>

  <div class="v2-altkap"><AltBilgi /></div>

  <WhatsAppDugme koyu />
  <script type="module" src="/s/olcum.js" is:inline></script>
</body>
</html>
