---
// ANA SAYFA — 6 SAHNE + SORU GÜVERTESİ (v3, brief 23.07 Aşama 2).
// Koyu hero + kelime koreografisi KALKTI; sahne akışı açılıştır.
// v3 DEĞİŞİMİ (soru hiyerarşisi): R2 alt şerit KALKTI. Sorular ilk ekranda,
//   sahnenin altındaki opak DİP "güverte" panelinde (garantili AA, kareye
//   bağlı değil). Öz-cevap güvertenin başında ilk ekranda. "Su nerelerde
//   çıkar?" (S2) dürüst açılır cevaba bağlandı (native <details>, JS'siz).
//   İniş bölümündeki sektör ızgarası KALKTI (kullanıcı kararı: kalksın).
// Eski landing SİLİNMEDİ: arsiv/landing-koyu/index.astro (geri dönüş yolu).
// Eski /deneyim/ rotası kapandı: arsiv/deneyim-rota/deneyim.astro + _redirects 301.
//
// Motor: src/scripts/scrub-engine.js (oso95/scroll-world, MIT — CREDITS.md).
//   VENDOR'A DOKUNULMADI; tema yalnız --sw-* değişkenleriyle ezilir.
//   Lazy: motor sahneyi ±1.6vh menzile girince yükler → ilk yükte yalnız
//   sahne1 posteri + sahne1 klibi iner (brief T-1).
// Sahne METİNLERİ kaldırıldı (kullanıcı kararı) → .sw-copylayer hiç render
//   edilmez (motorun vinyet degradesi de böylece kadrajdan çıkar).
// Güverte: 7 <a>/<details> DOM'da GERÇEK linktir; JS'siz ve reduced-motion'da
//   güverte statik listedir, 7'si de tıklanabilir/erişilebilir.
import UstMenu from '../components/UstMenu.astro';
import AltBilgi from '../components/AltBilgi.astro';
import { SORULAR } from '../data/anasayfa-sorular.js';
import '../styles/hareket.css';

// Öz-cevap (CLAUDE.md "cevap önce, dayanak sonra"; ≤280 karakter). KANONİK metin
// — meta description ile aynı kaynak; yalnız mevcut doğrulanmış içerikten
// damıtıldı, yeni hukuki iddia yok. v3: güverteye taşındı (ilk ekran).
const ozCevap =
  "Türkiye'nin 25 su havzası tek portalda: havza künyeleri ve yeraltı suyu " +
  'eğilimi, kuyu ruhsatı ile su tahsisi rehberleri, Su Kanunu taslak takibi. ' +
  'Kafanızdaki soruyu seçin — cevaba en kısa yoldan.';

// S2 — "Su nerelerde çıkar?" boş kapı çözümü (kullanıcı kararı: S2).
// Cevap sitede henüz YOK (Kuyu Çıkar Mı değerlendirmede). Dürüst kısa cevap +
// /harita/ yönlendirme + garanti-değil uyarısı. Kopya-içerik önlemi: /harita/
// öz-cevabı TEKRARLANMAZ — yalnız kısa yönlendirme. UYDURMA YOK.
const BOS_KAPI_SORU = 'Su nerelerde çıkar?';

// Sahne akışı — sıra AŞAMA 1'de sabitlendi (S1 sondaj → S6 göl kasabası).
// Aksan renkleri FAZ 8 palet C ailesindendir (DESIGN.md §2).
const V = '/deneyim/video';
const SAHNELER = [
  { id: 'sondaj', label: 'Sondaj', n: 1, accent: '#57BAE0' },
  { id: 'akifer', label: 'Akifer', n: 2, accent: '#2E7EA0' },
  { id: 'baraj', label: 'Baraj', n: 3, accent: '#0C5A7C' },
  { id: 'sehir', label: 'Şehir', n: 4, accent: '#C0883A' },
  { id: 'hukuk', label: 'Hukuk', n: 5, accent: '#2C5570' },
  { id: 'gol-kasabasi', label: 'Göl kasabası', n: 6, accent: '#57BAE0' },
];
const sahneVeri = SAHNELER.map((s) => ({
  id: s.id,
  label: s.label,
  still: `${V}/sahne${s.n}.jpg`,
  clip: `${V}/sahne${s.n}.mp4`,
  accent: s.accent,
}));
---
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Su Haritası — Su, yerin altında konuşur.</title>
<meta name="description" content="Türkiye'nin 25 su havzası: DSİ verisi, kuyu ruhsatı ve su mevzuatı rehberleri, Su Kanunu taslak takibi — tek portalda." />
<link rel="canonical" href="https://suharitasi.com/" />
<meta property="og:title" content="su haritası — Türkiye'nin su verisi ve mevzuatı" />
<meta property="og:description" content="Türkiye'nin 25 su havzası: DSİ verisi, kuyu ruhsatı ve su mevzuatı rehberleri, Su Kanunu taslak takibi — tek portalda." />
<meta property="og:url" content="https://suharitasi.com" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Su Haritası" />
<meta property="og:locale" content="tr_TR" />
<meta property="og:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Su Haritası — Türkiye'nin su verisi ve mevzuatı" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Su Haritası",
  "url": "https://suharitasi.com",
  "inLanguage": "tr",
  "description": "Türkiye'nin 25 su havzası: DSİ verisi, kuyu ruhsatı ve su mevzuatı rehberleri, Su Kanunu taslak takibi — tek portalda."
})} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- LCP: akış ilk karesi = sahne 1 posteri (motor lazy yükler; preload onu öne çeker) -->
<link rel="preload" as="image" href="/deneyim/video/sahne1.jpg" fetchpriority="high" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap&subset=latin-ext" rel="stylesheet" />
<style is:global>
  /* — SU-DİLİ derinlik skalası (DESIGN.md §2 — aday C). İniş bölümü, güverte
       ve alt bilgi bu tokenlardan beslenir; koyu menü şeridi kendi kabında
       tokenları ezer (aşağıda .ust-sabit). — */
  :root {
    --krem: #E9F0F4;
    --adacayi-krem: #DFE9F0;
    --murekkep-900: #132A3F;
    --murekkep-500: #48627A;
    --su-700: #0C5A7C;
    --su-400: #2E7EA0;
    --kehribar: #C0883A;
    --kehribar-metin: #875518;
    /* v3: --kehribar-koyu KALDIRILDI. Gerekçesi "yalnız ana sayfa soru şeridi
       hedef satırı"ydı; şerit güverteye dönüştü, hedef etiketi koyu DİP güverte
       üstünde --isima (akuamarin) kullanır. Öksüz değişken bırakılmadı;
       DESIGN.md §2 kaydı "emekli" olarak güncellendi (23.07). */
    --deniz: #0A2740;
    --akuamarin: #57BAE0;
    --kopuk: #DBEAF4;

    --zemin: var(--krem);
    --zemin-kart: var(--adacayi-krem);
    --metin: var(--murekkep-900);
    --metin-soluk: var(--murekkep-500);
    --baglanti: var(--su-700);
    --cizgi: rgba(19, 42, 63, 0.14);

    --serif: "Cormorant", Georgia, serif;
    --sans: "Manrope", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;

    /* — GÜVERTE + SAHNE GEOMETRİSİ (v3, soru güvertesi) —
       Sorular ilk ekranda alt "güverte"de; sahne üst banda çekilir.
       Sahne kabı (motorun tam-ekran `inset:0` kabı) güvertenin ÜSTÜNDEKİ
       bölgeye ortalanır; scrollY↔ilerleme eşlemesi motordan BAĞIMSIZDIR
       (motor yalnız scrollY ve .sw-track yüksekliğini okur) — ritim/crossfade/
       preload eşikleri DEĞİŞMEZ. Kırpma yok (contain korunur, letterbox DİP). */
    --kaydirma-cubugu: 0px;   /* JS ölçer: 100vw kaydırma çubuğunu sayar */
    --guverte-boy: 42dvh;     /* alt güverte paneli */
    --menu-boy: 4.4rem;
    --kadraj-en: calc(100vw - var(--kaydirma-cubugu));
    /* sahne üst bölgeye (güverte üstü) sığar: bant boyu − menü − nefes */
    --kadraj-boy: min(calc(var(--kadraj-en) * 464 / 832),
                      calc(100dvh - var(--guverte-boy) - var(--menu-boy) - 1.5rem));
    /* sahne güverte-üstü bölgede dikey ortalansın (menü kadar aşağı nudge) */
    --kadraj-ust: calc(var(--menu-boy)
                      + (100dvh - var(--guverte-boy) - var(--menu-boy) - var(--kadraj-boy)) / 2);
  }

  /* Motor teması: @layer sw varsayılanlarını ezer (unlayered kazanır).
     .sw-root AYRICA hedeflenir — motor kendi kabına layered `.sw-root{--sw-bg}`
     yazar; yalnız :root yazmak yetmez, kabın kendi bildirimi kalıtımı keser. */
  :root, .sw-root {
    --sw-bg: #0A2740;          /* DİP — sahne zemini + letterbox */
    --sw-ink: #DBEAF4;         /* Köpük */
    --sw-ink-soft: #8FB2C4;
    --sw-accent: #57BAE0;
    --sw-font-display: "Cormorant", Georgia, serif;
    --sw-font-body: "Manrope", system-ui, sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--zemin);
    color: var(--metin);
    font-family: var(--sans);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  a:focus-visible, button:focus-visible, summary:focus-visible {
    outline: 2px solid var(--akuamarin);
    outline-offset: 3px;
  }

  /* KIRPMASIZ (brief T-1): kaynak 832×464 kompozisyonu bozulmasın — contain,
     letterbox DİP tonunda. */
  .sw-scene__video, .sw-scene__still {
    object-fit: contain !important;
    background: var(--sw-bg);
  }

  /* Sahne kabı = güverte-üstü kadraj (yukarıdaki değişkenler). */
  .sw-stage {
    top: var(--kadraj-ust);
    bottom: auto;
    height: var(--kadraj-boy);
  }

  /* Poster'in Ken-Burns ölçeği/parallaks kaydırması kapatılır (kap tam kadraj,
     scale posteri kırpıyordu). Motor dosyasına dokunulmadı. */
  .sw-scene__still { transform: none !important; }

  /* Kaydırma ipucu kaldırıldı: kadraj + güverte geometrisi ipucuna yer bırakmaz;
     kaydırma daveti sahne ritmi + rota noktalarıdır. */
  .sw-hint { display: none !important; }

  /* Sahne metni yok → motorun kopya katmanı ve vinyet degradesi kadrajdan
     çıkar. Motorun kendi üst şeridi de kullanılmaz (tek kaynak UstMenu). */
  .sw-copylayer, .sw-topbar { display: none !important; }

  /* Akış bitince yüzen motor öğeleri + güverte kapanır (iniş bölümünün
     altında kalır). MENÜ ŞERİDİ KAPANMAZ — kapanınca pointer-events:none
     alıyordu ve dipte (scroll-restorasyonu) menü ÖLÜ açılıyordu (24.07 arıza,
     regresyon DEĞİL — eski davranış). Bunun yerine menü aydınlık iniş üstünde
     OKUNAKLI + AÇILIR kalır (aşağıda .ust-sabit aydınlık dönüşü). */
  html.akis-bitti .sw-route,
  html.akis-bitti .sw-hint,
  html.akis-bitti .sw-scrollbar,
  html.akis-bitti .guverte { opacity: 0; pointer-events: none; }

  .sw-route, .sw-hint, .sw-scrollbar, .guverte {
    transition: opacity 240ms var(--e-akinti);
  }

  /* Menü şeridi akış dibinde aydınlık iniş bölümü üstündedir → koyu scrim +
     köpük linkler okunmaz ve ESKİDEN gizleniyordu. Çözüm: tokenları aydınlığa
     çevir (içerik-sayfası `.ust.sv-yuzer` deseni) — şerit CANLI + tıklanır +
     okunaklı kalır. Renkler C paleti (yeni hex yok). */
  .ust-sabit {
    transition: background-color 240ms var(--e-akinti),
                box-shadow 240ms var(--e-akinti);
  }
  html.akis-bitti .ust-sabit {
    background: rgba(233, 240, 244, 0.90);
    box-shadow: 0 1px 14px rgba(19, 42, 63, 0.06);
    --metin: #132A3F;        /* Mürekkep */
    --metin-soluk: #48627A;  /* Soluk */
    --kopuk: #0C5A7C;        /* DERİN (hover) */
    --akuamarin: #0C5A7C;
  }
  @supports (backdrop-filter: blur(1px)) {
    html.akis-bitti .ust-sabit {
      background: rgba(233, 240, 244, 0.74);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  }

  /* SAHNE ADI HAPI GÖRÜNMEZ — clip tekniğiyle (a11y adı korunur, göz görmez). */
  .sw-route__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    background: none;
    backdrop-filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sw-route, .sw-hint, .sw-scrollbar, .guverte, .ust-sabit { transition: none; }
  }

  @media print {
    #world, .sw-sky, .sw-stage, .sw-route, .sw-hint, .sw-scrollbar { display: none !important; }
  }

  /* K3-2C: JS'siz sahne yedeği. JS açıkken <noscript> hiç render edilmez. */
  .akis-yedek { max-width: 68rem; margin: 0 auto; padding: 2rem 1.2rem; }
  .akis-yedek-not { font-family: var(--mono, ui-monospace, monospace); font-size: 0.8rem;
    color: #93AFC4; margin-bottom: 1rem; }
  .akis-yedek-liste { list-style: none; display: grid; gap: 1rem; padding: 0;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .akis-yedek-liste img { width: 100%; height: auto; display: block; }
  .akis-yedek-liste span { display: block; margin-top: 0.4rem;
    font-family: var(--mono, ui-monospace, monospace); font-size: 0.72rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: #93AFC4; }
</style>
<script type="module" src="/s/menu.js" is:inline></script>
</head>
<body>

  <!-- Menü şeridi akış boyunca SABİT (brief). Koyu dünya tokenları yalnız
       bu kapta ezilir; scrim olmadan video üzerinde AA tutmaz. -->
  <div class="ust-sabit">
    <UstMenu tema="koyu" />
  </div>

  <div id="world"></div>

  {/* K3-2C (26 Tem 2026): #world BOŞ bir div; 6 sahne JS ile monte ediliyor.
      Ölçüldü: statik HTML'de <video> 0, <img> 0 → JS çalıştırmayan istemci
      (AI tarayıcıları dahil) için ana sayfanın görsel katmanı HİÇ YOKTU;
      alt metni de yoktu. Burada YENİ GÖRSEL ÜRETİLMEZ — motorun zaten
      kullandığı poster kareleri (public/deneyim/video/sahne*.jpg) statik
      olarak da sunulur. Video dosyalarına DOKUNULMAZ (M7). <noscript>
      olduğu için JS açıkken hiç render edilmez: görünümde değişiklik yok. */}
  <noscript>
    <section class="akis-yedek" aria-label="Açılış akışı — sahneler">
      <p class="akis-yedek-not">Açılış akışı JavaScript ile oynatılır. Aşağıda
        akışın altı sahnesinin durağan kareleri yer alıyor.</p>
      <ul class="akis-yedek-liste">
        {sahneVeri.map((s, i) => (
          <li>
            <img src={s.still} width="640" height="360" loading="lazy" decoding="async"
                 alt={`${s.label} — açılış akışının ${i + 1}. sahnesi`} />
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </section>
  </noscript>

  <!-- SORU GÜVERTESİ — ilk ekranda, sahnenin altında opak DİP panel.
       Öz-cevap + 7 soru DOM'da GERÇEK linktir. JS'siz/reduced-motion'da
       güverte statik listedir; 7'si de görünür ve erişilebilir.
       S2 ("Su nerelerde çıkar?") native <details> ile dürüst açılır cevaba
       bağlanır — JS'siz de açılır/kapanır. -->
  <section class="guverte" aria-label="Sık sorulan sorular">
    <p class="g-kicker gk">Su Haritası</p>
    <p class="oz-cevap gk" role="doc-abstract">{ozCevap}</p>
    <nav class="sorular" aria-label="Sorular">
      {SORULAR.map((s) => (
        s.soru === BOS_KAPI_SORU ? (
          <details class="s s-detay gk">
            <summary>
              <span class="soru-metin">{s.soru}</span>
              <span class="soru-hedef" aria-hidden="true"><span class="ok">açılır ▾</span></span>
            </summary>
            <div class="s-cevap">
              <p>Türkiye'de yeraltı suyunun bölgesel durumunu <strong>havza haritasından</strong>
                görebilirsiniz. Nokta düzeyinde "burada kuyu çıkar" tahmini saha etüdü gerektirir.</p>
              <p class="s-uyari">Bu bir kuyu açma garantisi değildir; nokta tahmini saha etüdü ister.</p>
              <a class="s-git" href={s.hedef}>Havza haritasına git →</a>
            </div>
          </details>
        ) : (
          <a class="s gk" href={s.hedef}>
            <span class="soru-metin">{s.soru}</span>
            <span class="soru-hedef" aria-hidden="true">
              <span class="hedef-genis">{s.etiket}</span>
              <span class="hedef-dar">{s.etiketMobil}</span>
              <span class="ok"> →</span>
            </span>
          </a>
        )
      ))}
    </nav>
  </section>

  <!-- AKIŞ SONU İNİŞ BÖLÜMÜ — v3: sektör ızgarası KALKTI (kullanıcı kararı).
       Öz-cevap güverteye taşındı; burada kapanış başlığı + tek /durumum/ satırı. -->
  <section class="inis">
    <p class="inis-kicker">Su Haritası</p>
    <h1>Su, yerin altında <em>konuşur.</em></h1>
    <p class="inis-alt">Otelden madene, sanayiden sulama kooperatifine — hangi kapıdan
      girdiğiniz suyla ilişkinizi belirler. Sektörünüzü seçin, yükümlülüğünüzü görün.</p>
    <p class="tumu"><a href="/durumum/">Sektörünüzü seçin → /durumum/</a></p>
  </section>

  <div class="alt-kap"><AltBilgi /></div>

<script type="application/json" id="sahne-veri" is:inline set:html={JSON.stringify(sahneVeri)}></script>
<script>
  import { mountScrollWorld } from '../scripts/scrub-engine.js';

  const sahneler = JSON.parse(document.getElementById('sahne-veri').textContent);

  mountScrollWorld(document.getElementById('world'), {
    brand: null,        // üst şerit tek kaynak: UstMenu
    nav: false,
    hint: 'kaydırarak in',
    atmosphere: true,
    // 1.6 (deneyim'deki 1.4 değil): motorun klip ön-yükleme penceresi
    // `y > start - 1.6vh`. 1.6'da sahne 2 ancak KAYDIRINCA iner (brief T-1).
    diveScroll: 1.6,
    crossfade: 0.14,
    sections: sahneler,
    connectors: [],     // connector video YOK — sahneler doğrudan crossfade
  });

  /* POSTER ERTELEME (brief T-1) — motorun sahne <img>'leri sabit ve kadraj
     içindedir, loading="lazy" iş görmez: 6 poster de ilk yükte iniyordu.
     Sahne 1 dışındakilerin src'si alınır ve klip penceresiyle AYNI eşikte
     (start - 1.6vh) geri verilir. VENDOR'A DOKUNULMADI. */
  const sahneKaplari = [...document.querySelectorAll('#world .sw-scene')];
  const bekleyenPoster = sahneKaplari.map((el, i) => {
    const img = el.querySelector('.sw-scene__still');
    if (i === 0 || !img || !img.getAttribute('src')) return null;
    const src = img.getAttribute('src');
    img.removeAttribute('src');
    return { img, src, sira: i };
  }).filter(Boolean);

  function posterleriAc() {
    for (let j = bekleyenPoster.length - 1; j >= 0; j--) {
      const p = bekleyenPoster[j];
      if (scrollY > (p.sira * 1.6 - 1.6) * innerHeight) {
        p.img.setAttribute('src', p.src);
        bekleyenPoster.splice(j, 1);
      }
    }
  }

  /* — GÜVERTE SÜRÜCÜSÜ (v3) —
     Güverte STATİK liste; süzülen şerit sürücüsü KALKTI. Kalan iş:
     (1) poster erteleme, (2) akış bitince güverte/menü kapanışı (akis-bitti),
     (3) kaydırma çubuğu ölçümü (kadraj geometrisi 100vw'den türer). */
  const kok = document.documentElement;

  function cubugoOlc() {
    kok.style.setProperty('--kaydirma-cubugu',
      (window.innerWidth - kok.clientWidth) + 'px');
  }
  cubugoOlc();

  let iz = null;
  function akisUzunlugu() {
    if (!iz) iz = document.querySelector('#world .sw-track');
    return iz ? Math.max(1, iz.offsetHeight - innerHeight) : 1;
  }

  function guncelle() {
    if (bekleyenPoster.length) posterleriAc();
    const uz = akisUzunlugu();
    kok.classList.toggle('akis-bitti', scrollY > uz - 8);
  }

  addEventListener('scroll', () => requestAnimationFrame(guncelle), { passive: true });
  addEventListener('resize', () => { cubugoOlc(); guncelle(); });
  addEventListener('load', () => { cubugoOlc(); guncelle(); });
  guncelle();
</script>

<style>
  /* ——— MENÜ ŞERİDİ (sabit, koyu) ———
     Video üzerinde AA için DİP scrim'i: üstte α.82, aşağı doğru erir. */
  .ust-sabit {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
    --metin: #DCE9ED;
    --metin-soluk: #DBEAF4;
    --kopuk: #FFFFFF;
