  }

  .sorular {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px 2.4rem;
    align-content: start;
  }

  /* S2 detayı iki kolonu kaplar ve ilk sırada durur → açılınca temiz tam-en. */
  .s-detay { grid-column: 1 / -1; }

  .s, .s-detay > summary {
    display: flex;
    align-items: baseline;
