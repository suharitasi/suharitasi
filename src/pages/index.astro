---
// LANDING — FAZ A-ÖN birleştirmesi (2026-07-21): public/index.html buraya
// birebir taşındı (yedek: arsiv/landing-statik/index.html). Tek değişiklik:
// header bloğu artık tek kaynaktan gelir (<UstMenu tema="koyu" /> — eski
// header markup/CSS'i o komponentte, değer değer aynı). Geri kalan head,
// stil ve script'ler is:global / is:inline ile dokunulmadan korunur.
import UstMenu from '../components/UstMenu.astro';
---
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Su Haritası — Su, yerin altında konuşur.</title>
<meta name="description" content="Türkiye'nin 25 su havzası: DSİ verisi, kuyu ruhsatı ve su mevzuatı rehberleri, Su Kanunu taslak takibi — tek portalda." />
<link rel="canonical" href="https://suharitasi.com/" />
<meta property="og:title" content="su haritası — Türkiye'nin su verisi ve mevzuatı" />
<meta property="og:description" content="Türkiye'nin 25 su havzası: DSİ verisi, kuyu ruhsatı ve su mevzuatı rehberleri, Su Kanunu taslak takibi — tek portalda." />
<meta property="og:url" content="https://suharitasi.com" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Su Haritası" />
<meta property="og:locale" content="tr_TR" />
<meta property="og:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Su Haritası — Türkiye'nin su verisi ve mevzuatı" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500&display=swap&subset=latin-ext" rel="stylesheet" />
<style is:global>
  :root {
    --deniz: #04121F;
    --yukselti: #071D2E;
    --akis-sonuk: #0E3247;
    --akis-canli: #1E5A78;
    --akuamarin: #4FC3D0;
    --kopuk: #A8DDE0;
    --metin: #DCE9ED;
    --metin-soluk: #6C8A96;
    --bakir: #C08A4F;
    --mx: 50vw;
    --my: 42vh;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body { height: 100%; }

  body {
    background: var(--deniz);
    color: var(--metin);
    font-family: "Manrope", system-ui, sans-serif;
    overflow: hidden;
    /* Yukarısı görece aydınlık, aşağısı derin */
    background-image:
      radial-gradient(120vw 70vh at 50% -18vh, var(--yukselti) 0%, rgba(7, 29, 46, 0) 62%),
      linear-gradient(180deg, var(--deniz) 0%, #030D17 100%);
  }

  /* ---------- Dalga katmanları (derinlik konturları) ---------- */

  .dalgalar {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .dalgalar svg { width: 100%; height: 100%; display: block; }

  .dalgalar path {
    fill: none;
    stroke: var(--akis-sonuk);
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
  }

  /* İmleçle canlanan katman: aynı dalgalar, maskeyle açılır */
  .dalgalar--canli path {
    stroke: var(--akis-canli);
    stroke-width: 1.2;
  }

  .dalgalar--canli {
    filter: drop-shadow(0 0 7px rgba(79, 195, 208, 0.28));
    -webkit-mask-image: radial-gradient(circle 24rem at var(--mx) var(--my),
      rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.55) 42%, transparent 74%);
    mask-image: radial-gradient(circle 24rem at var(--mx) var(--my),
      rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.55) 42%, transparent 74%);
  }

  /* Canlanan katmanda çizgiler hafifçe akuamarine döner:
     üstüne çok düşük saydamlıkta akuamarin es geçirilir */
  .dalgalar--canli path:nth-child(odd) { stroke: #2A6B84; }

  .surukle {
    animation: surukle 70s ease-in-out infinite alternate;
  }

  @keyframes surukle {
    from { transform: translateX(-34px); }
    to   { transform: translateX(34px); }
  }

  /* ---------- Su damarları (alt yarıda yaşayan akıntı) ---------- */

  .damarlar {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    height: 54vh;
    pointer-events: none;
  }

  .damarlar svg { width: 100%; height: 100%; display: block; }

  .damarlar path {
    fill: none;
    stroke: var(--akuamarin);
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .damar-1 {
    stroke-width: 1.6;
    opacity: 0.5;
    stroke-dasharray: 170 340;
    animation: akinti 14s linear infinite;
    filter: drop-shadow(0 0 9px rgba(79, 195, 208, 0.55));
  }
  .damar-2 {
    stroke: var(--kopuk);
    stroke-width: 1.2;
    opacity: 0.32;
    stroke-dasharray: 120 420;
    animation: akinti 22s linear infinite;
    animation-delay: -8s;
    filter: drop-shadow(0 0 7px rgba(168, 221, 224, 0.4));
  }
  .damar-3 {
    stroke-width: 1.3;
    opacity: 0.22;
    stroke-dasharray: 220 380;
    animation: akinti 30s linear infinite;
    animation-delay: -14s;
    filter: drop-shadow(0 0 6px rgba(79, 195, 208, 0.35));
  }
  .damar-4 {
    stroke-width: 1;
    opacity: 0.14;
    stroke-dasharray: 90 300;
    animation: akinti 42s linear infinite;
    animation-delay: -20s;
  }

  @keyframes akinti {
    to { stroke-dashoffset: -1020; }
  }

  /* ---------- İçerik ---------- */

  .sahne {
    position: relative;
    z-index: 2;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  /* Üst şerit stilleri UstMenu bileşenine taşındı (tema="koyu") —
     FAZ A-ÖN birleştirmesi. */

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* İçerik üst yarıda otursun, damarlara yer kalsın */
    transform: translateY(-6vh);
  }

  h1 {
    font-family: "Cormorant", Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.4rem, 6.4vw, 4.9rem);
    line-height: 1.12;
    letter-spacing: -0.012em;
    max-width: 16ch;
    text-wrap: balance;
  }

  h1 em {
    font-style: italic;
    color: var(--kopuk);
  }

  .alt-metin {
    margin-top: 1.4rem;
    font-size: clamp(0.95rem, 1.6vw, 1.08rem);
    line-height: 1.6;
    color: var(--metin-soluk);
    max-width: 44ch;
  }

  /* Üç kapı: "Yakında" rozetinin yerini alan canlı girişler. Bakır ayraç
     dili korunur — kapı sırasının iki yanında eriyen çizgiler durur. */
  .kapilar {
    margin-top: clamp(2.6rem, 6vh, 4rem);
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: clamp(0.6rem, 2vw, 1.4rem);
    flex-wrap: wrap;
    position: relative;
  }

  .kapilar::before,
  .kapilar::after {
    content: "";
    align-self: center;
    display: block;
    width: clamp(2rem, 7vw, 5rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--bakir));
    opacity: 0.75;
    flex: none;
  }

  .kapilar::after {
    background: linear-gradient(270deg, transparent, var(--bakir));
  }

  .kapilar a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.7rem 1.15rem;
    text-decoration: none;
    border: 1px solid rgba(79, 195, 208, 0.34);
    border-radius: 2px;
    /* Zemin yeterince koyu olmalı: akan su damarları kapının içinden geçip
       alt etiketi kesiyordu. Derin su rengi korunur, okunabilirlik kazanılır. */
    background: rgba(5, 22, 36, 0.82);
    transition: border-color 0.25s ease, background-color 0.25s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @supports (backdrop-filter: blur(1px)) {
    .kapilar a {
      background: rgba(5, 22, 36, 0.62);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
    }
  }

  .kapilar a:hover {
    border-color: var(--akuamarin);
    background: rgba(14, 50, 71, 0.9);
    transform: translateY(-2px);
  }

  .kapilar a:focus-visible {
    outline: 2px solid var(--akuamarin);
    outline-offset: 3px;
  }

  .kapi-ad {
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--metin);
    margin-right: -0.2em;
  }

  .kapi-not {
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--metin-soluk);
  }

  .kapilar a:hover .kapi-not { color: var(--kopuk); }

  @media (max-width: 560px) {
    /* Dar ekranda yan çizgiler kapıları sıkıştırmasın */
    .kapilar::before, .kapilar::after { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kapilar a { transition: none; }
    .kapilar a:hover { transform: none; }
  }

  footer {
    display: flex;
    justify-content: center;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--metin-soluk);
  }

  /* Arslan Hukuk imzası: süs değil, imza */
  .imza {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35em 0.45em;
    padding: 0 1rem;
    text-align: center;
    color: var(--metin-soluk);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .imza span { white-space: nowrap; }

  .imza:hover, .imza:focus-visible {
    color: var(--metin);
  }

  .imza:focus-visible {
    outline: 2px solid var(--akuamarin);
    outline-offset: 4px;
  }

  .imza svg {
    height: 14px;
    width: auto;
    color: var(--bakir);
    opacity: 0.75;
    display: block;
  }

  /* İmza dokunuş: son kelime otururken altından ışıyıp geçen tek damar */
  .imza-damar {
    position: relative;
    width: min(58vw, 26ch);
    height: 0;
  }

  .imza-damar::before {
    content: "";
    position: absolute;
    top: 0.55rem;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent, #4FC3D0 35%, #A8DDE0 50%, #4FC3D0 65%, transparent);
    filter: drop-shadow(0 0 6px rgba(79, 195, 208, 0.8));
    opacity: 0;
  }

  body.giris .imza-damar::before {
    animation: imza-gec 1.2s 1.12s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  @keyframes imza-gec {
    0%   { opacity: 0; transform: translateX(-42%) scaleX(0.55); }
    35%  { opacity: 0.9; }
    100% { opacity: 0; transform: translateX(42%) scaleX(0.6); }
  }

  @media (prefers-reduced-motion: reduce) {
    .surukle, .damarlar path { animation: none; }
  }

  /* ---------- Giriş koreografisi (yalnızca body.giris varsa) ---------- */

  .kelime {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  .kelime-ic {
    display: inline-block;
    animation: kelime-kay 0.7s cubic-bezier(0.33, 1, 0.68, 1) both;
  }

  @keyframes kelime-kay {
    from { transform: translateY(110%); }
    to   { transform: translateY(0); }
  }

  @keyframes belir {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes metin-yuksel {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* body.giris .marka / .ust-nav kuralları UstMenu bileşeninde
     (tema="koyu" dalı) — FAZ A-ÖN birleştirmesi. */

  /* Dalga ve damar çizgileri başlıktan hemen önce soluk belirir */
  body.giris .dalgalar,
  body.giris .damarlar {
    animation: belir 1.1s 0.35s ease-out both;
  }

  body.giris .alt-metin {
    animation: metin-yuksel 0.6s 1.25s cubic-bezier(0.33, 1, 0.68, 1) both;
  }

  /* Kapılar, eski ayracın yerinde ve onun zamanlamasında belirir; ardından
     üç kapı 90ms arayla sırayla oturur (sekans korunur, hız değişmez). */
  body.giris .kapilar {
    animation: metin-yuksel 0.6s 1.55s cubic-bezier(0.33, 1, 0.68, 1) both;
  }

  body.giris .kapilar a {
    animation: metin-yuksel 0.5s cubic-bezier(0.33, 1, 0.68, 1) both;
  }

  body.giris .kapilar a:nth-of-type(1) { animation-delay: 1.68s; }
  body.giris .kapilar a:nth-of-type(2) { animation-delay: 1.77s; }
  body.giris .kapilar a:nth-of-type(3) { animation-delay: 1.86s; }

  body.giris footer {
    animation: belir 0.8s 1.75s ease-out both;
  }
</style>
<script type="module" src="/s/imlec.js" is:inline></script>
<!-- FAZ A: dar-şerit MENÜ tetikleyicisi (≤640px) tam-ekran paneli açar;
     davranış site-geneli tek dosyada (/s/menu.js), yeni JS yazılmadı. -->
<script type="module" src="/s/menu.js" is:inline></script>
</head>
<body>

  <!-- Sönük derinlik katmanları -->
  <div class="dalgalar" aria-hidden="true">
    <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
      <g class="surukle">
        <path d="M -60 84  C 240 72,  480 96,  760 82  S 1240 70, 1500 86"/>
        <path d="M -60 148 C 260 160, 520 134, 800 150 S 1260 162, 1500 146"/>
        <path d="M -60 222 C 230 208, 500 236, 780 220 S 1250 206, 1500 224"/>
        <path d="M -60 310 C 270 324, 540 296, 820 312 S 1270 326, 1500 308"/>
        <path d="M -60 416 C 250 400, 520 432, 810 414 S 1260 398, 1500 418"/>
        <path d="M -60 542 C 280 558, 560 526, 840 544 S 1280 560, 1500 540"/>
        <path d="M -60 690 C 260 672, 540 708, 830 688 S 1270 670, 1500 692"/>
        <path d="M -60 858 C 290 876, 570 842, 850 862 S 1280 878, 1500 856"/>
      </g>
    </svg>
  </div>

  <!-- İmleçle canlanan katman: aynı dalgalar -->
  <div class="dalgalar dalgalar--canli" aria-hidden="true">
    <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
      <g class="surukle">
        <path d="M -60 84  C 240 72,  480 96,  760 82  S 1240 70, 1500 86"/>
        <path d="M -60 148 C 260 160, 520 134, 800 150 S 1260 162, 1500 146"/>
        <path d="M -60 222 C 230 208, 500 236, 780 220 S 1250 206, 1500 224"/>
        <path d="M -60 310 C 270 324, 540 296, 820 312 S 1270 326, 1500 308"/>
        <path d="M -60 416 C 250 400, 520 432, 810 414 S 1260 398, 1500 418"/>
        <path d="M -60 542 C 280 558, 560 526, 840 544 S 1280 560, 1500 540"/>
        <path d="M -60 690 C 260 672, 540 708, 830 688 S 1270 670, 1500 692"/>
        <path d="M -60 858 C 290 876, 570 842, 850 862 S 1280 878, 1500 856"/>
      </g>
    </svg>
  </div>

  <!-- Su damarları: alt yarıda yaşayan akıntı -->
  <div class="damarlar" aria-hidden="true">
    <svg viewBox="0 0 1440 486" preserveAspectRatio="xMidYMid slice">
      <path class="damar-1" d="M -60 130 C 220 108, 430 168, 700 142 S 1180 96, 1500 134"/>
      <path class="damar-2" d="M -60 218 C 260 246, 510 186, 790 216 S 1240 258, 1500 210"/>
      <path class="damar-3" d="M -60 316 C 240 288, 520 348, 800 314 S 1260 282, 1500 320"/>
      <path class="damar-4" d="M -60 414 C 280 438, 540 386, 820 416 S 1270 442, 1500 408"/>
    </svg>
  </div>

  <div class="sahne">
    <UstMenu tema="koyu" />

    <main>
      <h1>Su, yerin altında <em>konuşur.</em></h1>
      <div class="imza-damar" aria-hidden="true"></div>
      <p class="alt-metin">Türkiye'nin su verisi, havzaları ve su mevzuatı — tek haritada.</p>
      <nav class="kapilar" aria-label="Portal bölümleri">
        <a href="/harita/">
          <span class="kapi-ad">Harita</span>
          <span class="kapi-not">havza atlası</span>
        </a>
        <a href="/rehberler/">
          <span class="kapi-ad">Rehberler</span>
          <span class="kapi-not">mevzuat rehberleri</span>
        </a>
        <a href="/su-kanunu/">
          <span class="kapi-ad">Su Kanunu</span>
          <span class="kapi-not">taslak takibi</span>
        </a>
      </nav>
    </main>

    <footer>
      <a class="imza" href="https://arslanhukuk.tr" target="_blank" rel="noopener">
        <span>suharitasi.com ·</span>
        <svg viewBox="0 0 77 109" aria-hidden="true"><path fill="currentColor" d="M 60.613281 72.335938 L 60.613281 72.339844 L 38.617188 89.519531 L 16.609375 72.339844 L 16.609375 15.898438 L 60.613281 15.898438 Z M 70.816406 77.316406 L 70.816406 5.699219 L 6.40625 5.699219 L 6.40625 77.320312 L 38.617188 102.464844 Z M 70.816406 77.316406"/><path fill="currentColor" d="M 57.265625 70.703125 L 57.265625 19.25 L 47.0625 19.25 L 47.0625 78.671875 Z M 57.265625 70.703125"/><path fill="currentColor" d="M 30.160156 78.671875 L 30.160156 19.25 L 19.957031 19.25 L 19.957031 70.703125 Z M 30.160156 78.671875"/><path fill="currentColor" d="M 57.265625 19.25 L 19.957031 19.25 L 19.957031 29.453125 L 57.265625 29.453125 Z M 57.265625 19.25"/><path fill="currentColor" d="M 46.324219 42.8125 L 31.261719 42.8125 L 31.261719 53.015625 L 46.324219 53.015625 Z M 46.324219 42.8125"/></svg>
        <span>Arslan Hukuk Bürosu güvencesiyle</span>
        <span>· 2026</span>
      </a>
    </footer>
  </div>

<script is:inline>
  // İmleç: canlanan dalga katmanının maskesini imlece bağla
  const kok = document.documentElement;
  let hedefX = innerWidth / 2, hedefY = innerHeight * 0.42;
  let x = hedefX, y = hedefY;

  addEventListener("pointermove", (e) => {
    hedefX = e.clientX;
    hedefY = e.clientY;
  }, { passive: true });

  // Yumuşak takip: maske imlecin hafif gerisinden gelir (su gibi)
  function akit() {
    x += (hedefX - x) * 0.08;
    y += (hedefY - y) * 0.08;
    kok.style.setProperty("--mx", x + "px");
    kok.style.setProperty("--my", y + "px");
    requestAnimationFrame(akit);
  }

  const azHareket = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Giriş koreografisi: başlığı kelimelere böl, sekansı başlat
  if (!azHareket) {
    document.body.classList.add("giris");
    let sira = 0;
    const BASLANGIC = 0.55; // başlık, çizgilerin belirmesinden hemen sonra
    const ADIM = 0.12;
    function kelimelereBol(dugum) {
      [...dugum.childNodes].forEach((c) => {
        if (c.nodeType === Node.TEXT_NODE) {
          const kelimeler = c.textContent.split(/\s+/).filter(Boolean);
          const parca = document.createDocumentFragment();
          kelimeler.forEach((k) => {
            const dis = document.createElement("span");
            dis.className = "kelime";
            const ic = document.createElement("span");
            ic.className = "kelime-ic";
            ic.textContent = k;
            ic.style.animationDelay = (BASLANGIC + sira++ * ADIM) + "s";
            dis.appendChild(ic);
            parca.appendChild(dis);
            parca.appendChild(document.createTextNode(" "));
          });
          c.replaceWith(parca);
        } else if (c.nodeType === Node.ELEMENT_NODE) {
          kelimelereBol(c); // <em> içindeki kelimeler stilini korur
        }
      });
    }
    kelimelereBol(document.querySelector("h1"));
  }

  if (azHareket) {
    kok.style.setProperty("--mx", hedefX + "px");
    kok.style.setProperty("--my", hedefY + "px");
    addEventListener("pointermove", (e) => {
      kok.style.setProperty("--mx", e.clientX + "px");
      kok.style.setProperty("--my", e.clientY + "px");
    }, { passive: true });
  } else {
    akit();

    // Dokunmatik cihazda imleç yok: maske yavaşça gezinsin
    if (matchMedia("(pointer: coarse)").matches) {
      let t = 0;
      setInterval(() => {
        t += 0.012;
        hedefX = innerWidth  * (0.5 + 0.34 * Math.sin(t));
        hedefY = innerHeight * (0.45 + 0.22 * Math.cos(t * 0.7));
      }, 40);
    }
  }
</script>
</body>
</html>
