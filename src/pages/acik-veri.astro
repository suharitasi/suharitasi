---
import TemelDuzen from '../layouts/TemelDuzen.astro';
import AltBilgi from '../components/AltBilgi.astro';
import PaylasilanMenu from '../components/PaylasilanMenu.astro';
import AcilDestekBar from '../components/AcilDestekBar.astro';
---

<TemelDuzen
  baslik="Açık Veri API: OpenAPI ve Veri Katalogu — Su Haritası"
  aciklama="Su Haritası makine-okunur veri katmanı: il ve havza JSON uçları, OpenAPI 3.0 şeması, Zenodo DOI tescili ve CC-BY-4.0 lisansı."
>
  <PaylasilanMenu />
  
  <main class="acik-veri-ana">
    <div class="acik-veri-ic">
      <header class="acik-veri-baslik">
        <p class="acik-veri-kicker">Makine-Okunur Hidroloji ve Hukuk Katmanı</p>
        <h1>Açık Veri ve API Altyapısı</h1>
        <p class="acik-veri-ozet">
          Su Haritası verileri; kamu kurumlarının resmî yayınlarından derlenmiş, uluslararası arşivlerde tescillenmiş ve araştırmacılar ile yazılım geliştiriciler için ücretsiz, doğrulanabilir JSON uçları olarak sunulmuştur.
        </p>
      </header>

      <!-- Uluslararası Tescil ve Lisans Vitrini -->
      <div class="tescil-izgara">
        <a href="https://doi.org/10.5281/zenodo.23002678" target="_blank" rel="noopener noreferrer" class="tescil-kutusu">
          <span class="etiket">Akademik Tescil</span>
          <strong>Zenodo DOI: 10.5281/zenodo.23002678</strong>
          <span>CERN / OpenAIRE kalıcı dijital nesne tanımlayıcısı</span>
        </a>
        <a href="https://www.wikidata.org/wiki/Q141582057" target="_blank" rel="noopener noreferrer" class="tescil-kutusu">
          <span class="etiket">Bilgi Grafiği</span>
          <strong>Wikidata: Q141582057</strong>
          <span>Semantik web ve AI ajanları küresel kimliği</span>
        </a>
        <div class="tescil-kutusu sabit">
          <span class="etiket">Veri Lisansı</span>
          <strong>Creative Commons (CC BY 4.0)</strong>
          <span>Atıf yapmak koşuluyla ticari ve akademik kullanıma açık</span>
        </div>
      </div>

      <section class="api-bolum">
        <h2>Uç Noktalar (REST JSON)</h2>
        <p class="not">Bütün yanıtlar build zamanında üretilen statik JSON dosyalarıdır; sunucu gecikmesi veya hız sınırı yoktur. Kimlik doğrulama gerektirmez.</p>
        
        <div class="uc-nokta-kart">
          <div class="uc-nokta-kod"><code>GET /api/v1/il/{'{il}'}.json</code></div>
          <p>İl bazında su idaresi, DSİ bölgesi, dahil olduğu havzalar ve Resmî Gazete kısıt künyeleri.</p>
          <a href="/api/v1/il/istanbul.json" target="_blank" class="ornek-link">Örnek: /api/v1/il/istanbul.json →</a>
        </div>

        <div class="uc-nokta-kart">
          <div class="uc-nokta-kod"><code>GET /api/v1/havza/{'{havza}'}.json</code></div>
          <p>Havza hidrolojik alanı, yıllık su potansiyeli, YAS rezervi ve havza eylem planı kaynakları.</p>
          <a href="/api/v1/havza/gediz.json" target="_blank" class="ornek-link">Örnek: /api/v1/havza/gediz.json →</a>
        </div>
      </section>

      <section class="api-bolum">
        <h2>Hızlı Başlangıç (cURL)</h2>
        <div class="kod-blogu">
          <pre><code># Havza verisini çekme
curl -s https://suharitasi.com/api/v1/havza/gediz.json

# İl kütüğünü çekme
curl -s https://suharitasi.com/api/v1/il/istanbul.json</code></pre>
        </div>
      </section>

      <section class="api-bolum">
        <h2>Veri İlkeleri (17 Skills Standartları)</h2>
        <ul class="ilkeler-liste">
          <li><strong>Uydurma veri yok:</strong> Doğrulanamayan hiçbir değer üretilmez; eksik veriler dürüstçe <code>null</code> veya "veri yok" olarak işaretlenir.</li>
          <li><strong>Hukuki hüküm değildir:</strong> Bilgilendirme ve ön araştırma amaçlıdır; idari kararlar resmi mercilerce verilir.</li>
          <li><strong>Tek kaynak güvencesi:</strong> API yanıtları ve sitedeki görsel sayaçlar aynı doğrulanmış statik kaynaktan beslenir.</li>
        </ul>
      </section>
    </div>
  </main>

  <AltBilgi />
  <AcilDestekBar />
</TemelDuzen>

<style>
  /* Menü çakışmasını önleyen güvenli üst boşluk */
  .acik-veri-ana {
    padding-top: 100px;
    padding-bottom: 60px;
    background: #f8fafc;
    color: #0f172a;
    min-height: 80vh;
  }
  .acik-veri-ic {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .acik-veri-kicker {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0284c7;
    margin-bottom: 0.5rem;
  }
  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 1rem;
    color: #0f172a;
    line-height: 1.2;
  }
  .acik-veri-ozet {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 2rem;
  }
  .tescil-izgara {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 768px) {
    .tescil-izgara { grid-template-columns: 1fr; }
    .acik-veri-ana { padding-top: 85px; }
  }
  .tescil-kutusu {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    min-height: 44px;
    transition: all 0.2s ease;
  }
  .tescil-kutusu:hover:not(.sabit) {
    transform: translateY(-2px);
    border-color: #0284c7;
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
  }
  .tescil-kutusu .etiket {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #0284c7;
    margin-bottom: 0.35rem;
  }
  .tescil-kutusu strong {
    font-size: 0.95rem;
    font-family: monospace;
    margin-bottom: 0.35rem;
  }
  .tescil-kutusu span:last-child {
    font-size: 0.8rem;
    color: #64748b;
  }
  .api-bolum {
    margin-bottom: 2.5rem;
  }
  .api-bolum h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #0f172a;
  }
  .not {
    font-size: 0.95rem;
    color: #64748b;
    margin-bottom: 1.25rem;
  }
  .uc-nokta-kart {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }
  .uc-nokta-kod code {
    font-family: monospace;
    font-size: 1rem;
    font-weight: 700;
    color: #0369a1;
  }
  .uc-nokta-kart p {
    font-size: 0.9rem;
    color: #475569;
    margin: 0.5rem 0;
  }
  .ornek-link {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #0284c7;
    text-decoration: none;
    min-height: 44px;
    line-height: 44px;
  }
  .kod-blogu {
    background: #0f172a;
    color: #f8fafc;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
  }
  .kod-blogu code {
    font-family: monospace;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .ilkeler-liste {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ilkeler-liste li {
    padding: 0.75rem 0;
    border-bottom: 1px solid #e2e8f0;
    font-size: 0.95rem;
    color: #334155;
  }
</style>
