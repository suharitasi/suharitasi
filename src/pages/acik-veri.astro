---
// /acik-veri/ — AÇIK VERİ VE GELİŞTİRİCİ PORTALI (ADIM 3, v6.0, 21.09.2026).
//
// Geliştirici, mühendis ve hukuk büroları için makine-okunur veri
// dokümantasyonu: /api/v1/* uçları, OpenAPI 3.0 spesifikasyonu, veri standardı
// lisansı ve atıf metni. Uydurma alan/örnek YOK (K7); örnekler canlı çıktıyla
// birebir aynı alan adlarını taşır. Veriler statiktir; kimlik doğrulama yoktur.
import Sayfa from '../layouts/Sayfa.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import OzCevap from '../components/OzCevap.astro';
import CiteThisData from '../components/CiteThisData.astro';
import CtaBlok from '../components/CtaBlok.astro';
import HukukSerhi from '../components/HukukSerhi.astro';
import kesifRegistry from '../../izleme/kesif/kaynak-kaynagi.json';
import { tazelikTablosu } from '../../arac/veri-tazelik.mjs';

// P6-B veri tazelik panosu — as-of yalnız veri künyesinden (uydurma yok).
const tazelik = tazelikTablosu();
const trTarih = (iso: string) => { const [y, a, g] = iso.split('-'); return `${g}.${a}.${y}`; };

// 04.10.2026 — KEŞİF MOTORU: sürekli keşif/validasyon hattının bulduğu aday
// açık veri kaynakları burada ŞEFFAF biçimde listelenir (otoritesi + durumu).
// Otoritesiz kaynak otomatik ENTEGRE EDİLMEZ; bu tablo insan onay sürecinin
// kamuya açık yüzü. NASA POWER bu oturumda /veri/iklim/ sayfasına entegre edildi.
const ENTEGRE = new Set(['nasa-power']);
const adaylar = [
  ...kesifRegistry.kaynaklar.filter((k) => k.entegre === 'aday'),
  ...kesifRegistry.aday_kaynaklar,
].map((k) => ({
  ad: k.ad,
  kurum: k.kurum || '',
  url: k.url,
  otorite: k.otorite || 'resmi',
  durum: ENTEGRE.has(k.id) ? 'Entegre' : (k.erisim === 'anahtar' ? 'Kimlik gerekli' : k.erisim === 'kayit' ? 'Kayıt gerekli' : 'Doğrulandı, aday'),
}));

const OZ_CEVAP =
  'Su Haritası makine-okunur veri katmanı: /api/v1/il/{il}.json ve ' +
  '/api/v1/havza/{havza}.json uçları, OpenAPI 3.0 spesifikasyonu ve ' +
  'kaynak gösterme standardı. Statik JSON; kimlik doğrulama yok. Yalnız ' +
  'doğrulanmış kaynaklardan derlenir, hukuki görüş değildir.';

const kok = new URL('/', Astro.site).href;
const canonical = new URL('/acik-veri/', Astro.site).href;
const specYolu = '/api/v1/openapi.json';

const uclar = [
  {
    yol: '/api/v1/il/{il}.json',
    ornek: '/api/v1/il/istanbul.json',
    ad: 'İl künyesi',
    alanlar: ['il', 'slug', 'sayfa', 'dsiBolgeleri[]', 'suIdaresi', 'havzalar[]', 'rgKisitKayitlari[]', 'mevzuatDayanagi[]', 'kaynak', 'not'],
  },
  {
    yol: '/api/v1/havza/{havza}.json',
    ornek: '/api/v1/havza/gediz.json',
    ad: 'Havza künyesi',
    alanlar: ['havza', 'baslik', 'veri{} (baslik, ozet, tarih, guncelleme, no, kunye{})', 'kaynak', 'not'],
  },
];

const sema = [
  {
    '@type': 'TechArticle',
    '@id': `${canonical}#makale`,
    headline: 'Açık veri ve geliştirici portalı',
    url: canonical,
    inLanguage: 'tr-TR',
    about: { '@type': 'DataCatalog', name: 'Su Haritası açık veri kataloğu', url: `${kok}veri/` },
    description: OZ_CEVAP,
    isPartOf: { '@id': `${kok}#site` },
  },
];
---

<Sayfa
  baslik="Açık veri portalı"
  aciklama={OZ_CEVAP}
  tarayiciBaslik="Açık Veri API: OpenAPI ve Veri Standardı"
  sema={sema}
>
  <SayfaBasi
    etiket="Açık veri"
    baslik="Açık veri ve geliştirici portalı"
    ozet="Geliştiriciler, mühendisler ve hukuk büroları için makine-okunur uçlar, OpenAPI 3.0 şeması ve atıf standardı."
  />
  <OzCevap metin={OZ_CEVAP} etiket="Özet" />

  <section class="av-blok">
    <h2>Uç noktalar</h2>
    <p>
      Bütün yanıtlar build zamanında üretilen <strong>statik JSON</strong>
      dosyalarıdır; sunucu veya veritabanı yoktur, kimlik doğrulama gerekmez.
      Tam şema tanımları için{' '}
      <a href={specYolu}>OpenAPI 3.0 spesifikasyonu</a>{' '}
      (<code>{specYolu}</code>).
    </p>
    <ul class="av-uclar">
      {uclar.map((u) => (
        <li class="av-uc">
          <p class="av-uc-ust"><span class="av-uc-ad">{u.ad}</span><code>{u.yol}</code></p>
          <p class="av-alanlar">
            <span class="av-alan-etiket">Alanlar</span>
            {u.alanlar.map((a, i) => (<>{i > 0 && ' · '}<code>{a}</code></>))}
          </p>
          <p class="av-ornek">
            Örnek: <a href={u.ornek}><code>{u.ornek}</code></a>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="av-blok">
    <h2>Hızlı başlangıç</h2>
    <pre class="av-kod"><code>{`# İl künyesi (slug: küçük harf, aksansız)
curl -s https://suharitasi.com/api/v1/il/istanbul.json

# Havza künyesi
curl -s https://suharitasi.com/api/v1/havza/gediz.json

# OpenAPI 3.0 spesifikasyonu
curl -s https://suharitasi.com/api/v1/openapi.json`}</code></pre>
  </section>

  <section class="av-blok">
    <h2>Veri ilkeleri</h2>
    <ul class="av-ilkeler">
      <li><strong>Uydurma veri yok.</strong> Doğrulanamayan değer üretilmez; eksik alan boş dizi (<code>[]</code>), <code>null</code> veya "veri yok" işaretiyle dürüstçe belirtilir.</li>
      <li><strong>Hukuki hüküm değildir.</strong> Veri ve alanlar bilgilendirme amaçlıdır; ceza tutarı veya kesin sonuç üretilmez, yalnız mevzuat dayanağı gösterilir.</li>
      <li><strong>Tek kaynak.</strong> Alan adları ve şema, canlı JSON çıktısıyla birebir aynıdır.</li>
    </ul>
  </section>

  <section class="av-blok">
    <h2>Veri tazeliği</h2>
    <p>Her veri kümesinin <strong>as-of</strong> tarihi, tazeleyen iş ve durumu. Tarihler yalnız veri künyesinden okunur; statik derlemeler eşik denetimine girmez.</p>
    <div class="av-tablo-sar" tabindex="0" role="region" aria-label="Veri tazeliği tablosu">
      <table class="av-tablo">
        <caption>Veri kümesi · kaynak · as-of · tazeleyen iş · durum</caption>
        <thead><tr><th scope="col">Veri kümesi</th><th scope="col">Kaynak</th><th scope="col">As-of</th><th scope="col">Tazeleyen iş</th><th scope="col">Durum</th></tr></thead>
        <tbody>
          {tazelik.map((t) => (
            <tr>
              <td>{t.ad}</td>
              <td>{t.kaynak}</td>
              <td>{t.asOf ? trTarih(t.asOf) : 'bilinmiyor'}</td>
              <td>{t.job}</td>
              <td>{t.durum === 'guncel' ? 'Güncel' : t.durum === 'gecikmis' ? `Gecikmiş (${t.yasGun} gün)` : t.durum === 'bilinmiyor' ? 'Bilinmiyor' : 'Statik/manuel'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>Makine-okunur kopya: <a href="/veri/veri-tazelik.json">/veri/veri-tazelik.json</a></p>
  </section>

  <section class="av-blok">
    <h2>Veri keşif motoru ve aday kaynaklar</h2>
    <p>
      Su Haritası, açık su/iklim verisi kaynaklarını <strong>sürekli</strong>
      izler: canlılık, biçim, şema ve yayım disiplinini her gün yoklar. Yalnız
      otoritesi <strong>resmî, akademik veya kurumsal</strong> olan kaynaklar
      havuza alınır; ticari aracı/agregatör ve magazin kaynaklı veriler otomatik
      reddedilir. Doğrulanan bir kaynak <em>insan onayı</em> olmadan yayına
      bağlanmaz — önce aşağıdaki aday havuzunda listelenir.
    </p>
    <p>
      Bu oturumda entegre edilen kaynak:
      <a href="/veri/iklim/"><strong>NASA POWER</strong> — 25 havza iklim verisi (yağış, sıcaklık, toprak nemi)</a>.
    </p>
    <div class="av-tablo-sar">
      <table class="av-tablo">
        <thead><tr><th>Kaynak</th><th>Kurum</th><th>Otorite</th><th>Durum</th></tr></thead>
        <tbody>
          {adaylar.map((a) => (
            <tr>
              <td><a href={a.url} target="_blank" rel="noopener noreferrer">{a.ad}</a></td>
              <td>{a.kurum}</td>
              <td>{a.otorite}</td>
              <td>{a.durum}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="av-notkucuk">Aday havuzu, keşif motorunun günlük yoklamasıyla güncellenir. Otoritesi doğrulanamayan kaynaklar bu tabloda yer almaz.</p>
  </section>

  <section class="av-blok">
    <h2>Lisans ve atıf</h2>
    <p class="av-veri-standardi">
      <strong>Su Haritası Açık Hidroloji ve Hukuk Veri Standardı</strong> —
      kaynak gösterilerek kullanım (CC BY 4.0 uyumlu).
    </p>
    <p>
      Veriyi kullanırken aşağıdaki atıf biçimini koruyun. Ticari kullanımda
      büro künyesine bağlantı verilmesi beklenir.
    </p>
    <pre class="av-kod"><code>{`Su Haritası Açık Hidroloji ve Hukuk Veri Standardı (2026).
<sorgulanan uç URL'i>. Erişim: <tarih>.
Arslan Hukuk Bürosu — https://suharitasi.com/acik-veri/`}</code></pre>
  </section>

  <CiteThisData baslik="Açık veri portalı" />

  <nav class="av-capraz" aria-label="İlgili bölümler">
    <a href="/veri/">→ Açık veri kataloğu (JSON listesi)</a>
    <a href={specYolu}>→ OpenAPI 3.0 spesifikasyonu</a>
    <a href="/gizlilik/">→ Gizlilik ve kullanım koşulları</a>
    <a href="/hakkinda/">→ Yöntem ve kaynak politikası</a>
  </nav>

  <CtaBlok konu="Açık veri / API" baslik="Veriyi büronuz için kullanıyor musunuz?" metin="Su verisi ve mevzuat dayanağını kurumsal iş akışınıza uyarlamak için veri standardı ve entegrasyon yöntemini konuşalım." />
  <HukukSerhi />
</Sayfa>

<style>
  .av-blok { margin-top: 1.6rem; }
  .av-blok h2 { font-family: var(--serif); font-weight: 500; font-size: 1.4rem; margin-bottom: 0.6rem; }
  .av-blok p { max-width: 74ch; }
  .av-uclar { list-style: none; margin: 0.8rem 0 0; padding: 0; display: grid; gap: 0.8rem; }
  .av-uc { padding: 0.9rem 1rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); border-top: 2px solid var(--su-700); }
  .av-uc-ust { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 0.9rem; margin: 0 0 0.4rem; }
  .av-uc-ad { font-family: var(--serif); font-size: 1.1rem; font-weight: 500; }
  .av-alanlar { font-size: 0.88rem; color: var(--metin-soluk); margin: 0.2rem 0; }
  .av-alan-etiket { font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--su-700); margin-right: 0.5rem; }
  .av-ornek { font-size: 0.88rem; margin: 0.3rem 0 0; }
  code { font-family: var(--mono); font-size: 0.82em; background: rgba(19, 42, 63, 0.05); padding: 0.05rem 0.3rem; }
  .av-kod { background: var(--deniz); color: var(--kopuk); border: 1px solid var(--cizgi); padding: 0.9rem 1rem; overflow-x: auto; margin: 0.8rem 0; }
  .av-kod code { background: none; padding: 0; color: inherit; font-size: 0.82rem; line-height: 1.7; white-space: pre; }
  .av-ilkeler { margin: 0.8rem 0 0 1.1rem; display: grid; gap: 0.5rem; max-width: 74ch; }
  .av-veri-standardi { padding: 0.7rem 1rem; border: 1px solid var(--cizgi); border-left: 3px solid var(--kehribar); background: var(--zemin-kart); max-width: 74ch; }
  .av-capraz { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-top: 1.6rem; padding-top: 1rem; border-top: 1px solid var(--cizgi); }
  .av-capraz a { color: var(--baglanti); text-decoration: none; }
  .av-capraz a:hover { text-decoration: underline; }
  .av-tablo-sar { overflow-x: auto; margin-top: 0.6rem; }
  .av-tablo { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  .av-tablo th, .av-tablo td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--cizgi); vertical-align: top; }
  .av-tablo th { font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--metin-soluk); }
  .av-tablo a { color: var(--baglanti); text-decoration: none; }
  .av-tablo a:hover { text-decoration: underline; }
  .av-notkucuk { font-size: 0.8rem; color: var(--metin-soluk); margin-top: 0.6rem; }
</style>
