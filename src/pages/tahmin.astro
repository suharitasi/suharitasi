---
/* /tahmin/ — Tahminsel analitik: havza su depolama ve baraj projeksiyonu.
   BİLİMSEL İLKE: bu sayfa ÖLÇÜM değil, İSTATİSTİKSEL TAHMİN sunar. Her sayı
   data/tahmin/kuraklik-projeksiyonu.json'dan gelir (tur="tahmin"); ölçülen
   verilerle karıştırılmaz. Yöntem: mevsimsel ayrıştırma + OLS trend + MK testi. */
import Sayfa from '../layouts/Sayfa.astro';
import { TARIH, enYeni } from '../data/guncellik.js';
// P3 (05.10.2026): şema tazelik damgası — tahminin iki girdisi GRACE + baraj.
const TAHMIN_VERI_TARIHI = enYeni(TARIH.grace, TARIH.baraj);
import SayfaBasi from '../components/SayfaBasi.astro';
import OzCevap from '../components/OzCevap.astro';
import CtaBlok from '../components/CtaBlok.astro';
import HukukSerhi from '../components/HukukSerhi.astro';
import tahmin from '../../data/tahmin/kuraklik-projeksiyonu.json';

const kayitlar = Object.entries(tahmin.havzalar).map(([ad, v]: [string, any]) => ({
  ad,
  grace: v.grace,
  baraj: v.baraj,
}));
const graceVar = kayitlar.filter((k: any) => k.grace);
const barajVar = kayitlar.filter((k: any) => k.baraj);
const azalan = graceVar
  .filter((k: any) => k.grace.egilim_aylik_cm < 0)
  .sort((a: any, b: any) => a.grace.egilim_aylik_cm - b.grace.egilim_aylik_cm)
  .slice(0, 6);

const OZ_CEVAP =
  `Bu sayfa ölçüm değil, istatistiksel tahmindir: ${graceVar.length} havza için ` +
  `uydu ölçümlerine dayalı 6 aylık su değişimi, ${barajVar.length} havza için son ` +
  `60 günün hızına göre baraj doluluğunun 30 gün sonraki tahmini. Her değer olası ` +
  `alt–üst bantla verilir; gerçekleşme garanti edilmez.`;

const sema = [
  {
    '@type': 'Dataset',
    name: 'Türkiye su havzaları — istatistiksel su/kuraklık projeksiyonu (tahmin)',
    description: OZ_CEVAP,
    creator: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' },
    publisher: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' },
    measurementTechnique: 'Statistical forecast: seasonal decomposition + ordinary least squares trend + Mann-Kendall test',
    isBasedOn: ['https://podaac.jpl.nasa.gov/GRACE', 'https://seffaflik.epias.com.tr'],
    variableMeasured: ['Karasal su depolama anomalisi (cm)', 'Baraj ortalama doluluk (%)'],
    temporalCoverage: '2002-04/2026-09',
    isAccessibleForFree: true,
    inLanguage: 'tr-TR',
    ...(TAHMIN_VERI_TARIHI ? { dateModified: TAHMIN_VERI_TARIHI } : {}),
    spatialCoverage: { '@type': 'Place', name: 'Türkiye' },
    // ÖLÇÜM DEĞİL — schema düzeyinde de ayrılır:
    additionalType: 'https://schema.org/Dataset',
    keywords: ['tahmin', 'forecast', 'kuraklık', 'projeksiyon', 'GRACE'],
  },
];
const isaret = (v: number) => (v > 0 ? '+' : '');
---
<Sayfa
  baslik="Tahminsel analitik: havza su projeksiyonu"
  aciklama={OZ_CEVAP}
  tarayiciBaslik="Kuraklık Tahmini ve Havza Su Projeksiyonu | 6 Aylık"
  metaAciklamaHam="25 havzanın 6 aylık su depolama ve baraj doluluğu projeksiyonu; her değer olası bant ve kaynağıyla. Ölçüm değil, istatistiksel tahmindir."
  sema={sema}
>
  <SayfaBasi etiket="Tahminsel analitik" baslik="Havza su projeksiyonu: 6 aylık istatistiksel tahmin" ozet={`${tahmin.havza_sayisi} havza · uydu su ölçümü + baraj doluluğu · her sayı geçmiş veriden hesaplanan tahmindir; sade karşılıklar sayfada.`} />
  <OzCevap metin={OZ_CEVAP} etiket="Özet" />

  <p class="th-uyari" role="note">
    <strong>Bu sayfa ölçüm değil, istatistiksel tahmindir.</strong> Değerler geçmiş
    gözlemlere dayanan model çıktısıdır ve gerçekleşmesi garanti edilmez. Her satır
    tahmin aralığıyla (80/95%) verilir; resmî bir tahmin veya uyarı değildir.
    Kaynak veriler: NASA'nın yerçekimi uydu ölçümleri (aylık), EPİAŞ baraj dolulukları (günlük).
  </p>

  <section class="th-bolum">
    <h2>6 Aylık Su Projeksiyonu — suyu en hızlı azalan 6 havza</h2>
    <p class="th-not">Aylık değişim (cm): eksi değer suyun azaldığını gösterir. "Güvenilir Trend mi? (Tesadüf Değil)" sütunu, bu değişimin tesadüfi dalgalanma değil gerçek bir yön olup olmadığını söyler. Yani: havzanın toplam suyu son aylarda azalıyor mu, artıyor mu?</p>
    <table class="th-tablo">
      <thead><tr>
        <th>Havza</th>
        <th>Son değer<span class="th-meal">en güncel aylık ölçüm (cm)</span></th>
        <th>Aylık Su Seviyesi Değişimi<span class="th-meal">su seviyesi ayda kaç cm değişiyor</span></th>
        <th>6 ay sonra (tahmin)<span class="th-meal">beklenen değer, olası bantla</span></th>
        <th>Güvenilir Trend mi? (Tesadüf Değil)<span class="th-meal">bu değişim tesadüf mü, gerçek yön mü?</span></th>
      </tr></thead>
      <tbody>
        {azalan.map((k: any) => (
          <tr>
            <td><a href={`/havzalar/${k.ad.toLowerCase().replace(/ı/g, 'i').replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ş/g, 's').replace(/ö/g, 'o').replace(/ç/g, 'c').replace(/ /g, '-').replace('-kapali', '-kapali')}/`}>{k.ad}</a></td>
            <td>{k.grace.son_deger}</td>
            <td>{isaret(k.grace.egilim_aylik_cm)}{k.grace.egilim_aylik_cm}</td>
            <td>{k.grace.projeksiyon[5]?.deger} <span class="th-aralik">[{k.grace.projeksiyon[5]?.alt95} … {k.grace.projeksiyon[5]?.ust95}]</span></td>
            <td>{k.grace.mk_anlamli ? 'evet' : 'hayır'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="th-bolum">
    <h2>Baraj doluluğu — 30 gün sonrası için tahmin</h2>
    <p class="th-not">Son 60 günün günlük değişimine bakılarak 30. gün için tahmin (yüzde puan). Örneklem kısa olduğundan güven düşüktür; bant geniştir. Yani: baraj bugünkü hızla değişirse bir ay sonra doluluk hangi aralıkta olur?</p>
    <table class="th-tablo">
      <thead><tr>
        <th>Havza</th>
        <th>Bugün (%)<span class="th-meal">son ölçülen ortalama doluluk</span></th>
        <th>Günlük değişim<span class="th-meal">doluluk günde kaç puan değişiyor</span></th>
        <th>30 gün sonra (tahmin)<span class="th-meal">bir ay sonra beklenen doluluk</span></th>
        <th>Olası bant (%80)<span class="th-meal">alt–üst sınır; değerin bu aralıkta kalması beklenir</span></th>
      </tr></thead>
      <tbody>
        {barajVar.sort((a: any, b: any) => a.baraj.egilim_gunluk_puan - b.baraj.egilim_gunluk_puan).map((k: any) => {
          const t30 = k.baraj.projeksiyon.find((p: any) => p.gun === 30) ?? k.baraj.projeksiyon[0];
          return (
            <tr>
              <td>{k.ad}</td>
              <td>{k.baraj.son_deger}</td>
              <td>{isaret(k.baraj.egilim_gunluk_puan)}{k.baraj.egilim_gunluk_puan}</td>
              <td>{t30.deger}</td>
              <td class="th-aralik">[{t30.alt80} … {t30.ust80}]</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>

  <p class="th-kaynak">
    Bu sayılar nasıl üretiliyor: geçmiş aylık değerlerden mevsim etkisi ayıklanır,
    en uygun düz çizgi çıkarılır ve değişimin tesadüf olup olmadığı test edilir;
    ayrıntılı yöntem aşağıdaki kapalı bölümdedir.
    Ham projeksiyon verisi: <a href="/veri/kuraklik.json">/veri/kuraklik.json</a> · üretim {tahmin.uretim}.
  </p>

  <details class="th-detay">
    <summary>Akademik ve Teknik Yöntem Detayları</summary>
    <div class="th-detay-ic">
      <p>
        Yöntem: mevsimsel ayrıştırma + en-küçük-kareler (OLS) trend + Mann-Kendall
        testi (numpy, sunucu dışı cron). Mann-Kendall anlamlılık eşiği p&lt;0,05.
        GRACE değeri NASA GRACE/GRACE-FO mascon verisidir; 2004–2009 ortalamasına
        göre <strong>değişimdir</strong> (mutlak su miktarı değil).
      </p>
      <p>
        Model tanımı ve varsayımlar:
        <a href="/api-dokumantasyonu/">API dokümantasyonu</a> · OpenAPI 3.1 şeması.
      </p>
    </div>
  </details>

  <nav class="th-capraz" aria-label="İlgili bölümler">
    <a href="/veri/iklim/">→ Havza iklim verisi (NASA POWER)</a>
    <a href="/veri/">→ Açık veri &amp; bilgi bankası</a>
    <a href="/su-riski-endeksi/">→ Su riski endeksi</a>
  </nav>

  <CtaBlok konu="Tahmin" baslik="Kurumunuz için havza projeksiyonu" metin="Seçili havza için aylık su depolama ve kuraklık projeksiyon raporu talep edin." />
  <HukukSerhi />
</Sayfa>

<style>
  .th-uyari { font-size: 0.9rem; color: var(--metin-soluk); max-width: 76ch; margin-bottom: 1.6rem; padding: 0.8rem 1rem; border-left: 3px solid #b45309; background: var(--zemin-kart); }
  .th-bolum { margin-bottom: 1.9rem; }
  .th-bolum h2 { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; margin-bottom: 0.5rem; }
  .th-not { font-size: 0.82rem; color: var(--metin-soluk); margin: 0 0 0.6rem; max-width: 76ch; }

  /* Sade dil turu 3 (04.10.2026 §57): üst sözlük kaldırıldı; teknik adlar
     yalnız sayfa sonundaki kapalı <details> içinde yaşar. */
  .th-detay { margin-top: 1rem; border: 1px solid var(--cizgi); background: var(--zemin-kart); }
  .th-detay summary { cursor: pointer; padding: 0.7rem 1rem; font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--metin-soluk); }
  .th-detay summary:focus-visible { outline: 2px solid var(--baglanti); outline-offset: 2px; }
  .th-detay-ic { padding: 0 1rem 0.9rem; font-size: 0.84rem; color: var(--metin-soluk); max-width: 76ch; }
  .th-detay-ic a { color: var(--baglanti); text-decoration: none; }
  .th-meal {
    display: block; margin-top: 0.18rem;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 0.66rem; font-weight: 400; letter-spacing: 0; text-transform: none;
    color: var(--metin-soluk); white-space: normal;
  }
  @media (max-width: 720px) { .th-detay summary { padding: 0.6rem 0.8rem; } }
  /* Mobil taşma onarımı (04.10.2026): 5 kolonlu tablo sarımsızdı. */
  .th-tablo { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  .th-tablo th, .th-tablo td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--cizgi); }
  .th-tablo th { font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--metin-soluk); }
  .th-tablo td:nth-child(n+2) { font-family: var(--mono); }
  .th-aralik { color: var(--metin-soluk); font-size: 0.78rem; }
  .th-kaynak { margin-top: 1rem; font-size: 0.84rem; color: var(--metin-soluk); max-width: 76ch; }
  .th-capraz { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-top: 1.4rem; padding-top: 1rem; border-top: 1px solid var(--cizgi); }
  .th-capraz a { color: var(--baglanti); text-decoration: none; }
</style>
