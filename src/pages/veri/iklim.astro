---
/* /veri/iklim/ — NASA POWER iklim verisi: 25 havza görünümü (04.10.2026).
   Kaynak NASA POWER (power.larc.nasa.gov, Langley/GMAO), KAMU MALI, anahtarsız.
   Değerler 1981-2010 klimatolojisidir; havza temsil noktası = poligon bbox
   merkezi. UYDURMA YOK: tüm sayılar data/canli/nasa-power.json'dan gelir. */
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import OzCevap from '../../components/OzCevap.astro';
import CtaBlok from '../../components/CtaBlok.astro';
import HukukSerhi from '../../components/HukukSerhi.astro';
import iklim from '../../../data/canli/nasa-power.json';
import { readFileSync } from 'node:fs';
import { DOI_URL, DOI_ATANDI } from '../../data/doi.js';

const havzalarGeo = JSON.parse(
  readFileSync('data/havzalar/havzalar-web.geojson', 'utf8'),
);

const h = Object.entries(iklim.havzalar)
  .filter(([, v]) => !v.hata)
  .map(([ad, v]) => ({
    ad,
    yagis: v.yagis_ann_mm_gun,
    yagisYil: Math.round(v.yagis_ann_mm_gun * 365),
    sicaklik: v.sicaklik_ann_c,
    nem: v.toprak_nemi_ann,
  }));

// HARİTA KATMANI (04.10.2026): 25 havza poligonu (data/havzalar/havzalar-web.geojson
// — DSİ havza sınırları, proje içi doğrulanmış geometri) yağış verisine göre
// renklendirilir (SVG choropleth, sunucu tarafında üretilir; JS yok).
let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
const gez = (c: any) => {
  if (typeof c[0] === 'number') { x0 = Math.min(x0, c[0]); x1 = Math.max(x1, c[0]); y0 = Math.min(y0, c[1]); y1 = Math.max(y1, c[1]); }
  else for (const p of c) gez(p);
};
for (const f of havzalarGeo.features) gez(f.geometry.coordinates);
const W = 760;
const H = Math.round((W * (y1 - y0)) / (x1 - x0) / Math.cos((39 * Math.PI) / 180));
const proj = (lon: number, lat: number): [number, number] =>
  [((lon - x0) / (x1 - x0)) * W, ((y1 - lat) / (y1 - y0)) * H];
const yolYap = (geom: any) => {
  const polyler = geom.type === 'Polygon' ? [geom.coordinates] : geom.coordinates;
  return polyler
    .flatMap((poly: any[]) =>
      poly.map((ring: any[]) =>
        ring.map(([lon, lat]: number[], i: number) => {
          const [px, py] = proj(lon, lat);
          return `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`;
        }).join(' ') + ' Z',
      ),
    )
    .join(' ');
};
const yagisMin = Math.min(...h.map((x) => x.yagis));
const yagisMax = Math.max(...h.map((x) => x.yagis));
const renk = (v: number) => {
  const t = yagisMax === yagisMin ? 0.5 : (v - yagisMin) / (yagisMax - yagisMin);
  const a = [36, 99, 235], b = [186, 230, 253];
  const c = a.map((ch, i) => Math.round(ch + (b[i] - ch) * t));
  return `rgb(${c[0]},${c[1]},${c[2]})`;
};
const harita = havzalarGeo.features.map((f: any) => {
  const ad = String(f.properties.ad || '').replace(' Havzası', '').trim();
  const kayit = h.find((x) => x.ad === ad);
  return { ad, d: yolYap(f.geometry), yagis: kayit?.yagis ?? null, renk: kayit ? renk(kayit.yagis) : '#e2e8f0' };
});

const ort = (arr, k) => arr.reduce((t, x) => t + x[k], 0) / arr.length;
const yy = (x) => Math.round(x * 100) / 100;
const ulusalYagis = yy(ort(h, 'yagis'));
const enYagisli = [...h].sort((a, b) => b.yagis - a.yagis).slice(0, 5);
const enKurak = [...h].sort((a, b) => a.yagis - b.yagis).slice(0, 5);
const enKuruToprak = [...h].sort((a, b) => a.nem - b.nem).slice(0, 5);

const OZ_CEVAP =
  `NASA POWER 1981-2010 klimatolojisine göre 25 su havzasında ortalama yağış ` +
  `günde ${ulusalYagis} mm (yılda ~${Math.round(ulusalYagis * 365)} mm). En yağışlı ` +
  `${enYagisli[0].ad} (${enYagisli[0].yagisYil} mm/yıl), en kurak ${enKurak[0].ad} ` +
  `(${enKurak[0].yagisYil} mm/yıl). Veri NASA POWER'dan derlenir; bu sayfa yayın ` +
  `anında hesaplanır, değer uydurulmaz.`;

const sema = [
  {
    '@type': 'Dataset',
    name: 'Türkiye 25 su havzası — NASA POWER iklim göstergeleri',
    description: OZ_CEVAP,
    creator: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' },
    publisher: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' },
    isBasedOn: 'https://power.larc.nasa.gov/',
    license: 'https://www.nasa.gov/nasa-brand-center/images-and-media/',
    isAccessibleForFree: true,
    inLanguage: 'tr-TR',
    spatialCoverage: { '@type': 'Place', name: 'Türkiye' },
    variableMeasured: ['Yağış (mm/gün)', '2 m hava sıcaklığı (°C)', 'Kök bölgesi toprak nemi'],
    ...(DOI_ATANDI
      ? {
          identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: DOI_URL },
          isPartOf: {
            '@type': 'Dataset',
            name: 'Su Haritası Açık Hidro-Legal Veri ve Mevzuat Platformu',
            url: DOI_URL,
          },
        }
      : {}),
  },
];
---
<Sayfa baslik="İklim verisi: 25 havzada yağış, sıcaklık ve toprak nemi" aciklama={OZ_CEVAP} tarayiciBaslik="Havza İklim Verisi: Yağış, Sıcaklık, Toprak Nemi" sema={sema}>
  <SayfaBasi etiket="Veri" baslik="İklim verisi: 25 havzada yağış, sıcaklık ve toprak nemi" ozet={`NASA POWER 1981-2010 klimatolojisi · ${h.length} havza · yayın anında hesaplandı.`} />
  <OzCevap metin={OZ_CEVAP} etiket="Özet" />

  <p class="ik-not">
    Bu tablo, <strong>NASA POWER</strong> (power.larc.nasa.gov — NASA Langley/GMAO,
    kamu malı) uydu/model-temelli klimatoloji verisinden <strong>otomatik</strong>
    derlenir. Havza başına bir temsil noktası (havza sınırı merkezi) kullanılır;
    değerler 1981-2010 ortalamasıdır. Hiçbir sayı elle yazılmamıştır; kaynak:
    <code>data/canli/nasa-power.json</code>.
  </p>

  <div class="ik-ozet">
    <div><span class="ik-buyuk">{ulusalYagis} mm/gün</span><span class="ik-etiket">Ulusal ortalama yağış</span></div>
    <div><span class="ik-buyuk">~{Math.round(ulusalYagis * 365)} mm/yıl</span><span class="ik-etiket">Yıllık yağış eşdeğeri</span></div>
    <div><span class="ik-buyuk">{yy(ort(h, 'sicaklik'))} °C</span><span class="ik-etiket">Ortalama sıcaklık</span></div>
  </div>

  <section class="ik-bolum">
    <h2>Havza haritası — yıllık yağış</h2>
    <p class="ik-not2">25 havza, NASA POWER yıllık yağışına göre renklendirilmiştir (açık = az, koyu = çok). Havza sınırları: DSİ havza geometrisi.</p>
    <svg class="ik-harita" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Türkiye 25 su havzası yıllık yağış haritası" preserveAspectRatio="xMidYMid meet">
      {harita.map((b) => (
        <path d={b.d} fill={b.renk} stroke="#0f172a" stroke-width="0.6">
          <title>{b.ad}{b.yagis != null ? ` — ${Math.round(b.yagis * 365)} mm/yıl` : ''}</title>
        </path>
      ))}
    </svg>
    <div class="ik-lejant">
      <span>{Math.round(yagisMin * 365)} mm/yıl</span>
      <span class="ik-skala" aria-hidden="true"></span>
      <span>{Math.round(yagisMax * 365)} mm/yıl</span>
    </div>
  </section>

  <section class="ik-bolum">
    <h2>En yağışlı 5 havza</h2>
    <ol class="ik-liste">
      {enYagisli.map((x) => (
        <li><span class="ik-ad">{x.ad}</span> <span class="ik-deger">{x.yagisYil} mm/yıl</span></li>
      ))}
    </ol>
  </section>

  <section class="ik-bolum">
    <h2>En kurak 5 havza</h2>
    <ol class="ik-liste">
      {enKurak.map((x) => (
        <li><span class="ik-ad">{x.ad}</span> <span class="ik-deger">{x.yagisYil} mm/yıl</span></li>
      ))}
    </ol>
  </section>

  <section class="ik-bolum">
    <h2>Toprak nemi en düşük 5 havza</h2>
    <p class="ik-not2">Kök bölgesi toprak nemi (0-1); düşük değer kuraklık eğilimine işaret eder.</p>
    <ol class="ik-liste">
      {enKuruToprak.map((x) => (
        <li><span class="ik-ad">{x.ad}</span> <span class="ik-deger">{yy(x.nem)}</span></li>
      ))}
    </ol>
  </section>

  <section class="ik-bolum">
    <h2>Tüm havzalar</h2>
    <div class="ik-tablo-sar">
      <table class="ik-tablo">
        <thead><tr><th>Havza</th><th>Yağış (mm/yıl)</th><th>Sıcaklık (°C)</th><th>Toprak nemi</th></tr></thead>
        <tbody>
          {[...h].sort((a, b) => b.yagis - a.yagis).map((x) => (
            <tr><td>{x.ad}</td><td>{x.yagisYil}</td><td>{yy(x.sicaklik)}</td><td>{yy(x.nem)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <p class="ik-kaynak">Kaynak: NASA POWER (power.larc.nasa.gov) · Lisans: kamu malı (NASA) · Dönem: 1981-2010 klimatolojisi · Bu sayfa yayın anında hesaplanır.</p>

  <nav class="ik-capraz" aria-label="İlgili bölümler">
    <a href="/veri/">→ Açık veri &amp; bilgi bankası</a>
    <a href="/veri/hikaye/baraj-doluluk/">→ Baraj doluluk verisi</a>
    <a href="/su-riski-endeksi/">→ Su riski endeksi</a>
  </nav>

  <CtaBlok konu="İklim verisi" baslik="Bu veriyi kurumunuz için raporlayalım" metin="Seçili havza için yağış, sıcaklık ve toprak nemi temelli iklim raporu talep edin." />
  <HukukSerhi />
</Sayfa>

<style>
  .ik-not { font-size: 0.9rem; color: var(--metin-soluk); max-width: 74ch; margin-bottom: 1.4rem; }
  .ik-not code { font-family: var(--mono); font-size: 0.8rem; }
  .ik-not2 { font-size: 0.82rem; color: var(--metin-soluk); margin: 0 0 0.5rem; }
  .ik-ozet { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.8rem; margin-bottom: 1.8rem; }
  .ik-ozet > div { padding: 0.9rem 1rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); border-left: 3px solid var(--su-400); display: flex; flex-direction: column; gap: 0.2rem; }
  .ik-buyuk { font-family: var(--serif); font-size: 1.5rem; }
  .ik-etiket { font-size: 0.78rem; color: var(--metin-soluk); }
  .ik-bolum { margin-bottom: 1.8rem; }
  .ik-bolum h2 { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; margin-bottom: 0.6rem; }
  .ik-liste { list-style: none; padding: 0; display: grid; gap: 0.35rem; max-width: 40rem; }
  .ik-liste li { display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem; padding: 0.45rem 0.7rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); border-left: 3px solid var(--su-400); }
  .ik-ad { font-family: var(--serif); font-size: 1rem; }
  .ik-deger { font-family: var(--mono); font-weight: 600; color: var(--su-700); }
  .ik-tablo-sar { overflow-x: auto; }
  .ik-tablo { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .ik-tablo th, .ik-tablo td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--cizgi); }
  .ik-tablo th { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--metin-soluk); }
  .ik-tablo td:nth-child(n+2) { font-family: var(--mono); }
  .ik-harita { width: 100%; max-width: 640px; height: auto; display: block; background: var(--zemin-kart); border: 1px solid var(--cizgi); }
  .ik-harita path { transition: opacity 0.15s ease; }
  .ik-harita path:hover { opacity: 0.75; }
  .ik-lejant { display: flex; align-items: center; gap: 0.6rem; max-width: 640px; margin-top: 0.5rem; font-family: var(--mono); font-size: 0.72rem; color: var(--metin-soluk); }
  .ik-skala { flex: 1; height: 0.6rem; border: 1px solid var(--cizgi); background: linear-gradient(90deg, rgb(36,99,235), rgb(186,230,253)); }
  .ik-kaynak { margin-top: 1rem; font-size: 0.84rem; color: var(--metin-soluk); max-width: 74ch; }
  .ik-capraz { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-top: 1.4rem; padding-top: 1rem; border-top: 1px solid var(--cizgi); }
  .ik-capraz a { color: var(--baglanti); text-decoration: none; }
</style>
