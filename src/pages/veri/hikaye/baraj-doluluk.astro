---
// /veri/hikaye/baraj-doluluk/ — İLK OTONOM VERİ ANALİZ HİKÂYESİ (13.09.2026).
// Baraj doluluk verisinden (EPİAŞ, günlük) otomatik hesaplanır. Uydurma yok.
import Sayfa from '../../../layouts/Sayfa.astro';
import SayfaBasi from '../../../components/SayfaBasi.astro';
import OzCevap from '../../../components/OzCevap.astro';
import CtaBlok from '../../../components/CtaBlok.astro';
import HukukSerhi from '../../../components/HukukSerhi.astro';
import baraj from '../../../../data/canli/baraj.json';

// Havza bazlı: en son ortalama doluluk + 30 gün önceki ortalama
function havzaSeri(ad, h) {
  const gunluk = {};
  for (const b of Object.values(h.barajlar || {})) {
    for (const [gun, v] of Object.entries(b.seri || {})) {
      if (v && v.doluluk != null) (gunluk[gun] = gunluk[gun] || []).push(v.doluluk);
    }
  }
  const gunler = Object.keys(gunluk).sort();
  const ort = (arr) => (arr.length ? arr.reduce((t, v) => t + v, 0) / arr.length : null);
  const son = gunler.at(-1);
  const oncekiGun = gunler.at(-31);
  return {
    ad, sonGun: son,
    son: son ? ort(gunluk[son]) : null,
    onceki: oncekiGun ? ort(gunluk[oncekiGun]) : null,
    barajSayisi: Object.keys(h.barajlar || {}).length,
  };
}
const havzalar = Object.entries(baraj.havzalar || {}).map(([ad, h]) => havzaSeri(ad, h)).filter((h) => h.son != null);
const yuvarla = (x) => (x == null ? null : Math.round(x * 10) / 10);
const ulusalSon = yuvarla(havzalar.reduce((t, h) => t + h.son, 0) / havzalar.length);
const enDolu = [...havzalar].sort((a, b) => b.son - a.son).slice(0, 5);
const enBos = [...havzalar].sort((a, b) => a.son - b.son).slice(0, 5);
const sonGun = havzalar[0]?.sonGun ?? '—';

const OZ_CEVAP =
  `EPİAŞ günlük verisine göre ${sonGun} itibarıyla izlenen havzalarda ortalama baraj doluluğu ` +
  `%${ulusalSon}. En dolu havza ${enDolu[0]?.ad} (%${yuvarla(enDolu[0]?.son)}), en düşük ${enBos[0]?.ad} (%${yuvarla(enBos[0]?.son)}). ` +
  `Veri EPİAŞ Şeffaflık Platformu’ndan günlük derlenir; bu sayfa otomatik hesaplanır.`;
---
<Sayfa baslik="Baraj doluluk verisi: havza görünümü" aciklama={OZ_CEVAP} tarayiciBaslik="Baraj Doluluk 2026: Havza Bazında Görünüm" sema={[{ '@type': 'Dataset', name: 'Baraj doluluk havza görünümü', description: OZ_CEVAP, creator: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' }, isAccessibleForFree: true, inLanguage: 'tr-TR' }]}>
  <SayfaBasi etiket="Veri hikâyesi" baslik="Baraj doluluk verisi: havza görünümü" ozet={`EPİAŞ günlük verisi · son ölçüm ${sonGun} · otomatik hesaplandı.`} ozCevap />
  <OzCevap metin={OZ_CEVAP} etiket="Özet" />

  <p class="hy-not">Bu analiz, EPİAŞ Şeffaflık Platformu’ndan günlük derlenen baraj doluluk verisinden <strong>otomatik</strong> hesaplanır. Hiçbir sayı elle yazılmamıştır; kaynak: <code>data/canli/baraj.json</code>.</p>

  <section class="hy-bolum">
    <h2>En dolu 5 havza (% doluluk)</h2>
    <ol class="hy-liste">{enDolu.map((h) => (
      <li><span class="hy-ad">{h.ad}</span> <span class="hy-deger">%{yuvarla(h.son)}</span> <span class="hy-not2">{h.barajSayisi} baraj</span></li>
    ))}</ol>
  </section>

  <section class="hy-bolum">
    <h2>En düşük doluluklu 5 havza (% doluluk)</h2>
    <ol class="hy-liste">{enBos.map((h) => (
      <li><span class="hy-ad">{h.ad}</span> <span class="hy-deger">%{yuvarla(h.son)}</span> <span class="hy-not2">{h.barajSayisi} baraj</span></li>
    ))}</ol>
  </section>

  <section class="hy-bolum">
    <h2>30 günlük değişim (son − 30 gün önce)</h2>
    <ul class="hy-liste">
      {havzalar.filter((h) => h.onceki != null).map((h) => ({ ...h, fark: yuvarla(h.son - h.onceki) })).sort((a, b) => a.fark - b.fark).map((h) => (
        <li><span class="hy-ad">{h.ad}</span> <span class={`hy-fark ${h.fark < 0 ? 'hy-dus' : 'hy-art'}`}>{h.fark > 0 ? '+' : ''}{h.fark} puan</span></li>
      ))}
    </ul>
  </section>

  <p class="hy-kaynak">Kaynak: EPİAŞ Şeffaflık Platformu (seffaflik.epias.com.tr) · Derleme: Su Haritası günlük cron · Bu sayfa yayın anında hesaplanır. Yöntem: <a href="/hakkinda/">kaynak politikası</a>.</p>

  <nav class="hy-capraz" aria-label="İlgili bölümler">
    <a href="/veri/gundem/">→ Veri gündemi</a>
    <a href="/su-riski-endeksi/">→ Su riski endeksi</a>
    <a href="/veri/">→ Açık veri kataloğu</a>
  </nav>

  <CtaBlok konu="Su verisi" baslik="Bu veriyi kurumunuz için raporlayalım" metin="Seçili il/havza için aylık baraj doluluk ve su riski raporu talep edin." />
  <HukukSerhi />
</Sayfa>

<style>
  .hy-not { font-size: 0.9rem; color: var(--metin-soluk); max-width: 74ch; margin-bottom: 1.4rem; }
  .hy-bolum { margin-bottom: 1.8rem; }
  .hy-bolum h2 { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; margin-bottom: 0.6rem; }
  .hy-liste { list-style: none; padding: 0; display: grid; gap: 0.35rem; max-width: 40rem; }
  .hy-liste li { display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem; padding: 0.45rem 0.7rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); border-left: 3px solid var(--su-400); }
  .hy-ad { font-family: var(--serif); font-size: 1rem; }
  .hy-deger { font-family: var(--mono); font-weight: 600; color: var(--su-700); }
  .hy-not2 { font-size: 0.78rem; color: var(--metin-soluk); }
  .hy-fark { font-family: var(--mono); font-size: 0.82rem; }
  .hy-dus { color: #8a1f17; } .hy-art { color: #146b39; }
  .hy-kaynak { margin-top: 1rem; font-size: 0.84rem; color: var(--metin-soluk); max-width: 74ch; }
  .hy-capraz { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-top: 1.4rem; padding-top: 1rem; border-top: 1px solid var(--cizgi); }
  .hy-capraz a { color: var(--baglanti); text-decoration: none; }
</style>
