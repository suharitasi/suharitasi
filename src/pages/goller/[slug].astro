---
// Göl detay sayfası: /goller/[slug]/
// Veri kaynağı: tr-goller.json (OSM + Natural Earth hibrit, erişim 04.08.2026).
// 24.08.2026 (agustos-uyum M4+M5): aksansız şablon Türkçesi düzeltildi;
// verisiz dolgu cümlesi ("su zenginliğinin parçası") KALDIRILDI; künyeye
// kapsam+erişim+lisans eklendi; il/havza iç bağları geometrik eşlemeden
// (gol-nehir-cografya.js) kuruldu; ölçek şerhi (dürüstlük etiketi) eklendi.
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import { TARIH } from '../../data/guncellik.js';
import OzCevap from '../../components/OzCevap.astro';
import Katman from '../../components/Katman.astro';
import { tumGoller, golOzet, golTipi, golTurSerhi,
         GOLNEHIR_ERISIM, GOLNEHIR_KAPSAM_GOL, GOLNEHIR_LISANS, kaynakBagi } from '../../data/gol-nehir.js';

export async function getStaticPaths() {
  return tumGoller().map((g) => ({ params: { slug: g.slug }, props: { gol: g } }));
}

const { gol } = Astro.props;
const ozet = golOzet(gol);
const tur = golTipi(gol);
// Faz E (08.09.2026): tür şerhi — yerel düzeltme dayanağı ya da kaynak çelişkisi.
const turSerhi = golTurSerhi(gol);
const il = gol.cografya.il;
const havza = gol.cografya.havzalar[0] ?? null;

const sayi = (n, o) =>
  n?.toLocaleString('tr-TR', { minimumFractionDigits: o, maximumFractionDigits: o });

// Schema.org BodyOfWater + FAQPage — her alan veriden.
const sema = [{
  '@type': 'BodyOfWater',
  name: gol.ad,
  description: ozet,
  geo: { '@type': 'GeoCoordinates', latitude: gol.merkez[1], longitude: gol.merkez[0] },
  additionalProperty: [
    ...(gol.alan_km2 != null
      ? [{ '@type': 'PropertyValue', name: 'Yüzey alanı (km²)', value: gol.alan_km2 }] : []),
    { '@type': 'PropertyValue', name: 'Veri kaynağı', value: gol.kaynak },
    ...(gol.tip_duzeltme
      ? [{ '@type': 'PropertyValue', name: 'Tür kaynağı', value: gol.tip_duzeltme.kaynak }] : []),
  ],
  containedInPlace: { '@type': 'Place', name: il ? `${il.ad}, Türkiye` : 'Türkiye' },
}, {
  '@type': 'FAQPage',
  // Damga (25.08.2026): OSM/Natural Earth çekim tarihi (gol-nehir.js künyesi).
  ...(TARIH.golNehir ? { dateModified: TARIH.golNehir } : {}),
  mainEntity: [{
    '@type': 'Question',
    name: `${gol.ad} nerede, yüzey alanı ne kadar?`,
    acceptedAnswer: { '@type': 'Answer', text: ozet },
  }],
}];
---

<Sayfa baslik={`${gol.ad} — Türkiye Gölleri`} aciklama={ozet} sema={sema}>
  <SayfaBasi etiket="Göl" baslik={gol.ad} tarih={TARIH.golNehir ? new Date(TARIH.golNehir) : undefined} />

  <OzCevap metin={ozet} />

  <Katman baslik="Göl profili" ipucu={`${tur.ad.toLowerCase()} · koordinat · yüzey alanı`}>
    <dl class="kunye kunye-katman">
      <div class="kunye-satir">
        <dt>Tür</dt>
        <dd>{tur.ad}{gol.tip == null && !gol.tip_celiski && ' (veri türü belirtilmemiş)'}{turSerhi && <> — <span class="not">{turSerhi}</span></>}</dd>
      </div>
      {gol.alan_km2 != null && (
        <div class="kunye-satir">
          <dt>Yüzey alanı</dt>
          <dd>{sayi(gol.alan_km2, 1)} km²</dd>
        </div>
      )}
      <div class="kunye-satir">
        <dt>Koordinat</dt>
        <dd>{gol.merkez[1].toFixed(4)}°K, {gol.merkez[0].toFixed(4)}°D</dd>
      </div>
      {il && (
        <div class="kunye-satir">
          <dt>İl</dt>
          <dd><a href={`/kuyu-ruhsati/${il.slug}/`}>{il.ad}</a></dd>
        </div>
      )}
      {havza && (
        <div class="kunye-satir">
          <dt>Havza</dt>
          <dd><a href={`/havzalar/${havza.slug}/`}>{havza.ad}</a></dd>
        </div>
      )}
    </dl>
  </Katman>

  <Katman baslik="Konum ve ölçek şerhi" ipucu="yaklaşık merkez · geometrik eşleme · bilgi amaçlıdır" ton="murekkep">
    <p class="not">
      Koordinat, gölün sınır kutusunun geometrik merkezidir; hidrografik
      referans veya ölçüm noktası DEĞİLDİR. İl ve havza eşlemesi göl
      geometrisinin örneklenmiş noktalarından türetilmiştir; göl birden çok
      il veya havzaya taşabilir — idari/hidrografik tescil yerine geçmez.
    </p>
    <p class="not">
      {il && havza && (
        <>İlgili resmî veriler: <a href={`/kuyu-ruhsati/${il.slug}/`}>{il.ad} kuyu
        ruhsatı ve yetkili merci</a> · <a href={`/havzalar/${havza.slug}/`}>{havza.ad}{' '}
        rezerv ve doluluk verisi</a> · </>
      )}
      <a href="/nerede-su-cikar/">ilinizin su potansiyeli</a>
      {/* C6b (08.09.2026): yalnız baraj gölü (OSM tip=reservoir) sayfalarında,
          konuyla birebir ilgili rehbere bağ — ölçüm: göl→rehber içerik
          bağlantısı 0/247; baraj-kamulastirmasi rehberinin gelen bağlantısı
          2 (en düşük), coğrafyadan 0. Doğal göl/gölet/lagünde eklenmez. */}
      {gol.tip === 'reservoir' && (
        <> · <a href="/rehberler/baraj-kamulastirmasi/">baraj kamulaştırması rehberi</a></>
      )}.
    </p>
  </Katman>

  <p class="veri-kunyesi">
    {/* K19 (27.08): kaynak adı artık resmî adresine bağlanıyor;
        adres bilinmiyorsa düz metin kalır (uydurma yasağı). */}
    {gol.ad_kaynakta && gol.ad_kaynakta !== gol.ad && (
      <>Kaynaktaki tam ad: {gol.ad_kaynakta}. </>
    )}
    Veri künyesi: {kaynakBagi(gol.kaynak)
      ? <a href={kaynakBagi(gol.kaynak)} rel="nofollow noopener" target="_blank">{gol.kaynak}</a>
      : gol.kaynak} — kapsam: {GOLNEHIR_KAPSAM_GOL}; erişim
    {' '}{GOLNEHIR_ERISIM}. {GOLNEHIR_LISANS}. Bu sayfa hukuki görüş değildir.
  </p>
</Sayfa>

<style>
  .kunye {
    margin: 0 0 2rem;
    padding: 1.3rem 1.4rem 1.3rem 1.8rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
    position: relative;
  }
  .kunye::before {
    content: "";
    position: absolute;
    left: 0.6rem;
    top: 1rem;
    bottom: 1rem;
    width: 6px;
    background:
      repeating-linear-gradient(180deg,
        rgba(46, 126, 160, 0.4) 0 1px, transparent 1px 7px),
      linear-gradient(90deg, rgba(46, 126, 160, 0.4) 0 1px, transparent 1px);
  }
  .kunye-katman {
    margin: 0;
    padding: 0.4rem 0 0;
    background: transparent;
    border: 0;
  }
  .kunye-katman::before { display: none; }
  .kunye-satir {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 0.4rem 1.2rem;
    padding: 0.5rem 0;
  }
  .kunye-satir + .kunye-satir { border-top: 1px solid var(--cizgi); }
  dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    align-self: center;
  }
  dd { font-size: 0.96rem; }
  dd a { color: var(--baglanti, var(--su-700)); }
  .not {
    font-size: 0.9rem;
    color: var(--metin-soluk);
    margin: 0.6rem 0;
  }
  .not a { color: var(--baglanti, var(--su-700)); }
  .veri-kunyesi {
    font-size: 0.8rem;
    color: var(--metin-soluk);
    margin: 1.2rem 0 0;
  }
  @media (max-width: 560px) {
    .kunye-satir { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
