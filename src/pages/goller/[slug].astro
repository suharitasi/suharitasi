---
// Gol detay sayfasi: /goller/[slug]/
// Veri kaynagi: tr-goller.json (OSM + Natural Earth hibrit)
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import OzCevap from '../../components/OzCevap.astro';
import Katman from '../../components/Katman.astro';
import { tumGoller, golOzet } from '../../data/gol-nehir.js';
import { OG_GORSEL } from '../../data/site';

export async function getStaticPaths() {
  return tumGoller().map((g) => ({ params: { slug: g.slug }, props: { gol: g } }));
}

const { gol } = Astro.props;
const ozet = golOzet(gol);

const sayi = (n, o) =>
  n?.toLocaleString('tr-TR', { minimumFractionDigits: o, maximumFractionDigits: o });

// Tur tanimi
const turMetni = (gol.tip === 'reservoir' || gol.ad.includes('Baraj'))
  ? 'Baraj golu'
  : gol.tip === 'lagoon' ? 'Lagun' : 'Dogal gol';

// Schema.org Place / BodyOfWater JSON-LD
const sema = [{
  '@type': 'BodyOfWater',
  name: gol.ad,
  description: ozet,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: gol.merkez[1],
    longitude: gol.merkez[0],
  },
  additionalProperty: gol.alan_km2 != null ? [
    { '@type': 'PropertyValue', name: 'Yuzey alani (km²)', value: gol.alan_km2 },
    { '@type': 'PropertyValue', name: 'Veri kaynagi', value: gol.kaynak },
  ] : [
    { '@type': 'PropertyValue', name: 'Veri kaynagi', value: gol.kaynak },
  ],
  containedInPlace: {
    '@type': 'Place',
    name: 'Turkiye',
  },
}];

// FAQPage — golun temel sorusu
sema.push({
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: `${gol.ad} nerede, yuzey alani ne kadar?`,
    acceptedAnswer: { '@type': 'Answer', text: ozet },
  }],
});
---

<Sayfa baslik={`${gol.ad} — Turkiye Golleri`} aciklama={ozet} sema={sema}>
  <SayfaBasi etiket="Gol" baslik={gol.ad} />

  <OzCevap metin={ozet} />

  <Katman baslik="Gol profili" ipucu={`${turMetni} · koordinat · yuzey alani`}>
    <dl class="kunye kunye-katman">
      <div class="kunye-satir">
        <dt>Tur</dt>
        <dd>{turMetni}</dd>
      </div>
      {gol.alan_km2 != null && (
        <div class="kunye-satir">
          <dt>Yuzey alani</dt>
          <dd>{sayi(gol.alan_km2, 1)} km²</dd>
        </div>
      )}
      <div class="kunye-satir">
        <dt>Koordinat</dt>
        <dd>{gol.merkez[1].toFixed(4)}°N, {gol.merkez[0].toFixed(4)}°E</dd>
      </div>
      <div class="kunye-satir">
        <dt>Veri kaynagi</dt>
        <dd>{gol.kaynak}</dd>
      </div>
    </dl>
  </Katman>

  <Katman baslik="Konum" ipucu="yaklasik merkez koordinati · bilgi amaclidir" ton="murekkep">
    <p class="not">
      Bu sayfadaki koordinat, golun geometrik merkezidir; hidrografik referans
      veya olcum noktasi DEGILDIR. Harita uzerinde tam gol siniri icin
      OpenStreetMap / Natural Earth verisine basvurunuz.
    </p>
    <p class="not">
      Bu gol Turkiye'nin su zenginliginin bir parcasidir.
      <a href="/havzalar/">Havza sayfalarimizda</a> bolgenizdeki su potansiyeli,
      baraj doluluklari ve su hukuku ile ilgili resmi verileri bulabilirsiniz.
    </p>
  </Katman>
</Sayfa>

<style>
  .kunye {
    margin: 0 0 2rem;
    padding: 1.3rem 1.4rem 1.3rem 1.8rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
    position: relative;
  }
  .kunye::before {
    content: "";
    position: absolute;
    left: 0.6rem;
    top: 1rem;
    bottom: 1rem;
    width: 6px;
    background:
      repeating-linear-gradient(180deg,
        rgba(46, 126, 160, 0.4) 0 1px, transparent 1px 7px),
      linear-gradient(90deg, rgba(46, 126, 160, 0.4) 0 1px, transparent 1px);
  }
  .kunye-katman {
    margin: 0;
    padding: 0.4rem 0 0;
    background: transparent;
    border: 0;
  }
  .kunye-katman::before { display: none; }
  .kunye-satir {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 0.4rem 1.2rem;
    padding: 0.5rem 0;
  }
  .kunye-satir + .kunye-satir { border-top: 1px solid var(--cizgi); }
  dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    align-self: center;
  }
  dd { font-size: 0.96rem; }
  .not {
    font-size: 0.9rem;
    color: var(--metin-soluk);
    margin: 0.6rem 0;
  }
  .not a { color: var(--baglanti); }
  @media (max-width: 560px) {
    .kunye-satir { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
