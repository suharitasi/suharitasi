---
// Göl detay sayfası: /goller/[slug]/
// Veri kaynağı: tr-goller.json (OSM + Natural Earth hibrit, erişim 04.08.2026).
// 24.08.2026 (agustos-uyum M4+M5): aksansız şablon Türkçesi düzeltildi;
// verisiz dolgu cümlesi ("su zenginliğinin parçası") KALDIRILDI; künyeye
// kapsam+erişim+lisans eklendi; il/havza iç bağları geometrik eşlemeden
// (gol-nehir-cografya.js) kuruldu; ölçek şerhi (dürüstlük etiketi) eklendi.
import Sayfa from '../../layouts/Sayfa.astro';
import { tumIlProfilleri } from '../../data/il-profil.js';
import SayfaBasi from '../../components/SayfaBasi.astro';
import { TARIH } from '../../data/guncellik.js';
import OzCevap from '../../components/OzCevap.astro';
import Katman from '../../components/Katman.astro';
import GeoOnizleme from '../../components/GeoOnizleme.astro';
import GeoDisaAktar from '../../components/GeoDisaAktar.astro';
// eeat-audit (27.09.2026): yazar kutusu göl sayfalarına bağlandı.
import YazarKutusu from '../../components/YazarKutusu.astro';
import { tumGoller, golOzet, golTipi, golTurSerhi,
         GOLNEHIR_ERISIM, GOLNEHIR_KAPSAM_GOL, GOLNEHIR_LISANS, kaynakBagi } from '../../data/gol-nehir.js';

export async function getStaticPaths() {
  return tumGoller().map((g) => ({ params: { slug: g.slug }, props: { gol: g } }));
}

const { gol } = Astro.props;
const ozet = golOzet(gol);
const tur = golTipi(gol);
// Faz E (08.09.2026): tür şerhi — yerel düzeltme dayanağı ya da kaynak çelişkisi.
const turSerhi = golTurSerhi(gol);
const il = gol.cografya.il;
const dsiBolge = il ? (tumIlProfilleri().find((x) => x.slug === il.slug)?.dsiBolgeleri ?? []) : [];
const havza = gol.cografya.havzalar[0] ?? null;
// P2 (24.09.2026): aynı havzadaki diğer göller (en çok 2) — statik iç link.
const kardesGoller = havza
  ? tumGoller()
      .filter((x) => x.slug !== gol.slug && x.cografya.havzalar.some((h) => h.slug === havza.slug))
      .slice(0, 2)
  : [];
const kok = new URL('/', Astro.site).href;

const sayi = (n, o) =>
  n?.toLocaleString('tr-TR', { minimumFractionDigits: o, maximumFractionDigits: o });

// C1 (V5, 10.09.2026): <title> arama niyetiyle hizalanır. H1 ve og:title
// DEĞİŞMEZ (baslik korunur). Uzun göl adlarında 60 karakter bütçesi aşılınca
// "Haritası" kelimesi düşer (title bütünlüğü; build düşmez).
const tamBaslik = `${gol.ad} Nerede? Konumu, Haritası ve Özellikleri`;
const tarayiciBaslik = tamBaslik.length <= 60 ? tamBaslik : `${gol.ad} Nerede? Konumu ve Özellikleri`;
if (tarayiciBaslik.length > 60)
  throw new Error(`göl "${gol.slug}": title ${tarayiciBaslik.length} karakter (>60)`);

// C5 (V5): FAQ soruları ölçülen sorgu kalıplarına ("nerede", "yüzey alanı")
// ayrıştırılır; her cevap veriden. "kapalı havza mı" sorusu VERİSİZ olduğundan
// eklenmez (uydurma yasağı).
const konumCevabi = `${gol.ad} ${il ? `${il.ad} ili sınırlarındadır` : 'Türkiye sınırları içindedir'} (merkez koordinatı ${gol.merkez[1].toFixed(4)}°K, ${gol.merkez[0].toFixed(4)}°D).`;
const alanCevabi = gol.alan_km2 != null
  ? `${gol.ad} yaklaşık ${gol.alan_km2.toLocaleString('tr-TR')} km² yüzey alanına sahiptir.`
  : `${gol.ad} için yüzey alanı verisi kaynakta yer almıyor.`;

// P2 (24.09.2026): SSS soruları TEK kaynak — hem görünür gövde (semantik HTML)
// hem JSON-LD FAQPage aynı diziden beslenir. Cevap metni veriden; yeni iddia yok.
const sssSorular = [{
  '@type': 'Question',
  name: `${gol.ad} nerededir?`,
  acceptedAnswer: { '@type': 'Answer', text: konumCevabi },
}, {
  '@type': 'Question',
  name: `${gol.ad} yüzey alanı ne kadar?`,
  acceptedAnswer: { '@type': 'Answer', text: alanCevabi },
}];

// Schema.org BodyOfWater + FAQPage — her alan veriden.
const sema = [{
  '@type': 'BodyOfWater',
  name: gol.ad,
  description: ozet,
  // C3 (V5): merkez GeoCoordinates + bbox GeoShape (çokgen).
  geo: [
    { '@type': 'GeoCoordinates', latitude: gol.merkez[1], longitude: gol.merkez[0] },
    { '@type': 'GeoShape', box: `${gol.bbox[1]} ${gol.bbox[0]} ${gol.bbox[3]} ${gol.bbox[2]}` },
  ],
  additionalProperty: [
    ...(gol.alan_km2 != null
      ? [{ '@type': 'PropertyValue', name: 'Yüzey alanı (km²)', value: gol.alan_km2 }] : []),
    { '@type': 'PropertyValue', name: 'Veri kaynağı', value: gol.kaynak },
    ...(gol.tip_duzeltme
      ? [{ '@type': 'PropertyValue', name: 'Tür kaynağı', value: gol.tip_duzeltme.kaynak }] : []),
  ],
  containedInPlace: { '@type': 'Place', name: il ? `${il.ad}, Türkiye` : 'Türkiye' },
}, {
  '@type': 'FAQPage',
  // Damga (25.08.2026): OSM/Natural Earth çekim tarihi (gol-nehir.js künyesi).
  ...(TARIH.golNehir ? { dateModified: TARIH.golNehir } : {}),
  // C3 (V5): FAQPage CreativeWork'tür — publisher + license burada geçerli.
  publisher: { '@id': `${kok}#kurum` },
  license: GOLNEHIR_LISANS,
  mainEntity: sssSorular,
}];
---

<Sayfa baslik={`${gol.ad} — Türkiye Gölleri`} tarayiciBaslik={tarayiciBaslik} aciklama={ozet} sema={sema}>
  <SayfaBasi etiket="Göl" baslik={gol.ad} tarih={TARIH.golNehir ? new Date(TARIH.golNehir) : undefined} />

  <OzCevap metin={ozet} etiket="Özet bilgi" />

  <GeoOnizleme geometry={gol.geometry} bbox={gol.bbox} ad={gol.ad} tur="gol" havza={havza} />

  <GeoDisaAktar slug={gol.slug} ad={gol.ad} tur="gol" merkez={gol.merkez} kaynak={gol.kaynak} />

  <Katman baslik="Göl profili" ipucu={`${tur.ad.toLowerCase()} · koordinat · yüzey alanı`}>
    <dl class="kunye kunye-katman">
      <div class="kunye-satir">
        <dt>Tür</dt>
        <dd>{tur.ad}{gol.tip == null && !gol.tip_celiski && ' (veri türü belirtilmemiş)'}{turSerhi && <> — <span class="not">{turSerhi}</span></>}</dd>
      </div>
      {gol.alan_km2 != null && (
        <div class="kunye-satir">
          <dt>Yüzey alanı</dt>
          <dd><data value={gol.alan_km2}>{sayi(gol.alan_km2, 1)} km²</data></dd>
        </div>
      )}
      <div class="kunye-satir">
        <dt>Koordinat</dt>
        <dd><data value={`${gol.merkez[1].toFixed(4)},${gol.merkez[0].toFixed(4)}`}>{gol.merkez[1].toFixed(4)}°K, {gol.merkez[0].toFixed(4)}°D</data></dd>
      </div>
      {il && (
        <div class="kunye-satir">
          <dt>İl</dt>
          <dd><a href={`/kuyu-ruhsati/${il.slug}/`}>{il.ad}</a></dd>
        </div>
      )}
      {havza && (
        <div class="kunye-satir">
          <dt>Havza</dt>
          <dd><a href={`/havzalar/${havza.slug}/`}>{havza.ad}</a></dd>
        </div>
      )}
      {dsiBolge.length > 0 && (
        <div class="kunye-satir">
          <dt>İdari Yetki Mercii</dt>
          <dd>{dsiBolge.map((b) => `DSİ ${b.no}. Bölge Müdürlüğü (${b.merkez})`).join(' · ')}</dd>
        </div>
      )}
    </dl>
  </Katman>

  <Katman baslik="Konum ve ölçek şerhi" ipucu="yaklaşık merkez · geometrik eşleme · bilgi amaçlıdır" ton="murekkep">
    <p class="not">
      Koordinat, gölün sınır kutusunun geometrik merkezidir; hidrografik
      referans veya ölçüm noktası DEĞİLDİR. İl ve havza eşlemesi göl
      geometrisinin örneklenmiş noktalarından türetilmiştir; göl birden çok
      il veya havzaya taşabilir — idari/hidrografik tescil yerine geçmez.
    </p>
    <p class="not">
      {il && havza && (
        <>İlgili resmî veriler: <a href={`/kuyu-ruhsati/${il.slug}/`}>{il.ad} kuyu
        ruhsatı ve yetkili merci</a> · <a href={`/havzalar/${havza.slug}/`}>{havza.ad}{' '}
        rezerv ve doluluk verisi</a> · </>
      )}
      <a href="/nerede-su-cikar/">ilinizin su potansiyeli</a>
      {/* C6b (08.09.2026): yalnız baraj gölü (OSM tip=reservoir) sayfalarında,
          konuyla birebir ilgili rehbere bağ — ölçüm: göl→rehber içerik
          bağlantısı 0/247; baraj-kamulastirmasi rehberinin gelen bağlantısı
          2 (en düşük), coğrafyadan 0. Doğal göl/gölet/lagünde eklenmez. */}
      {gol.tip === 'reservoir' && (
        <> · <a href="/rehberler/baraj-kamulastirmasi/">baraj kamulaştırması rehberi</a></>
      )}.
    </p>
  </Katman>

  <p class="veri-kunyesi">
    {/* K19 (27.08): kaynak adı artık resmî adresine bağlanıyor;
        adres bilinmiyorsa düz metin kalır (uydurma yasağı). */}
    {gol.ad_kaynakta && gol.ad_kaynakta !== gol.ad && (
      <>Kaynaktaki tam ad: {gol.ad_kaynakta}. </>
    )}
    Veri künyesi: {kaynakBagi(gol.kaynak)
      ? <a href={kaynakBagi(gol.kaynak)} rel="nofollow noopener" target="_blank">{gol.kaynak}</a>
      : gol.kaynak} — kapsam: {GOLNEHIR_KAPSAM_GOL}; erişim
    {' '}{GOLNEHIR_ERISIM}. {GOLNEHIR_LISANS}. Bu sayfa hukuki görüş değildir.
  </p>

  {/* P2 (24.09.2026): GÖVDE SSS — JSON-LD FAQPage ile AYNI `sssSorular`
      dizisinden görünür semantik HTML. AI Overview/RAG gövdeden çekebilir. */}
  <section class="sss" aria-label="Sık sorulan sorular">
    <h2>Sık sorulan sorular</h2>
    {sssSorular.map((q) => (
      <div class="sss-madde">
        <h3>{q.name}</h3>
        <p>{q.acceptedAnswer.text}</p>
      </div>
    ))}
  </section>

  {/* P2 (24.09.2026): İlgili Havza Varlıkları tablosu — havza + aynı havzadaki
      diğer göller (statik iç link omurgası). */}
  <section class="havza-varlik" aria-label="İlgili havza varlıkları">
    <h2>İlgili Havza Varlıkları</h2>
    <table>
      <thead>
        <tr><th scope="col">Varlık</th><th scope="col">Bağ</th></tr>
      </thead>
      <tbody>
        <tr><td>{gol.ad}</td><td>Bu sayfa (göl/gölet)</td></tr>
        {havza && (
          <tr><td>{havza.ad}</td><td><a href={`/havzalar/${havza.slug}/`}>Havza verisi</a></td></tr>
        )}
        {kardesGoller.map((k) => (
          <tr><td>{k.ad}</td><td><a href={`/goller/${k.slug}/`}>Aynı havzadaki göl</a></td></tr>
        ))}
      </tbody>
    </table>
  </section>

  {/* C6 (V5, 10.09.2026): hub çapraz link bloğu — PageRank akışını il/havza
      ve dönüşüm sayfalarına (rehberler, /nerede-su-cikar/) yönlendirir.
      Yalnız gerçek iç bağlar (uydurma yok). */}
  <nav class="ilgili" aria-label="İlgili içerik">
    <h2>İlgili su verisi ve mevzuat</h2>
    <div class="capraz">
      {il && <a href={`/kuyu-ruhsati/${il.slug}/`}>{il.ad} kuyu ruhsatı</a>}
      {havza && <a href={`/havzalar/${havza.slug}/`}>{havza.ad} verisi</a>}
      <a href="/nerede-su-cikar/">İlinizde su nerede çıkar</a>
      <a href="/rehberler/">Su hukuku rehberleri</a>
    </div>
  </nav>

  <YazarKutusu />
</Sayfa>

<style>
  .kunye {
    margin: 0 0 2rem;
    padding: 1.3rem 1.4rem 1.3rem 1.8rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
    position: relative;
  }
  .kunye::before {
    content: "";
    position: absolute;
    left: 0.6rem;
    top: 1rem;
    bottom: 1rem;
    width: 6px;
    background:
      repeating-linear-gradient(180deg,
        rgba(46, 126, 160, 0.4) 0 1px, transparent 1px 7px),
      linear-gradient(90deg, rgba(46, 126, 160, 0.4) 0 1px, transparent 1px);
  }
  .kunye-katman {
    margin: 0;
    padding: 0.4rem 0 0;
    background: transparent;
    border: 0;
  }
  .kunye-katman::before { display: none; }
  .kunye-satir {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 0.4rem 1.2rem;
    padding: 0.5rem 0;
  }
  .kunye-satir + .kunye-satir { border-top: 1px solid var(--cizgi); }
  dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    align-self: center;
  }
  dd { font-size: 0.96rem; }
  dd a { color: var(--baglanti, var(--su-700)); }
  .not {
    font-size: 0.9rem;
    color: var(--metin-soluk);
    margin: 0.6rem 0;
  }
  .not a { color: var(--baglanti, var(--su-700)); }
  .veri-kunyesi {
    font-size: 0.8rem;
    color: var(--metin-soluk);
    margin: 1.2rem 0 0;
  }
  @media (max-width: 560px) {
    .kunye-satir { grid-template-columns: 1fr; gap: 0.1rem; }
  }

  /* C6 (V5): hub çapraz link bloğu — havza/il sayfalarındaki .capraz dili. */
  .ilgili { margin-top: 2.4rem; }
  .ilgili h2 { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 0.8rem; }
  .capraz { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.2rem 0 0; }
  .capraz a { font-family: var(--mono); font-size: 0.8rem; color: var(--su-700); border: 1px solid var(--cizgi); padding: 0.4rem 0.7rem; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .capraz a:hover { background: var(--zemin-kart); }

  /* P2: gövde SSS (semantik h3 soru + doğrudan yanıt). radius 0, gölge yok. */
  .sss { margin-top: 2rem; }
  .sss h2 { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 0.8rem; }
  .sss-madde { border-top: 1px solid var(--cizgi); padding: 0.7rem 0; }
  .sss-madde h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.3rem; }
  .sss-madde p { color: var(--metin-soluk); }

  /* P2: İlgili Havza Varlıkları tablosu. */
  .havza-varlik { margin-top: 2rem; }
  .havza-varlik h2 { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 0.8rem; }
  .havza-varlik table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .havza-varlik th, .havza-varlik td {
    text-align: left; padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--cizgi); vertical-align: top;
  }
  .havza-varlik th {
    font-family: var(--mono); font-weight: 500; font-size: 0.68rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--metin-soluk); background: var(--adacayi-krem);
    border-bottom: 2px solid var(--su-700);
  }
  .havza-varlik a { color: var(--baglanti); text-decoration: none; }
  .havza-varlik a:hover { text-decoration: underline; }
</style>
