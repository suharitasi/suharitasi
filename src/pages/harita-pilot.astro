---
// PİLOT — scroll-scrub "dünyaya uçuş" denemesi. Ayrı sayfa: /harita-pilot/.
// Mevcut /harita/ ve landing'e DOKUNULMAZ; yan yana kıyas için buradadır.
//
// Motor: oso95/scroll-world "scrub-engine.js" (MIT, telif: cyw) scroll-scrub
// grameri — smoothstep + lingerEase + segment eşlemesi + bölüm-copy koreografisi
// + route rail + rAF yumuşatma buradan porta edildi. Higgsfield / AI video /
// ücretli hiçbir adım YOK: motorun video katmanı yerine tek onaylı görselden
// (HEDEF.png → /hedef-hero.v2.webp) CSS kamera transformu sürülür. Sunucuda
// ffmpeg olmadığından ken-burns MP4 üretilemedi; görevin fallback kuralı gereği
// CSS-only parallax yolu seçildi (ek olarak ~90MB video yükü yerine near-sıfır
// ağırlık — görsel zaten public'te, yeniden kullanılıyor).
// MENÜ BİRLEŞTİRME (27.07): TamEkranMenu import'u kalktı, dosya durur (M10).
import PaylasilanMenu from '../components/PaylasilanMenu.astro';
---
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>Harita (pilot) — Su Haritası</title>
<meta name="description" content="Scroll ile Türkiye su haritasında uçuş — deneme sürümü." />
<meta name="robots" content="noindex" />
<link rel="canonical" href="https://suharitasi.com/harita-pilot/" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preload" as="image" href="/hedef-hero.v2.webp" fetchpriority="high" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500;600&display=swap&subset=latin-ext" rel="stylesheet" />
<style is:global>
  :root {
    --deniz: #04121F;
    --kopuk: #A8DDE0;
    --akuamarin: #4FC3D0;
    --metin-soluk: #6C8A96;
    --serif: "Cormorant", Georgia, serif;
    --sans: "Manrope", system-ui, sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: #8A9489;
    font-family: var(--sans);
    color: #F4F1EA;
  }

  /* Sahne: sabit tam ekran pencere; görsel bunun içinde kameralanır. */
  .sahne {
    position: fixed;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    background: #8A9489 url('/hedef-zemin.v1.webp') center / cover no-repeat;
  }
  .dunya {
    position: absolute;
    inset: 0;
    background: url('/hedef-hero.v2.webp') center / cover no-repeat;
    transform-origin: center center;
    will-change: transform;
    /* İlk boya: hafif yakın, açılışta yerine oturur */
    transform: translate(0, -4%) scale(1.08);
  }
  /* Kamera hareketini okunur kılan yumuşak vinyet + üstten hava */
  .sahne::after {
    content: "";
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(120% 90% at 50% 42%, transparent 55%, rgba(4,18,31,0.28) 100%),
      linear-gradient(180deg, rgba(4,18,31,0.30) 0%, transparent 22%, transparent 68%, rgba(4,18,31,0.42) 100%);
  }

  /* Kaydırma mesafesini yaratan boşluk (JS bunu bölümlere böler) */
  .kaydirma { position: relative; z-index: 2; }

  /* Bölüm başına sabitlenen metin */
  .kopya {
    position: fixed;
    left: clamp(18px, 5vw, 64px);
    top: 50%;
    /* --dy: JS'in sürdüğü yönlü kayma (giden yukarı, gelen alttan) — kesişimde
       iki metnin aynı yerde üst üste binmesini (hayalet) önler. */
    transform: translateY(calc(-50% + var(--dy, 0px)));
    width: min(42vw, 460px);
    z-index: 5;
    opacity: 0;
    will-change: opacity, transform;
    pointer-events: none;
  }
  .kopya__ust {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.32em;
    text-transform: uppercase; color: var(--akuamarin);
    text-shadow: 0 1px 10px rgba(4,18,31,0.7);
  }
  .kopya__baslik {
    font-family: var(--serif); font-weight: 500; font-style: italic;
    color: #FFFFFF; font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 1.04; margin: 10px 0 0; letter-spacing: -0.005em;
    text-shadow: 0 2px 22px rgba(4,18,31,0.85);
  }
  .kopya__govde {
    margin-top: 16px; font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.55; color: #EAF3F2; max-width: 34ch;
    text-shadow: 0 1px 14px rgba(4,18,31,0.9);
  }
  .kopya__cta { margin-top: 22px; display: flex; gap: 14px; pointer-events: auto; flex-wrap: wrap; }
  .kopya__cta a {
    font-size: 0.82rem; font-weight: 600; letter-spacing: 0.04em;
    text-decoration: none; padding: 0.62rem 1.15rem; border-radius: 999px;
    transition: transform 0.2s var(--e-suzul), background 0.2s var(--e-akinti);
  }
  .cta-birincil { background: var(--akuamarin); color: #04121F; }
  .cta-birincil:hover { transform: translateY(-2px); background: var(--kopuk); }
  .cta-ikincil { color: #EAF3F2; border: 1px solid rgba(234,243,242,0.4); }
  .cta-ikincil:hover { transform: translateY(-2px); border-color: var(--kopuk); }

  /* Sağ route rail — hangi bölümdeyiz */
  .ray {
    position: fixed; right: clamp(14px, 2.4vw, 30px); top: 50%; z-index: 6;
    transform: translateY(-50%); display: flex; flex-direction: column; gap: 20px;
  }
  .ray button {
    width: 8px; height: 8px; border-radius: 50%; background: rgba(234,243,242,0.35);
    transition: background 0.3s var(--e-akinti), transform 0.3s var(--e-suzul); cursor: pointer;
    border: 0; padding: 0;
  }
  .ray button.aktif { background: var(--akuamarin); transform: scale(1.5); }

  /* Alt scroll ipucu + ilerleme çubuğu */
  .ipucu {
    position: fixed; left: 50%; bottom: clamp(18px, 4vh, 34px); z-index: 6;
    transform: translateX(-50%); color: #EAF3F2; font-size: 0.7rem;
    letter-spacing: 0.28em; text-transform: uppercase; opacity: 0.85;
    text-shadow: 0 1px 10px rgba(4,18,31,0.8); pointer-events: none;
  }
  .cubuk {
    position: fixed; left: 0; top: 0; height: 3px; z-index: 7;
    background: var(--akuamarin); width: 100%;
    transform: scaleX(0); transform-origin: left; will-change: transform;
  }

  /* Sol üst menü tetikleyici (harita ile birebir) + pilot etiketi */
  .rozet {
    position: fixed; top: clamp(0.9rem, 2.4vw, 1.4rem); right: clamp(1rem, 2.8vw, 1.7rem);
    z-index: 10; font-size: 0.62rem; letter-spacing: 0.24em; text-transform: uppercase;
    color: #EAF3F2; opacity: 0.6;
  }

  @media (max-width: 860px) {
    .kopya {
      left: clamp(16px, 5vw, 40px); right: clamp(16px, 5vw, 40px);
      top: auto; bottom: calc(clamp(56px, 12vh, 96px) + env(safe-area-inset-bottom));
      transform: translateY(var(--dy, 0px)); width: auto; max-width: 560px;
    }
    .ray { display: none; }
  }

  /* Hareket azaltma: uçuş yok, görsel sabit, tüm metin görünür */
  @media (prefers-reduced-motion: reduce) {
    .dunya { transform: translate(0, 0) scale(1.02) !important; }
    .kopya { position: relative; opacity: 1 !important; top: auto; transform: none;
             width: auto; max-width: 640px; margin: 84vh auto 12vh; left: 0;
             padding: 0 clamp(18px, 5vw, 48px); }
    .kaydirma { display: none; }
    .ray, .ipucu, .cubuk { display: none; }
  }
</style>
</head>
<body>
  <!-- Sahne + kameralı dünya -->
  <div class="sahne" aria-hidden="true">
    <div class="dunya" id="dunya"></div>
  </div>

  <!-- Kaydırma boşluğu (JS yükseklik verir) -->
  <div class="kaydirma" id="kaydirma"></div>

  <!-- Bölüm metinleri (JS opaklığı sürer) -->
  <div class="kopya" data-beat="0">
    <div class="kopya__ust">Su Haritası</div>
    <h1 class="kopya__baslik">Türkiye'nin suyu, tek haritada.</h1>
    <p class="kopya__govde">Kaydırın — havzaların üzerinde uçun.</p>
  </div>
  <div class="kopya" data-beat="1">
    <div class="kopya__ust">25 Havza</div>
    <h2 class="kopya__baslik">Sular havzalara bölünür.</h2>
    <p class="kopya__govde">Her havzanın kendi rezervi, kendi sınırı, kendi kuralı vardır.</p>
  </div>
  <div class="kopya" data-beat="2">
    <div class="kopya__ust">Veri</div>
    <h2 class="kopya__baslik">Rakamlar yüzeyin altında.</h2>
    <p class="kopya__govde">Yüzeysuyu, yeraltı suyu, baraj doluluğu — havza havza.</p>
  </div>
  <div class="kopya" data-beat="3">
    <div class="kopya__ust">Hukuk</div>
    <h2 class="kopya__baslik">Veri ile mevzuat aynı ekranda.</h2>
    <p class="kopya__govde">Kuyu belgesi, su tahsisi, kaynak hakkı — haritanın üstünde.</p>
  </div>
  <div class="kopya" data-beat="4">
    <div class="kopya__ust">Başlayın</div>
    <h2 class="kopya__baslik">Haritaya girin.</h2>
    <p class="kopya__govde">Havzalardan ya da rehberlerden ilerleyin.</p>
    <div class="kopya__cta">
      <a class="cta-birincil" href="/havzalar/">Havzalar</a>
      <a class="cta-ikincil" href="/rehberler/">Rehberler</a>
    </div>
  </div>

  <!-- Route rail (JS doldurur) -->
  <nav class="ray" id="ray" aria-label="Bölümler"></nav>

  <div class="ipucu" id="ipucu">kaydırarak uçun</div>
  <div class="cubuk" id="cubuk"></div>

  
  <span class="rozet">pilot</span>
  <PaylasilanMenu />

  <script is:inline>
    /* Scroll-scrub grameri: oso95/scroll-world scrub-engine.js (MIT) mantığı.
       clamp/smooth/lingerEase ve segment eşlemesi motordan; sürülen şey
       video.currentTime yerine HEDEF.png kamera transformu. */
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const dunya  = document.getElementById('dunya');
      const cubuk  = document.getElementById('cubuk');
      const ipucu  = document.getElementById('ipucu');
      const rayEl  = document.getElementById('ray');
      const kopya  = Array.from(document.querySelectorAll('.kopya'));

      // Kamera keyframe'leri: her bölüm için {s: ölçek, fx,fy: -1..1 pan}.
      // Pan, ölçekten doğan hareket payının kesridir — kenar asla açılmaz.
      const beats = [
        { s: 1.08, fx:  0.00, fy: -0.15 },
        { s: 1.52, fx: -0.52, fy: -0.34 },
        { s: 1.72, fx:  0.55, fy:  0.36 },
        { s: 1.36, fx:  0.06, fy:  0.10 },
        { s: 1.90, fx: -0.16, fy: -0.08 },
      ];
      const N = beats.length;

      if (reduce) { return; } // reduced-motion: CSS statik görseli + tüm metni gösterir

      // Route rail noktaları
      beats.forEach((_, i) => {
        const b = document.createElement('button');
        b.type = 'button'; b.setAttribute('aria-label', 'Bölüm ' + (i + 1));
        b.addEventListener('click', () => {
          const y = (i / (N - 1)) * maxScroll();
          window.scrollTo({ top: y, behavior: 'smooth' });
        });
        rayEl.appendChild(b);
      });
      const noktalar = Array.from(rayEl.children);

      // Kaydırma yüksekliği: bölüm başına ~1.3 ekran
      const BAND = 1.3;
      const kaydirma = document.getElementById('kaydirma');
      function setHeight() { kaydirma.style.height = (N * BAND * 100) + 'vh'; }
      setHeight();
      const maxScroll = () => document.documentElement.scrollHeight - window.innerHeight;

      const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));
      const smooth = x => { x = clamp(x); return x * x * (3 - 2 * x); };

      let target = 0, cur = 0, ticking = false;
      function read() {
        ticking = false;
        target = clamp((window.scrollY || window.pageYOffset) / maxScroll());
      }

      function applyCamera(p) {
        // p 0..1 → segment (beats arası). smooth() ile yumuşak geçiş.
        const fseg = p * (N - 1);
        let i = Math.floor(fseg);
        if (i >= N - 1) i = N - 2;
        const local = smooth(fseg - i);
        const a = beats[i], b = beats[i + 1];
        const s  = a.s  + (b.s  - a.s)  * local;
        const fx = a.fx + (b.fx - a.fx) * local;
        const fy = a.fy + (b.fy - a.fy) * local;
        const maxShift = (s - 1) / 2;                 // kenarı açmayan tavan
        const tx = (fx * maxShift * 100).toFixed(3);
        const ty = (fy * maxShift * 100).toFixed(3);
        dunya.style.transform = `translate(${tx}%, ${ty}%) scale(${s.toFixed(4)})`;
      }

      function applyCopy(p) {
        // Motor koreografisi: ilk bölüm açılışta karşılar, son bölüm sonda tutar,
        // ortadakiler kendi merkezinde belirip söner.
        // Plato + kısa dikiş takası: her metin kendi bölümü boyunca TAM opaklıkta
        // durur (sönük an yok), yalnız iki bölüm arasındaki dar dikiş bandında
        // (RW) hızlıca el değiştirir. Böylece ne uzun sönük an ne uzun çakışma
        // olur — sadece kısa, yönlü kaymalı bir takas.
        const span = 1 / (N - 1);       // bölüm merkezleri arası
        const RW = 0.34 * span;          // dikiş geçiş bandı (dar = kısa takas)
        const SHIFT = 60;                // px — takası yönlendiren kayma
        // e kenarında 0→1 yumuşak rampa (e-RW/2'de 0, e+RW/2'de 1)
        const rampa = (x, e) => smooth((x - e + RW / 2) / RW);
        kopya.forEach((el, i) => {
          const cp = i / (N - 1);
          const solDikis = cp - span / 2, sagDikis = cp + span / 2;
          const gelen  = i === 0     ? 1 : rampa(p, solDikis);       // soldan belir
          const giden  = i === N - 1 ? 0 : rampa(p, sagDikis);       // sağda çık
          el.style.opacity = clamp(gelen * (1 - giden));
          // Giden yukarı süzülür, gelen alttan; dikişte kısa yönlü kayma
          let dy = 0;
          if (i !== N - 1 && p > cp) dy = -smooth(rampa(p, sagDikis)) * SHIFT;      // çıkış: yukarı
          else if (i !== 0 && p < cp) dy = smooth(1 - rampa(p, solDikis)) * SHIFT;  // giriş: alttan
          el.style.setProperty('--dy', dy.toFixed(1) + 'px');
        });
        // Aktif rail noktası
        const active = Math.round(p * (N - 1));
        noktalar.forEach((d, i) => d.classList.toggle('aktif', i === active));
      }

      function raf() {
        cur += (target - cur) * 0.12;            // rAF yumuşatma (motordaki lerp)
        if (Math.abs(target - cur) < 0.0002) cur = target;
        applyCamera(cur);
        applyCopy(cur);
        cubuk.style.transform = `scaleX(${cur.toFixed(4)})`;
        ipucu.style.opacity = clamp(1 - cur * 6).toString();
        requestAnimationFrame(raf);
      }

      window.addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(read); }
      }, { passive: true });
      window.addEventListener('resize', () => { setHeight(); read(); }, { passive: true });

      read();
      requestAnimationFrame(raf);
    })();
  </script>
</body>
</html>
