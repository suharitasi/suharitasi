---
// /yeralti-suyu/[il]/ — PROGRAMATİK İL SAYFALARI (04.10.2026 · KARARLAR §55).
//
// AMAÇ: "X yeraltı suyu haritası / durumu" arama ailesine il-özel, GERÇEK
// verili sayfa. İçerik yalnız mevcut doğrulanmış JSON'lardan derlenir
// (il-profil.js tek kaynak); sabit/şablon metinle şişirilmez — her sayfada
// ilin havza künyeleri, GRACE eğilimi ve baraj doluluğu sayı olarak basılır.
//
// İNCE İÇERİK KAPISI: yalnız `yayinlananIller()` (5 gerçek unsurdan ≥3'ü
// dolu) sayfa alır; eşiği geçmeyen il ÜRETİLMEZ (kuyu-ruhsati deseni).
// Hukuki satır mevcut rehbere KÖPRÜ verir; yeni hukuki iddia yazılmaz.
import Sayfa from '../../layouts/Sayfa.astro';
import { TARIH } from '../../data/guncellik.js';
import SayfaBasi from '../../components/SayfaBasi.astro';
import OzCevap from '../../components/OzCevap.astro';
import CtaBlok from '../../components/CtaBlok.astro';
import HukukSerhi from '../../components/HukukSerhi.astro';
import { yayinlananIller } from '../../data/il-profil.js';
import { ilKayitlari } from '../../data/kisit-sorgu.js';

export async function getStaticPaths() {
  return yayinlananIller().map((p) => ({ params: { il: p.slug }, props: { profil: p } }));
}

const { profil } = Astro.props;

const tr = (n: number | null, ond = 2) =>
  n == null ? 'veri yok' : n.toLocaleString('tr-TR', { minimumFractionDigits: ond, maximumFractionDigits: ond });
const yonYazi = { azalma: 'azalma', toparlanma: 'toparlanma', sabit: 'belirgin eğilim yok' } as const;

const bolgeMetni = profil.dsiBolgeleri.length
  ? profil.dsiBolgeleri.map((b: any) => `${b.merkez} (${b.no}. Bölge)`).join(', ')
  : null;

// §57 Yerel Su ve Kuyu Rehberi: 2. soru yalnız doğrulanmış RG kayıtlarından
// (uydurma yasağı: kayıt yoksa "yok" denir, kısıt uydurulmaz).
const rg = ilKayitlari(profil.il);
const rgSon = rg[0] ?? null;
const rgOzet = rg.length
  ? `${rg.length} doğrulanmış Resmî Gazete kaydı; en günceli ${rgSon.tarih} tarihli (${rgSon.durum}).`
  : 'Bu il için doğrulanmış Resmî Gazete ilanı kaydı yok; kayıt bulunmaması kısıt olmadığının kanıtı değildir.';
const adlar = profil.havzalar.map((h: any) => h.ad.replace(/\s*Havzası\s*$/, ''));
const havzaMetni = adlar.length === 0
  ? 'kayıtlı havza eşleşmesi bulunmayan'
  : adlar.length === 1
    ? `${adlar[0]} Havzası`
    : `${adlar.slice(0, -1).join(', ')} ve ${adlar.at(-1)} havzaları`;

const azalan = profil.havzalar.filter((h: any) => h.egilim?.yon === 'azalma');
const egilimCumlesi = azalan.length
  ? `Uydu ölçümüne göre ${azalan.length} havzada su depolaması son 5 yılda azalıyor.`
  : 'Uydu ölçümüne göre son 5 yılda belirgin azalma eğilimi öne çıkmıyor.';

// Öz-cevap 280 sınırı: çok havzalı illerde ad listesi kısaltılır (B4 deseni).
const havzaKisa = adlar.length === 0
  ? 'kayıtlı havza eşleşmesi bulunmayan'
  : adlar.length <= 3
    ? (adlar.length === 1 ? `${adlar[0]} Havzası` : `${adlar.slice(0, -1).join(', ')} ve ${adlar.at(-1)} havzaları`)
    : `${adlar.length} havza (${adlar.slice(0, 2).join(', ')}…)`;

const OZ_CEVAP =
  `${profil.il} ili ${havzaKisa} içinde` +
  (bolgeMetni ? `; yetkili DSİ bölge müdürlüğü: ${bolgeMetni}` : '') +
  `. ${egilimCumlesi} Havza künyeleri ve güncel eğilim tablodadır; ` +
  `kuyu ruhsatı rehberi bağlantılıdır.`;
if (OZ_CEVAP.length > 280) throw new Error(`yeralti-suyu/${profil.slug}: öz-cevap ${OZ_CEVAP.length} karakter.`);

// Meta 160 (CTR): öz-cevaptan ayrı, il adı başta; iddialar yalnız sayfada
// GERÇEKTEN gösterilen veri (havza sayısı + güncel eğilim + doluluk).
const META =
  `${profil.il} yeraltı suyu haritası ve güncel durumu: ${profil.havzalar.length} havza künyesi, ` +
  `uydu ölçümü${profil.havzalar.some((h: any) => h.baraj) ? ', baraj doluluğu' : ''} ve kuyu ruhsatı bağlantıları.`;
if (META.length > 160) throw new Error(`yeralti-suyu/${profil.slug}: meta ${META.length} karakter.`);

const canonical = new URL(`/yeralti-suyu/${profil.slug}/`, Astro.site).href;
const sema = [
  {
    '@type': 'WebPage',
    '@id': `${canonical}#sayfa`,
    url: canonical,
    name: `${profil.il} yeraltı suyu haritası ve havza verileri`,
    description: META,
    inLanguage: 'tr-TR',
    ...(TARIH.potansiyel ? { dateModified: TARIH.potansiyel } : {}),
    isPartOf: { '@id': `${new URL('/', Astro.site).href}#site` },
  },
  ...(profil.havzalar.length
    ? [{
        '@type': 'ItemList',
        name: `${profil.il} ili havzaları`,
        numberOfItems: profil.havzalar.length,
        itemListElement: profil.havzalar.map((h: any, i: number) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: h.ad,
          url: new URL(`/havzalar/${h.slug}/`, Astro.site).href,
        })),
      }]
    : []),
];
---
<Sayfa
  baslik={`${profil.il} yeraltı suyu haritası ve havza verileri`}
  aciklama={OZ_CEVAP}
  tarayiciBaslik={`${profil.il} Yeraltı Suyu Haritası ve Havza Verileri`}
  metaAciklamaHam={META}
  sema={sema}
>
  <SayfaBasi
    etiket="İl verisi"
    baslik={`${profil.il} yeraltı suyu haritası ve güncel durumu`}
    ozet={`${havzaMetni} · DSİ künyeleri, uydu su ölçümü${profil.havzalar.some((h: any) => h.baraj) ? ' ve baraj doluluğu' : ''}.`}
  />
  <OzCevap metin={OZ_CEVAP} etiket="Özet" />

  <section class="ys-bolum ys-rehber" aria-labelledby="ys-rehber-baslik">
    <h2 id="ys-rehber-baslik">{profil.il} Yerel Su ve Kuyu Rehberi</h2>
    <dl class="ys-sorular">
      <div>
        <dt>1. Hangi DSİ bölge müdürlüğüne bağlı?</dt>
        <dd>{bolgeMetni ?? 'Doğrulanmış DSİ bölge eşleşmesi bulunamadı.'}</dd>
      </div>
      <div>
        <dt>2. Resmî kısıtlar ve Resmî Gazete yasakları neler?</dt>
        <dd>{rgOzet} <a href="/kuyu-kisit-sorgu/">Kısıt sorgu aracında görün →</a></dd>
      </div>
      <div>
        <dt>3. Hangi yerel idare yetkili?</dt>
        <dd>{profil.suIdaresi ? `${profil.suIdaresi} (içme suyu ve kanalizasyon altyapısı)` : 'Açık su idaresi kaydı yok; il özel idaresinden/belediyeden teyit alınmalıdır.'}</dd>
      </div>
      <div>
        <dt>4. Kuyu ruhsatı/izin süreci kaç gün sürer?</dt>
        <dd>
          Mevzuatta doğrulanmış sabit bir işlem süresi yok; süre DSİ bölge
          müdürlüğünün işlem sırasına bağlıdır — kesin süre DSİ'den teyit edilmelidir.
          İdari işleme karşı dava açma süresi 60 gündür (İYUK m. 7).
          {' '}<a href={`/kuyu-ruhsati/${profil.slug}/`}>Belge adımları ve başvuru akışı →</a>
        </dd>
      </div>
    </dl>
  </section>

  <section class="ys-bolum">
    <h2>{profil.il} hangi havzalarda?</h2>
    {profil.havzalar.length ? (
      <div class="ys-kaydir">
        <table class="ys-tablo">
          <thead>
            <tr>
              <th>Havza</th>
              <th>Yağış alanı<span class="ys-meal">km²</span></th>
              <th>Yüzey suyu<span class="ys-meal">km³/yıl · DSİ {profil.veriKunyesi.havzaVeriKaynak.match(/\d{4}/)?.[0] ?? '2024'}</span></th>
              <th>Uydu ölçümü<span class="ys-meal">son 5 yıl · cm/yıl</span></th>
              <th>Baraj doluluğu<span class="ys-meal">son ölçüm · ortalama</span></th>
            </tr>
          </thead>
          <tbody>
            {profil.havzalar.map((h: any) => (
              <tr>
                <td><a href={`/havzalar/${h.slug}/`}>{h.ad}</a></td>
                <td>{tr(h.yagisAlani_km2, 0)}</td>
                <td>{tr(h.yuzeysuyuPotansiyeli_km3)}</td>
                <td>
                  {h.egilim
                    ? <>{h.egilim.egim > 0 ? '+' : ''}{tr(h.egilim.egim)} <span class="ys-soluk">({yonYazi[h.egilim.yon as keyof typeof yonYazi] ?? h.egilim.yon})</span></>
                    : <span class="ys-soluk">veri yok</span>}
                </td>
                <td>
                  {h.baraj
                    ? <>{tr(h.baraj.ortalamaDoluluk, 1)}% <span class="ys-soluk">({h.baraj.tarih})</span></>
                    : <span class="ys-soluk">veri yok</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="ys-veri-yok">Bu il için doğrulanmış havza künyesi bulunmuyor; veri uydurulmaz.</p>
    )}
    <p class="ys-not">
      Sayılar DSİ 2024 resmî istatistikleri, NASA'nın yerçekimi uydu ölçümleri
      ve EPİAŞ Şeffaflık Platformu’ndan derlenmiştir; eksik
      alanlar “veri yok” basar. Uydu değerleri 2004–2009 ortalamasına göre
      <strong>değişimdir</strong> (mutlak miktar değil).
    </p>
  </section>

  <section class="ys-bolum ys-hukuk">
    <h2>{profil.il} için hukuki durum</h2>
    <p>
      Yeraltı suyu kullanımı ve kuyu açma, ilin bağlı olduğu
      {bolgeMetni ?? 'DSİ bölge müdürlüğü'} izin rejimine tabidir.
      {profil.suIdaresi ? `İçme suyu ve kanalizasyon altyapısı: ${profil.suIdaresi}. ` : ''}
      Havzaya özgü kısıt ve güncel mevzuat ayrıntısı il rehberindedir.
    </p>
    <nav class="ys-baglar" aria-label="İlgili sayfalar">
      <a href={`/kuyu-ruhsati/${profil.slug}/`}>→ {profil.il} kuyu ruhsatı rehberi</a>
      <a href="/mevzuat/">→ Su mevzuatı maddeleri</a>
      <a href="/harita/">→ Türkiye havza haritası</a>
      <a href="/ilce-sorgu/">→ İl/ilçe yeraltı suyu sorgusu</a>
      <a href="/tahmin/">→ 6 aylık kuraklık projeksiyonu</a>
    </nav>
  </section>

  <CtaBlok
    konu={`${profil.il} yeraltı suyu`}
    baslik={`${profil.il} için parsel bazlı ön değerlendirme`}
    metin="İl ve ilçe bilgisiyle teknik ön değerlendirme talebi oluşturun; hukuki süreç için rehber sayfalarından ilerleyin."
  />
  <HukukSerhi />
</Sayfa>

<style>
  .ys-bolum { margin-bottom: 1.9rem; }
  .ys-bolum h2 { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; margin-bottom: 0.6rem; }
  .ys-kaydir { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .ys-tablo { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  .ys-tablo th, .ys-tablo td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--cizgi); vertical-align: top; }
  .ys-tablo th { font-family: var(--mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--metin-soluk); }
  .ys-tablo td:nth-child(n+2) { font-family: var(--mono); }
  .ys-meal { display: block; margin-top: 0.15rem; font-family: var(--sans, system-ui, sans-serif); font-size: 0.64rem; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--metin-soluk); white-space: normal; }
  .ys-soluk { color: var(--metin-soluk); }
  .ys-not { margin-top: 0.7rem; font-size: 0.8rem; color: var(--metin-soluk); max-width: 76ch; }
  .ys-veri-yok { font-size: 0.9rem; color: var(--metin-soluk); }
  .ys-hukuk { border-top: 1px solid var(--cizgi); padding-top: 1.2rem; }
  .ys-hukuk p { max-width: 76ch; }
  /* §57 Yerel Su ve Kuyu Rehberi — 4 soru bloğu */
  .ys-rehber { border: 1px solid var(--cizgi); background: var(--zemin-kart); padding: 1.1rem 1.3rem; }
  .ys-sorular { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem 1.6rem; margin: 0.6rem 0 0; }
  .ys-sorular dt { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--metin-soluk); margin-bottom: 0.25rem; }
  .ys-sorular dd { margin: 0; font-size: 0.88rem; line-height: 1.5; }
  .ys-sorular a { color: var(--baglanti); text-decoration: none; }
  .ys-sorular a:hover { text-decoration: underline; }
  @media (max-width: 720px) { .ys-sorular { grid-template-columns: 1fr; } }
  .ys-baglar { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; margin-top: 0.8rem; }
  .ys-baglar a { color: var(--baglanti); text-decoration: none; }
  .ys-baglar a:hover { text-decoration: underline; }
</style>
