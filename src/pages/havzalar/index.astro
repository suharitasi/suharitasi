---
import { getCollection } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import havzaVeri from '../../../data/havza-veri.json';
import GorselSlot from '../../components/GorselSlot.astro';

// DSİ havza numarasına göre sırala; numarasızlar sona, ada göre
const girisler = (await getCollection('havzalar')).sort((a, b) => {
  if (a.data.no && b.data.no) return a.data.no.localeCompare(b.data.no);
  if (a.data.no) return -1;
  if (b.data.no) return 1;
  return a.data.baslik.localeCompare(b.data.baslik, 'tr');
});

// Veri rozeti: MEVCUT havza-veri.json künyesinden (yeni veri eklenmez)
const kunye = Object.fromEntries(havzaVeri.havzalar.map((h) => [h.no, h]));
const sayi = (n: number) => n.toLocaleString('tr-TR');
---
<Sayfa
  baslik="Havzalar"
  aciklama="Türkiye'nin 25 su havzası: sınırlar, su potansiyeli, tahsis durumu ve koruma eylem planları."
>
  <SayfaBasi
    baslik="Havzalar"
    ozet="Türkiye'nin 25 su havzası, havza bazında veri künyeleriyle. Sayfalar açık kaynaklardan doğrulanmış veriyle adım adım doluyor."
  />

  {/* Görsel slot sözleşmesi: 'havza-kart-zemini' — görsel gelince tek
      config değişimiyle oturur (src/data/gorseller.js) */}
  <GorselSlot ad="havza-kart-zemini" yukseklik="clamp(120px, 16vh, 170px)" alt="" />

  <ul class="sv-liste">
    {girisler.map((g) => {
      const v = g.data.no ? kunye[g.data.no] : undefined;
      return (
        <li>
          <a href={`/havzalar/${g.id}/`}>
            {g.data.no && <span class="sv-no" aria-hidden="true">{g.data.no}</span>}
            <span class="sv-metin">
              <span class="sv-baslik">{g.data.baslik}</span>
              <span class="sv-ozet">{g.data.ozet}</span>
            </span>
            {v && v.yagisAlani_km2 && (
              <span class="sv-rozet">
                <span>{sayi(v.yagisAlani_km2)} km²</span>
                {v.yuzeysuyuPotansiyeli_km3 != null && (
                  <span>{v.yuzeysuyuPotansiyeli_km3.toLocaleString('tr-TR')} km³/yıl</span>
                )}
              </span>
            )}
          </a>
        </li>
      );
    })}
  </ul>
</Sayfa>

<style>
  .sv-liste { list-style: none; margin-top: 1.6rem; }

  .sv-liste li + li { border-top: 1px solid var(--cizgi); }

  .sv-liste a {
    display: grid;
    grid-template-columns: 3.4rem 1fr auto;
    align-items: baseline;
    gap: 0 1rem;
    padding: 1.25rem 0.4rem;
    text-decoration: none;
    color: inherit;
    transition: transform 240ms var(--e-suzul), background-color 240ms var(--e-akinti);
    will-change: transform;
  }

  .sv-liste a:hover { transform: translateY(-2px); background: rgba(79, 123, 120, 0.06); }

  .sv-liste a:active { transform: translateY(0) scale(0.995); transition-duration: 120ms; }

  /* Sol büyük numara: resmî DSİ kodu */
  /* DSİ kodu mono katmanda: kot/etiket estetiği (DESIGN.md §5-6) */
  .sv-no {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1;
    color: rgba(90, 107, 98, 0.45);
    transition: color 120ms var(--e-akinti);
  }

  .sv-liste a:hover .sv-no { color: var(--su-400); }

  .sv-baslik {
    display: block;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.3;
    transition: color 120ms var(--e-akinti);
  }

  .sv-liste a:hover .sv-baslik { color: var(--su-700); }

  .sv-ozet {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.92rem;
    color: var(--metin-soluk);
    max-width: 52ch;
  }

  /* Veri rozeti: yağış alanı + yüzey suyu potansiyeli (havza-veri.json) */
  .sv-rozet {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-self: center;
  }

  .sv-rozet span {
    display: inline-block;
    padding: 0.2rem 0.66rem;
    background: var(--adacayi-krem);
    border: 1px solid rgba(28, 43, 36, 0.08);
    border-left: 2px solid var(--su-400);
    font-family: var(--mono);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--murekkep-500);
    white-space: nowrap;
    text-align: left;
  }

  @media (max-width: 640px) {
    .sv-liste a { grid-template-columns: 2.6rem 1fr; }
    .sv-no { font-size: 1.3rem; }
    .sv-rozet {
      grid-column: 2;
      flex-direction: row;
      margin-top: 0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-liste a { transition: none; }
    .sv-liste a:hover { transform: none; }
  }
</style>
