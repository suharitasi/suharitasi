---
import { getCollection } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';

const girisler = (await getCollection('havzalar')).sort(
  (a, b) => a.data.baslik.localeCompare(b.data.baslik, 'tr')
);
---
<Sayfa
  baslik="Havzalar"
  aciklama="Türkiye'nin 25 su havzası: sınırlar, su potansiyeli, tahsis durumu ve koruma eylem planları."
>
  <SayfaBasi
    baslik="Havzalar"
    ozet="Türkiye'nin 25 su havzası, havza bazında veri künyeleriyle. Sayfalar açık kaynaklardan doğrulanmış veriyle adım adım doluyor."
  />
  <ul class="liste">
    {girisler.map((g) => (
      <li>
        <a href={`/havzalar/${g.id}/`}>
          <span class="liste-baslik">{g.data.baslik}</span>
          <span class="liste-ozet">{g.data.ozet}</span>
        </a>
      </li>
    ))}
  </ul>
</Sayfa>

<style>
  .liste { list-style: none; }

  .liste li + li { border-top: 1px solid var(--cizgi); }

  .liste a {
    display: block;
    padding: 1.1rem 0;
    text-decoration: none;
    color: inherit;
  }

  .liste-baslik {
    display: block;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .liste a:hover .liste-baslik { color: var(--baglanti); }

  .liste-ozet {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.92rem;
    color: var(--metin-soluk);
    max-width: 62ch;
  }
</style>
