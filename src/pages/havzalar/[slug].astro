---
import { getCollection, render } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import OzCevap from '../../components/OzCevap.astro';
import BarajDoluluk from '../../components/BarajDoluluk.astro';
import GraceEgilim from '../../components/GraceEgilim.astro';
import HavzaYasBandi from '../../components/HavzaYasBandi.astro';
import HavzaKahraman from '../../components/HavzaKahraman.astro';
import Katman from '../../components/Katman.astro';
import ilKurum from '../../../data/il-kurum.json';
import { havzaKonum, ULKE_YOLU, EN as HARITA_EN, BOY as HARITA_BOY } from '../../data/havza-harita.js';
import havzaVeri from '../../../data/havza-veri.json';
import graceHavza from '../../../data/canli/grace-havza.json';
import { graceEgilim } from '../../data/grace-hesap.js';
import { yayinlananIller } from '../../data/il-profil.js';
import { havzaYasGeo } from '../../data/havza-yas-geo.js';

export async function getStaticPaths() {
  const girisler = await getCollection('havzalar');
  return girisler.map((g) => ({ params: { slug: g.id }, props: { giris: g } }));
}

const tumRehberler = await getCollection('rehberler');

const { giris } = Astro.props;
const { Content } = await render(giris);
const k = giris.data.kunye;

// Boş künye alanı "veri yok (14.07.2026)" olarak işaretlenir — Sakarya'nın
// tahsis alanındaki mevcut kalıpla aynı. Statik sitede hiçbir şey
// "yükleniyor" olamaz; dürüst dil tek biçim (rapor KOD-6).
const [yy, aa, gg] = ilKurum.derlemeTarihi.split('-');
const derleme = `${gg}.${aa}.${yy}`;

// "Bu havzada hukuki durum" bloğu: yalnız frontmatter'ında hukuk alanı olan
// havzalarda çıkar (şu an Sakarya pilotu). Rehber slug'ları derlemede
// doğrulanır — kırık slug build'i düşürür, sessizce kaybolmaz.
const hukuk = giris.data.hukuk;
const hukukRehberleri = (hukuk?.rehberler ?? []).map((s) => {
  const r = tumRehberler.find((x) => x.id === s);
  if (!r) throw new Error(`havza "${giris.id}" hukuk.rehberler: "${s}" adlı rehber yok.`);
  return r;
});

const alanlar = [
  { ad: 'Yıllık ortalama su potansiyeli', deger: k.yillikPotansiyel },
  { ad: 'YAS emniyetli rezervi', deger: k.yasRezervi },
  { ad: 'Tahsis durumu', deger: k.tahsis },
  { ad: 'Havza koruma eylem planı', deger: k.eylemPlani },
];

// İller ve yetkili kurumlar: havza no → il listesi → DSİ bölgesi + su idaresi
const havzaIl = giris.data.no ? ilKurum.havzaIlleri[giris.data.no] : undefined;

// D3-A konumlandırıcı (26 Tem 2026, referans görsel turu onayı).
// Havza SINIRI değil, havzanın KAPSADIĞI İLLER — etiket bunu söyler.
const konum = giris.data.no ? havzaKonum(giris.data.no) : null;

// K3-3 (26 Tem 2026) — content-strategy küme bütünlüğü: 25 havza sayfasının
// HİÇBİRİ kardeş havzaya link vermiyordu (spoke<->spoke 0/25). Ölçüt
// COĞRAFİ KOMŞULUK DEĞİL (o bir iddia olurdu) — sayfanın zaten yazdığı
// olgu: AYNI İLLERİ KAPSAMAK. Kaynak: il-kurum.json havzaIlleri.
const buIller = new Set(havzaIl?.iller ?? []);
const kesisenHavzalar = buIller.size
  ? (await getCollection('havzalar'))
      .filter((g) => g.id !== giris.id && g.data.no)
      .map((g) => {
        const il = ilKurum.havzaIlleri[g.data.no]?.iller ?? [];
        return { id: g.id, ad: g.data.baslik, ortak: il.filter((x) => buIller.has(x)).length };
      })
      .filter((x) => x.ortak > 0)
      .sort((a, b) => b.ortak - a.ortak)
      .slice(0, 5)
  : [];
const ilBolge = {};
for (const [no, b] of Object.entries(ilKurum.dsiBolgeleri)) {
  for (const il of b.iller) ilBolge[il] = { no, merkez: b.merkez };
}
// İl sayfası yayında olan iller tabloda linklenir (topic cluster:
// havza → il → rehber). Yayında olmayan il düz metin kalır.
const ilSayfalari = Object.fromEntries(yayinlananIller().map((p) => [p.il, p.slug]));
const ilSatirlari = (havzaIl?.iller ?? []).map((il) => ({
  il,
  ilYolu: ilSayfalari[il] ? `/kuyu-ruhsati/${ilSayfalari[il]}/` : null,
  bolge: ilBolge[il]
    ? `DSİ ${Number(ilBolge[il].no)}. Bölge Müdürlüğü (${ilBolge[il].merkez})`
    : null,
  suIdaresi: ilKurum.suIdareleri[il] ?? 'İl Özel İdaresi / belediye',
}));

// — ÖZ CEVAP (CLAUDE.md): TAMAMEN mevcut doğrulanmış veriden türetilir.
//   Kaynak: havza-veri.json (yağış alanı, yüzey suyu potansiyeli) +
//   grace-havza.json (son 5 yıl su depolaması eğilimi). Eksik alan JENERİK
//   metinle DOLDURULMAZ — o cümle atlanır (uydurma yasağı).
const vd = havzaVeri.havzalar.find((h) => h.no === giris.data.no);
const sayi = (n, ondalik) =>
  n.toLocaleString('tr-TR', { minimumFractionDigits: ondalik, maximumFractionDigits: ondalik });

const cumleler = [];
// 1) Ad + yağış alanı + yüzey suyu potansiyeli (DSİ 2024)
if (vd) {
  const parcalar = [];
  if (vd.yagisAlani_km2 != null) parcalar.push(`${sayi(vd.yagisAlani_km2, 0)} km² yağış alanı`);
  if (vd.yuzeysuyuPotansiyeli_km3 != null)
    parcalar.push(`${sayi(vd.yuzeysuyuPotansiyeli_km3, 2)} km³/yıl yüzey suyu potansiyeli`);
  if (parcalar.length)
    cumleler.push(`${giris.data.baslik}, DSİ ${vd.yuzeysuyuYili ?? 2024} verisine göre ${parcalar.join(' ve ')}ne sahiptir.`);
}
// 2) GRACE eğilimi (son 5 yıl gerçek aylardan) — "değişim, mutlak miktar değil".
//    Hesap tek bakım noktasından (grace-hesap.js).
const gkayit = graceHavza.havzalar?.[giris.data.baslik];
const gSonuc = gkayit ? graceEgilim(gkayit.seri) : null;
if (gSonuc) {
  cumleler.push(
    gSonuc.yon === 'sabit'
      ? `GRACE uydu ölçümüne göre son 5 yılda toplam su depolaması belirgin değişim göstermemektedir (değişim verisidir, mutlak miktar değildir).`
      : `GRACE uydu ölçümüne göre son 5 yılda toplam su depolaması ${gSonuc.yon} eğilimindedir (değişim verisidir, mutlak miktar değildir).`
  );
}
const havzaOzCevap = cumleler.join(' ');
const aciklama = havzaOzCevap || giris.data.ozet;

// — FAQPage JSON-LD: YAS potansiyeli öz-cevabı (AI-arama alıntısı). Tek
//   kaynak havza-yas-geo.js; verisi yoksa şema eklenmez (uydurma yok).
const yasGeo = havzaYasGeo(giris.data.no);
const semalar = yasGeo
  ? [{
      '@type': 'FAQPage',
      mainEntity: [{
        '@type': 'Question',
        name: `${giris.data.baslik} yeraltı suyu potansiyeli nedir?`,
        acceptedAnswer: { '@type': 'Answer', text: yasGeo.cumle },
      }],
    }]
  : [];
---
<Sayfa baslik={giris.data.baslik} aciklama={aciklama} sema={semalar}>
{giris.data.kalip === 2 ? (
  <Fragment>
    {/* ——— KALIP 2 (DESIGN.md §17, pilot): kahraman veri bandı + katmanlı
        sunum. Çifte özet yasağı: SayfaBasi'ya ozet GEÇİLMEZ — görünür tek
        özet OzCevap'tır (ozet, liste kartları + og metni olarak yaşar).
        Yayılım notu: eski kalıpla ortak hukuk/il-kurum işaretlemesi yayılım
        fazında tekilleştirilir; pilotta eski yol bilerek DOKUNULMAMIŞTIR. */}
    <SayfaBasi etiket="Havza" baslik={giris.data.baslik} />

    <HavzaKahraman havzaNo={giris.data.no} havzaBaslik={giris.data.baslik} />

    {havzaOzCevap && <OzCevap metin={havzaOzCevap} />}

    {/* B2B RAPOR CTA: havza sayfasında ilk ekranda görünür PDF indirme butonu */}
    {giris.data.baslik && (
      <aside class="rapor-cta" aria-label="B2B rapor indirme">
        <div class="rapor-cta-govde">
          <span class="rapor-cta-baslik">{giris.data.baslik} — Ağustos 2026 Su Durum Raporu (PDF)</span>
          <span class="rapor-cta-alt">DSİ · GRACE · EPİAŞ · Risk Analizi · Yetkili Kurumlar</span>
        </div>
        <div class="rapor-cta-dugmeler">
          <a href={`/rapor/suharitasi-${giris.data.baslik.toLowerCase().replace(/ı/g,'i').replace(/ğ/g,'g').replace(/ü/g,'u').replace(/ş/g,'s').replace(/ö/g,'o').replace(/ç/g,'c').replace(/havzası/g,'').replace(/\s+/g,'-')}-durum-raporu.pdf`} download class="btn-indir">PDF İndir</a>
          <a href="/raporlar/" class="btn-kurumsal">Tam Kurumsal Rapor Talep Et</a>
        </div>
      </aside>
    )}

    <Katman baslik="Resmî yeraltısuyu verisi" ipucu="DSİ Tablo 1.3 / 1.6 · yıl serileri">
      <HavzaYasBandi havzaNo={giris.data.no} havzaBaslik={giris.data.baslik} />
    </Katman>

    <Katman baslik="Havza profili" ipucu="su varlığı · planlama ve koruma · veri notu">
      <div class="icerik">
        <Content />
      </div>
    </Katman>

    <Katman baslik="Baraj doluluk" ipucu="günlük kayıt · EPİAŞ Şeffaflık">
      <BarajDoluluk havzaBaslik={giris.data.baslik} />
    </Katman>

    <Katman baslik="Su depolaması eğilimi" ipucu="GRACE uydu ölçümü · tam şerh">
      <GraceEgilim havzaBaslik={giris.data.baslik} />
    </Katman>

    {hukuk && (
      <Katman baslik="Bu havzada hukuki durum" ipucu="izin rejimi · kısıtlar · rehberler" ton="kehribar">
        <section class="hukuk">
          <h2>Bu havzada hukuki durum nedir?</h2>

          <div class="hukuk-govde" set:html={hukuk.cerceve} />

          <div class="hukuk-kisit">
            <p class="hukuk-alt-baslik">Havzaya özgü kısıtlar</p>
            {hukuk.kisitlar
              ? <Fragment set:html={hukuk.kisitlar} />
              : (
                <p class="veri-yok">
                  Havzaya özgü kısıt verisi: doğrulanmadı ({derleme}). Kapalı havza
                  ilanı, kuyu derinliği sınırı veya çekim kısıtı gibi havza bazlı
                  kararlar resmî kaynakta kamuya açık ve derli biçimde
                  yayımlanmadığından bu alan boş bırakılmıştır; doğrulanmamış bilgi
                  yazılmaz.
                </p>
              )}
          </div>

          {hukukRehberleri.length > 0 && (
            <nav class="hukuk-rehberler" aria-label="Havzayla ilgili rehberler">
              <p class="hukuk-alt-baslik">Bu havzada işinize yarayacak rehberler</p>
              <ul>
                {hukukRehberleri.map((r) => (
                  <li><a href={`/rehberler/${r.id}/`}>{r.data.baslik}</a></li>
                ))}
              </ul>
            </nav>
          )}
        </section>
      </Katman>
    )}

    {ilSatirlari.length > 0 && (
      <Katman baslik="İller ve yetkili kurumlar" ipucu={`${ilSatirlari.length} il · DSİ bölgeleri · su idareleri`} ton="murekkep">
        <section class="il-kurum">
          <h2>Havzada hangi iller ve yetkili kurumlar var?</h2>
      {konum && (
        <figure class="konum">
          <svg viewBox={`0 0 ${HARITA_EN} ${HARITA_BOY}`} width={HARITA_EN} height={HARITA_BOY}
               role="img" aria-labelledby={`konum-baslik-${giris.id}`} xmlns="http://www.w3.org/2000/svg">
            <title id={`konum-baslik-${giris.id}`}>{giris.data.baslik} — kapsadığı {konum.iller.length} il Türkiye haritasında işaretli</title>
            <path d={ULKE_YOLU} fill="#DFE9F0" stroke="#B9CEDC" stroke-width="0.5" />
            <path d={konum.yol} fill="#0C5A7C" fill-opacity="0.88" stroke="#08405A" stroke-width="0.6" stroke-linejoin="round" />
          </svg>
          <figcaption>
            Koyu alan bu havzanın kapsadığı {konum.iller.length} ildir; havza sınırı değildir.
            İller havzalara kısmen girebilir.
          </figcaption>
        </figure>
      )}
          <div class="tablo-kaydir">
            <table>
              <thead>
                <tr>
                  <th>İl</th>
                  <th>DSİ bölge müdürlüğü</th>
                  <th>Su ve kanalizasyon idaresi</th>
                </tr>
              </thead>
              <tbody>
                {ilSatirlari.map((s) => (
                  <tr>
                    <td>{s.ilYolu ? <a href={s.ilYolu}>{s.il}</a> : s.il}</td>
                    <td>{s.bolge ?? <span class="veri-yok">veri yok</span>}</td>
                    <td>{s.suIdaresi}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="kaynak-notu">
            İl listesi resmî havza belgesinden derlendi
            (<a href={havzaIl.kaynak} target="_blank" rel="noopener">kaynak</a>);
            iller havzaya kısmen girebilir.
            {havzaIl.not ? ` ${havzaIl.not}.` : ''}
            Büyükşehir olmayan illerde köy içme suları İl Özel İdaresi / belediye
            görev alanındadır. Derleme: {ilKurum.derlemeTarihi}.
          </p>
        </section>
      </Katman>
    )}

    <Katman baslik="Kaynak künyesi" ipucu="resmî kaynak bağlantıları · eylem planı" ton="murekkep">
      <dl class="kunye kunye-katman">
        {alanlar.map((a) => (
          <div class="kunye-satir">
            <dt>{a.ad}</dt>
            <dd>
              {a.deger
                ? <Fragment set:html={a.deger} />
                : <span class="veri-yok">veri yok ({derleme})</span>}
            </dd>
          </div>
        ))}
      </dl>
    </Katman>
  </Fragment>
) : (
  <Fragment>
  <SayfaBasi etiket="Havza" baslik={giris.data.baslik} ozet={giris.data.ozet} />

  {havzaOzCevap && <OzCevap metin={havzaOzCevap} />}

  {giris.data.baslik && (
    <aside class="rapor-cta" aria-label="B2B rapor indirme">
      <div class="rapor-cta-govde">
        <span class="rapor-cta-baslik">{giris.data.baslik} — Ağustos 2026 Su Durum Raporu (PDF)</span>
        <span class="rapor-cta-alt">DSİ · GRACE · EPİAŞ · Risk Analizi · Yetkili Kurumlar</span>
      </div>
      <div class="rapor-cta-dugmeler">
        <a href={`/rapor/suharitasi-${giris.data.baslik.toLowerCase().replace(/ı/g,'i').replace(/ğ/g,'g').replace(/ü/g,'u').replace(/ş/g,'s').replace(/ö/g,'o').replace(/ç/g,'c').replace(/havzası/g,'').replace(/\s+/g,'-')}-durum-raporu.pdf`} download class="btn-indir">PDF İndir</a>
        <a href="/raporlar/" class="btn-kurumsal">Tam Kurumsal Rapor Talep Et</a>
      </div>
    </aside>
  )}

  <dl class="kunye">
    {alanlar.map((a) => (
      <div class="kunye-satir">
        <dt>{a.ad}</dt>
        <dd>
          {a.deger
            ? <Fragment set:html={a.deger} />
            : <span class="veri-yok">veri yok ({derleme})</span>}
        </dd>
      </div>
    ))}
  </dl>

  <HavzaYasBandi havzaNo={giris.data.no} havzaBaslik={giris.data.baslik} />

  <div class="icerik">
    <Content />
  </div>

  <BarajDoluluk havzaBaslik={giris.data.baslik} />

  <GraceEgilim havzaBaslik={giris.data.baslik} />

  {hukuk && (
    <section class="hukuk">
      <h2>Bu havzada hukuki durum nedir?</h2>

      <div class="hukuk-govde" set:html={hukuk.cerceve} />

      <div class="hukuk-kisit">
        <p class="hukuk-alt-baslik">Havzaya özgü kısıtlar</p>
        {hukuk.kisitlar
          ? <Fragment set:html={hukuk.kisitlar} />
          : (
            <p class="veri-yok">
              Havzaya özgü kısıt verisi: doğrulanmadı ({derleme}). Kapalı havza
              ilanı, kuyu derinliği sınırı veya çekim kısıtı gibi havza bazlı
              kararlar resmî kaynakta kamuya açık ve derli biçimde
              yayımlanmadığından bu alan boş bırakılmıştır; doğrulanmamış bilgi
              yazılmaz.
            </p>
          )}
      </div>

      {hukukRehberleri.length > 0 && (
        <nav class="hukuk-rehberler" aria-label="Havzayla ilgili rehberler">
          <p class="hukuk-alt-baslik">Bu havzada işinize yarayacak rehberler</p>
          <ul>
            {hukukRehberleri.map((r) => (
              <li><a href={`/rehberler/${r.id}/`}>{r.data.baslik}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </section>
  )}

  {ilSatirlari.length > 0 && (
    <section class="il-kurum">
      <h2>Havzada hangi iller ve yetkili kurumlar var?</h2>
      {konum && (
        <figure class="konum">
          <svg viewBox={`0 0 ${HARITA_EN} ${HARITA_BOY}`} width={HARITA_EN} height={HARITA_BOY}
               role="img" aria-labelledby={`konum-baslik-${giris.id}`} xmlns="http://www.w3.org/2000/svg">
            <title id={`konum-baslik-${giris.id}`}>{giris.data.baslik} — kapsadığı {konum.iller.length} il Türkiye haritasında işaretli</title>
            <path d={ULKE_YOLU} fill="#DFE9F0" stroke="#B9CEDC" stroke-width="0.5" />
            <path d={konum.yol} fill="#0C5A7C" fill-opacity="0.88" stroke="#08405A" stroke-width="0.6" stroke-linejoin="round" />
          </svg>
          <figcaption>
            Koyu alan bu havzanın kapsadığı {konum.iller.length} ildir; havza sınırı değildir.
            İller havzalara kısmen girebilir.
          </figcaption>
        </figure>
      )}
      <div class="tablo-kaydir">
        <table>
          <thead>
            <tr>
              <th>İl</th>
              <th>DSİ bölge müdürlüğü</th>
              <th>Su ve kanalizasyon idaresi</th>
            </tr>
          </thead>
          <tbody>
            {ilSatirlari.map((s) => (
              <tr>
                <td>{s.ilYolu ? <a href={s.ilYolu}>{s.il}</a> : s.il}</td>
                <td>{s.bolge ?? <span class="veri-yok">veri yok</span>}</td>
                <td>{s.suIdaresi}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="kaynak-notu">
        İl listesi resmî havza belgesinden derlendi
        (<a href={havzaIl.kaynak} target="_blank" rel="noopener">kaynak</a>);
        iller havzaya kısmen girebilir.
        {havzaIl.not ? ` ${havzaIl.not}.` : ''}
        Büyükşehir olmayan illerde köy içme suları İl Özel İdaresi / belediye
        görev alanındadır. Derleme: {ilKurum.derlemeTarihi}.
      </p>
    </section>
  )}
  </Fragment>
)}

{kesisenHavzalar.length > 0 && (
  <section aria-label="Aynı illeri kapsayan havzalar">
    <h2>Aynı illeri kapsayan diğer havzalar hangileri?</h2>
    <nav class="capraz">
      {kesisenHavzalar.map((x) => <a href={`/havzalar/${x.id}/`}>&rarr; {x.ad}</a>)}
    </nav>
  </section>
)}
</Sayfa>

<style>
  .konum { margin: 0 0 1.4rem; }
  .konum svg {
    display: block;
    width: 100%;
    height: auto;
    max-width: 30rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
  }
  .konum figcaption {
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.6;
    color: var(--metin-soluk);
    max-width: 30rem;
    margin-top: 0.4rem;
  }

  .capraz { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 1.6rem; }
  .capraz a { font-family: var(--mono); font-size: 0.8rem; color: var(--su-700); border: 1px solid var(--cizgi); padding: 0.4rem 0.7rem; text-decoration: none; }
  .capraz a:hover { background: var(--zemin-kart); }
  /* Havza künyesi = veri bandı (DESIGN.md §5): kot cetveli + DERİN hairline */
  .kunye {
    margin: 0 0 2rem;
    padding: 1.3rem 1.4rem 1.3rem 1.8rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
    position: relative;
  }

  .kunye::before {
    content: "";
    position: absolute;
    left: 0.6rem;
    top: 1rem;
    bottom: 1rem;
    width: 6px;
    background:
      repeating-linear-gradient(180deg,
        rgba(46, 126, 160, 0.4) 0 1px, transparent 1px 7px),
