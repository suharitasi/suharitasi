---
import { getCollection, render } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';

export async function getStaticPaths() {
  const girisler = await getCollection('havzalar');
  return girisler.map((g) => ({ params: { slug: g.id }, props: { giris: g } }));
}

const { giris } = Astro.props;
const { Content } = await render(giris);
const k = giris.data.kunye;

const alanlar = [
  { ad: 'Yıllık ortalama su potansiyeli', deger: k.yillikPotansiyel },
  { ad: 'YAS emniyetli rezervi', deger: k.yasRezervi },
  { ad: 'Tahsis durumu', deger: k.tahsis },
  { ad: 'Havza koruma eylem planı', deger: k.eylemPlani },
];
---
<Sayfa baslik={giris.data.baslik} aciklama={giris.data.ozet}>
  <SayfaBasi etiket="Havza" baslik={giris.data.baslik} ozet={giris.data.ozet} />

  <dl class="kunye">
    {alanlar.map((a) => (
      <div class="kunye-satir">
        <dt>{a.ad}</dt>
        <dd>
          {a.deger
            ? <Fragment set:html={a.deger} />
            : <span class="veri-yok">veri yükleniyor</span>}
        </dd>
      </div>
    ))}
  </dl>

  <div class="icerik">
    <Content />
  </div>
</Sayfa>

<style>
  .kunye {
    margin: 0 0 2rem;
    padding: 1.3rem 1.4rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
  }

  .kunye-satir {
    display: grid;
    grid-template-columns: minmax(11rem, 16rem) 1fr;
    gap: 0.4rem 1.2rem;
    padding: 0.5rem 0;
  }

  .kunye-satir + .kunye-satir { border-top: 1px solid var(--cizgi); }

  dt {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    align-self: center;
  }

  dd { font-size: 0.96rem; }

  @media (max-width: 560px) {
    .kunye-satir { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
