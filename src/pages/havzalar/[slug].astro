---
import { getCollection, render } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import OzCevap from '../../components/OzCevap.astro';
import BarajDoluluk from '../../components/BarajDoluluk.astro';
import GraceEgilim from '../../components/GraceEgilim.astro';
import HavzaSuTablasiGostergesi from '../../components/HavzaSuTablasiGostergesi.astro';
import HavzaYasBandi from '../../components/HavzaYasBandi.astro';
import HavzaKahraman from '../../components/HavzaKahraman.astro';
import Katman from '../../components/Katman.astro';
import ilKurum from '../../../data/il-kurum.json';
import { havzaKonum, ULKE_YOLU, EN as HARITA_EN, BOY as HARITA_BOY } from '../../data/havza-harita.js';
import havzaVeri from '../../../data/havza-veri.json';
import graceHavza from '../../../data/canli/grace-havza.json';
import { graceEgilim } from '../../data/grace-hesap.js';
import { yayinlananIller } from '../../data/il-profil.js';
import { havzaninGolleri, havzaninNehirleri } from '../../data/gol-nehir.js';
import { havzaYasGeo } from '../../data/havza-yas-geo.js';
import { TARIH, enYeni } from '../../data/guncellik.js';
import HukukSerhi from '../../components/HukukSerhi.astro';
import HukukKopru from '../../components/HukukKopru.astro';
import CtaBlok from '../../components/CtaBlok.astro';

export async function getStaticPaths() {
  const girisler = await getCollection('havzalar');
  return girisler.map((g) => ({ params: { slug: g.id }, props: { giris: g } }));
}

const tumRehberler = await getCollection('rehberler');

const { giris } = Astro.props;
const { Content } = await render(giris);
const k = giris.data.kunye;

// Boş künye alanı "veri yok (14.07.2026)" olarak işaretlenir — Sakarya'nın
// tahsis alanındaki mevcut kalıpla aynı. Statik sitede hiçbir şey
// "yükleniyor" olamaz; dürüst dil tek biçim (rapor KOD-6).
const [yy, aa, gg] = ilKurum.derlemeTarihi.split('-');
const derleme = `${gg}.${aa}.${yy}`;

// "Bu havzada hukuki durum" bloğu: yalnız frontmatter'ında hukuk alanı olan
// havzalarda çıkar (şu an Sakarya pilotu). Rehber slug'ları derlemede
// doğrulanır — kırık slug build'i düşürür, sessizce kaybolmaz.
const hukuk = giris.data.hukuk;
const hukukRehberleri = (hukuk?.rehberler ?? []).map((s) => {
  const r = tumRehberler.find((x) => x.id === s);
  if (!r) throw new Error(`havza "${giris.id}" hukuk.rehberler: "${s}" adlı rehber yok.`);
  return r;
});

const alanlar = [
  { ad: 'Yıllık ortalama su potansiyeli', deger: k.yillikPotansiyel },
  { ad: 'YAS emniyetli rezervi', deger: k.yasRezervi },
  { ad: 'Tahsis durumu', deger: k.tahsis },
  { ad: 'Havza koruma eylem planı', deger: k.eylemPlani },
];

// İller ve yetkili kurumlar: havza no → il listesi → DSİ bölgesi + su idaresi
const havzaIl = giris.data.no ? ilKurum.havzaIlleri[giris.data.no] : undefined;

// D3-A konumlandırıcı (26 Tem 2026, referans görsel turu onayı).
// Havza SINIRI değil, havzanın KAPSADIĞI İLLER — etiket bunu söyler.
const konum = giris.data.no ? havzaKonum(giris.data.no) : null;

// K3-3 (26 Tem 2026) — content-strategy küme bütünlüğü: 25 havza sayfasının
// HİÇBİRİ kardeş havzaya link vermiyordu (spoke<->spoke 0/25). Ölçüt
// COĞRAFİ KOMŞULUK DEĞİL (o bir iddia olurdu) — sayfanın zaten yazdığı
// olgu: AYNI İLLERİ KAPSAMAK. Kaynak: il-kurum.json havzaIlleri.
const buIller = new Set(havzaIl?.iller ?? []);
const kesisenHavzalar = buIller.size
  ? (await getCollection('havzalar'))
      .filter((g) => g.id !== giris.id && g.data.no)
      .map((g) => {
        const il = ilKurum.havzaIlleri[g.data.no]?.iller ?? [];
        return { id: g.id, ad: g.data.baslik, no: g.data.no, ortak: il.filter((x) => buIller.has(x)).length };
      })
      .filter((x) => x.ortak > 0)
      // Eşitlikte id'ye göre sıralanır: getCollection dönüş sırası Astro
      // sürümüne göre değişiyor (7: id-alfabetik; 5: loader sırası) — eşitlik
      // açıkça bozulmazsa sıra sürüm/ortam değiştikçe kayar (26.08 ölçümü).
      .sort((a, b) => (b.ortak - a.ortak) || (a.id < b.id ? -1 : 1))
      .slice(0, 5)
  : [];
const ilBolge = {};
for (const [no, b] of Object.entries(ilKurum.dsiBolgeleri)) {
  for (const il of b.iller) ilBolge[il] = { no, merkez: b.merkez };
}
// İl sayfası yayında olan iller tabloda linklenir (topic cluster:
// havza → il → rehber). Yayında olmayan il düz metin kalır.
const ilSayfalari = Object.fromEntries(yayinlananIller().map((p) => [p.il, p.slug]));
const havzaGolleri = havzaninGolleri(giris.id);
const havzaNehirleri = havzaninNehirleri(giris.id);
const ilSatirlari = (havzaIl?.iller ?? []).map((il) => ({
  il,
  ilYolu: ilSayfalari[il] ? `/kuyu-ruhsati/${ilSayfalari[il]}/` : null,
  bolge: ilBolge[il]
    ? `DSİ ${Number(ilBolge[il].no)}. Bölge Müdürlüğü (${ilBolge[il].merkez})`
    : null,
  suIdaresi: ilKurum.suIdareleri[il] ?? 'İl Özel İdaresi / belediye',
}));

// — ÖZ CEVAP (CLAUDE.md): TAMAMEN mevcut doğrulanmış veriden türetilir.
//   Kaynak: havza-veri.json (yağış alanı, yüzey suyu potansiyeli) +
//   grace-havza.json (son 5 yıl su depolaması eğilimi). Eksik alan JENERİK
//   metinle DOLDURULMAZ — o cümle atlanır (uydurma yasağı).
const vd = havzaVeri.havzalar.find((h) => h.no === giris.data.no);
const sayi = (n, ondalik) =>
  n.toLocaleString('tr-TR', { minimumFractionDigits: ondalik, maximumFractionDigits: ondalik });

// — Talep uyumu (havza-talep briefi + GSC eki, 25.08.2026; rapor/havza-talep.md):
//   "X havzası nerede / hangi illeri kapsar / haritası" sorgu ailesi ölçüldü.
//   Konum cümlesi YALNIZ resmî il listesinden kurulur (il-kurum.json, SYGM
//   tanıtım belgeleri). Coğrafi bölge/yön iddiası veri kaydında olmadığından
//   YAZILMAZ (uydurma yasağı); iller havzaya kısmen girebilir — şerh, il
//   bölümünün kaynak notunda ve SSS cevabında.
const konumIller = havzaIl?.iller ?? [];
const ilVe = (d) => (d.length > 1 ? `${d.slice(0, -1).join(', ')} ve ${d.at(-1)}` : (d[0] ?? ''));
const konumCumlesi = konumIller.length >= 2
  ? (konumIller.length <= 5
      ? `${giris.data.baslik} ${ilVe(konumIller)} illerini kapsar.`
      : `${giris.data.baslik}, aralarında ${konumIller.slice(0, 3).join(', ')} de bulunan ${konumIller.length} ilin topraklarını kapsar.`)
  : '';

const cumleler = [];
// 1) Ad + yağış alanı + yüzey suyu potansiyeli (DSİ 2024)
if (vd) {
  const parcalar = [];
  if (vd.yagisAlani_km2 != null) parcalar.push(`${sayi(vd.yagisAlani_km2, 0)} km² yağış alanı`);
  if (vd.yuzeysuyuPotansiyeli_km3 != null)
    parcalar.push(`${sayi(vd.yuzeysuyuPotansiyeli_km3, 2)} km³/yıl yüzey suyu potansiyeli`);
  if (parcalar.length)
    cumleler.push(`${konumCumlesi ? 'Havza' : giris.data.baslik}, DSİ ${vd.yuzeysuyuYili ?? 2024} verisine göre ${parcalar.join(' ve ')}ne sahiptir.`);
}
// 2) GRACE eğilimi (son 5 yıl gerçek aylardan) — "değişim, mutlak miktar değil".
//    Hesap tek bakım noktasından (grace-hesap.js).
const gkayit = graceHavza.havzalar?.[giris.data.baslik];
const gSonuc = gkayit ? graceEgilim(gkayit.seri) : null;
if (gSonuc) {
  cumleler.push(
    gSonuc.yon === 'sabit'
      ? `GRACE uydu ölçümüne göre son 5 yılda toplam su depolaması belirgin değişim göstermemektedir (değişim verisidir, mutlak miktar değildir).`
      : `GRACE uydu ölçümüne göre son 5 yılda toplam su depolaması ${gSonuc.yon} eğilimindedir (değişim verisidir, mutlak miktar değildir).`
  );
}
if (konumCumlesi) cumleler.unshift(konumCumlesi);
// 280 bütçesi (geo-audit "oz-cevap-uzun" eşiği): sıra öncelikli — konum →
// su varlığı → GRACE. Bütçeyi aşan İLK cümlede kesilir (soncul bilgiler
// kendi bölümlerinde zaten var; kırpılmış yarım cümle basılmaz).
const ozParcalar = [];
for (const c of cumleler) {
  if ([...ozParcalar, c].join(' ').length > 280) break;
  ozParcalar.push(c);
}
const havzaOzCevap = ozParcalar.join(' ');
// Meta description: merkezî kırpım (Sayfa.astro) cümle ortasında yarım sayı
// bırakabiliyordu ("1,62…") — "emin" dili için TAM cümle bütçesi: 160'a
// sığan cümle öneki (konum → su varlığı). 150-160 hedefinden sapma bilinçli:
// cümle bütünlüğü dolgu metne tercih edildi (rapor/havza-talep.md).
const descParcalar = [];
for (const c of cumleler) {
  if ([...descParcalar, c].join(' ').length > 160) break;
  descParcalar.push(c);
}
const aciklama = descParcalar.join(' ') || havzaOzCevap || giris.data.ozet;

// 28.09.2026 (GSC-CTR, FREEZE-İSTİSNA): havza title deseni — YAS/kuyu/rezerv
// niyeti; nehir sayfasından (akış/kol/dökülür) anlamsal olarak ayrışır
// (de-cannibalization). Yıl build anında hesaplanır.
const YIL = new Date().getFullYear();
const havzaAd = /Havzası\s*$/.test(giris.data.baslik)
  ? giris.data.baslik
  : `${giris.data.baslik} Havzası`;
const tarayiciBaslik = `${havzaAd} Su Rezervi ve DSİ Kuyu İzinleri (${YIL}) | Su Haritası`;
if (tarayiciBaslik.length > 100)
  throw new Error(`havza "${giris.id}": title ${tarayiciBaslik.length} karakter (>100)`);
const h1Baslik = konumCumlesi ? `${giris.data.baslik} nerede, hangi illeri kapsar?` : giris.data.baslik;

// — FAQPage JSON-LD: YAS potansiyeli öz-cevabı (AI-arama alıntısı). Tek
//   kaynak havza-yas-geo.js; verisi yoksa şema eklenmez (uydurma yok).
const yasGeo = havzaYasGeo(giris.data.no);
// Damga (kalanlar paketi 25.08.2026): sayfanın dayandığı veri kayıtlarının
// en yeni künye tarihi (DSİ/SYGM künyeleri · EPİAŞ günlük · GRACE işleme ·
// havza metninin son gerçek değişikliği). Build saati DEĞİL — sahte tazelik yok.
const damgaISO = enYeni(
  TARIH.havzaVeri, TARIH.baraj, TARIH.grace,
  (giris.data.guncelleme ?? giris.data.tarih).toISOString().slice(0, 10),
);
// SSS soruları ölçülen sorgu kalıplarından — YALNIZ veriyle cevaplananlar
// (havza-talep briefi Faz 3.1): nerede · hangi iller · YAS potansiyeli.
// "Açık havza mı kapalı havza mı" sorusu KONULMAZ: havza bazlı tahsis
// sınıflaması hiçbir veri kaydında yok (25/25 tahsis=null ölçüldü);
// cevabı veriden gelmeyen soru şemaya giremez.
const sss = [];
if (konumCumlesi) {
  sss.push({
    soru: `${giris.data.baslik} nerede?`,
    cevap: `${konumCumlesi} Türkiye'nin 25 su havzasından biridir (DSİ). İller havzaya kısmen girebilir; il listesi resmî havza tanıtım belgesinden derlendi.`,
  });
  sss.push({
    soru: `${giris.data.baslik} hangi illeri kapsar?`,
    cevap: `${ilVe(konumIller)}. İller havzaya kısmen girebilir; liste resmî havza belgesinden derlendi (derleme: ${derleme}).`,
  });
}
if (yasGeo) {
  sss.push({
    soru: `${giris.data.baslik} yeraltı suyu potansiyeli nedir?`,
    cevap: yasGeo.cumle,
  });
}
// V7.0 · spec 4.1 — havza sayfasına Legislation + Dataset (GRACE-FO) eklenir;
// LegalService zaten Sayfa.astro @graph'ında site geneli tanımlıdır.
// UYDURMA YASAĞI: RG kısıt kararı numarası URETILMEZ; yalnız kanun künyesi
// ve doğrulanmış veri kaydı referansı verilir.
const kok = new URL('/', Astro.site).href;
const canonical = new URL(`/havzalar/${giris.id}/`, Astro.site).href;
const semalar = [
  ...(sss.length
    ? [{
        '@type': 'FAQPage',
        ...(damgaISO ? { dateModified: damgaISO } : {}),
        mainEntity: sss.map((s) => ({
          '@type': 'Question',
          name: s.soru,
          acceptedAnswer: { '@type': 'Answer', text: s.cevap },
        })),
      }]
    : []),
  {
    '@type': 'Legislation',
    name: '167 sayılı Yeraltı Suları Hakkında Kanun',
    legislationIdentifier: '167',
    legislationType: 'Kanun',
    jurisdiction: { '@type': 'Country', name: 'Türkiye' },
    url: new URL('/mevzuat/167/', Astro.site).href,
    inLanguage: 'tr-TR',
  },
  {
    '@type': 'Dataset',
    '@id': `${canonical}#akifer`,
    name: `${giris.data.baslik} — uydu (GRACE-FO) yeraltı su depolaması eğilimi`,
    description:
      'NASA GRACE-FO yerçekimi ölçümünden türetilen aylık yeraltı su depolaması anomalisi eğilimi; havza veri kaydından okunur.',
    variableMeasured: 'Yerçekimi uydu (GRACE-FO) yeraltı su depolaması anomalisi',
    spatialCoverage: { '@type': 'Place', name: giris.data.baslik },
    creator: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' },
    isAccessibleForFree: true,
    inLanguage: 'tr-TR',
  },
];
---
<Sayfa baslik={giris.data.baslik} tarayiciBaslik={tarayiciBaslik} aciklama={aciklama} sema={semalar}>
{giris.data.kalip === 2 ? (
  <Fragment>
    {/* ——— KALIP 2 (DESIGN.md §17, pilot): kahraman veri bandı + katmanlı
        sunum. Çifte özet yasağı: SayfaBasi'ya ozet GEÇİLMEZ — görünür tek
        özet OzCevap'tır (ozet, liste kartları + og metni olarak yaşar).
        Yayılım notu: eski kalıpla ortak hukuk/il-kurum işaretlemesi yayılım
        fazında tekilleştirilir; pilotta eski yol bilerek DOKUNULMAMIŞTIR. */}
    <SayfaBasi etiket="Havza" baslik={h1Baslik} tarih={damgaISO ? new Date(damgaISO) : undefined} />

    <HavzaKahraman havzaNo={giris.data.no} havzaBaslik={giris.data.baslik} />

    {havzaOzCevap && <OzCevap metin={havzaOzCevap} />}

    {ilSatirlari.length > 0 && (
      <Katman baslik="İller ve yetkili kurumlar" ipucu={`${ilSatirlari.length} il · DSİ bölgeleri · su idareleri`} ton="murekkep">
        <section class="il-kurum">
          <h2>Havzada hangi iller ve yetkili kurumlar var?</h2>
      {konum && (
        <figure class="konum">
          <svg viewBox={`0 0 ${HARITA_EN} ${HARITA_BOY}`} width={HARITA_EN} height={HARITA_BOY}
               role="img" aria-labelledby={`konum-baslik-${giris.id}`} xmlns="http://www.w3.org/2000/svg">
            <title id={`konum-baslik-${giris.id}`}>{giris.data.baslik} — kapsadığı {konum.iller.length} il Türkiye haritasında işaretli</title>
            <path d={ULKE_YOLU} fill="#DFE9F0" stroke="#B9CEDC" stroke-width="0.5" />
            <path d={konum.yol} fill="#0C5A7C" fill-opacity="0.88" stroke="#08405A" stroke-width="0.6" stroke-linejoin="round" />
          </svg>
          <figcaption>
            Koyu alan bu havzanın kapsadığı {konum.iller.length} ildir; havza sınırı değildir.
            İller havzalara kısmen girebilir.
          </figcaption>
        </figure>
      )}
          <div class="tablo-kaydir" tabindex="0" role="region">
            <table>
              <thead>
                <tr>
                  <th>İl</th>
                  <th>DSİ bölge müdürlüğü</th>
                  <th>Su ve kanalizasyon idaresi</th>
                </tr>
              </thead>
              <tbody>
                {ilSatirlari.map((s) => (
                  <tr>
                    <td>{s.ilYolu ? <a href={s.ilYolu}>{s.il}</a> : s.il}</td>
                    <td>{s.bolge ?? <span class="veri-yok">veri yok</span>}</td>
                    <td>{s.suIdaresi}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="kaynak-notu">
            İl listesi resmî havza belgesinden derlendi
            (<a href={havzaIl.kaynak} target="_blank" rel="noopener">kaynak</a>);
            iller havzaya kısmen girebilir.
            {havzaIl.not ? ` ${havzaIl.not}.` : ''}{' '}
            Büyükşehir olmayan illerde köy içme suları İl Özel İdaresi / belediye
            görev alanındadır. Derleme: {ilKurum.derlemeTarihi}.
            Açık/kapalı havza sınıflaması: havza bazlı tahsis ve kısıt
            kararları resmî kaynakta kamuya açık ve derli biçimde
            yayımlanmadığından bu sitede sınıflama verisi yer almaz;
            doğrulanmamış bilgi yazılmaz.
          </p>
        </section>
      </Katman>
    )}


    <Katman baslik="Resmî yeraltısuyu verisi" ipucu="DSİ Tablo 1.3 / 1.6 · yıl serileri">
      <HavzaYasBandi havzaNo={giris.data.no} havzaBaslik={giris.data.baslik} />
    </Katman>

    <Katman baslik="Havza profili" ipucu="su varlığı · planlama ve koruma · veri notu">
      <div class="icerik">
        <Content />
      </div>
    </Katman>

    <Katman baslik="Baraj doluluk" ipucu="günlük kayıt · EPİAŞ Şeffaflık">
      <BarajDoluluk havzaBaslik={giris.data.baslik} />
    </Katman>

    <Katman baslik="Su depolaması eğilimi" ipucu="GRACE uydu ölçümü · tam şerh">
      <GraceEgilim havzaBaslik={giris.data.baslik} />
    </Katman>

    <Katman baslik="Akifer su tablası göstergesi" ipucu="10 yıl · GRACE + DSİ YAS · veri-koşullu">
      <HavzaSuTablasiGostergesi no={giris.data.no} ad={giris.data.baslik} />
    </Katman>

    {hukuk && (
      <Katman baslik="Bu havzada hukuki durum" ipucu="izin rejimi · kısıtlar · rehberler" ton="kehribar">
        <section class="hukuk">
          <h2>Bu havzada hukuki durum nedir?</h2>

          <div class="hukuk-govde" set:html={hukuk.cerceve} />

          <div class="hukuk-kisit">
            <p class="hukuk-alt-baslik">Havzaya özgü kısıtlar</p>
            {hukuk.kisitlar
              ? <Fragment set:html={hukuk.kisitlar} />
              : (
                <p class="veri-yok">
                  Havzaya özgü kısıt verisi: doğrulanmadı ({derleme}). Kapalı havza
                  ilanı, kuyu derinliği sınırı veya çekim kısıtı gibi havza bazlı
                  kararlar resmî kaynakta kamuya açık ve derli biçimde
                  yayımlanmadığından bu alan boş bırakılmıştır; doğrulanmamış bilgi
                  yazılmaz.
                </p>
              )}
          </div>

          {hukukRehberleri.length > 0 && (
            <nav class="hukuk-rehberler" aria-label="Havzayla ilgili rehberler">
              <p class="hukuk-alt-baslik">Bu havzada işinize yarayacak rehberler</p>
              <ul>
                {hukukRehberleri.map((r) => (
                  <li><a href={`/rehberler/${r.id}/`}>{r.data.baslik}</a></li>
                ))}
              </ul>
            </nav>
          )}
        </section>
      </Katman>
    )}


    <Katman baslik="Kaynak künyesi" ipucu="resmî kaynak bağlantıları · eylem planı" ton="murekkep">
      <dl class="kunye kunye-katman">
        {alanlar.map((a) => (
          <div class="kunye-satir">
            <dt>{a.ad}</dt>
            <dd>
              {a.deger
                ? <Fragment set:html={a.deger} />
                : <span class="veri-yok">veri yok ({derleme})</span>}
            </dd>
          </div>
        ))}
      </dl>
    </Katman>
  </Fragment>
) : (
  <Fragment>
  <SayfaBasi etiket="Havza" baslik={h1Baslik} ozet={giris.data.ozet} tarih={damgaISO ? new Date(damgaISO) : undefined} />

  {havzaOzCevap && <OzCevap metin={havzaOzCevap} />}

  {ilSatirlari.length > 0 && (
    <section class="il-kurum">
      <h2>Havzada hangi iller ve yetkili kurumlar var?</h2>
      {konum && (
        <figure class="konum">
          <svg viewBox={`0 0 ${HARITA_EN} ${HARITA_BOY}`} width={HARITA_EN} height={HARITA_BOY}
               role="img" aria-labelledby={`konum-baslik-${giris.id}`} xmlns="http://www.w3.org/2000/svg">
            <title id={`konum-baslik-${giris.id}`}>{giris.data.baslik} — kapsadığı {konum.iller.length} il Türkiye haritasında işaretli</title>
            <path d={ULKE_YOLU} fill="#DFE9F0" stroke="#B9CEDC" stroke-width="0.5" />
            <path d={konum.yol} fill="#0C5A7C" fill-opacity="0.88" stroke="#08405A" stroke-width="0.6" stroke-linejoin="round" />
          </svg>
          <figcaption>
            Koyu alan bu havzanın kapsadığı {konum.iller.length} ildir; havza sınırı değildir.
            İller havzalara kısmen girebilir.
          </figcaption>
        </figure>
      )}
      <div class="tablo-kaydir" tabindex="0" role="region">
        <table>
          <thead>
            <tr>
              <th>İl</th>
              <th>DSİ bölge müdürlüğü</th>
              <th>Su ve kanalizasyon idaresi</th>
            </tr>
          </thead>
          <tbody>
            {ilSatirlari.map((s) => (
              <tr>
                <td>{s.ilYolu ? <a href={s.ilYolu}>{s.il}</a> : s.il}</td>
                <td>{s.bolge ?? <span class="veri-yok">veri yok</span>}</td>
                <td>{s.suIdaresi}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="kaynak-notu">
        İl listesi resmî havza belgesinden derlendi
        (<a href={havzaIl.kaynak} target="_blank" rel="noopener">kaynak</a>);
        iller havzaya kısmen girebilir.
        {havzaIl.not ? ` ${havzaIl.not}.` : ''}{' '}
        Büyükşehir olmayan illerde köy içme suları İl Özel İdaresi / belediye
        görev alanındadır. Derleme: {ilKurum.derlemeTarihi}.
        Açık/kapalı havza sınıflaması: havza bazlı tahsis ve kısıt kararları
        resmî kaynakta kamuya açık ve derli biçimde yayımlanmadığından bu
        sitede sınıflama verisi yer almaz; doğrulanmamış bilgi yazılmaz.
      </p>
    </section>
  )}


  <dl class="kunye">
    {alanlar.map((a) => (
      <div class="kunye-satir">
        <dt>{a.ad}</dt>
        <dd>
          {a.deger
            ? <Fragment set:html={a.deger} />
            : <span class="veri-yok">veri yok ({derleme})</span>}
        </dd>
      </div>
    ))}
  </dl>

  <HavzaYasBandi havzaNo={giris.data.no} havzaBaslik={giris.data.baslik} />

  <div class="icerik">
    <Content />
  </div>

  <BarajDoluluk havzaBaslik={giris.data.baslik} />

  <GraceEgilim havzaBaslik={giris.data.baslik} />

  <HavzaSuTablasiGostergesi no={giris.data.no} ad={giris.data.baslik} />

  {hukuk && (
    <section class="hukuk">
      <h2>Bu havzada hukuki durum nedir?</h2>

      <div class="hukuk-govde" set:html={hukuk.cerceve} />

      <div class="hukuk-kisit">
        <p class="hukuk-alt-baslik">Havzaya özgü kısıtlar</p>
        {hukuk.kisitlar
          ? <Fragment set:html={hukuk.kisitlar} />
          : (
            <p class="veri-yok">
              Havzaya özgü kısıt verisi: doğrulanmadı ({derleme}). Kapalı havza
              ilanı, kuyu derinliği sınırı veya çekim kısıtı gibi havza bazlı
              kararlar resmî kaynakta kamuya açık ve derli biçimde
              yayımlanmadığından bu alan boş bırakılmıştır; doğrulanmamış bilgi
              yazılmaz.
            </p>
          )}
      </div>

      {hukukRehberleri.length > 0 && (
        <nav class="hukuk-rehberler" aria-label="Havzayla ilgili rehberler">
          <p class="hukuk-alt-baslik">Bu havzada işinize yarayacak rehberler</p>
          <ul>
            {hukukRehberleri.map((r) => (
              <li><a href={`/rehberler/${r.id}/`}>{r.data.baslik}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </section>
  )}

  </Fragment>
)}

{kesisenHavzalar.length > 0 && (
  <section aria-label="Aynı illeri kapsayan havzalar">
    <h2>Aynı illeri kapsayan diğer havzalar hangileri?</h2>
    <nav class="capraz">
      {kesisenHavzalar.map((x) => <a href={`/havzalar/${x.id}/`}>&rarr; {x.ad}</a>)}
    </nav>
  </section>
)}

{/* Geo-schema brief V2 (10.09.2026) — "Mevzuat" çapraz link bloğu. "İlişkili
    Havzalar" yukarıda (kesisenHavzalar); bu blok havza sayfasını mevzuat
    merkezine bağlar. Yalnız GENEL bağlantılar (uydurma yok) — havzaya özgü
    rehberler, varsa, yukarıdaki hukuk bloğunda listelenir. */}
<section aria-label="İlgili mevzuat">
  <h2>İlgili su mevzuatı</h2>
  <nav class="capraz">
    <a href="/su-kanunu/">&rarr; Su Kanunu ve mevzuat kütüphanesi</a>
    <a href="/rehberler/">&rarr; Su hukuku rehberleri</a>
  </nav>
</section>

{/* Yüksek niyetli hukuki rehber köprüsü (13.09.2026): havza sayfası
    "su nerede / hangi kurum" cevabını veriyor; bu blok "peki izin, ceza,
    ihtilaf?" sorusunu adım adım rehberlere bağlar. Ölçüm: coğrafya→rehber
    doğrudan bağ 0'dı (rapor/08-09-gsc-ticari-whatsapp.md B6c). */}
<HukukKopru />
<CtaBlok konu={`${giris.data.baslik} — su hukuku`} baslik="Havzanızdaki izin ve kısıtlar için destek" metin="Kuyu ruhsatı, su tahsisi, işletme sahası veya kamulaştırma uyuşmazlığında erken hukuki adım sonucu değiştirir." />

{/* 24.08 (agustos-uyum M5.7): göl/nehir sayfalarının geri bağı — ada kalmaz.
    Eşleme geometrik örneklemdir (gol-nehir-cografya.js); şerh blok sonunda. */}
{(havzaGolleri.length > 0 || havzaNehirleri.length > 0) && (
  <section aria-label="Havzada örneklenen göller ve akarsular">
    <h2>Havzada hangi göller ve akarsular var?</h2>
    {havzaGolleri.length > 0 && (
      <nav class="capraz" aria-label="Havzadaki göller">
        {havzaGolleri.map((g) => <a href={`/goller/${g.slug}/`}>&rarr; {g.ad}</a>)}
      </nav>
    )}
    {havzaNehirleri.length > 0 && (
      <nav class="capraz" aria-label="Havzadaki akarsular">
        {havzaNehirleri.map((n) => <a href={`/nehirler/${n.slug}/`}>&rarr; {n.ad}</a>)}
      </nav>
    )}
    <p class="hidro-serh">Liste, OSM/Natural Earth hidrografya verisinin
      (erişim 04.08.2026) havza sınırlarıyla geometrik kesişiminden türetilmiştir;
      hidrografik envanter yerine geçmez.</p>
  </section>
)}

  {/* 27.08 denetimi K9: hukuki şerh (kullanıcı onaylı) */}
  <HukukSerhi />
</Sayfa>

