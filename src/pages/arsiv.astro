---
// VERİ ARŞİVİ — /arsiv/ (vitrin briefi FAZ 2).
// Sitedeki sayıların dayandığı veri setlerinin KÜNYE listesi. Editoryal metin
// YAZILMAZ (brief): her set kaynak + kapsam + sayım + erişim biçimiyle durur.
// Sayıların TAMAMI build anında gerçek dosyalardan sayılır (src/data/vitrin.js).
// Tasarım: mevcut içerik sayfası dili (Sayfa + SayfaBasi + OzCevap + mono künye
// bandı); yeni renk/font/desen İCAT EDİLMEZ.
import Sayfa from '../layouts/Sayfa.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import { TARIH, enYeni } from '../data/guncellik.js';
// Damga (25.08.2026): arşivdeki veri setlerinin künye tarihlerinin en yenisi.
const damgaISO = enYeni(TARIH.baraj, TARIH.grace, TARIH.potansiyel, TARIH.golNehir, TARIH.havzaVeri);
import OzCevap from '../components/OzCevap.astro';
import { ARSIV_SETLERI, ARSIV_OZ_CEVAP, KAPATMA_KAYITLARI, KAPATMA_OZET, KAPATMA_SERHI } from '../data/vitrin.js';

const canonical = new URL('/arsiv/', Astro.site).href;

const sema = [
  {
    '@type': 'WebPage',
    ...(damgaISO ? { dateModified: damgaISO } : {}),
    name: 'Veri arşivi',
    description: ARSIV_OZ_CEVAP,
    url: canonical,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': `${new URL('/', Astro.site).href}#site` },
  },
  {
    '@type': 'ItemList',
    name: 'Su Haritası veri setleri',
    numberOfItems: ARSIV_SETLERI.length,
    itemListElement: ARSIV_SETLERI.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.ad,
    })),
  },
  // Dataset şeması (gsc-mcp turu 25.08.2026, brief 5.3): AI sistemlerinin
  // veri kaynağını tanıması için. Her alan ARSIV_SETLERI'nin KAYITLI
  // alanlarından; kurum varlığı uydurulmaz (kaynak metni description'da),
  // lisans alanı bilinmediği için YAZILMAZ. temporalCoverage yalnız
  // kapsam alanı yıl aralığıysa basılır.
  {
    '@type': 'DataCatalog',
    name: 'Su Haritası veri arşivi',
    description: ARSIV_OZ_CEVAP,
    url: canonical,
    inLanguage: 'tr-TR',
    dataset: ARSIV_SETLERI.map((s) => ({
      '@type': 'Dataset',
      name: s.ad,
      description: `${s.sayim}. Kaynak: ${s.kaynak}. ${s.erisim}`,
      ...(/^\d{4}/.test(s.kapsam) ? { temporalCoverage: s.kapsam } : {}),
      url: new URL(s.yol, Astro.site).href,
      isAccessibleForFree: true,
    })),
  },
];
---
<Sayfa baslik="Veri arşivi" aciklama={ARSIV_OZ_CEVAP} sema={sema}>
  <SayfaBasi etiket="Veri ve yöntem" baslik="Veri arşivi" tarih={damgaISO ? new Date(damgaISO) : undefined} />
  <OzCevap metin={ARSIV_OZ_CEVAP} />

  <h2 id="setler">Hangi veri setleri kullanılıyor?</h2>

  <ol class="ar-liste">
    {ARSIV_SETLERI.map((s) => (
      <li>
        <h3>{s.ad}</h3>
        <dl class="ar-kunye">
          <div><dt>Kaynak</dt><dd>{s.kaynak}</dd></div>
          <div><dt>Kapsam</dt><dd>{s.kapsam}</dd></div>
          <div><dt>Sayım</dt><dd>{s.sayim}</dd></div>
          <div><dt>Erişim</dt><dd>{s.erisim}</dd></div>
        </dl>
        <p class="ar-git"><a href={s.yol}>Sitede nerede görünüyor →</a></p>
      </li>
    ))}
  </ol>

  <h2 id="kapatma">Tahsise kapatma ve kısıt kayıtları</h2>

  <p class="ar-kapatma-giris">
    Taranan Resmî Gazete kayıtları arasında yasak ya da kısıt hükmü içeren
    {KAPATMA_OZET.sayi} ilan pasajı bulundu ({KAPATMA_OZET.ilkYil}-{KAPATMA_OZET.sonYil}).
    Aşağıda tarih sırasıyla, Resmî Gazete'nin kendi metninden alıntıyla
    listelenmiştir.
  </p>

  <p class="ar-kapatma-serh">{KAPATMA_SERHI}</p>

  <p class="ar-kapatma-sorgu">
    Bir yer adının bu kayıtlarda geçip geçmediğini
    <a href="/kapatma-kaydi/">tek soruluk sorgu sayfasından</a> arayabilirsiniz.
  </p>

  <p class="ar-kapatma-sayi-serh">
    * işaretli gazete sayıları Resmî Gazete arşiv bağlantısından türetilmiştir
    (ilan kayıtları sayıyı ayrı alan olarak vermez). Yöntem, sayısı künyeli
    109 kayıtta sınandı: 109/109 eşleşti, çelişen 0. Sayısı türetilemeyen
    kayıtlarda alan boş bırakılmıştır.
  </p>

  <ol class="ar-kapatma">
    {KAPATMA_KAYITLARI.map((k) => (
      <li>
        <p class="ar-kapatma-kunye">
          RG {k.tarih}
          {k.sayi != null && <> · Sayı {k.sayi}{k.sayiKaynak === 'cikarim' && '*'}</>}
          {' '}· {k.durum}
        </p>
        <p class="ar-kapatma-pasaj">&#8220;{k.pasaj}&#8230;&#8221;</p>
        <p class="ar-kapatma-git">
          <a href={k.url} rel="nofollow">Resmî Gazete kaydı</a>
        </p>
      </li>
    ))}
  </ol>

  <p class="ar-serh">
    Sayımlar her yayında veri dosyalarından yeniden hesaplanır; elle yazılmaz.
    Kaynak lisansları ve erişim tarihleri için
    <a href="/hakkinda/">hakkında sayfasındaki</a> kaynak kaydına bakınız.
  </p>
</Sayfa>

<style>
  .ar-liste {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .ar-liste > li {
    padding: 1rem 1.2rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
  }

  .ar-liste h3 {
    font-family: var(--serif);
    font-size: 1.12rem;
    font-weight: 500;
    margin: 0 0 0.6rem;
  }

  /* Künye ızgarası: il sayfasındaki .pot-morf veri bandıyla aynı dil */
  .ar-kunye { margin: 0; }

  .ar-kunye div {
    display: grid;
    grid-template-columns: minmax(6rem, 8rem) 1fr;
    gap: 0.3rem 1.2rem;
    padding: 0.4rem 0;
  }

  .ar-kunye div + div { border-top: 1px solid var(--cizgi); }

  .ar-kunye dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metin-soluk);
  }

  .ar-kunye dd { margin: 0; font-size: 0.93rem; }

  .ar-git { margin: 0.7rem 0 0; font-size: 0.9rem; }

  .ar-serh {
    margin-top: 1.6rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--cizgi);
    font-size: 0.88rem;
    color: var(--metin-soluk);
  }

  @media (max-width: 560px) {
    .ar-kunye div { grid-template-columns: 1fr; gap: 0.1rem; }
  }

  .ar-kapatma-giris { max-width: 66ch; }

  /* Şerh kutusu: il bloklarındaki dürüstlük etiketiyle aynı görünüm */
  .ar-kapatma-serh {
    margin: 0 0 1.4rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--cizgi);
    border-left: 3px solid var(--kehribar);
    font-size: 0.88rem;
    color: var(--metin-soluk);
    max-width: 66ch;
  }

  .ar-kapatma-sayi-serh {
    margin: -0.8rem 0 1.4rem;
    font-size: 0.82rem;
    color: var(--metin-soluk);
    max-width: 66ch;
  }

  .ar-kapatma { list-style: none; padding: 0; display: grid; gap: 0.9rem; }

  .ar-kapatma > li {
    padding: 0.9rem 1.1rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
  }

  .ar-kapatma-kunye {
    margin: 0 0 0.4rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--metin-soluk);
  }

  /* Alıntı: IlPotansiyel'deki .pot-pasaj ile aynı dil */
  .ar-kapatma-pasaj {
    margin: 0;
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .ar-kapatma-git { margin: 0.5rem 0 0; font-size: 0.88rem; }
</style>
