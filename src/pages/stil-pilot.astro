---
// STİL PİLOTU — FAZ 0 örnek sayfası (DESIGN.md 2.0 anayasasının canlı kanıtı).
// İçerik: kuyu-ruhsati rehberinin AYNISI (collection'dan; kopya değil, aynı
// kaynak) — değişen yalnız giydirme. Mevcut sayfalara DOKUNULMAZ; kullanıcı
// bu sayfayı canlıda onaylarsa dil FAZ 1'de tüm iş sayfalarına taşınır.
// noindex + sitemap dışı: pilot, arama motorlarına açılmaz.
import { getCollection, render } from 'astro:content';
import { YAZAR } from '../data/site';
import AcilDestekBar from '../components/AcilDestekBar.astro';

const giris = (await getCollection('rehberler')).find((g) => g.id === 'kuyu-ruhsati');
if (!giris) throw new Error('stil-pilot: kuyu-ruhsati bulunamadı');
const { Content } = await render(giris);

const ilgili = (await getCollection('rehberler')).filter((g) =>
  giris.data.ilgili.includes(g.id)
);
// Kart kimliği: küme → ton ailesi (anayasa §7)
const aile = { surec: 'suyesili', uyusmazlik: 'kehribar' };

const tarihYaz = giris.data.tarih.toLocaleDateString('tr-TR', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Stil pilotu — kuyu ruhsatı (DESIGN 2.0) — Su Haritası</title>
<meta name="description" content="Tasarım anayasası 2.0 örnek sayfası — onay için pilot." />
<meta name="robots" content="noindex, nofollow" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="stylesheet" href="/fonts/fonts.css" />
<style is:global>
  /* ═══ DESIGN 2.0 token seti (anayasa §4-8) — pilot kapsamı ═══ */
  :root {
    /* SU-DİLİ derinlik skalası (DESIGN 3.0 — tonlar HEDEF görselinden) */
    --krem: #E9F0F4;             /* YÜZEY */
    --kart: #DFE9F0;             /* YÜZEY-kart */
    --murekkep: #132A3F;
    --soluk: #4E6478;
    --baglanti: #0C5A7C;
    --su-cizgi: #2E7EA0;         /* SIĞ — dekoratif */
    --vurgu: #0C5A7C;            /* DERİN petrol — vurgu sesi (6.3:1) */
    --vurgu-hairline: #2E7EA0;
    --dip: #0A2740;
    --kehribar-hair: #C0883A;
    --kehribar-metin: #875518;
    --suyesili: #2C5570;
    --cizgi: rgba(19, 42, 63, 0.14);

    --serif: "Cormorant", Georgia, serif;
    --sans: "Manrope", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;

    /* Akış — suyun ivmesi (anayasa §3) */
    --e-suzul: cubic-bezier(0.22, 1, 0.36, 1);
    --e-kabar: cubic-bezier(0.35, 0, 0.15, 1);
    --e-akinti: cubic-bezier(0.45, 0.05, 0.55, 0.95);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--krem);
    color: var(--murekkep);
    font-family: var(--sans);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  a { color: var(--baglanti); transition: color 120ms var(--e-akinti); }
  a:hover { color: var(--vurgu); }

  a:focus-visible, button:focus-visible {
    outline: 2px solid var(--vurgu);
    outline-offset: 3px;
  }

  /* ── Üst şerit: pilot kimliği ── */
  .pilot-serit {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--dip);
    color: #DBEAF4;
    padding: 0.5rem clamp(1.25rem, 4vw, 2rem);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .pilot-serit a { color: #57BAE0; text-decoration: none; }
  .pilot-serit a:hover { color: #FFFFFF; }

  header.ust {
    border-bottom: 1px solid var(--cizgi);
    padding: 0.9rem clamp(1.25rem, 4vw, 2rem);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .marka { font-family: var(--serif); font-style: italic; font-weight: 500;
    font-size: 1.3rem; color: var(--murekkep); text-decoration: none; }
  .ust-meta { font-family: var(--mono); font-size: 0.66rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--soluk); }

  main { max-width: 46rem; margin: 0 auto;
    padding: clamp(2.2rem, 6vh, 3.5rem) clamp(1.25rem, 4vw, 2rem) 5rem; }

  /* ═══ §6 KICKER SİSTEMİ ═══ */
  .kicker {
    display: flex; align-items: center; gap: 0.7rem;
    font-family: var(--mono); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--vurgu);
  }
  .kicker::before { content: ""; width: 1.6rem; height: 1px;
    background: var(--vurgu-hairline); }
  .kicker-sub { margin-top: 0.3rem; font-family: var(--mono);
    font-size: 0.68rem; color: var(--soluk); letter-spacing: 0.06em; }

  h1 {
    margin-top: 0.9rem;
    font-family: var(--serif); font-weight: 500;
    font-size: clamp(2.1rem, 4.8vw, 3.1rem); line-height: 1.14;
    letter-spacing: -0.01em; text-wrap: balance;
  }
  h1 em {
    font-style: italic;
    background: linear-gradient(105deg, #0C5A7C 0%, #2E7EA0 45%, #186789 60%, #0C5A7C 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .sayfa-kunye { margin-top: 0.9rem; font-family: var(--mono);
    font-size: 0.7rem; letter-spacing: 0.05em; color: var(--soluk);
    display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .sayfa-kunye a { color: var(--baglanti); }

  .su-hatti { width: 100%; height: 1px; border: 0; margin: 1.3rem 0 0;
    background: linear-gradient(90deg, rgba(78,134,168,0) 0%,
      var(--su-cizgi) 14%, var(--su-cizgi) 62%, rgba(78,134,168,0) 100%); }

  /* ═══ §9 VERİ BANDI ═══ */
  .veri-bandi {
    margin: 1.8rem 0 0; padding: 1.1rem 1.3rem 1.1rem 1.7rem;
    background: var(--kart); border: 1px solid var(--cizgi);
    border-top: 2px solid var(--vurgu);
    position: relative;
  }
  /* Kot cetveli: su seviyesi göstergesi imzası */
  .veri-bandi::before {
    content: ""; position: absolute; left: 0.55rem; top: 0.9rem; bottom: 0.9rem;
    width: 6px;
    background: repeating-linear-gradient(180deg,
      rgba(46, 126, 160, 0.4) 0 1px, transparent 1px 7px),
      linear-gradient(90deg, rgba(46, 126, 160, 0.4) 0 1px, transparent 1px);
  }
  .veri-bandi-ic {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
  }
  @media (max-width: 560px) { .veri-bandi-ic { grid-template-columns: 1fr; } }
  .veri-bandi .rakam { font-family: var(--serif); font-weight: 500;
    font-size: 2rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .veri-bandi .etiket { font-family: var(--mono); font-size: 0.62rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--soluk);
    margin-top: 0.25rem; }
  .veri-kaynak { grid-column: 1 / -1; font-family: var(--mono);
    font-size: 0.62rem; color: var(--soluk); border-top: 1px solid var(--cizgi);
    padding-top: 0.6rem; }

  /* ── Öz cevap (anayasa diliyle) ── */
  .oz-cevap {
    margin: 1.8rem 0 0; padding: 1.1rem 1.3rem;
    border-left: 3px solid var(--vurgu-hairline);
    background: rgba(12, 90, 124, 0.05);
    font-size: 1.06rem; line-height: 1.6; font-weight: 500; max-width: 66ch;
  }
  .oz-cevap .oz-etiket { display: block; font-family: var(--mono);
    font-weight: 500; font-size: 0.64rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--vurgu); margin-bottom: 0.45rem; }

  /* ═══ İçerik: bölüm kicker'ları CSS sayaçla (içerikten türeyen numara) ═══ */
  .icerik { counter-reset: bolum; margin-top: 1rem; }
  .icerik h2 {
    counter-increment: bolum;
    font-family: var(--serif); font-weight: 500; font-size: 1.7rem;
    line-height: 1.25; margin: 2.6rem 0 0.8rem;
  }
  .icerik h2::before {
    content: "BÖLÜM " counter(bolum, decimal-leading-zero);
    display: flex; align-items: center; gap: 0.7rem;
    font-family: var(--mono); font-size: 0.66rem; font-weight: 500;
    letter-spacing: 0.22em; color: var(--vurgu); margin-bottom: 0.55rem;
  }
  .icerik h2::after { content: ""; display: block; width: 2.6rem; height: 1px;
    background: var(--vurgu-hairline); margin-top: 0.55rem; }

  .icerik p { margin: 0.9rem 0; max-width: 68ch; }
  .icerik ul, .icerik ol { margin: 0.9rem 0 0.9rem 1.3rem; max-width: 66ch; }
  .icerik li { margin: 0.35rem 0; }
  .icerik a { text-decoration-thickness: 1px; text-underline-offset: 3px;
    transition: color 120ms var(--e-akinti), text-decoration-thickness 120ms var(--e-akinti); }
  .icerik a:hover { text-decoration-thickness: 2px; }

  .icerik blockquote {
    margin: 1.4rem 0; padding: 0.85rem 1.1rem;
    border-left: 3px solid var(--vurgu-hairline);
    background: rgba(19, 42, 63, 0.035);
    color: var(--soluk); font-family: var(--serif); font-size: 1.1rem;
  }

  .icerik table { width: 100%; border-collapse: collapse; margin: 1.4rem 0;
    font-size: 0.95rem; }
  .icerik th {
    font-family: var(--mono); font-weight: 500; font-size: 0.66rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--soluk);
    background: var(--kart); text-align: left; padding: 0.55rem 0.7rem;
    border-bottom: 2px solid var(--vurgu);
  }
  .icerik td { text-align: left; padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--cizgi); vertical-align: top; }
  .icerik tbody tr { transition: background-color 120ms var(--e-akinti); }
  .icerik tbody tr:hover { background: rgba(12, 90, 124, 0.05); }

  /* ═══ §7 KART KİMLİKLERİ — ilgili rehberler ═══ */
  .ilgili { margin-top: 3rem; }
  .ilgili-kartlar { display: grid; gap: 0.8rem; margin-top: 1rem; }
  .kart {
    display: block; padding: 1rem 1.2rem; text-decoration: none;
    background: var(--kart); border: 1px solid var(--cizgi);
    border-top: 2px solid var(--ton, var(--vurgu));
    transition: transform 240ms var(--e-suzul), background-color 240ms var(--e-akinti);
  }
  .kart:hover { transform: translateY(-2px); background: var(--ton-zemin, var(--kart)); }
  .kart:active { transform: translateY(0) scale(0.985); transition-duration: 120ms; }
  .kart.suyesili { --ton: var(--suyesili); --ton-metin: var(--suyesili); --ton-zemin: rgba(44, 85, 112, 0.07); }
  .kart.kehribar { --ton: var(--kehribar-hair); --ton-metin: var(--kehribar-metin); --ton-zemin: rgba(192, 136, 58, 0.08); }
  .kart-kicker { font-family: var(--mono); font-size: 0.62rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--ton-metin, var(--ton)); }
  .kart-baslik { display: block; margin-top: 0.35rem; font-family: var(--serif);
    font-weight: 500; font-size: 1.18rem; line-height: 1.3; color: var(--murekkep); }
  .kart-ozet { display: block; margin-top: 0.3rem; font-size: 0.85rem;
    line-height: 1.55; color: var(--soluk); }

  /* ── Yazar kutusu (mürekkep ailesi) ── */
  .yazar { margin-top: 3rem; padding: 1.2rem 1.3rem; background: var(--kart);
    border: 1px solid var(--cizgi); border-top: 2px solid var(--murekkep); }
  .yazar .kart-kicker { color: var(--murekkep); }
  .yazar-ad { font-family: var(--serif); font-size: 1.3rem; font-weight: 500;
    margin-top: 0.35rem; }
  .yazar-bio { margin-top: 0.45rem; font-size: 0.9rem; color: var(--soluk);
    max-width: 62ch; }
  .yazar-meta { margin-top: 0.6rem; font-family: var(--mono); font-size: 0.7rem;
    letter-spacing: 0.05em; }

  footer { border-top: 1px solid var(--cizgi); margin-top: 4rem;
    padding: 1.4rem; text-align: center; font-family: var(--mono);
    font-size: 0.68rem; letter-spacing: 0.08em; color: var(--soluk); }
  footer a { color: var(--soluk); text-decoration: none; }
  footer a:hover { color: var(--murekkep); }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
</head>
<body>
  <div class="pilot-serit">
    <span>STİL PİLOTU — DESIGN 2.0 ÖRNEK SAYFA · ONAY BEKLİYOR</span>
    <a href="/rehberler/kuyu-ruhsati/">mevcut sayfayla karşılaştır →</a>
  </div>

  <header class="ust">
    <a class="marka" href="/">su haritası</a>
    <span class="ust-meta">Rehber · Süreç</span>
  </header>

  <main>
    <p class="kicker">Rehber · Süreç</p>
    <p class="kicker-sub">167 sayılı Kanun rejimi — {tarihYaz}</p>
    <h1>Kuyu ruhsatı: yeraltı suyunun <em>üç belgesi</em></h1>
    <p class="sayfa-kunye">
      <span>GÜNCELLEME: {tarihYaz}</span>
      <span>HUKUKİ İÇERİK: <a href="/hakkinda/">{YAZAR.ad}</a></span>
    </p>
    <hr class="su-hatti" />

    <div class="veri-bandi"><div class="veri-bandi-ic">
      <div><div class="rakam">3</div><div class="etiket">Belge zinciri: arama · kullanma · ıslah-tadil</div></div>
      <div><div class="rakam">1 ay</div><div class="etiket">Başvuruya cevap süresi (Tüzük m.13)</div></div>
      <div><div class="rakam">0</div><div class="etiket">Harç, damga, rüsum — muaf (167 m.12)</div></div>
      <div class="veri-kaynak">KAYNAK: 167 sayılı Kanun + Yeraltı Suları Tüzüğü — sayfadaki madde metinlerinden; {tarihYaz}</div>
    </div></div>

    <p class="oz-cevap">
      <span class="oz-etiket">Öz cevap — 10 saniyede</span>
      {giris.data.ozCevap}
    </p>

    <div class="icerik">
      <Content />
    </div>

    <section class="yazar">
      <p class="kart-kicker">Bu rehberi hazırlayan</p>
      <p class="yazar-ad">{YAZAR.ad}</p>
      <p class="yazar-bio">{YAZAR.bio}</p>
      <p class="yazar-meta">
        <a href={YAZAR.buroUrl} target="_blank" rel="noopener">{YAZAR.buro}</a> ·
        <a href="/hakkinda/">portal hakkında</a>
      </p>
    </section>

    <section class="ilgili">
      <p class="kicker">Sonraki adım</p>
      <h2 style="font-family: var(--serif); font-weight: 500; font-size: 1.7rem; margin-top: 0.6rem;">
        İlgili <em>rehberler</em>
      </h2>
      <div class="ilgili-kartlar">
        {ilgili.map((g) => (
          <a class={`kart ${aile[g.data.kume]}`} href={`/rehberler/${g.id}/`}>
            <span class="kart-kicker">{g.data.kume === 'surec' ? 'Rehber · Süreç' : 'Rehber · Uyuşmazlık'}</span>
            <span class="kart-baslik">{g.data.baslik}</span>
            <span class="kart-ozet">{g.data.ozet.slice(0, 110)}…</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer>
    <a href="https://arslanhukuk.tr" target="_blank" rel="noopener">suharitasi.com · Arslan Hukuk Bürosu güvencesiyle · 2026</a>
  </footer>
  <AcilDestekBar />
</body>
</html>
