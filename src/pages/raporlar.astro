---
// B2B RAPORLAR LANDING PAGE — /raporlar/
// 25 havza icin PDF indirme kartlari + kurumsal rapor talep CTA'si.
import Sayfa from '../layouts/Sayfa.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import OzCevap from '../components/OzCevap.astro';
import Katman from '../components/Katman.astro';
import havzaVeri from '../../data/havza-veri.json';
import { tumHavzaRiskleri } from '../data/havza-risk.js';

const riskler = tumHavzaRiskleri();
const riskHaritasi = Object.fromEntries(riskler.map((r) => [r.ad, r]));

function raporSlug(ad) {
  return ad.toLowerCase()
    .replace(/ı/g, 'i').replace(/ğ/g, 'g').replace(/ü/g, 'u')
    .replace(/ş/g, 's').replace(/ö/g, 'o').replace(/ç/g, 'c')
    .replace(/havzası/g, '')
    .replace(/\s+/g, '-');
}

function raporUrl(ad) {
  return `/rapor/suharitasi-${raporSlug(ad)}-durum-raporu.pdf`;
}

const aylar = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
const bugun = new Date();
const ayAdi = aylar[bugun.getMonth()];
const yil = bugun.getFullYear();

const ozet = 'Türkiye\'nin 25 su havzası için DSİ, GRACE ve EPİAŞ verilerinden derlenen '
  + 'B2B su durum raporları. Her rapor A4 PDF formatında; havza su potansiyeli, '
  + 'baraj doluluk tablosu, GRACE uydu eğilimi, risk puanı ve yetkili kurum '
  + 'iletişim bilgilerini içerir. Ücretsiz örnek raporu indirin; tam kurumsal '
  + 'rapor için iletişime geçin.';

const sema = [{
  '@type': 'ItemList',
  name: 'B2B Havza Su Durum Raporları',
  description: ozet,
  numberOfItems: havzaVeri.havzalar.length,
}];
---

<Sayfa baslik="B2B Havza Su Durum Raporları — PDF İndir" aciklama={ozet} sema={sema}>
  <SayfaBasi etiket="Raporlar" baslik="B2B Havza Su Durum Raporları" />

  <OzCevap metin={ozet} />

  <Katman baslik={`${ayAdi} ${yil} Raporları`} ipucu={`${havzaVeri.havzalar.length} havza · A4 PDF · DSİ+GRACE+EPİAŞ`}>
    <div class="rapor-grid">
      {havzaVeri.havzalar.map((h) => {
        const risk = riskHaritasi[h.ad];
        return (
          <div class="rapor-kart">
            <div class="rapor-baslik">
              <span class="rapor-ad">{h.ad}</span>
              {risk && (
                <span class="risk-badge" style={`background:${risk.renk}`}>
                  {risk.puan}/100
                </span>
              )}
            </div>
            <div class="rapor-meta">
              {h.yagisAlani_km2 && <span>{h.yagisAlani_km2.toLocaleString('tr-TR')} km²</span>}
              {h.yuzeysuyuPotansiyeli_km3 && <span>{h.yuzeysuyuPotansiyeli_km3} km³/yıl</span>}
            </div>
            <div class="rapor-eylem">
              <a href={raporUrl(h.ad)} download class="btn-indir">
                PDF İndir
              </a>
              <a href={`/havzalar/${raporSlug(h.ad)}/`} class="btn-detay">
                Havza Sayfası
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </Katman>

  <Katman baslik="Tam Kurumsal Rapor Talep Edin" ipucu="özelleştirilmiş · sektörel kırılımlı · hukuki analizli" ton="kehribar">
    <div class="kurumsal-cta">
      <p class="kurumsal-metin">
        Yukarıdaki örnek raporlar yalnızca kamuya açık verilerden otomatik
        üretilmiştir ve hukuki görüş içermez. <strong>Tam kurumsal rapor</strong> için:
      </p>
      <ul class="kurumsal-liste">
        <li>Havzanızdaki sektörel su tahsis durumu</li>
        <li>İl/ilçe bazlı yeraltı suyu potansiyeli detayı</li>
        <li>Ruhsat başvurusu risk değerlendirmesi</li>
        <li>Su hukuku çerçevesinde uyum takvimi</li>
        <li>Yetkili kurumlarla yazışma stratejisi</li>
      </ul>
      <div class="kurumsal-eylem">
        <a href="mailto:serdar@arslanhukuk.com?subject=Kurumsal%20Su%20Durum%20Raporu%20Talebi" class="btn-kurumsal">
          Tam Kurumsal Rapor Talep Et
        </a>
        <span class="kurumsal-alt">5-25k TL bandında · 5 iş günü</span>
      </div>
    </div>
  </Katman>

  <Katman baslik="Rapor İçeriği" ipucu="her raporda neler var" ton="murekkep">
    <div class="icerik-listesi">
      <div class="icerik-oge">
        <strong>DSİ Resmi Veri Künyesi</strong>
        <p>Yağış alanı, yüzey suyu ve YAS potansiyeli, işletme rezervi (DSİ 2024).</p>
      </div>
      <div class="icerik-oge">
        <strong>GRACE Uydu Su Depolaması Eğilimi</strong>
        <p>Son 5 yıllık aylık toplam su depolaması değişimi (NASA GSFC).</p>
      </div>
      <div class="icerik-oge">
        <strong>Baraj Doluluk Tablosu</strong>
        <p>EPİAŞ günlük verisinden havzadaki enerji barajlarının anlık doluluk yüzdeleri.</p>
      </div>
      <div class="icerik-oge">
        <strong>Bileşik Risk Puanı</strong>
        <p>6 göstergeden hesaplanan 0-100 su riski skoru ve yorumu.</p>
      </div>
      <div class="icerik-oge">
        <strong>Yetkili Kurum İletişim Listesi</strong>
        <p>Havzadaki her il için DSİ bölge müdürlüğü ve su idaresi bilgisi.</p>
      </div>
    </div>
  </Katman>
</Sayfa>

<style>
  .rapor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 0.8rem; }
  .rapor-kart {
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .rapor-baslik { display: flex; align-items: center; gap: 0.5rem; }
  .rapor-ad { font-family: var(--serif); font-size: 1rem; font-weight: 500; color: var(--metin); flex: 1; }
  .risk-badge { color: #fff; font-size: 0.68rem; font-weight: 600; padding: 0.15rem 0.4rem; white-space: nowrap; }
  .rapor-meta { display: flex; gap: 0.8rem; font-size: 0.72rem; color: var(--metin-soluk); font-family: var(--mono); }
  .rapor-eylem { display: flex; gap: 0.5rem; margin-top: 0.2rem; }
  .btn-indir {
    display: inline-block;
    padding: 0.45rem 1rem;
    background: var(--su-700, #0C5A7C);
    color: #fff;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: var(--mono);
  }
  .btn-indir:hover { background: var(--su-800, #08405A); }
  .btn-detay {
    display: inline-block;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--cizgi);
    color: var(--metin-soluk);
    text-decoration: none;
    font-size: 0.78rem;
    font-family: var(--mono);
  }
  .btn-detay:hover { background: var(--zemin-kart-hover, #f0f4f7); }

  .kurumsal-cta { padding: 0.4rem 0; }
  .kurumsal-metin { font-size: 0.95rem; color: var(--metin); margin-bottom: 0.8rem; }
  .kurumsal-liste { margin: 0 0 1rem 1.2rem; font-size: 0.9rem; color: var(--metin); }
  .kurumsal-liste li { margin: 0.3rem 0; }
  .kurumsal-eylem { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .btn-kurumsal {
    display: inline-block;
    padding: 0.7rem 1.6rem;
    background: var(--kehribar-600, #875518);
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--mono);
  }
  .btn-kurumsal:hover { background: var(--kehribar-700, #6B4212); }
  .kurumsal-alt { font-size: 0.78rem; color: var(--metin-soluk); }

  .icerik-listesi { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem; }
  .icerik-oge { padding: 0.8rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); }
  .icerik-oge strong { display: block; font-size: 0.88rem; margin-bottom: 0.3rem; color: var(--metin); }
  .icerik-oge p { font-size: 0.8rem; color: var(--metin-soluk); margin: 0; }

  @media (max-width: 560px) {
    .rapor-grid { grid-template-columns: 1fr; }
    .icerik-listesi { grid-template-columns: 1fr; }
  }
</style>
