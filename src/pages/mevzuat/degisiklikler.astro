---
// /mevzuat/degisiklikler/ — MEVZUAT DEĞİŞİKLİK RADARI (13.09.2026).
// Takip edilen kanun/tüzük/yönetmeliklerin resmî metni düzenli taranır; her
// maddenin SHA-256 özeti karşılaştırılır. Bu sayfa son kontrolü, izlenen
// mevzuatı ve değişiklik günlüğünü gösterir. Uydurma yok — resmî metnin farkı.
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import OzCevap from '../../components/OzCevap.astro';
import CtaBlok from '../../components/CtaBlok.astro';
import HukukSerhi from '../../components/HukukSerhi.astro';
import surum from '../../../data/kamu/mevzuat-surum.json';
import log from '../../../data/kamu/mevzuat-degisiklik.json';

// P3 (05.10.2026): kısmi tarama hatası artık görünür — "9/9 kontrol" sanısı yok.
const HATA_SAYISI = Number((surum as any).hata_sayisi ?? 0);

const OZ_CEVAP =
  'Su hukuku mevzuatı yaşayan bir metindir. Bu radar, 167 sayılı Kanun, Yeraltı ' +
  'Suları Tüzüğü, Su Tahsisleri Yönetmeliği ve ilgili kanunların resmî metnini ' +
  'düzenli tarar; madde eklenir, kaldırılır veya değişirse farkı kaydeder. ' +
  'Böylece hangi hükmün ne zaman değiştiğini kaynağıyla izleyebilirsiniz.';

const kok = new URL('/', Astro.site).href;
const canonical = new URL('/mevzuat/degisiklikler/', Astro.site).href;

const MEVZUAT_AD = {
  '167': ['167 Sayılı Yeraltı Suları Hakkında Kanun', 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=167&MevzuatTur=1&MevzuatTertip=4'],
  'YAS Tüzüğü': ['Yeraltı Suları Tüzüğü', 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=51465&MevzuatTur=2&MevzuatTertip=4'],
  'Su Tahsisleri Yön.': ['Su Tahsisleri Hakkında Yönetmelik', 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=34021&MevzuatTur=7&MevzuatTertip=5'],
  '2942': ['2942 Sayılı Kamulaştırma Kanunu', 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=2942&MevzuatTur=1&MevzuatTertip=5'],
  '2886': ['2886 Sayılı Devlet İhale Kanunu', 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=2886&MevzuatTur=1&MevzuatTertip=5'],
  '831': ['831 Sayılı Sular Hakkında Kanun', 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=831&MevzuatTur=1&MevzuatTertip=3'],
  '5686': ['5686 Sayılı Jeotermal Kaynaklar ve Doğal Mineralli Sular Kanunu', 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=5686&MevzuatTur=1&MevzuatTertip=5'],
  '5393': ['5393 Sayılı Belediye Kanunu', 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=5393&MevzuatTur=1&MevzuatTertip=5'],
  '6200': ['6200 Sayılı DSİ Kanunu', 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=6200&MevzuatTur=1&MevzuatTertip=3'],
};

const izlenen = Object.entries(surum.mevzuatlar || {}).map(([k, maddeler]) => ({
  kisa: k,
  ad: MEVZUAT_AD[k]?.[0] ?? k,
  url: MEVZUAT_AD[k]?.[1] ?? '#',
  madde: Object.keys(maddeler).length,
}));
const toplamMadde = izlenen.reduce((t, x) => t + x.madde, 0);
const kayitlar = (log.kayitlar || []).slice(0, 50);

const trTarih = (iso) => (iso || '').replace('T', ' ').slice(0, 16);

const sema = [
  {
    '@type': 'Dataset',
    '@id': `${canonical}#veri`,
    name: 'Su hukuku mevzuat değişiklik günlüğü',
    description: OZ_CEVAP,
    creator: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' },
    isAccessibleForFree: true,
    inLanguage: 'tr-TR',
    temporalCoverage: '2026/..',
    numberOfItems: kayitlar.length,
  },
  { '@type': 'WebPage', '@id': `${canonical}#sayfa`, url: canonical, name: 'Mevzuat değişiklik radarı', description: OZ_CEVAP, inLanguage: 'tr-TR', ...(surum.son_kontrol ? { dateModified: String(surum.son_kontrol).slice(0, 10) } : {}), isPartOf: { '@id': `${kok}#site` } },
];
---
<Sayfa baslik="Mevzuat değişiklik radarı" aciklama={OZ_CEVAP} tarayiciBaslik="Mevzuat Değişiklik Radarı: Su Hukuku Canlı Takip" sema={sema}>
  <SayfaBasi etiket="Canlı mevzuat" baslik="Mevzuat değişiklik radarı" ozet={`${izlenen.length} mevzuat, ${toplamMadde} madde düzenli taranır.`} />
  <OzCevap metin={OZ_CEVAP} etiket="Kanun özeti" />

  <p class="mr-durum">Son kontrol: <strong>{trTarih(surum.son_kontrol)}</strong> · izlenen <strong>{izlenen.length}</strong> mevzuat · <strong>{toplamMadde}</strong> madde.</p>
  {HATA_SAYISI > 0 && (
    <p class="mr-durum" role="status">Uyarı: son taramada <strong>{HATA_SAYISI}</strong> kaynak erişilemedi ({(surum as any).erisilemeyenler?.join(', ')}); bu mevzuatlar için önceki kayıt korundu.</p>
  )}

  <section class="mr-bolum" aria-label="İzlenen mevzuat">
    <h2>İzlenen mevzuat</h2>
    <div class="mr-kaydir" tabindex="0" role="region">
      <table class="mr-tablo">
        <caption>Mevzuat · izlenen madde sayısı · resmî kaynak.</caption>
        <thead><tr><th scope="col">Mevzuat</th><th scope="col">İzlenen madde</th><th scope="col">Resmî kaynak</th></tr></thead>
        <tbody>
          {izlenen.map((m) => (
            <tr>
              <th scope="row">{m.ad}</th>
              <td>{m.madde}</td>
              <td><a href={m.url} target="_blank" rel="noopener">mevzuat.gov.tr</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mr-bolum" aria-label="Değişiklik günlüğü">
    <h2>Değişiklik günlüğü</h2>
    {kayitlar.length === 0 ? (
      <p class="mr-bos">İlk anlık görüntü alındı; henüz değişiklik tespit edilmedi. Radar her taramada madde özetlerini karşılaştırır; bir hüküm eklenir, kaldırılır veya değişirse burada görünür.</p>
    ) : (
      <ul class="mr-liste">
        {kayitlar.map((k) => (
          <li>
            <span class={`mr-tip mr-${k.tip}`}>{k.tip}</span>
            <span class="mr-kunye">{trTarih(k.tarih)} · {k.kanun} · {k.madde}</span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="mr-bolum mr-takip" aria-label="Değişiklik takibi">
    <h2>Değişiklik olunca haber alın</h2>
    <p>Bir hüküm değiştiğinde e-posta ile bilgilendirilmek için adresinizi bırakın. (Gönderim servisi bağlandığında aktive edilir; aboneler şimdiden kaydedilir.)</p>
    <form id="takip-form" class="mr-form">
      <label>E-posta
        <input type="email" name="eposta" required autocomplete="email" placeholder="ornek@eposta.com" />
      </label>
      <label class="mr-onay">
        <input type="checkbox" name="onay" required />
        <span><a href="/gizlilik/">Gizlilik ve KVKK</a> metnini okudum; e-postamın yalnız mevzuat değişikliği bildirimi için işlenmesine onay veriyorum.</span>
      </label>
      <div class="mr-tuzak" aria-hidden="true">Boş bırakın <input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
      <button type="submit">Takip et</button>
      <p class="mr-form-durum" id="takip-durum" aria-live="polite"></p>
    </form>
  </section>

  <nav class="mr-capraz" aria-label="İlgili bölümler">
    <a href="/mevzuat/">→ Mevzuat maddeleri (madde madde)</a>
    <a href="/su-hukuku/">→ Su hukuku omurga sayfası</a>
    <a href="/emsal-kararlar/">→ Emsal kararlar</a>
  </nav>

  <CtaBlok konu="Mevzuat değişikliği" baslik="Değişen hüküm dosyanızı etkiliyor mu?" metin="Mevzuat değişikliğinin somut durumunuza etkisini değerlendirelim." />
  <HukukSerhi />
<script slot="ek-script" type="module" src="/s/takip.js" is:inline></script>
</Sayfa>


<style>
  .mr-durum { font-size: 0.92rem; color: var(--metin-soluk); margin-bottom: 1.2rem; }
  .mr-bolum { margin-bottom: 2rem; }
  .mr-bolum h2 { font-family: var(--serif); font-weight: 500; font-size: 1.4rem; margin-bottom: 0.7rem; }
  .mr-kaydir { overflow-x: auto; }
  .mr-tablo { width: 100%; border-collapse: collapse; font-size: 0.86rem; min-width: 40rem; }
  .mr-tablo caption { caption-side: top; text-align: left; font-size: 0.78rem; color: var(--metin-soluk); padding-bottom: 0.5rem; }
  .mr-tablo th, .mr-tablo td { text-align: left; vertical-align: top; padding: 0.55rem 0.65rem; border-bottom: 1px solid var(--cizgi); }
  .mr-tablo thead th { font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--metin-soluk); background: var(--zemin); border-bottom: 2px solid var(--su-700); }
  .mr-tablo tbody th { font-family: var(--serif); font-size: 0.98rem; font-weight: 500; }
  .mr-bos { color: var(--metin-soluk); font-style: italic; max-width: 70ch; }
  .mr-liste { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .mr-liste li { display: flex; gap: 0.7rem; align-items: baseline; padding: 0.5rem 0.7rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); border-left: 3px solid var(--su-400); }
  .mr-tip { font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.05rem 0.35rem; border: 1px solid var(--cizgi); }
  .mr-eklendi { color: var(--yesil-kara); }
  .mr-kaldirildi { color: #8a1f17; }
  .mr-degisti { color: var(--kehribar-metin); }
  .mr-kunye { font-size: 0.9rem; }
  .mr-form { display: flex; flex-direction: column; gap: 0.5rem; max-width: 26rem; }
  .mr-form label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.9rem; }
  .mr-form input { font: inherit; padding: 0.6rem 0.7rem; min-height: 44px; border: 1px solid var(--cizgi); background: var(--zemin-kart); color: var(--metin); }
  .mr-form button { font: inherit; font-weight: 600; padding: 0.7rem 1.4rem; min-height: 46px; background: var(--su-700); color: #fff; border: 0; border-radius: 2px; cursor: pointer; width: fit-content; }
  .mr-tuzak { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .mr-onay { flex-direction: row !important; align-items: flex-start; gap: 0.5rem !important; font-size: 0.84rem; }
  .mr-onay input { width: auto; min-height: auto; margin-top: 0.2rem; }
  .mr-form-durum { font-weight: 500; }
  .mr-capraz { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-top: 1.4rem; padding-top: 1rem; border-top: 1px solid var(--cizgi); }
  .mr-capraz a { color: var(--baglanti); text-decoration: none; }
</style>
