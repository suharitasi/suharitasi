---
// /mevzuat/[kanun]/[madde]/ — bağımsız madde sayfası (13.09.2026).
// Metin birebir; ilgili rehberlere ve emsal kararlara çapraz bağlı.
import Sayfa from '../../../layouts/Sayfa.astro';
import { TARIH } from '../../../data/guncellik.js';
import SayfaBasi from '../../../components/SayfaBasi.astro';
import OzCevap from '../../../components/OzCevap.astro';
import CtaBlok from '../../../components/CtaBlok.astro';
import HukukSerhi from '../../../components/HukukSerhi.astro';
import mevzuat from '../../../../data/kamu/mevzuat-maddeleri.json';
import { emsalById as EMSAL_ID, dogrulandiMi, emsalYol, tamMerci } from '../../../data/emsal.js';
import { MEVZUAT_EDITORYAL } from '../../../data/mevzuat-editoryal.js';
import SayfaQr from '../../../components/SayfaQr.astro';
import CezaTutarTablosu from '../../../components/CezaTutarTablosu.astro';
import { cezaYerlestir } from '../../../data/ceza-tutar.js';
// eeat-audit (27.09.2026): yazar kutusu mevzuat madde sayfalarına bağlandı.
import YazarKutusu from '../../../components/YazarKutusu.astro';
// 07.10.2026 denetimi (sahip kararı EK-2/1): başlık/açıklama/öz-cevap ve dizin
// kararı tek yardımcıdan (src/data/mevzuat-metin.js) — kelime ortası kırpım yok,
// gövdesiz/kesik sayfa veri-koşullu noindex (metin tamamlanınca kendiliğinden açılır).
import { maddeTarayiciBaslik, maddeAciklama, maddeOzCevap, metinDurumu } from '../../../data/mevzuat-metin.js';
import { maddeDizinKarari } from '../../../data/mevzuat-dizin.js';
import { komsuMaddeler, maddeYolu, maddeyiAnanRehberler, resmiKontrol, degisiklikIsaretleri } from '../../../data/madde-baglari.js';
import { EMSAL_DOGRULANAN, emsalAlinti, kunyeKisa } from '../../../data/emsal.js';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const slug = (s) =>
    s.toLowerCase().replace(/ı/g, 'i').replace(/İ/g, 'i').replace(/ş/g, 's')
      .replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ö/g, 'o').replace(/ç/g, 'c')
      .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return mevzuat.maddeler.map((m) => ({
    params: { kanun: slug(m.kanunKisa), madde: slug(m.madde) },
    props: { m },
  }));
}

function slugla(s) {
  return s.toLowerCase().replace(/ı/g, 'i').replace(/İ/g, 'i').replace(/ş/g, 's')
    .replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ö/g, 'o').replace(/ç/g, 'c')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const { m } = Astro.props;
const emsalById = EMSAL_ID;
const ilgiliEmsaller = m.emsaller.map((id) => emsalById[id]).filter(Boolean);

const kok = new URL('/', Astro.site).href;
const canonical = new URL(`/mevzuat/${slugla(m.kanunKisa)}/${slugla(m.madde)}/`, Astro.site).href;

// Kısa başlık yoksa madde künyesine düş (uydurma başlık üretilmez).
const baslikMetni = m.baslik || m.madde;

// P2 (24.09.2026): yalnız yüksek niyetli 3 madde için editoryal katman
// (mevzuat-editoryal.js). Yoksa hiçbir şey değişmez.
const editoryal = MEVZUAT_EDITORYAL[`${m.kanunKisa}|${m.madde}`] ?? null;

// Öz cevap: maddenin kendi resmî metninden, kelime sınırında ≤280 (GEO bandı).
const oz = maddeOzCevap(m);
// Meta açıklama HAM metni: kırpımı Sayfa.astro'nun merkezî cümle/kelime sınırı kuralı yapar.
const aciklama = maddeAciklama(m);
// <title> ≤60: kanun adını içeren ilk sığan aday (editoryal seoBaslik öncelikli).
const tarayiciBaslik = maddeTarayiciBaslik(m, editoryal);
// Dizin kararı: gövdesi olmayan (boş / yalnız mülga notu), kesik ya da yürürlük
// tablosu artığı taşıyan madde noindex alır; sitemap ve llms üreticileri bu
// işareti okuyup sayfayı atlar (adres değişmez, sayfa silinmez).
// 10.10.2026 (brif 2.2): su ile bağı olmayan ve yalnız yürürlük/yürütme bildiren maddeler de kapalı (src/data/mevzuat-dizin.js).
const indekslenir = maddeDizinKarari(m).dizin;
const { onceki, sonraki } = komsuMaddeler(m);
const rehberAd = Object.fromEntries((await getCollection('rehberler')).map((r) => [r.id, r.data.baslik]));
const tumRehberler = [...new Set([...m.rehberler, ...maddeyiAnanRehberler(m)])].filter((r) => rehberAd[r]);
const buYol = maddeYolu(m);
const ananKararlar = EMSAL_DOGRULANAN.filter((k) => !m.emsaller.includes(k.id) && (emsalAlinti(k)?.anilanMaddeler ?? []).some((a) => a.yol === buYol));
const kontrol = resmiKontrol(m);
const isaretler = degisiklikIsaretleri(m.metin);
const h1 = m.baslik ? `${m.kanun} — ${m.madde}: ${m.baslik}` : `${m.kanun} — ${m.madde}`;
const durum = metinDurumu(m.metin);

const sema = [
  {
    '@type': 'Legislation',
    '@id': `${canonical}#madde`,
    name: `${m.kanun} — ${m.madde}`,
    legislationIdentifier: m.madde,
    legislationType: m.tur,
    text: m.metin,
    inLanguage: 'tr-TR',
    url: canonical,
    sameAs: m.kaynakUrl,
  },
  {
    '@type': 'Article',
    headline: `${m.kanun} ${m.madde}${m.baslik ? `: ${m.baslik}` : ''}`,
    description: oz,
    inLanguage: 'tr-TR',
    about: { '@id': `${canonical}#madde` },
    author: { '@id': `${kok}#yazar` },
    publisher: { '@id': `${kok}#kurum` },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#sayfa`,
    url: canonical,
    name: `${m.kanun} ${m.madde}`,
    description: oz,
    inLanguage: 'tr-TR',
    ...(TARIH.mevzuat ? { dateModified: TARIH.mevzuat } : {}),
    isPartOf: { '@id': `${kok}#site` },
    about: { '@id': `${canonical}#madde` },
  },
];
---
<Sayfa baslik={h1} aciklama={aciklama} tarayiciBaslik={tarayiciBaslik} sema={sema} robots={indekslenir ? undefined : 'noindex, follow'}>
  <SayfaBasi etiket={`${m.tur} · madde`} baslik={h1} ozet={m.baslik ? undefined : baslikMetni} />
  <OzCevap metin={oz} etiket="Madde özeti" />

  {editoryal && (
    <section class="mv-bolum mv-editoryal" aria-label="Pratik karşılık">
      <h2>{editoryal.h2}</h2>
      <p class="mv-yorum">{editoryal.ozet}</p>
      {editoryal.baglar?.length > 0 && (
        <nav class="mv-capraz" aria-label="İlgili sayfalar">
          {editoryal.baglar.map((b) => <a href={b.yol}>→ {b.ad}</a>)}
        </nav>
      )}
      {editoryal.not && <p class="mv-veri-yok">{editoryal.not}</p>}
    </section>
  )}

  <section class="mv-bolum" aria-label="Resmî madde metni">
    <h2>Resmî madde metni</h2>
    <blockquote class="mv-metin">{m.metin}</blockquote>
  </section>

  <p class="mv-kaynak">
    Kaynak: <a href={m.kaynakUrl} target="_blank" rel="noopener">resmî tam metin (mevzuat.gov.tr)</a>.
    Metin resmî kaynaktan birebir aktarılmıştır; yürürlükteki güncel metin için resmî kaynak esastır.
    {kontrol.kapsamda && kontrol.tarih && <> Resmî metin son kontrol: <time>{kontrol.tarih}</time> (haftalık karşılaştırma{kontrol.kayitlar.length ? `; ${kontrol.kayitlar.length} değişiklik kaydı` : '; bu maddede değişiklik kaydı yok'}).</>}
  </p>

  {isaretler.length > 0 && (
    <section class="mv-bolum" aria-label="Değişiklik geçmişi">
      <h2>Değişiklik geçmişi</h2>
      <p class="mv-anonim">Resmî metnin içindeki değişiklik işaretleri (birebir):</p>
      <ul class="mv-degisiklik">{isaretler.map((x) => <li>{x}</li>)}</ul>
    </section>
  )}

  {/* Sahip kararı EK-2/1a (08.10.2026): içeriği olmayan bölüm hiç gösterilmez;
      merci/süre/yorum notu yalnız doğrulanmış veri varsa basılır. */}
  {(m.merci || m.sure) && (
    <section class="mv-bolum" aria-label="Yetkili merci ve süreler">
      <h2>Yetkili merci ve süreler</h2>
      <dl class="mv-dl">
        <div><dt>Yetkili merci</dt><dd>{m.merci ?? '—'}</dd></div>
        <div><dt>Süre / hak düşürücü</dt><dd>{m.sure ?? '—'}</dd></div>
      </dl>
    </section>
  )}

  {m.yorum && (
    <section class="mv-bolum" aria-label="Gerekçe ve yorum">
      <h2>Gerekçe / yorum</h2>
      <p class="mv-yorum">{cezaYerlestir(m.yorum)}</p>
    </section>
  )}

  {/* DURAK 1 A-a: 167 m.18 sayfasında kanun metni + yılın uygulanan tutarı, yıl yıl tablo (onay bekliyor). */}
  {m.id === '167-madde-18' && <CezaTutarTablosu />}

  {(durum.kesik || durum.kirli) && (
    <p class="mv-veri-yok">Bu maddenin aktarılan metni eksik ya da kaynak tablosu artığı içeriyor; tam metin için resmî kaynak esastır.</p>
  )}

  {tumRehberler.length > 0 && (
    <section class="mv-bolum" aria-label="Bu maddeyi kullanan rehberler">
      <h2>Bu maddeyi kullanan rehberler</h2>
      <nav class="mv-capraz">
        {tumRehberler.map((r) => <a href={`/rehberler/${r}/`}>→ {rehberAd[r]}</a>)}
      </nav>
    </section>
  )}

  {ilgiliEmsaller.length > 0 && (
    <section class="mv-bolum" aria-label="İlgili emsal kararlar">
      <h2>Bu maddeye bağlı emsal kararlar</h2>
      <ul class="mv-emsaller">
        {ilgiliEmsaller.map((k) => (
          <li>
            {dogrulandiMi(k)
              ? <><a href={emsalYol(k)}>{tamMerci(k)} {k.esas} E., {k.karar} K.</a> ({k.resmi_dogrulama.karar_tarihi}; <a href={k.resmi_dogrulama.url} target="_blank" rel="noopener">resmî metin</a>)</>
              : <><a href="/emsal-kararlar/dogrulanamadi/">{k.merci} {k.esas} E., {k.karar} K.</a> <em>(resmî kaynaktan doğrulanamadı)</em></>}
            <span> — {k.konu}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {ananKararlar.length > 0 && (
    <section class="mv-bolum" aria-label="Bu maddeyi anan kararlar">
      <h2>Karar metninde bu maddeyi anan emsal kararlar</h2>
      <ul class="mv-emsaller">{ananKararlar.map((k) => <li><a href={emsalYol(k)}>{kunyeKisa(k)}</a> ({k.resmi_dogrulama.karar_tarihi})</li>)}</ul>
    </section>
  )}

  <nav class="mv-komsu" aria-label="Önceki ve sonraki madde">
    {onceki ? <a href={maddeYolu(onceki)} rel="prev">← {onceki.madde}</a> : <span></span>}
    {sonraki ? <a href={maddeYolu(sonraki)} rel="next">{sonraki.madde} →</a> : <span></span>}
  </nav>

  <nav class="mv-capraz mv-geri" aria-label="İlgili bölümler">
    <a href="/mevzuat/">→ Tüm mevzuat maddeleri</a>
    <a href="/su-hukuku/">→ Su hukuku omurga sayfası</a>
    <a href="/islem-matrisi/">→ İşlem → yetkili kurum</a>
  </nav>

  <CtaBlok konu={`${m.kanun} ${m.madde}`} baslik="Bu maddeyi somut durumunuza uygulayalım" metin="Maddenin olayınıza nasıl uygulandığını değerlendirmek için durumunuzu iletin." />
  <SayfaQr />
  <YazarKutusu />
  <HukukSerhi />
</Sayfa>

<style>
  .mv-komsu { display: flex; justify-content: space-between; gap: 1rem; margin: 1.2rem 0; padding: 0.7rem 0; border-top: 1px solid var(--cizgi); border-bottom: 1px solid var(--cizgi); }
  .mv-degisiklik { margin: 0; padding-left: 1.2rem; font-size: 0.9rem; }
  .mv-anonim { font-size: 0.84rem; color: var(--metin-soluk); margin: 0 0 0.6rem; }
  .mv-metin {
    margin: 0.4rem 0 1.2rem;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--su-400);
    background: rgba(46, 126, 160, 0.06);
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.7;
    max-width: 70ch;
  }
  .mv-kaynak { font-size: 0.86rem; color: var(--metin-soluk); max-width: 70ch; }
  .mv-dl { display: grid; gap: 0.4rem; max-width: 70ch; }
  .mv-dl > div { display: grid; grid-template-columns: 13rem 1fr; gap: 0.6rem; }
  .mv-dl dt { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--metin-soluk); }
  .mv-dl dd { margin: 0; }
  .mv-yorum { max-width: 70ch; }
  .mv-veri-yok { color: var(--metin-soluk); font-style: italic; max-width: 70ch; }
  @media (max-width: 560px) { .mv-dl > div { grid-template-columns: 1fr; gap: 0.1rem; } }
  .mv-bolum { margin-top: 1.8rem; }
  .mv-bolum h2 { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; margin-bottom: 0.6rem; }
  .mv-emsaller { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .mv-emsaller li { font-size: 0.92rem; padding-left: 0.8rem; border-left: 2px solid var(--kehribar); }
  .mv-emsaller a { font-family: var(--serif); font-weight: 500; }
  .mv-emsaller span { color: var(--metin-soluk); }
  .mv-capraz { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-top: 0.4rem; }
  .mv-capraz a { color: var(--baglanti); text-decoration: none; }
  .mv-capraz a:hover { text-decoration: underline; }
  .mv-geri { margin-top: 1.6rem; padding-top: 1rem; border-top: 1px solid var(--cizgi); }
</style>
