---
// Harita sayfası: tam ekran hero görseli (HEDEF.png) — görünümü kendine özgü,
// Sayfa layout'u KULLANMAZ. Menü, sitenin ortak tam ekran katmanıdır
// (TamEkranMenu + /s/menu.js) — iki ayrı menü kodu dönemi kapandı (KOD-8).
// FAZ 3 (2026-07-21): hero'nun ALTINA 25 havza kartlık canlı veri paneli
// (HavzaPaneli). Hero markup/CSS'ine dokunulmadı; eski "kaydırmasız sahne"
// düzeni body'den .hero-sahne kabına taşındı ki ilk ekran birebir kalsın
// (pixel kanıtı cikti/denetim/faz3/) ve sayfa panel için kaydırılabilsin.
import TamEkranMenu from '../components/TamEkranMenu.astro';
import HavzaPaneli from '../components/HavzaPaneli.astro';
---
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Harita — Su Haritası</title>
<meta name="description" content="Türkiye'nin su haritası. Havza verisi ve etkileşimli katman yolda." />
<link rel="canonical" href="https://suharitasi.com/harita/" />
<meta property="og:title" content="Harita — Su Haritası" />
<meta property="og:description" content="Türkiye'nin su haritası. Havza verisi ve etkileşimli katman yolda." />
<meta property="og:url" content="https://suharitasi.com/harita/" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Su Haritası" />
<meta property="og:locale" content="tr_TR" />
<meta property="og:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Su Haritası — Türkiye'nin su verisi ve mevzuatı" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preload" as="image" href="/hedef-hero.v2.webp" fetchpriority="high" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap&subset=latin-ext" rel="stylesheet" />
<style is:global>
  :root {
    --deniz: #04121F;
    --kopuk: #A8DDE0;
    --akuamarin: #4FC3D0;
    --metin-soluk: #6C8A96;
    /* Ortak menü bileşeni bu tokenları bekler */
    --serif: "Cormorant", Georgia, serif;
    --sans: "Manrope", system-ui, sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { height: 100%; }

  body {
    /* Zemin: görselden ImageMagick ile üretilmiş gerçek blur dosyası.
       Koyu renk zemin YOK; anlık yedek ton da görselin orta adaçayısı. */
    background: #8A9489 url('/hedef-zemin.v1.webp') center / cover no-repeat fixed;
    font-family: system-ui, sans-serif;
    min-height: 100%;
  }

  /* Eski kaydırmasız sahnenin düzeni body'den bu kaba taşındı (FAZ 3):
     hero kompozisyonu birebir aynı (ortalanmış, 100dvh), sayfa artık
     panel için aşağı kaydırılabilir. Hero (.cerceve/.hero) CSS'i AYNEN. */
  .hero-sahne {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100dvh;
  }

  /* Tam ekran, taşmasız: görselin tamamı her zaman görünür (contain).
     Çerçeve/gölge/köşe YOK; görselin kendisine filtre/overlay YOK. */
  .cerceve {
    position: relative;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .cerceve.geldi { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .cerceve { transition: none; opacity: 1; }
  }

  .hero {
    display: block;
    max-width: 100vw;
    max-height: 100dvh;
    width: auto;
    height: auto;
    /* Dikişi erit: üst/alt kenar blur zeminine kenarsız karışır */
    -webkit-mask-image: linear-gradient(180deg,
      transparent 0, #000 46px, #000 calc(100% - 46px), transparent 100%);
    mask-image: linear-gradient(180deg,
      transparent 0, #000 46px, #000 calc(100% - 46px), transparent 100%);
  }

  /* Görsel üstünde tek öğe: sol üstteki "menü" tetikleyicisi.
     Logo, kullanıcının kendi logosu üretilince eklenecek.
     Davranış sınıfı sv-menu-ac (ortak menü); görünüm bu sayfanın kendisi. */
  .sv-menu-ac {
    position: fixed;
    top: clamp(0.9rem, 2.4vw, 1.4rem);
    left: clamp(1rem, 2.8vw, 1.7rem);
    z-index: 10;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--kopuk);
    text-shadow: 0 1px 8px rgba(4, 18, 31, 0.55);
    padding: 0.4rem 0.2rem;
    transition: color 0.25s ease;
  }

  .sv-menu-ac:hover { color: #FFFFFF; }

  .sv-menu-ac:focus-visible {
    outline: 2px solid var(--akuamarin);
    outline-offset: 4px;
  }
</style>
</head>
<body>

  <div class="hero-sahne">
    <figure class="cerceve" data-menu-dis>
      <img class="hero" src="/hedef-hero.v2.webp" alt="Türkiye'nin kabartma su haritası — sıcak gün ışığında, denizden yükselen su kavisleri ve süzülen damlalarla" fetchpriority="high" decoding="async" />
    </figure>
  </div>

  <button
    class="sv-menu-ac"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="sv-menu"
  >menü</button>

  <main data-menu-dis>
    <HavzaPaneli />
  </main>

  <TamEkranMenu />

  <script is:inline>
    const cerceve = document.querySelector('.cerceve');
    const hero = document.querySelector('.hero');
    function goster() { cerceve.classList.add('geldi'); }
    if (hero.complete) goster();
    else hero.addEventListener('load', goster);
    setTimeout(goster, 2500); // emniyet
  </script>
  <script type="module" src="/s/menu.js" is:inline></script>
</body>
</html>
