---
// Harita sayfası: tam ekran hero görseli (HEDEF.png) — görünümü kendine özgü,
// Sayfa layout'u KULLANMAZ. Menü, sitenin ortak tam ekran katmanıdır
// (TamEkranMenu + /s/menu.js) — iki ayrı menü kodu dönemi kapandı (KOD-8).
// FAZ 3 (2026-07-21): hero'nun ALTINA 25 havza kartlık canlı veri paneli
// (HavzaPaneli). Hero markup/CSS'ine dokunulmadı; eski "kaydırmasız sahne"
// düzeni body'den .hero-sahne kabına taşındı ki ilk ekran birebir kalsın
// (pixel kanıtı cikti/denetim/faz3/) ve sayfa panel için kaydırılabilsin.
// MENÜ BİRLEŞTİRME (27.07): TamEkranMenu import'u kalktı, dosya durur (M10).
//
// h1 YOKLUĞU BİLİNÇLİDİR — KULLANICI KARARI 28.07.2026.
// Bu sayfanın kuralı: SALT HERO, üstünde öğe yok. Başlık hiyerarşisi bu
// yüzden <h2> ile başlar ve <h1> HİÇ YOKTUR. Denetimlerde "h1 eksik"
// bulgusu çıkarsa TASARIM KARARIDIR, arıza değildir — düzeltilmez.
// (28.07 tam-sistem denetimi bunu bulgu olarak açmıştı; kullanıcı kapattı.)
import PaylasilanMenu from '../components/PaylasilanMenu.astro';
import HavzaPaneli from '../components/HavzaPaneli.astro';
// Hareket sözlüğü tek kaynak: /harita/ sahne rotası da --e-* eğrilerini
// buradan alır (HavzaPaneli yerel --pk-e-suzul kopyası kaldırıldı).
import '../styles/hareket.css';
// GEO/SEO açığı kapatma (2026-07-23): sağlık sistemi bu sayfada öz-cevap ve
// JSON-LD bulunmadığını raporladı. Sayfa Sayfa.astro layout'unu kullanmadığı
// için ikisi de yoktu. Şema değerleri UYDURULMAZ — panelin beslendiği aynı
// veri dosyalarından build-time türetilir.
import havzaVeri from '../../data/havza-veri.json';
import yasVeri from '../../data/canli/havza-yas.json';
import grace from '../../data/canli/grace-havza.json';
import { SITE_ADI, YAZAR, VERI_KATALOGU, KURUM_SOSYAL } from '../data/site';
import AcilDestekBar from '../components/AcilDestekBar.astro';
import CfAnalitik from '../components/CfAnalitik.astro';
import Analitik from '../components/Analitik.astro';

const KOK_URL = 'https://suharitasi.com/';
const SAYFA_URL = 'https://suharitasi.com/harita/';

const havzaSayisi = havzaVeri.havzalar.length;

// GRACE serisinin gerçek zaman aralığı (temporalCoverage uydurulmaz).
const graceAylar = Object.keys(grace.havzalar[Object.keys(grace.havzalar)[0]].seri).sort();
const graceIlk = graceAylar[0];
const graceSon = graceAylar[graceAylar.length - 1];

const dsiKunye = yasVeri.kaynak.havzaPotansiyelRezerv;
const potYil = havzaVeri.havzalar[0].yuzeysuyuYili ?? 2024;

// ÖZ-CEVAP (CLAUDE.md "cevap önce, dayanak sonra", ≤280 karakter).
// DİKKAT: bu sayfa BARAJ DOLULUĞU taşımaz (panel yorumu: "tahsis ve baraj
// karta girmez"); baraj doluluk verisi havza sayfalarındadır. Öz-cevap bu
// yüzden baraj iddiası ETMEZ — sayfanın gerçekten gösterdiğini anlatır.
const ozCevap =
  `Türkiye'nin ${havzaSayisi} su havzası tek haritada: her havzanın yüzey suyu ` +
  'potansiyeli, yeraltı suyu işletme rezervi ve uydu su ölçümüyle son 5 yılın ' +
  'yeraltı suyu eğilimi. Kartlar en hızlı azalan havzadan başlar; her kart o ' +
  'havzanın veri künyesine açılır.';
if (ozCevap.length > 280) {
  // Sessiz hata yasağı: sınır aşılırsa build DÜŞER, kırpılıp sessizce bozulmaz.
  throw new Error(`/harita/ öz-cevap ${ozCevap.length} karakter — sınır 280.`);
}

// CTR meta (04.10.2026 §55): öz-cevap 280 sınırında, meta 160 sınırına ayrı
// metin gerekir. İddialar yalnız sayfanın GERÇEK içeriği: 25 havza künyesi +
// GRACE eğilimi; baraj doluluğu bu sayfada yok → metne yazılmaz.
const metaAciklama =
  "25 su havzasının yüzey suyu potansiyeli, yeraltı suyu rezervi ve uyduyla " +
  'ölçülen son 5 yıl eğilimi; en hızlı azalan havzadan başlayan harita paneli.';
if (metaAciklama.length > 160) {
  throw new Error(`/harita/ meta ${metaAciklama.length} karakter — sınır 160.`);
}

/* JSON-LD — ŞEMA SEÇİMİ VE GEREKÇESİ
   · WebPage: sayfanın kendisi (ad, açıklama, dil, birincil görsel, site
     ilişkisi). Her sayfada olması gereken taban tip.
   · Dataset: sayfanın gövdesi bir VERİ SUNUMUDUR — 25 havza × üç ölçülen
     değişken (yüzey suyu potansiyeli km³/yıl, YAS işletme rezervi hm³/yıl,
     GRACE su depolaması eğimi cm/yıl), adlandırılmış kaynaklarla. Dataset
     Google Dataset Search'ün indekslediği tiptir ve AI-aramada "hangi veri,
     hangi kaynak, hangi dönem" sorularına doğrudan cevap verir.
   · SEÇİLMEYENLER ve NEDENİ: Map/Place — sayfa coğrafi bir yer tarif etmiyor,
     ölçüm sunuyor. Article — analiz metni yok, künye ve veri var.
     Table — sunum biçimi, içerik tipi değil. ItemList — 25 kart bir liste ama
     asıl varlık ölçülen veri; Dataset onu variableMeasured ile daha doğru
     tarif ediyor.
   · license (geo-schema brief V2, 10.09.2026 — kullanıcı kararı): TEK lisans
     URL'i uydurulmaz (kaynaklar karışık: NASA GRACE kamu malı, DSİ/SYGM açık
     resmî istatistik). Kaynak lisans niteliği metin olarak license alanına
     yazılır; yanı sıra citation + isBasedOn kullanılır.
   · distribution YAZILMADI: indirilebilir veri dosyası yayımlanmıyor. */
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'LegalService'],
      '@id': `${KOK_URL}#kurum`,
      name: SITE_ADI,
      url: KOK_URL,
      description:
        "Türkiye'nin su verisi, havzaları ve su mevzuatını tek haritada birleştiren bağımsız bilgi portalı.",
      areaServed: { '@type': 'Country', name: 'Türkiye' },
      sameAs: KURUM_SOSYAL,
      telephone: '+90 532 449 71 44',
      founder: { '@type': 'Person', name: YAZAR.adSade, jobTitle: YAZAR.unvan },
    },
    {
      '@type': 'WebSite',
      '@id': `${KOK_URL}#site`,
      name: SITE_ADI,
      url: KOK_URL,
      inLanguage: 'tr-TR',
      publisher: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' },
    },
    {
      '@type': 'WebPage',
      '@id': `${SAYFA_URL}#sayfa`,
      url: SAYFA_URL,
      name: 'Harita — Su Haritası',
      description: ozCevap,
      inLanguage: 'tr-TR',
      isPartOf: { '@id': `${KOK_URL}#site` },
      primaryImageOfPage: { '@type': 'ImageObject', url: `${KOK_URL}hedef-hero.v2.webp` },
      mainEntity: { '@id': `${SAYFA_URL}#veri` },
    },
    {
      // 04.10.2026 (§55): harita modülü etkileşimli bir web uygulamasıdır.
      // Yıldız/aggregateRating YOK — sahte değerlendirme üretilmez.
      '@type': 'SoftwareApplication',
      '@id': `${SAYFA_URL}#uygulama`,
      name: 'Su Haritası — Türkiye havza veri paneli',
      applicationCategory: 'WebApplication',
      operatingSystem: 'Web',
      url: SAYFA_URL,
      inLanguage: 'tr-TR',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
      featureList: [
        '25 havza künyesi (yüzey suyu potansiyeli, YAS işletme rezervi)',
        'GRACE uydu ölçümüyle son 5 yıl su depolaması eğilimi',
        'Havza hukuki durum köprüsü',
      ],
      publisher: { '@id': `${KOK_URL}#kurum` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', '@id': `${KOK_URL}#breadcrumb-1`, position: 1, name: 'Ana sayfa', item: KOK_URL },
        { '@type': 'ListItem', '@id': `${SAYFA_URL}#breadcrumb-2`, position: 2, name: 'Harita', item: SAYFA_URL },
      ],
    },
    {
      '@type': 'Dataset',
      '@id': `${SAYFA_URL}#veri`,
      name: `Türkiye ${havzaSayisi} su havzası — yüzey suyu potansiyeli, yeraltı suyu rezervi ve su depolaması eğilimi`,
      description:
        `Türkiye'nin ${havzaSayisi} su havzası için havza bazında yüzey suyu potansiyeli ` +
        `(DSİ ${potYil}), yeraltı suyu işletme rezervi (DSİ Tablo 1.3) ve NASA ` +
        'GRACE/GRACE-FO toplam su depolaması anomalisinin son 5 yıllık eğimi. ' +
        'GRACE değeri DEĞİŞİM verisidir (2004-2009 ortalamasına göre), mutlak su ' +
        'miktarı değildir; havza ortalamaları yarım-derece grid yaklaşığıdır.',
      inLanguage: 'tr-TR',
      isAccessibleForFree: true,
      creator: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' },
      // K6 (27.08): WebSite düğümü DataCatalog değildir — gerçek katalog düğümüne bağlandı.
      includedInDataCatalog: { '@id': `${KOK_URL}#veri-katalogu` },
      // Publisher: bu derlenmiş veri kümesini yayımlayan kurum = portalın kendisi.
      publisher: { '@type': 'Organization', name: 'Su Haritası', url: 'https://suharitasi.com' },
      spatialCoverage: { '@type': 'Place', name: 'Türkiye' },
      temporalCoverage: `${graceIlk}/${graceSon}`,
      variableMeasured: [
        { '@type': 'PropertyValue', name: 'Yüzey suyu potansiyeli', unitText: 'km³/yıl' },
        { '@type': 'PropertyValue', name: 'Yeraltı suyu işletme rezervi', unitText: 'hm³/yıl' },
        {
          '@type': 'PropertyValue',
          name: 'Toplam su depolaması anomalisi eğimi (son 5 yıl)',
          unitText: 'cm/yıl',
        },
      ],
      citation: [
        `${dsiKunye.ad} (erişim ${dsiKunye.indirmeTarihi})`,
        grace.kunye.kaynak,
      ],
      isBasedOn: [dsiKunye.url, 'https://earth.gsfc.nasa.gov/geo/data/grace-mascons'],
      // License (geo-schema brief V2, 10.09.2026 — kullanıcı kararı): TEK
      // lisans URL'i UYDURULMAZ (kaynaklar karışık). Bunun yerine kaynakların
      // lisans niteliği dürüstçe metinle yazılır.
      license:
        'NASA GRACE/GRACE-FO verisi kamu malıdır; DSİ, SYGM, EPİAŞ ve Resmî Gazete ' +
        'verileri kamuya açık resmî kaynaklardan derlenmiştir (kaynak başına ayrı ' +
        'açık lisans etiketi doğrulanmamıştır).',
    },
    // K6 (27.08): Dataset'in bağlandığı gerçek katalog düğümü.
    VERI_KATALOGU,
  ],
}).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Türkiye Su Havzaları Haritası: 25 Havza, Canlı Veri | DSİ</title>
<meta name="description" content={metaAciklama} />
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
<meta name="bingbot" content="index, follow" />
<link rel="canonical" href="https://suharitasi.com/harita/" />
<meta property="og:title" content="Türkiye Su Havzaları Haritası: 25 Havza, Canlı Veri — Su Haritası" />
<meta property="og:description" content={metaAciklama} />
<meta property="og:url" content="https://suharitasi.com/harita/" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Su Haritası" />
<meta property="og:locale" content="tr_TR" />
<meta property="og:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Su Haritası — Türkiye'nin su verisi ve mevzuatı" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://suharitasi.com/og-suharitasi.v1.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<script type="application/ld+json" is:inline set:html={jsonLd} />
<link rel="preload" as="image" href="/hedef-hero-1100.webp" imagesrcset="/hedef-hero-736.webp 736w, /hedef-hero-1100.webp 1100w, /hedef-hero.v2.webp 2200w" imagesizes="100vw" fetchpriority="high" />
<link rel="stylesheet" href="/fonts/fonts.css" />
<style is:global>
  :root {
    --deniz: #04121F;
    --kopuk: #A8DDE0;
    --akuamarin: #4FC3D0;
    --metin-soluk: #6C8A96;
    /* Ortak menü bileşeni bu tokenları bekler */
    --serif: "Cormorant", Georgia, serif;
    --sans: "Manrope", system-ui, sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { height: 100%; }

  body {
    /* Zemin: görselden ImageMagick ile üretilmiş gerçek blur dosyası.
       Koyu renk zemin YOK; anlık yedek ton da görselin orta adaçayısı. */
    background: #8A9489 url('/hedef-zemin.v1.webp') center / cover no-repeat fixed;
    font-family: 'Manrope', system-ui, sans-serif;
    min-height: 100%;
  }

  /* Eski kaydırmasız sahnenin düzeni body'den bu kaba taşındı (FAZ 3):
     hero kompozisyonu birebir aynı (ortalanmış, 100dvh), sayfa artık
     panel için aşağı kaydırılabilir. Hero (.cerceve/.hero) CSS'i AYNEN. */
  .hero-sahne {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100dvh;
  }

  /* Tam ekran, taşmasız: görselin tamamı her zaman görünür (contain).
     Çerçeve/gölge/köşe YOK; görselin kendisine filtre/overlay YOK. */
  .cerceve {
    position: relative;
    opacity: 0;
    transition: opacity 1s var(--e-akinti);
  }

  .cerceve.geldi { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .cerceve { transition: none; opacity: 1; }
  }

  .hero {
    display: block;
    max-width: 100vw;
    max-height: 100dvh;
    width: auto;
    height: auto;
    /* Dikişi erit: üst/alt kenar blur zeminine kenarsız karışır */
    -webkit-mask-image: linear-gradient(180deg,
      transparent 0, #000 46px, #000 calc(100% - 46px), transparent 100%);
    mask-image: linear-gradient(180deg,
      transparent 0, #000 46px, #000 calc(100% - 46px), transparent 100%);
  }

  /* .sv-menu-ac CSS blogu kalkti (27.07): tetik ve menu.js kaldirildi. */

  /* ——— ÖZ-CEVAP SLABI (2026-07-23) ———
     Panelle AYNI açık zemin (#E9F0F4) kullanılır ki hero'dan sonra tek bir
     aydınlık gövde başlasın; panelin kendi border-top'u ikisini ayırır.
     Renkler panelin yerel değerleriyle birebir (SU-DİLİ aday C). */
  .oz-kap {
    background: #E9F0F4;
    border-top: 1px solid rgba(19, 42, 63, 0.2);
  }

  .oz-ic {
    max-width: 84rem;
    margin: 0 auto;
    padding: clamp(1.8rem, 4vh, 2.6rem) clamp(1.25rem, 4vw, 3rem)
             clamp(1.4rem, 3vh, 2rem);
  }

  .oz-cevap {
    margin: 0;
    padding: 1rem 1.2rem;
    border-left: 3px solid #2E7EA0;
    background: rgba(46, 126, 160, 0.06);
    color: #132A3F;
    font-family: var(--sans);
    font-size: 1.06rem;
    font-weight: 500;
    line-height: 1.6;
    max-width: 66ch;
  }

  @media print {
    .oz-cevap { background: none; }
  }

  /* K23 (27.08): skip-link — Sayfa.astro'daki global kuralın eşi
     (bu sayfa o layout'u kullanmıyor). Değerler birebir aynı. */
  .atla-baglantisi { position: fixed; top: 0.5rem; left: 0.5rem; z-index: 999; transform: translateY(calc(-100% - 1rem)); padding: 0.75rem 1rem; min-height: 44px; display: inline-flex; align-items: center; background: var(--su-700, #0C5A7C); color: #fff; font-family: var(--mono, ui-monospace, monospace); font-size: 0.8rem; text-decoration: none; border: 1px solid var(--su-700, #0C5A7C); transition: transform 0.18s var(--e-suzul, cubic-bezier(0.22, 1, 0.36, 1)); }
  .atla-baglantisi:focus { transform: translateY(0); outline: 2px solid var(--kopuk); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .atla-baglantisi { transition: none; } }
  #ana-icerik:focus { outline: none; }

  /* ——— YAZDIRMA FİLİGRANI (04.10.2026 §55) ———
     Bu sayfa Sayfa.astro layout'unu kullanmadığı için global print kuralının
     eşi burada da tanımlı; yalnız @media print, ekran görünümü DEĞİŞMEZ. */
  @media print {
    body::before {
      content: "suharitasi.com Tarafından Üretilmiştir";
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-32deg);
      font-family: ui-monospace, monospace;
      font-size: 1.8rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      white-space: nowrap;
      color: rgba(19, 42, 63, 0.1);
      pointer-events: none;
      z-index: 9999;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
</head>
<body>

  {/* K23 (27.08): "içeriğe atla" — WCAG 2.4.1 (A). Stil `Sayfa.astro`
      global bloğunda; bu sayfa o layout'u kullanmadığı için bağlantı
      elle eklendi. */}
  <a href="#ana-icerik" class="atla-baglantisi">İçeriğe atla</a>

  <PaylasilanMenu yuzer />

  <div class="hero-sahne">
    <figure class="cerceve" data-menu-dis>
      <img class="hero" src="/hedef-hero.v2.webp" srcset="/hedef-hero-736.webp 736w, /hedef-hero-1100.webp 1100w, /hedef-hero.v2.webp 2200w" sizes="100vw" width="2200" height="1232" alt="Türkiye'nin kabartma su haritası — sıcak gün ışığında, denizden yükselen su kavisleri ve süzülen damlalarla" fetchpriority="high" decoding="async" />
    </figure>
  </div>

  {/* Eski tek "menü" tetikleyicisi KALKTI: hedefi (sv-menu) artık render
      edilmiyor; gezinme PaylasilanMenu barında (27.07 birleştirme). */}
  <main data-menu-dis id="ana-icerik" tabindex="-1">
    {/* ÖZ-CEVAP: hero'dan hemen sonra, panelden önce. Panelle aynı açık
        slab üstünde durur ki iki ayrı zemin görünmesin. JS'siz DOM'da. */}
    <section class="oz-kap" aria-label="Sayfa özeti">
      <div class="oz-ic">
        <p class="oz-cevap" role="doc-abstract">{ozCevap}</p>
      </div>
    </section>
    <HavzaPaneli />
  </main>

  <script is:inline>
    const cerceve = document.querySelector('.cerceve');
    const hero = document.querySelector('.hero');
    function goster() { cerceve.classList.add('geldi'); }
    if (hero.complete) goster();
    else hero.addEventListener('load', goster);
    setTimeout(goster, 2500); // emniyet
  </script>
  <CfAnalitik />
  <Analitik />
  <AcilDestekBar />
</body>
</html>
