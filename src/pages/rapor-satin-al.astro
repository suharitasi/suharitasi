---
// PAYTR B2B RAPOR SATIN ALMA — /rapor-satin-al/
import Sayfa from '../layouts/Sayfa.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import OzCevap from '../components/OzCevap.astro';
import Katman from '../components/Katman.astro';

const ozet = 'Kurumsal su durum raporu ve hukuki analiz paketleri. Ön değerlendirme, detaylı B2B su potansiyeli analizi veya tam kapsamlı hukuki görüş paketlerinden birini seçin.';
const API_URL = 'https://api.suharitasi.com'; // Hetzner VPS API
---

<Sayfa baslik="B2B Rapor Satin Al — Su Haritasi" aciklama={ozet}>
  <SayfaBasi etiket="Rapor" baslik="Kurumsal B2B Rapor ve Hukuki Analiz Paketleri" />
  <OzCevap metin={ozet} />

  <Katman baslik="Paket Secimi" ipucu="3 paket · aninda odeme · PDF teslimati">
    <div class="paket-grid" id="paket-grid">
      <div class="paket-kart" data-package="paket_1" data-price="3500">
        <h3>Ön Değerlendirme & Risk Raporu</h3>
        <div class="paket-fiyat">3.500 TL</div>
        <ul>
          <li>İl/ilçe bazlı AHP su potansiyeli skoru</li>
          <li>Akifer tipi ve tahmini derinlik analizi</li>
          <li>Bölgesel ruhsat risk değerlendirmesi</li>
          <li>PDF formatında teslimat</li>
        </ul>
        <button type="button" class="paket-sec" data-package="paket_1">Bu Paketi Seç</button>
      </div>
      <div class="paket-kart paket-one-cikan" data-package="paket_2" data-price="8000">
        <div class="one-cikan-etiket">En Çok Tercih Edilen</div>
        <h3>Detaylı B2B Su Potansiyeli & Ruhsat Analizi</h3>
        <div class="paket-fiyat">8.000 TL</div>
        <ul>
          <li>948 ilçe verisiyle detaylandırılmış AHP analizi</li>
          <li>DSİ bölge kısıtlamaları ve ruhsat risk haritası</li>
          <li>Hidrojeolojik akifer yapısı ve sondaj derinlik raporu</li>
          <li>Yetkili kurum irtibat listesi ve başvuru ön adımları</li>
          <li>Filigranlı güvenli PDF + e-posta teslimatı</li>
        </ul>
        <button type="button" class="paket-sec paket-sec-one" data-package="paket_2">Bu Paketi Seç</button>
      </div>
      <div class="paket-kart" data-package="paket_3" data-price="15000">
        <h3>Kurumsal Hukuki Görüş & Resmi Başvuru Paketi</h3>
        <div class="paket-fiyat">15.000 TL</div>
        <ul>
          <li>Av. Serdar Arslan tarafından kişiselleştirilmiş hukuki görüş</li>
          <li>Tam kapsamlı ruhsat başvuru dosyası hazırlığı</li>
          <li>DSİ ve ilgili kurumlarla resmi yazışma desteği</li>
          <li>İdari itiraz ve dava stratejisi</li>
          <li>Islak imzalı fiziki rapor + filigranlı PDF</li>
        </ul>
        <button type="button" class="paket-sec" data-package="paket_3">Bu Paketi Seç</button>
      </div>
    </div>
  </Katman>

  <div id="odeme-formu" style="display:none">
    <Katman baslik="Müşteri Bilgileri ve Ödeme" ipucu="fatura bilgileri · PayTR güvenli ödeme">
      <form id="musteri-form" class="musteri-form">
        <input type="hidden" id="secili-paket" name="package_id" />
        <div class="form-grid-2">
          <input type="text" id="customer_name" placeholder="Ad Soyad / Firma Unvanı" required class="form-input" />
          <input type="email" id="customer_email" placeholder="E-posta Adresi" required class="form-input" />
        </div>
        <div class="form-grid-2">
          <input type="tel" id="customer_phone" placeholder="Telefon Numarası" required class="form-input" />
          <input type="text" id="customer_tax_id" placeholder="VKN / TCKN" required class="form-input" />
        </div>
        <textarea id="parcel_info" placeholder="Ek bilgi / özel talepleriniz (opsiyonel)" rows={3} class="form-input form-textarea"></textarea>
        <p class="form-alt">Ödemeniz PayTR güvenli altyapısı üzerinden işlenecektir. Kredi kartı bilgileriniz sunucularımızda saklanmaz.</p>
        <button type="submit" id="odeme-baslat" class="odeme-btn">Ödemeye Geç</button>
      </form>
      <div id="odeme-durum" class="odeme-durum" style="display:none"></div>
    </Katman>
  </div>

  <div id="paytr-iframe-container" style="display:none">
    <Katman baslik="Güvenli Ödeme" ipucu="PayTR">
      <iframe id="paytr-iframe" style="width:100%;height:600px;border:0"></iframe>
    </Katman>
  </div>
</Sayfa>

<style>
  .paket-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1rem; }
  .paket-kart { padding: 1.4rem; background: var(--zemin-kart); border: 1px solid var(--cizgi); display: flex; flex-direction: column; gap: 0.6rem; position: relative; }
  .paket-kart.secilmis { border-color: var(--su-500); box-shadow: 0 0 0 2px rgba(79,195,208,0.3); }
  .paket-one-cikan { border-color: var(--kehribar-500, #C0883A); }
  .one-cikan-etiket { position: absolute; top: -10px; right: 10px; background: var(--kehribar-600, #875518); color: #fff; font-size: 0.66rem; padding: 0.2rem 0.6rem; font-weight: 600; }
  .paket-kart h3 { font-family: var(--serif); font-size: 1.15rem; color: var(--metin); margin: 0; }
  .paket-fiyat { font-family: var(--serif); font-size: 2rem; font-weight: 600; color: var(--su-700); }
  .paket-kart ul { margin: 0 0 0 1rem; font-size: 0.84rem; color: var(--metin-soluk); }
  .paket-kart li { margin: 0.2rem 0; }
  .paket-sec { margin-top: auto; padding: 0.55rem 1rem; background: var(--su-700); color: #fff; border: 0; font-size: 0.88rem; font-weight: 600; cursor: pointer; font-family: var(--mono); }
  .paket-sec:hover { background: var(--su-800, #08405A); }
  .paket-sec-one { background: var(--kehribar-600, #875518); }
  .paket-sec-one:hover { background: var(--kehribar-700, #6B4212); }

  .musteri-form { margin: 0.5rem 0; }
  .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-bottom: 0.6rem; }
  .form-input { width: 100%; padding: 0.6rem 0.8rem; font-size: 0.9rem; font-family: var(--govde); border: 1px solid var(--cizgi); background: #fff; color: var(--metin); box-sizing: border-box; }
  .form-input:focus { outline: 2px solid var(--su-500); outline-offset: 1px; }
  .form-textarea { resize: vertical; margin-bottom: 0.6rem; }
  .form-alt { font-size: 0.72rem; color: var(--metin-soluk); margin: 0.5rem 0; }
  .odeme-btn { padding: 0.7rem 2rem; background: var(--kehribar-600, #875518); color: #fff; border: 0; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: var(--mono); }
  .odeme-btn:hover { background: var(--kehribar-700, #6B4212); }
  .odeme-durum { margin-top: 1rem; padding: 0.8rem; font-size: 0.9rem; }

  @media (max-width: 560px) {
    .paket-grid { grid-template-columns: 1fr; }
    .form-grid-2 { grid-template-columns: 1fr; }
  }
</style>

<script>
  const API = '{API_URL}';
  const formDiv = document.getElementById('odeme-formu');
  const iframeDiv = document.getElementById('paytr-iframe-container');
  const iframe = document.getElementById('paytr-iframe');
  const durumDiv = document.getElementById('odeme-durum');

  // Paket secimi
  document.querySelectorAll('.paket-sec').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.paket-kart').forEach(k => k.classList.remove('secilmis'));
      btn.closest('.paket-kart').classList.add('secilmis');
      document.getElementById('secili-paket').value = btn.dataset.package;
      formDiv.style.display = '';
      iframeDiv.style.display = 'none';
      formDiv.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Odeme baslatma
  document.getElementById('musteri-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('odeme-baslat');
    btn.disabled = true; btn.textContent = 'İşleniyor...';

    try {
      const resp = await fetch(API + '/api/paytr/create-charge', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          package_id: document.getElementById('secili-paket').value,
          customer_name: document.getElementById('customer_name').value,
          customer_email: document.getElementById('customer_email').value,
          customer_phone: document.getElementById('customer_phone').value,
          customer_tax_id: document.getElementById('customer_tax_id').value,
          parcel_info: document.getElementById('parcel_info').value,
        }),
      });
      const data = await resp.json();
      if (data.error) {
        durumDiv.style.display = ''; durumDiv.innerHTML = '<p style="color:#C62828">Hata: ' + data.error + '</p>';
        btn.disabled = false; btn.textContent = 'Ödemeye Geç';
        return;
      }
      if (data.token) {
        iframe.src = 'https://www.paytr.com/odeme/guvenli/' + data.token;
        iframeDiv.style.display = '';
        iframeDiv.scrollIntoView({ behavior: 'smooth' });
      }
    } catch (err) {
      durumDiv.style.display = ''; durumDiv.innerHTML = '<p style="color:#C62828">Bağlantı hatası. Lütfen tekrar deneyin.</p>';
    }
    btn.disabled = false; btn.textContent = 'Ödemeye Geç';
  });
</script>
