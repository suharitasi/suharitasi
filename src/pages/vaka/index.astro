---
import { getCollection } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import HukukSerhi from '../../components/HukukSerhi.astro';

const girisler = (await getCollection('vakalar')).sort(
  (a, b) => b.data.tarih.getTime() - a.data.tarih.getTime(),
);
// K22 (27.08): indeks damgası — koleksiyondaki en yeni içerik tarihi
// (`guncelleme ?? tarih`). Build saati KULLANILMAZ (KARARLAR §27/K3).
const _tarihler = girisler
  .map((g) => (g.data as any).guncelleme ?? (g.data as any).tarih)
  .filter(Boolean)
  .map((t: any) => new Date(t).getTime());
const enYeniTarih = _tarihler.length ? new Date(Math.max(..._tarihler)) : undefined;

---
<Sayfa
  baslik="Vakalar"
  aciklama="Şirketlerin su kaynağını nasıl güvenceye aldığını gösteren, yalnız kamuya açık KAP bildirimlerine dayanan vaka incelemeleri."

  guncelleme={enYeniTarih}
>
    {/* K22 (27.08): güncellik damgası — tarih YALNIZ veri künyesinden
        (KARARLAR §27/Karar 3: build saati damga değildir). */}
  <SayfaBasi
    tarih={enYeniTarih}
    etiket="Vakalar"
    baslik="Vakalar"
    ozet="Şirketlerin su kaynağını güvenceye alma süreçleri — yalnız kamuya açık, doğrulanmış KAP bildirimlerine dayanan olgu incelemeleri."
    ozCevap
  />

  <ul class="vaka-liste">
    {girisler.map((g) => (
      <li>
        <a href={`/vaka/${g.id}/`}>
          <span class="vaka-liste__sirket">{g.data.sirket}</span>
          <span class="vaka-liste__baslik">{g.data.baslik}</span>
          <span class="vaka-liste__ozet">{g.data.ozet}</span>
        </a>
      </li>
    ))}
  </ul>


  {/* 27.08 denetimi K9: hukuki şerh (kullanıcı onaylı) */}
  <HukukSerhi />
</Sayfa>

<style>
  .vaka-liste { list-style: none; margin: 1.8rem 0 0; padding: 0; }
  .vaka-liste li + li { border-top: 1px solid var(--cizgi); }
  .vaka-liste a {
    display: block;
    padding: 1.4rem 0.4rem;
    text-decoration: none;
    color: inherit;
    transition: transform 240ms var(--e-suzul), background-color 240ms var(--e-akinti);
  }
  .vaka-liste a:hover { transform: translateY(-2px); background: rgba(46, 126, 160, 0.06); }
  .vaka-liste__sirket {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--su-700);
    margin-bottom: 0.4rem;
  }
  .vaka-liste__baslik {
    display: block;
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 0.4rem;
  }
  .vaka-liste__ozet { display: block; color: var(--metin-soluk); line-height: 1.55; max-width: 60ch; }
  /* ÖLÜ CSS SİLİNDİ (04.10.2026 denetimi): .vaka-not markup'ta 0 kez geçiyor. */
</style>
