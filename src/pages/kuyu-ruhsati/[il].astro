---
// HENDEK FAZ 2 — programatik il sayfası: /kuyu-ruhsati/[il]/
// TEK kaynaktan (il-profil.js) türetilir; araçla aynı veriyi kullanır.
//
// İNCE İÇERİK / DUPLICATE ÖNLEMİ (brief'in çekirdeği):
// - getStaticPaths YALNIZ "3+ gerçek unsur" eşiğini geçen illeri üretir.
// - Genel kuyu ruhsatı süreci bu sayfaya KOPYALANMAZ: il sayfası yalnız
//   İL-ÖZGÜ veriyi taşır, genel süreç için ana rehbere gövde linki verir.
// - Her veri kaleminin kaynağı ve tarihi sayfa sonunda künyelidir.
import { getCollection } from 'astro:content';
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import OzCevap from '../../components/OzCevap.astro';
import IlgiliRehberler from '../../components/IlgiliRehberler.astro';
import { ilinGolleri, ilinNehirleri } from '../../data/gol-nehir.js';
import { yayinlananIller } from '../../data/il-profil.js';
import IlPotansiyel from '../../components/IlPotansiyel.astro';
import { ilPotansiyel } from '../../data/potansiyel.js';
import { YAZAR, OG_GORSEL } from '../../data/site';

export async function getStaticPaths() {
  return yayinlananIller().map((p) => ({ params: { il: p.slug }, props: { profil: p } }));
}

const { profil: p } = Astro.props;

// SU POTANSİYELİ bloğu — 81 ilde (pilot onayı 2026-07-27, kapı kalktı).
const potansiyel = ilPotansiyel(p.il);

// K3-3 (26 Tem 2026) — content-strategy küme bütünlüğü: ÖLÇÜM, 81 il
// sayfasının HİÇBİRİNİN kardeş il sayfasına link vermediğini gösterdi
// (spoke<->spoke 0/81). Komşuluk UYDURULMAZ: kardeşlik ölçütü sayfanın
// zaten yazdığı olgudur — AYNI DSİ BÖLGE MÜDÜRLÜĞÜ. Coğrafi komşuluk
// iddiası YOK. Kaynak: il-profil.js (il-kurum.json türevi).
const buBolgeNo = new Set(p.dsiBolgeleri.map((b) => b.no));
const kardesIller = buBolgeNo.size
  ? yayinlananIller()
      .filter((x) => x.slug !== p.slug && x.dsiBolgeleri.some((b) => buBolgeNo.has(b.no)))
      .slice(0, 6)
  : [];
const ilGolleri = ilinGolleri(p.slug);
const ilNehirleri = ilinNehirleri(p.slug);

const tumHavzalar = await getCollection('havzalar');
const havzaSlug = (ad) => tumHavzalar.find((h) => h.data.baslik === ad)?.id;

const sayi = (n, o) =>
  n.toLocaleString('tr-TR', { minimumFractionDigits: o, maximumFractionDigits: o });
const trTarih = (iso) => iso.split('-').reverse().join('.');
const trAy = (iso) => {
  const adlar = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
  return `${adlar[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`;
};

// — ÖZ CEVAP: tamamen bu ilin profil verisinden damıtılır (uydurma yok)
const anaHavza = p.havzalar[0];
const bolgeMetni = p.dsiBolgeleri
  .map((b) => `DSİ ${b.no}. Bölge Müdürlüğü (${b.merkez})`)
  .join(' ve ');
const cumleler = [];
if (anaHavza && bolgeMetni) {
  // B4 (25.08.2026): 280 sınırı için çok-havzalı illerde ad listesi
  // kısaltılır ("X Havzası, Y Havzası" → "X ve Y havzaları") ve belge
  // türleri parantezi öz-cevaptan çıkarıldı (gövdede zaten sayılıyor).
  const adlar = p.havzalar.map((h) => h.ad.replace(/\s*Havzası\s*$/, ''));
  const havzaMetni = p.havzalar.length === 1
    ? `${p.havzalar[0].ad}`
    : `${adlar.slice(0, -1).join(', ')} ve ${adlar.at(-1)} havzaları`;
  cumleler.push(
    `${p.il} ili ${havzaMetni} sınırları içindedir; kuyu ruhsatı başvurusunun muhatabı ${bolgeMetni}'dür.`
  );
}
if (p.suIdaresi) cumleler.push(`İçme suyu ve kanalizasyonda yetkili idare: ${p.suIdaresi}.`);
const azalanlar = p.havzalar.filter((h) => h.egilim?.yon === 'azalma');
if (azalanlar.length)
  cumleler.push(`Uydu ölçümüne göre havzada su depolaması son 5 yılda azalma eğilimindedir.`);
// 280 sınırı (CLAUDE.md içerik ilkesi): aşılıyorsa sondan cümle düşürülür —
// düşen bilgi sayfa gövdesinde zaten var; öz-cevap YENİ metin üretmez.
while (cumleler.length > 1 && cumleler.join(' ').length > 280) cumleler.pop();
const ozCevap = cumleler.join(' ');

const baslik = `Kuyu ruhsatı — ${p.il}`;
const kok = new URL('/', Astro.site).href;
const canonical = new URL(`/kuyu-ruhsati/${p.slug}/`, Astro.site).href;

const sema = [
  {
    '@type': 'Article',
    headline: `${p.il} ilinde kuyu ruhsatı: yetkili merci ve su rejimi`,
    description: ozCevap,
    inLanguage: 'tr-TR',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    image: new URL(OG_GORSEL, Astro.site).href,
    author: {
      '@type': 'Person',
      '@id': `${kok}hakkinda/#yazar`,
      name: YAZAR.adSade,
      jobTitle: YAZAR.unvan,
      url: YAZAR.buroUrl,
      worksFor: { '@type': 'Organization', name: YAZAR.buro, url: YAZAR.buroUrl },
    },
    publisher: { '@id': `${kok}#kurum` },
  },
];
---
<Sayfa baslik={baslik} aciklama={ozCevap} sema={sema}>
  <SayfaBasi etiket="İl rejimi" baslik={baslik} yazarli />

  <OzCevap metin={ozCevap} />

  <section class="il-blok">
    <h2>Bu ilde yetkili merci hangisi?</h2>
    <dl class="il-kunye">
      <div>
        <dt>Kuyu belgeleri için başvuru mercii</dt>
        <dd>{bolgeMetni || <span class="veri-yok">veri yok</span>}</dd>
      </div>
      <div>
        <dt>Su ve kanalizasyon idaresi</dt>
        <dd>{p.suIdaresi ?? 'İl Özel İdaresi / belediye (il özelinde açık kayıt yok)'}</dd>
      </div>
      {p.havzalar.map((h) => (
        <div>
          <dt>{h.ad}</dt>
          <dd>
            {havzaSlug(h.ad)
              ? <a href={`/havzalar/${havzaSlug(h.ad)}/`}>{h.ad} sayfası</a>
              : h.ad}
            {h.yagisAlani_km2 != null && ` — yağış alanı ${sayi(h.yagisAlani_km2, 0)} km²`}
            {h.yuzeysuyuPotansiyeli_km3 != null &&
              `, yüzey suyu potansiyeli ${sayi(h.yuzeysuyuPotansiyeli_km3, 2)} km³/yıl`}
            {h.veriYili && ` (DSİ ${h.veriYili})`}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  {p.havzalar.some((h) => h.egilim || h.baraj) && (
    <section class="il-blok">
      <h2>Havzada su durumu nedir?</h2>
      <ul class="durum-listesi">
        {p.havzalar.map((h) => (
          <>
            {h.egilim && (
              <li>
                {h.ad}: uydu ölçümüne göre son 5 yılda toplam su depolaması
                {h.egilim.yon === 'sabit'
                  ? ' belirgin değişim göstermiyor'
                  : ` ${h.egilim.yon} eğiliminde`}
                {' '}({h.egilim.egim > 0 ? '+' : ''}{sayi(h.egilim.egim, 2)} cm/yıl,
                {' '}{h.egilim.aySayisi} gerçek aylık ölçümden; değişim verisidir,
                mutlak miktar değildir).
              </li>
            )}
            {h.baraj && (
              <li>
                {h.ad}: enerji rezervuarlarında ortalama aktif doluluk
                %{sayi(h.baraj.ortalamaDoluluk, 1)}
                {' '}({h.baraj.barajSayisi} baraj, {trTarih(h.baraj.tarih)} kaydı).
              </li>
            )}
          </>
        ))}
      </ul>
    </section>
  )}

  {potansiyel && <IlPotansiyel p={potansiyel} />}

  <section class="il-blok">
    <h2>Belge süreci nasıl işler?</h2>
    <p>
      Arama, kullanma ve ıslah-tadil belgelerinin şartları, süreleri ve
      yaptırımları Türkiye genelinde aynıdır; adım adım süreç, madde
      metinleri ve başvuru akışı
      <a href="/rehberler/kuyu-ruhsati/">kuyu ruhsatı rehberinde</a>
      tek merkezde anlatılır. Bu sayfa yalnız {p.il} iline özgü merci ve
      havza verisini taşır.
    </p>
  </section>

  <IlgiliRehberler
    slugler={['kuyu-ruhsati', 'ruhsatsiz-kuyu-cezalari', 'su-tahsisi-oncelik-sirasi']}
  />

  {kardesIller.length > 0 && (
    <>
      <h2>Aynı DSİ bölgesindeki diğer iller hangileri?</h2>
      <nav class="capraz" aria-label="Aynı DSİ bölgesindeki iller">
        {kardesIller.map((x) => <a href={`/kuyu-ruhsati/${x.slug}/`}>&rarr; {x.ad}</a>)}
      </nav>
    </>
  )}

  {/* 24.08 (agustos-uyum M5.7): hidrografya geri bağı — ada kalmaz.
      Eşleme geometrik örneklemdir; şerh blok sonunda. */}
  {(ilGolleri.length > 0 || ilNehirleri.length > 0) && (
    <>
      <h2>Bu ilde hangi göller ve akarsular örnekleniyor?</h2>
      {ilGolleri.length > 0 && (
        <nav class="capraz" aria-label="İldeki göller">
          {ilGolleri.map((g) => <a href={`/goller/${g.slug}/`}>&rarr; {g.ad}</a>)}
        </nav>
      )}
      {ilNehirleri.length > 0 && (
        <nav class="capraz" aria-label="İldeki akarsular">
          {ilNehirleri.map((n) => <a href={`/nehirler/${n.slug}/`}>&rarr; {n.ad}</a>)}
        </nav>
      )}
      <p class="hidro-serh">Liste, OSM/Natural Earth hidrografya verisinin
        (erişim 04.08.2026) il sınırlarıyla geometrik kesişiminden türetilmiştir;
        göl ve akarsular birden çok ile taşabilir.</p>
    </>
  )}

  <p class="veri-kunyesi">
    Veri künyesi: il–bölge/havza eşlemesi resmî kaynaklardan derlendi
    ({trTarih(p.veriKunyesi.ilKurumDerleme)}); havza sayıları
    {' '}{p.veriKunyesi.havzaVeriKaynak} kaynaklıdır; su depolaması eğilimi
    {' '}{p.veriKunyesi.graceKaynak}, baraj doluluk {p.veriKunyesi.barajKaynak}
    verisidir. İller havzalara kısmen girebilir; bu sayfa hukuki görüş değildir.
  </p>
</Sayfa>

<style>
  .il-blok { margin-top: clamp(2.2rem, 5vh, 3.4rem); }

  .il-blok h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.8rem;
  }

  /* İl künyesi = veri bandı (§5): DERİN hairline + kot cetveli */
  .il-kunye {
    padding: 1.2rem 1.3rem 1.2rem 1.8rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
    position: relative;
  }

  .il-kunye::before {
    content: "";
    position: absolute;
    left: 0.6rem;
    top: 1rem;
    bottom: 1rem;
    width: 6px;
    background:
      repeating-linear-gradient(180deg,
        rgba(46, 126, 160, 0.4) 0 1px, transparent 1px 7px),
      linear-gradient(90deg, rgba(46, 126, 160, 0.4) 0 1px, transparent 1px);
  }

  .il-kunye div {
    display: grid;
    grid-template-columns: minmax(11rem, 16rem) 1fr;
    gap: 0.3rem 1.2rem;
    padding: 0.45rem 0;
  }

  .il-kunye div + div { border-top: 1px solid var(--cizgi); }

  .il-kunye dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    align-self: center;
  }

  .il-kunye dd { font-size: 0.95rem; }

  @media (max-width: 560px) {
    .il-kunye div { grid-template-columns: 1fr; gap: 0.1rem; }
  }

  .durum-listesi {
    list-style: none;
    padding: 1rem 1.2rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
  }

  .durum-listesi li { margin: 0.4rem 0; font-size: 0.94rem; }

  .capraz { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 1.6rem; }
  /* B5 (25.08.2026): 44px dokunma hedefi (WCAG 2.5.8; md21 Manisa 7→12
     borcunun kapanışı). Görsel dil aynı — yalnız dikey dolgu min-height'a
     bağlandı; yazı/çerçeve/renk değişmedi. */
  .capraz a { font-family: var(--mono); font-size: 0.8rem; color: var(--su-700); border: 1px solid var(--cizgi); padding: 0.4rem 0.7rem; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .capraz a:hover { background: var(--zemin-kart); }

  .veri-kunyesi {
    margin-top: clamp(2rem, 5vh, 3rem);
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.65;
    color: var(--metin-soluk);
  }
  .hidro-serh { font-size: 0.8rem; color: var(--metin-soluk); margin: 0.6rem 0 0; }
</style>
