---
// İl sayfaları indeksi: yalnız yayınlanan (3+ gerçek unsur) iller listelenir.
// Ana rehber → bu indeks → il sayfası → havza (topic cluster omurgası).
import Sayfa from '../../layouts/Sayfa.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import { yayinlananIller } from '../../data/il-profil.js';
import { TARIH } from '../../data/guncellik.js';
import HukukSerhi from '../../components/HukukSerhi.astro';

const iller = yayinlananIller();
const aciklama =
  `Kuyu ruhsatında ilinize göre yetkili DSİ bölge müdürlüğü, bağlı havza ve ` +
  `güncel su durumu: ${iller.length} il için il-özgü veri sayfası. Genel süreç ` +
  `kuyu ruhsatı rehberinde tek merkezde anlatılır.`;
---
<Sayfa baslik="Kuyu ruhsatı — il rejimi sayfaları" aciklama={aciklama}
  guncelleme={TARIH.havzaVeri ? new Date(TARIH.havzaVeri) : undefined}
>
    {/* K22 (27.08): güncellik damgası — tarih YALNIZ veri künyesinden
        (KARARLAR §27/Karar 3: build saati damga değildir). */}
  <SayfaBasi
    tarih={TARIH.havzaVeri ? new Date(TARIH.havzaVeri) : undefined}
    etiket="İl rejimi"
    baslik="Kuyu ruhsatında iliniz"
    ozet={`Belgelerin şartları Türkiye genelinde aynı, muhatap merci ve havza verisi ilden ile değişir. ${iller.length} il için il-özgü sayfa; hızlı bakış için il rejimi aracını da kullanabilirsiniz.`}
    ozCevap
  />

  <p class="arac-baglanti">
    <a href="/ilimde-kim-yetkili/">"İlimde kim yetkili?" aracı</a> ile ilinizi seçip yetkili kurum
    özetini görün; genel süreç için{' '}
    <a href="/rehberler/kuyu-ruhsati/">kuyu ruhsatı rehberi</a>ne bakın.
  </p>

  <ul class="il-listesi">
    {iller.map((p) => (
      <li>
        <a href={`/kuyu-ruhsati/${p.slug}/`}>{p.il}</a>
      </li>
    ))}
  </ul>

  {/* 27.08 denetimi K9: hukuki şerh (kullanıcı onaylı) */}
  <HukukSerhi />
</Sayfa>

<style>
  .arac-baglanti { margin-bottom: 1.6rem; }

  .il-listesi {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.4rem 1rem;
  }

  /* MOBİLDE İKİ KOLON (M10, 29.07.2026). ÖLÇÜM: 375px'te ızgara tek
     kolona düşüyor ve 81 il 4069px'lik tek sütun oluyordu. Sebep
     `minmax(10rem,…)`: 335px kapta 2×160+16 = 336px, tam 1px taşıyor.
     minmax'i küçültmek masaüstünü de bozardı (672px'te 3 → 4 kolon,
     md14 tabanı 3 kolon). Bu yüzden yalnız dar ekranda açık kural.
     Sığma ölçüldü: en uzun il adı 'Kahramanmaraş' 122px, kolon
     159,5px → 37,5px pay; 81 adın tamamı sığıyor. Dokunma hedefi
     yüksekliği (44px) DEĞİŞMEZ.
     İKİ SAYFADA BİRLİKTE: /nerede-su-cikar/ ve /kuyu-ruhsati/ aynı
     ızgarayı taşıyor (ölçüldü: 1440'ta da 375'te de bit-eşit). Yalnız
     birini değiştirmek iki sayfayı DESEN OLARAK AYIRIRDI. */
  @media (max-width: 420px) {
    .il-listesi { grid-template-columns: repeat(2, 1fr); }
  }

  .il-listesi a {
    display: block;
    padding: 0.45rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--cizgi);
    transition: color 120ms var(--e-akinti), border-color 240ms var(--e-akinti);
  }

  .il-listesi a:hover {
    color: var(--su-700);
    border-bottom-color: var(--su-400);
  }
</style>
