---
// GİRİŞ KAPISI — "Nerede su çıkar?" (brief 2026-07-28, FAZ 1).
// Bu sayfa CEVAP VERMEZ, cevabın bulunduğu yere GÖTÜRÜR: ana sayfadaki
// "su nerelerde çıkabilir" sorusunun tek kanonik hedefi. Cevabın kendisi
// il sayfalarındaki su potansiyeli bloğundadır (81 il).
//
// TASARIM: mevcut içerik sayfası dili — Sayfa.astro çatısı, SayfaBasi + H1,
// OzCevap kutusu, /kuyu-ruhsati/ indeksinin il ızgarası. Yeni renk/font/desen
// İCAT EDİLMEDİ (DESIGN.md; global CLAUDE.md marka kuralı).
//
// UYDURMA YASAĞI: sayfadaki her olgu cümlesi ya bir veri alanından
// (src/data/kapi.js — build anında sayılır) ya da KAYNAKLAR.md künyesinden
// gelir. SSS cevapları mevcut sayfalardan birebir (src/data/kapi-sss.js,
// ham-metin doğrulamalı). Model bilgisinden jeoloji/hukuk cümlesi yazılmadı.
import { getCollection } from 'astro:content';
import Sayfa from '../layouts/Sayfa.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import { TARIH } from '../data/guncellik.js';
import OzCevap from '../components/OzCevap.astro';
import CanliSayi from '../components/CanliSayi.astro';
import CanliSayiMotor from '../components/CanliSayiMotor.astro';
import { OZ_CEVAP, DURUSTLUK_ETIKETI, KATMANLAR, VERI_YOK_NOTU, SAYILAR, iller } from '../data/kapi.js';
import { sssListesi } from '../data/kapi-sss.js';
import HukukSerhi from '../components/HukukSerhi.astro';
import HukukKopru from '../components/HukukKopru.astro';
import HukukDanismanlik from '../components/HukukDanismanlik.astro';

const canonical = new URL('/nerede-su-cikar/', Astro.site).href;

// SSS'nin son maddesi rehberin KENDİ frontmatter öz-cevabıdır — kopyası
// tutulmaz, koleksiyondan okunur (kaynak değişirse sayfa da değişir).
const rehberler = await getCollection('rehberler');
const kuyuRehberi = rehberler.find((r) => r.id === 'kuyu-ruhsati');
if (!kuyuRehberi) {
  throw new Error('nerede-su-cikar: kuyu-ruhsati rehberi koleksiyonda bulunamadı.');
}
const sss = sssListesi(kuyuRehberi.data.ozCevap);

// İl seçici linklerinin HEPSİ gerçek rotaya çıkmalı (uydurma URL yasağı).
// getStaticPaths ile aynı kaynaktan geldiği için eşleşme garantidir; yine de
// sayı burada doğrulanır — sessizce 80 il basılmasın.
if (iller.length !== SAYILAR.ilSayisi) {
  throw new Error(`nerede-su-cikar: il seçici ${iller.length} kayıt, beklenen ${SAYILAR.ilSayisi}.`);
}

const sema = [
  {
    '@type': 'WebPage',
    // Damga (25.08.2026): il potansiyel derlemelerinin veri kaydı tarihi.
    ...(TARIH.potansiyel ? { dateModified: TARIH.potansiyel } : {}),
    name: 'Nerede su çıkar?',
    description: OZ_CEVAP,
    url: canonical,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': `${new URL('/', Astro.site).href}#site` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: sss.map((s) => ({
      '@type': 'Question',
      name: s.soru,
      acceptedAnswer: { '@type': 'Answer', text: s.cevap },
    })),
  },
  {
    '@type': 'ItemList',
    name: 'İl bazında yeraltı suyu potansiyeli sayfaları',
    numberOfItems: iller.length,
    itemListElement: iller.map((x, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: x.il,
      url: new URL(x.yol, Astro.site).href,
    })),
  },
];
---
<Sayfa
  baslik="Nerede su çıkar?"
  tarayiciBaslik="Arazimde Su Çıkar mı? Parsel Bazlı Yeraltı Su Potansiyeli ve Derinlik Sorgulama | Su Haritası"
  aciklama={OZ_CEVAP}
  metaAciklamaHam="Türkiye geneli hidrojeolojik harita ve DSİ kuyu verileriyle arazinizin yeraltı su tablası derinliğini, debi tahminini ve sondaj uygunluğunu parsel parsel sorgulayın."
  sema={sema}>
  <SayfaBasi etiket="Giriş kapısı" baslik="Nerede su çıkar?" tarih={TARIH.potansiyel ? new Date(TARIH.potansiyel) : undefined} />
  <OzCevap metin={OZ_CEVAP} />

  {/* NİYET-YÖNLENDİRME HUB'I (2026-09-21): kapı "su nerede çıkar" cevabını
      verir; hukuki niyeti MEVCUT kanonik motora BAĞLAR. Yeni motor/rota yok,
      hüküm/ceza/süre ÜRETİLMEZ — yalnız doğrulanmış sayfalara bağlantı. */}
  <nav class="yonlendirme" aria-label="Ne arıyorsunuz?">
    <h2 id="yonlendirme">Ne arıyorsunuz?</h2>
    <ul>
      <li>
        <a href="/kuyu-karar-motoru/">
          <span class="yn-baslik">İşlem, süre, ceza veya dilekçe taslağı</span>
          <span class="yn-alt">Kuyu ruhsatı, ceza itirazı ve kapatma tebliğinde son tarih (15/60 gün), yetkili merci, evrak listesi ve ön taslak.</span>
        </a>
      </li>
      <li>
        <a href="/ilimde-kim-yetkili/">
          <span class="yn-baslik">Hangi DSİ bölgesi / idare yetkili?</span>
          <span class="yn-alt">İlinizin DSİ bölge müdürlüğü, su idaresi ve havzaları.</span>
        </a>
      </li>
      <li>
        <a href="/kuyu-kisit-sorgu/">
          <span class="yn-baslik">Araziniz kısıtlı / işletme sahasında mı?</span>
          <span class="yn-alt">İlinize ait Resmî Gazete yeraltı suyu işletme sahası ve tahsise kapatma/kısıt ilanları (resmî linkli).</span>
        </a>
      </li>
      <li>
        <a href="#iliniz">
          <span class="yn-baslik">İl bazında detay</span>
          <span class="yn-alt">İl sayfasında yeraltı suyu kütleleri, Resmî Gazete kayıtları ve arazi biçimi göstergeleri.</span>
        </a>
      </li>
    </ul>
  </nav>

  <h2 id="iliniz">İliniz hangisi?</h2>
  <p class="kapi-yonerge">
    Cevap il ölçeğinde verilir: her il sayfasında o ile eşlenmiş yeraltı suyu
    kütleleri, Resmî Gazete'de ilan edilmiş işletme sahaları ve arazi biçimi
    göstergeleri birlikte durur. Havza ölçeğindeki tablo için{' '}
    <a href="/havzalar/">havza sayfalarına</a> bakabilirsiniz.
  </p>

  <ul class="il-listesi">
    {iller.map((x) => (
      <li><a href={x.yol}>{x.il}</a></li>
    ))}
  </ul>

  <h2 id="nasil">Cevap nasıl üretiliyor?</h2>
  <p class="kapi-yonerge">
    Dört veri katmanı üst üste konur. Her katmanın kaynağı künyelidir; künye
    listesinin tamamı <a href="/hakkinda/">hakkında sayfasındaki</a> kaynak
    kaydında durur.
  </p>

  {/* KANIT BANDI (B3.3, 28.07.2026): sayfanın başlık rakamları CanliSayi
      bileşeniyle. Bant BAŞLIK, altındaki katman listesi KIRILIM verir —
      bant şerhsiz bir sayı iddia etmez, şerhler listede durur (içerik
      ilkesi: cevap önce, dayanak sonra). Rakamlar burada da veriden
      sayılıdır (src/data/kapi.js bekçisi); elle yazılmış sayı yoktur. */}
  <ul class="kapi-kanit">
    <li><CanliSayi sayi={SAYILAR.kutleToplam} birim="Yeraltı suyu kütlesi"
        metin={`${SAYILAR.havzaPlan} yayımlı havza planından derlendi.`} /></li>
    <li><CanliSayi sayi={SAYILAR.rgToplam} birim="Resmî Gazete kaydı"
        metin={`${SAYILAR.rgYilIlk}-${SAYILAR.rgYilSon} arası işletme sahası ilanı.`} /></li>
    <li><CanliSayi sayi={SAYILAR.ilSayisi} birim="İl sayfası"
        metin="Cevap il ölçeğinde verilir; her il kendi sayfasında." /></li>
  </ul>
  <CanliSayiMotor />

  <ol class="kapi-katmanlar">
    {KATMANLAR.map((k, i) => (
      <li>
        <h3>{k.ad}</h3>
        <p class="kapi-olcum">{k.olcum}</p>
        <p>{k.aciklama}</p>
        <p class="kapi-kunye">Kaynak: {k.kunye} — {k.kaynakNot}</p>
      </li>
    ))}
  </ol>

  <p class="kapi-dipnot">{VERI_YOK_NOTU}</p>

  <h2 id="sorular">Sık sorulanlar</h2>
  {sss.map((s) => (
    <div class="kapi-sss">
      <h3>{s.soru}</h3>
      <p>{s.cevap}</p>
      <p class="kapi-kunye">
        Kaynak: {s.kaynakYol
          ? <a href={s.kaynakYol}>{s.kaynakAd}</a>
          : s.kaynakAd}
      </p>
    </div>
  ))}

  <p class="kapi-durustluk">{DURUSTLUK_ETIKETI}</p>

  {/* Yüksek niyetli hukuki rehber köprüsü (13.09.2026): bu kapı "su nerede
      çıkar" cevabını verir; "buldum, izin/ruhsat/ceza ne olacak?" sorusunu
      rehberlere ve iletişime bağlar. */}
  <HukukKopru
    baslik="Suyu buldum, şimdi izin ve ihtilaf ne olacak?"
    aciklama="Kuyu açma, belge, ceza ve komşu su uyuşmazlıklarında izlenecek adımlar için su hukuku rehberleri."
  />
  <HukukDanismanlik konu="Yeraltı suyu ve kuyu hukuku" />

  {/* 27.08 denetimi K9: hukuki şerh (kullanıcı onaylı) */}
  <HukukSerhi />
</Sayfa>

<style>
  /* İl ızgarası: /kuyu-ruhsati/ indeksiyle AYNI desen (kopya disiplini). */
  .il-listesi {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.4rem 1rem;
  }

  /* MOBİLDE İKİ KOLON (M10, 29.07.2026). ÖLÇÜM: 375px'te ızgara tek
     kolona düşüyor ve 81 il 4069px'lik tek sütun oluyordu. Sebep
     `minmax(10rem,…)`: 335px kapta 2×160+16 = 336px, tam 1px taşıyor.
     minmax'i küçültmek masaüstünü de bozardı (672px'te 3 → 4 kolon,
     md14 tabanı 3 kolon). Bu yüzden yalnız dar ekranda açık kural.
     Sığma ölçüldü: en uzun il adı 'Kahramanmaraş' 122px, kolon
     159,5px → 37,5px pay; 81 adın tamamı sığıyor. Dokunma hedefi
     yüksekliği (44px) DEĞİŞMEZ.
     İKİ SAYFADA BİRLİKTE: /nerede-su-cikar/ ve /kuyu-ruhsati/ aynı
     ızgarayı taşıyor (ölçüldü: 1440'ta da 375'te de bit-eşit). Yalnız
     birini değiştirmek iki sayfayı DESEN OLARAK AYIRIRDI. */
  @media (max-width: 420px) {
    .il-listesi { grid-template-columns: repeat(2, 1fr); }
  }

  .il-listesi a {
    display: block;
    padding: 0.45rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--cizgi);
    transition: color 120ms var(--e-akinti), border-color 240ms var(--e-akinti);
  }

  .il-listesi a:hover {
    color: var(--su-700);
    border-bottom-color: var(--su-400);
  }

  .kapi-yonerge { max-width: 66ch; margin-bottom: 1.4rem; }

  /* Kanıt bandı ızgarası (B3.3). Kart görünümü CanliSayi bileşenindedir;
     burada YALNIZ yerleşim var — kopya stil iki yerde sapma demektir.
     Kırılım noktası katman kartlarıyla aynı (720px) ki iki blok aynı
     anda tek kolona düşsün, ritim kırılmasın. */
  .kapi-kanit {
    list-style: none;
    padding: 0;
    margin: 0 0 1.6rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
  }
  @media (max-width: 720px) { .kapi-kanit { grid-template-columns: 1fr; } }

  /* Katman kartları: il bloğunun veri bandı diliyle aynı aile
     (zemin-kart + hairline + su-700 üst çizgi). */
  .kapi-katmanlar {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .kapi-katmanlar > li {
    padding: 1rem 1.2rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
  }

  .kapi-katmanlar h3 {
    font-family: var(--serif);
    font-size: 1.12rem;
    font-weight: 500;
    margin: 0 0 0.4rem;
  }

  .kapi-katmanlar p { margin: 0 0 0.5rem; max-width: 66ch; }
  .kapi-katmanlar p:last-child { margin-bottom: 0; }

  /* Ölçüm satırı mono katmanda (DESIGN.md §6): sayı = ölçüm estetiği */
  .kapi-olcum {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--metin);
  }

  .kapi-kunye {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--metin-soluk);
  }

  .kapi-dipnot {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    color: var(--metin-soluk);
    max-width: 66ch;
  }

  .kapi-sss { margin-bottom: 1.3rem; }

  .kapi-sss h3 {
    font-family: var(--serif);
    font-size: 1.12rem;
    font-weight: 500;
    margin: 0 0 0.35rem;
  }

  .kapi-sss p { max-width: 66ch; margin: 0 0 0.3rem; }

  /* Dürüstlük etiketi: il bloklarındaki .pot-durustluk ile aynı görünüm. */
  .kapi-durustluk {
    margin-top: 1.6rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--cizgi);
    font-size: 0.88rem;
    color: var(--metin-soluk);
  }

  /* NİYET-YÖNLENDİRME HUB'I — kart dili `kapi-katmanlar` ile AYNI aile
     (zemin-kart + hairline + su-700 üst çizgi). Yeni renk/font icat edilmedi. */
  .yonlendirme { margin: 1.6rem 0 2rem; }
  .yonlendirme h2 {
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 500;
    margin: 0 0 0.9rem;
  }
  .yonlendirme ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }
  @media (max-width: 720px) { .yonlendirme ul { grid-template-columns: 1fr; } }
  .yonlendirme li { display: flex; }
  .yonlendirme a {
    display: block;
    width: 100%;
    padding: 1rem 1.2rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms var(--e-akinti);
  }
  .yonlendirme a:hover { border-color: var(--su-400); }
  .yn-baslik {
    display: block;
    font-family: var(--serif);
    font-size: 1.12rem;
    font-weight: 500;
    color: var(--su-700);
    margin-bottom: 0.3rem;
  }
  .yn-alt {
    display: block;
    font-size: 0.9rem;
    color: var(--metin-soluk);
    max-width: 60ch;
  }
</style>
