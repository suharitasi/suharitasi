---
// PAYLAŞILAN MENÜ (04.08.2026 refactor) — 4 ana başlığa indirgendi.
// Tüm sayfalarda TEK menü.
import { VERI_ROTALARI } from '../data/anasayfa-v2.js';

interface Props {
  yuzer?: boolean;
}
const { yuzer = false } = Astro.props;
const anaSayfa = Astro.url.pathname === '/' || Astro.url.pathname === '';
const kok = (capa: string) => (anaSayfa ? `#${capa}` : `/#${capa}`);

const veriler = VERI_ROTALARI;
---
<header class:list={['pm-bar', anaSayfa ? 'pm-ana' : (yuzer ? 'pm-yuzer' : 'pm-icerik')]} id="pm-bar">
<div class="pm-ic">
  {/* CRO/marka (27.09.2026): header artık SİTENİN markasını taşır ("Su
      Haritası"); Arslan Hukuk künyesi footer'da "güvencesiyle" satırında
      KORUNUR (kullanıcı kararı). Eski logo-lockup.svg Arslan Hukuk markasıydı
      — alt metni ile görselin çelişmemesi için Su Haritası kelime-markası. */}
  <a class="pm-marka" href="/" aria-label="Su Haritası — ana sayfa">
    <img src="/assets/logo-suharitasi.svg" alt="Su Haritası" class="pm-logo" width="540" height="84" />
  </a>

  <nav class="pm-nav" aria-label="Site menüsü">
    <ul>
      {veriler.map((r) => (<li><a href={r.yol}>{r.ad}</a></li>))}
    </ul>
  </nav>


  <button type="button" class="pm-menu-dugme" id="pm-menu-dugme"
          aria-expanded="false" aria-controls="pm-mobil-panel"
          aria-label="Menüyü aç">
    {/* transitions-dev "icon swap": üç çizgi açılınca X'e morph eder
        (aria-expanded=true). Azaltılmış harekette morph yok, yalnız swap. */}
    <svg class="pm-ikon" width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line class="pm-cizgi pm-cizgi-1" x1="3" y1="6" x2="21" y2="6"></line>
      <line class="pm-cizgi pm-cizgi-2" x1="3" y1="12" x2="21" y2="12"></line>
      <line class="pm-cizgi pm-cizgi-3" x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>
</div>
</header>

<nav class="pm-mobil-panel" id="pm-mobil-panel" aria-label="Menü">
  <ul>
    {veriler.map((r) => (<li><a href={r.yol}>{r.ad}</a></li>))}
  </ul>
</nav>

<noscript>
  {/* P3 W3C onarımı: gövdede <style>, <noscript> çocuğu olamaz. Body-ok
      <link rel="stylesheet"> kullanılır; yalnız JS kapalıyken istenir. */}
  <link rel="stylesheet" href="/assets/noscript.css" />
</noscript>

<style>
  /* Etkileşim easing'leri (emil-design-eng): güçlü ease-out, <300ms. */
  .pm-bar {
    --pm-eo: cubic-bezier(0.23, 1, 0.32, 1);
    left: 0; right: 0; top: 0;
    z-index: 60;
    border-bottom: 1px solid transparent;
    transition: background-color 200ms var(--pm-eo), border-color 200ms var(--pm-eo);
  }
  /* Ana sayfa: fixed + şeffaf başlar (scroll>40 JS 'kaydi' verir). */
  .pm-ana { position: fixed; background: transparent; }
  /* İçerik sayfaları: sticky + HEP koyu (mimari kararı). */
  .pm-icerik {
    position: sticky;
    background: rgba(8, 32, 47, 0.96);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  /* Tam-ekran görsel sayfa: fixed + koyu (akışı itmez, görsel tam kalır). */
  .pm-yuzer {
    position: fixed;
    background: rgba(8, 32, 47, 0.82);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }
  .pm-bar.kaydi {
    background: rgba(8, 32, 47, 0.85);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  @supports (backdrop-filter: blur(1px)) {
    .pm-bar.kaydi, .pm-icerik, .pm-yuzer {
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    }
    .pm-icerik { background: rgba(8, 32, 47, 0.88); }
    .pm-yuzer { background: rgba(8, 32, 47, 0.72); }
  }
  .pm-ic {
    max-width: 72rem; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem;
    /* Navbar yüksekliği sabit ve kompakt tutulur (logo 40px + 2×0,7rem ≈ 62px);
       logo büyüyünce çubuk şişmesin. Mobil panel `top` değeri buna göre. */
    padding: 0.7rem clamp(1rem, 4vw, 1.5rem);
  }
  .pm-marka {
    color: #fff; text-decoration: none;
    font-family: var(--serif, "Cormorant", Georgia, serif);
    font-size: 1.125rem; font-weight: 600; letter-spacing: -0.02em;
    white-space: nowrap;
    display: flex; align-items: center;
    /* CRO: WCAG 2.5.8 — dokunma hedefi ≥44px (logo 2rem olsa da tıklama
       alanı büyütülür; görsel yükseklik korunur). */
    min-height: 44px; padding: 0.2rem 0;
  }
  .pm-logo {
    display: block;
    /* Logo ölçüsü (27.09.2026): navbar içinde NET 40px (h-10), w-auto.
       Responsive'de küçülür ama kaybolmaz. viewBox 540:84 ≈ 6,43:1. */
    height: 40px;
    width: auto; max-width: min(52vw, 14rem);
    object-fit: contain;
  }
  @media (max-width: 480px) {
    .pm-logo { height: 34px; max-width: 58vw; }
  }
  .pm-nav {
    /* Uzun menü (9 öğe) yatay sayfa taşması yaratmasın: nav kendi içinde
       küçülür/gerekirse yatay kaydırılır; çubuk asla dokümanı taşırmaz. */
    min-width: 0; overflow-x: auto;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .pm-nav::-webkit-scrollbar { display: none; }
  .pm-nav > ul {
    display: flex; align-items: center; gap: clamp(0.45rem, 0.95vw, 1rem);
    list-style: none; margin: 0; padding: 0;
  }
  .pm-nav a {
    font-family: var(--sans, "Manrope", system-ui, sans-serif);
    font-size: 0.8rem; font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none; background: none; border: 0; cursor: pointer;
    padding: 0.35rem 0.1rem;
    /* CRO (WCAG 2.5.8): menü hedefleri 44px dokunma yüksekliğine çıkarıldı. */
    min-height: 44px; display: inline-flex; align-items: center;
    /* DİKKAT (27.09.2026): etiketler TEK SATIR. Sarmalanınca (nowrap yokken)
       bazı öğeler 85px'e çıkıp navbar 108px oluyor ve içeriği örtüyordu. */
    white-space: nowrap;
    transition: color 150ms var(--pm-eo);
  }
  /* 1024–1200px arası: 9 menü öğesi sığsın diye aralık ve punto küçülür
     (yatay taşma / sarmalama olmadan tek satır kalır). */
  @media (max-width: 1200px) {
    .pm-nav > ul { gap: 0.5rem; }
    .pm-nav a { font-size: 0.74rem; }
    .pm-logo { max-width: 11rem; }
  }
  @media (hover: hover) and (pointer: fine) {
    .pm-nav a:hover { color: #fff; }
  }
  .pm-nav a:focus-visible,
  .pm-marka:focus-visible,
  .pm-menu-dugme:focus-visible {
  /* K30 (27.08.2026): odak halkası #7fd0ef → DESIGN.md §9 sözlüğündeki
     KÖPÜK (#DBEAF4). §9: ":focus-visible … koyu dünyada köpük". #7fd0ef
     sözlükte yoktu (ne köpük ne ışıma). Ölçüm sözlük değerinin aynı
     zamanda daha erişilebilir olduğunu gösterdi: koyu zeminde kontrast
     8,84 → 12,41. */
    outline: 2px solid var(--kopuk, #DBEAF4); outline-offset: 3px;
  }

  @media (max-width: 1023px) {
  }

  .pm-menu-dugme {
    display: none; background: none; border: 0; cursor: pointer;
    padding: 0.45rem; min-height: 44px; min-width: 44px;
    align-items: center; justify-content: center;
    color: #fff; transition: transform 120ms var(--pm-eo);
  }
  .pm-menu-dugme:active { transform: scale(0.94); }

  /* transitions-dev icon swap (27.09.2026): hamburger → X. Morph yalnız
     genişlik/animation pahası yok; transform-box:fill-box her çizgiyi kendi
     merkezinde döndürür. reduced-motion'da geçiş kapatılır (aşağıda). */
  .pm-cizgi {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 240ms var(--e-kabar, ease),
                opacity 180ms var(--e-kabar, ease);
  }
  .pm-menu-dugme[aria-expanded="true"] .pm-cizgi-1 { transform: translateY(6px) rotate(45deg); }
  .pm-menu-dugme[aria-expanded="true"] .pm-cizgi-2 { opacity: 0; }
  .pm-menu-dugme[aria-expanded="true"] .pm-cizgi-3 { transform: translateY(-6px) rotate(-45deg); }

  .pm-mobil-panel {
    display: none; position: fixed; top: 4.15rem; left: 0; right: 0;
    z-index: 59; max-height: calc(100dvh - 3.6rem); overflow-y: auto;
    padding: 0.8rem clamp(1.25rem, 4vw, 3rem) 1.4rem;
    background: rgba(6, 24, 36, 0.97);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .pm-mobil-panel ul { list-style: none; margin: 0; padding: 0; }
  /* ÖLÜ CSS SİLİNDİ (04.10.2026 denetimi): .pm-mobil-baslik ve .pm-mobil-alt
     markup'ta 0 kez geçiyor (ölçüldü). */
  .pm-mobil-panel > ul > li > a {
    display: flex; align-items: center; min-height: 44px;
    padding: 0.65rem 0; margin: 0;
    color: #fff; font-family: var(--sans, system-ui, sans-serif);
    font-size: 1rem; font-weight: 500; text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 1023px) {
    .pm-nav { display: none; }
    .pm-menu-dugme { display: inline-flex; }
    .pm-mobil-panel.acik {
      display: block;
      opacity: 1; transform: translateY(0);
      transition: opacity 200ms var(--pm-eo), transform 200ms var(--pm-eo);
    }
    @starting-style {
      .pm-mobil-panel.acik { opacity: 0; transform: translateY(-8px); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pm-bar, .pm-menu-dugme, .pm-mobil-panel.acik {
      transition-property: color, background-color, border-color, opacity;
    }
    .pm-cizgi { transition: none; }
  }

  @media print { .pm-bar, .pm-mobil-panel { display: none !important; } }
</style>

<script>
  const bar = document.getElementById('pm-bar');
  function barGuncelle() { bar.classList.toggle('kaydi', scrollY > 40); }
  addEventListener('scroll', () => requestAnimationFrame(barGuncelle), { passive: true });
  barGuncelle();

  const menuDugme = document.getElementById('pm-menu-dugme');
  const panel = document.getElementById('pm-mobil-panel');
  function panelDurum(acik) {
    panel.classList.toggle('acik', acik);
    menuDugme.setAttribute('aria-expanded', String(acik));
    menuDugme.setAttribute('aria-label', acik ? 'Menüyü kapat' : 'Menüyü aç');
  }
  menuDugme.addEventListener('click', () => panelDurum(!panel.classList.contains('acik')));
  panel.addEventListener('click', (e) => { if (e.target.closest('a')) panelDurum(false); });

  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (panel.classList.contains('acik')) { panelDurum(false); menuDugme.focus(); }
  });
</script>
