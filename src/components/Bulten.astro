---
// Su Kanunu bülteni formu: tek alan, JS yok, sunucu yok — saf HTML POST.
// Statik barındırma kısıtı (CLAUDE.md) korunur; Cloudflare Function gerekmez.
//
// BUTTONDOWN_KULLANICI boşsa hiçbir şey render edilmez (bkz. data/bulten.ts).
// TBB uyumu: hizmet pazarlaması değil — mevzuat değişikliği bildirimi.
import { BUTTONDOWN_KULLANICI, BULTEN_AKTIF } from '../data/bulten';

interface Props {
  // Kaydın hangi sayfadan geldiği Buttondown'da etiket olarak görünür.
  etiket: string;
}

const { etiket } = Astro.props;
const eylem = `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_KULLANICI}`;
---
{BULTEN_AKTIF && (
  <section class="bulten" aria-labelledby="bulten-baslik">
    <h2 id="bulten-baslik">Taslak değiştiğinde haberdar olun</h2>
    <p class="bulten-aciklama">
      Su Kanunu yasalaştığında ve taslak metin değiştiğinde e-postayla
      bilgilendirilmek istiyorum.
    </p>
    <form class="bulten-form" action={eylem} method="post">
      <input type="hidden" name="tag" value={etiket} />
      <label class="gorsel-gizli" for="bulten-eposta">E-posta adresiniz</label>
      <input
        id="bulten-eposta"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="eposta@ornek.com"
      />
      <button type="submit">Bildirim al</button>
    </form>
    <p class="bulten-not">
      Yalnız mevzuat gelişmeleri için kullanılır; istediğiniz an çıkabilirsiniz.
    </p>
  </section>
)}

<style>
  .bulten {
    margin-top: 2.8rem;
    padding: 1.5rem 1.5rem 1.3rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-left: 3px solid var(--su-400);
  }

  .bulten h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .bulten-aciklama {
    margin-top: 0.5rem;
    font-size: 0.94rem;
    color: var(--metin-soluk);
    max-width: 56ch;
  }

  .bulten-form {
    margin-top: 1.1rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .gorsel-gizli {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .bulten-form input[type="email"] {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    font-family: var(--sans);
    font-size: 0.95rem;
    color: var(--metin);
    background: var(--krem);
    border: 1px solid var(--cizgi);
    border-radius: 2px;
  }

  .bulten-form input[type="email"]:focus-visible {
    outline: 2px solid var(--su-400);
    outline-offset: 2px;
  }

  /* Sitenin tek birincil eylem kalıbı (rapor GÖRSEL-2): su konturu + kehribar hover */
  .bulten-form button {
    padding: 0.7rem 1.4rem;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--su-700);
    background: transparent;
    border: 1px solid var(--su-400);
    border-radius: 2px;
    cursor: pointer;
    transition: color 0.2s var(--e-akinti), border-color 0.2s var(--e-akinti), background-color 0.2s var(--e-akinti);
  }

  .bulten-form button:hover {
    color: var(--murekkep-900);
    border-color: var(--kehribar);
    background: rgba(217, 160, 91, 0.12);
  }

  .bulten-form button:focus-visible {
    outline: 2px solid var(--su-400);
    outline-offset: 3px;
  }

  .bulten-not {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--metin-soluk);
  }

  @media print { .bulten { display: none; } }
</style>
