---
// İYUK m. 7 — 60 GÜN İDARİ DAVA AÇMA SÜRESİ SAYACI (27.09.2026).
// Saf istemci (Vanilla JS, harici kütüphane/sunucu/DB YOK). Bilgilendirme
// amaçlıdır; hukuki görüş değildir. TBB m.55: hizmet vaadi yok; yalnız
// durum tespiti kanalına bağlanır.
import { EPOSTA } from '../data/site';
import OnayBekliyor from './OnayBekliyor.astro';
import kurallar from '../../data/kamu/sure-tablosu.json';

// DURAK 1 A-b (10.10.2026): tür → yol eşlemesi tek süre tablosundan (data/kamu/sure-tablosu.json).
// Para cezası sulh ceza hakimliğine 15 gün (5326 m.27/1); kapatma/ret idare mahkemesine 60 gün (2577 m.7);
// ikisi aynı kararda ise idari yargı (5326 m.27/8). Önceki sürüm para cezasına da 60 gün hesaplıyordu.
const TURLER = [
  { id: 'kabahat', ad: 'İdari para cezası (167 s.K. m.18)' },
  { id: 'idari', ad: 'Kuyu kapatma tebliği' },
  { id: 'idari-red', ad: 'Ruhsat / belge başvurusunun reddi' },
  { id: 'birlikte', ad: 'Para cezası ve kuyu kapatma aynı kararda' },
];
const Y = kurallar.yollar;
---
<section class="iyuk" aria-label="Dava ve başvuru süresi hesaplayıcı">
  <h2>Süre hesaplayıcı: başvuru ve dava süreleri</h2>
  <OnayBekliyor kaynak={`${Y.kabahat.dayanak}; ${Y.idari.dayanak}; ${Y.birlikte.dayanak}; tatil: ${kurallar.tatil.dayanak} — son doğrulama ${kurallar.son_dogrulama.split('-').reverse().join('.')}`} />
  <ul class="iyuk-not">
    <li><strong>{Y.kabahat.ad}:</strong> {Y.kabahat.merci}, {Y.kabahat.gun} gün ({Y.kabahat.dayanak}).</li>
    <li><strong>{Y.idari.ad}:</strong> {Y.idari.merci}, {Y.idari.gun} gün ({Y.idari.dayanak}).</li>
    <li><strong>{Y.birlikte.ad}:</strong> {Y.birlikte.merci} ({Y.birlikte.dayanak}).</li>
    <li>Bu araç bilgilendirme amaçlıdır; hukuki görüş değildir.</li>
  </ul>
  <form id="iyuk-form" class="iyuk-form">
    <label class="iyuk-alan">Tebliğ tarihi
      <input type="date" id="iyuk-tarih" required>
    </label>
    <label class="iyuk-alan">Tebliğ edilen karar
      <select id="iyuk-tur">
        {TURLER.map((t) => <option value={t.id}>{t.ad}</option>)}
      </select>
    </label>
    <button type="submit" class="iyuk-dugme">Kalan süreyi hesapla</button>
  </form>

  <div id="iyuk-sonuc" class="iyuk-sonuc" hidden>
    <p id="iyuk-metin" class="iyuk-metin"></p>
    <div class="iyuk-cubuk" role="progressbar" aria-label="Kalan süre"
         aria-valuemin="0" aria-valuemax="60">
      <span id="iyuk-dolgu" class="iyuk-dolgu"></span>
    </div>
    <ul id="iyuk-notlar" class="iyuk-lead"></ul>
    <p id="iyuk-uyari" class="iyuk-uyari" hidden>
      Hesaplanan son gün geçmiş görünüyor. Süreyi etkileyebilecek durumlar (ör. tebliğin
      usulüne uygun olup olmadığı, mücbir sebep) ancak somut dosyada değerlendirilebilir.
    </p>
    <p class="iyuk-lead">
      Somut durumun değerlendirilmesi için
      <a href="/whatsapp/">durum tespiti talebi</a> iletebilir veya
      <a href={`mailto:${EPOSTA}?subject=${encodeURIComponent('Kuyu idari süreç — durum tespiti')}`}>e-posta</a>
      gönderebilirsiniz.
    </p>
  </div>
</section>

<script>
  import { sonGun, kalanGun } from '../data/sure-hesap.js';
  import kurallar from '../../data/kamu/sure-tablosu.json';
  const YOL: Record<string, string> = { kabahat: 'kabahat', idari: 'idari', 'idari-red': 'idari', birlikte: 'birlikte' };
  const form = document.getElementById('iyuk-form');
  const girdi = document.getElementById('iyuk-tarih') as HTMLInputElement | null;
  const tur = document.getElementById('iyuk-tur') as HTMLSelectElement | null;
  const sonuc = document.getElementById('iyuk-sonuc');
  const metin = document.getElementById('iyuk-metin');
  const notlar = document.getElementById('iyuk-notlar');
  const uyari = document.getElementById('iyuk-uyari');
  const dolgu = document.getElementById('iyuk-dolgu');
  const cubuk = document.querySelector('.iyuk-cubuk') as HTMLElement | null;

  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (!girdi?.value || !sonuc || !metin || !dolgu) return;
    const yolId = YOL[tur?.value || 'idari'] || 'idari';
    const yol = (kurallar as any).yollar[yolId];
    const r = sonGun(girdi.value, yolId, kurallar);
    if (!r) return;
    const kalan = kalanGun(r.son);
    const bitis = r.son.toLocaleDateString('tr-TR');
    if (kalan >= 0) {
      metin.textContent = `${yol.merci} — ${yol.ad}: son gün ${bitis} (${kalan} gün kaldı). Dayanak: ${yol.dayanak}.`;
      uyari?.setAttribute('hidden', '');
    } else {
      metin.textContent = `${yol.merci} — ${yol.ad}: hesaplanan son gün ${bitis}. Dayanak: ${yol.dayanak}.`;
      uyari?.removeAttribute('hidden');
    }
    if (notlar) {
      notlar.textContent = '';
      for (const n of r.notlar) { const li = document.createElement('li'); li.textContent = n; notlar.appendChild(li); }
    }
    const oran = Math.max(0, Math.min(100, Math.round((kalan / yol.gun) * 100)));
    dolgu.style.width = `${oran}%`;
    cubuk?.setAttribute('aria-valuemax', String(yol.gun));
    cubuk?.setAttribute('aria-valuenow', String(Math.max(0, kalan)));
    sonuc.removeAttribute('hidden');
  });
</script>

<style>
  .iyuk {
    margin-top: 1.6rem;
    padding: 1.1rem 1.3rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--su-700);
  }
  .iyuk h2 {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 0.6rem;
  }
  .iyuk-not { font-size: 0.9rem; color: var(--metin-soluk); max-width: 66ch; margin: 0 0 1rem; }
  .iyuk-form { display: flex; flex-wrap: wrap; gap: 0.8rem 1.2rem; align-items: end; }
  .iyuk-alan { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; }
  .iyuk-dugme { padding: 0.5rem 1rem; cursor: pointer; }
  .iyuk-sonuc { margin-top: 1.1rem; }
  .iyuk-metin { font-size: 0.98rem; max-width: 66ch; }
  .iyuk-cubuk { height: 10px; background: var(--cizgi); border-radius: 999px; overflow: hidden; margin: 0.6rem 0; }
  .iyuk-dolgu { display: block; height: 100%; width: 100%; background: var(--su-700); transition: width 200ms var(--e-akinti); }
  .iyuk-uyari { font-size: 0.9rem; color: var(--metin); max-width: 66ch; }
  .iyuk-lead { font-size: 0.9rem; color: var(--metin-soluk); max-width: 66ch; }
</style>
