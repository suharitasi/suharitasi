---
// Sayfa başlığı + su hattı. Rehberlerde başlığın hemen altına künye satırı
// (tarih + hukuki içeriği hazırlayan) düşer: E-E-A-T kimlik sinyali ilk
// ekranda görünür olur, sayfanın dibinde kalmaz.
import { YAZAR } from '../data/site';

interface Props {
  etiket?: string;
  baslik: string;
  ozet?: string;
  tarih?: Date;
  // true ise "Hukuki içerik: Av. Serdar Arslan" satırı gösterilir.
  yazarli?: boolean;
  // true ise ozet, sayfanın öz-cevabı olarak işaretlenir (CLAUDE.md "cevap
  // önce, dayanak sonra"): class="oz-cevap" + role="doc-abstract". Yalnız
  // kendi OzCevap bileşeni OLMAYAN hub sayfalarında açılır — iki öz-cevap
  // çıkmasın. Görünüm değişmez; işaret makine okuyucular içindir.
  ozCevap?: boolean;
}

const { etiket, baslik, ozet, tarih, yazarli, ozCevap } = Astro.props;

const tarihYaz = (t: Date) =>
  t.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<div class="sayfa-basi">
  {etiket && <p class="sayfa-etiket">{etiket}</p>}
  <h1>{baslik}</h1>
  {(tarih || yazarli) && (
    <p class="sayfa-kunye">
      {tarih && (
        <span>
          Güncelleme: <time datetime={tarih.toISOString().slice(0, 10)}>{tarihYaz(tarih)}</time>
        </span>
      )}
      {tarih && yazarli && <span class="kunye-ayrac" aria-hidden="true">·</span>}
      {yazarli && (
        <span>
          Hukuki içerik: <a href="/hakkinda/">{YAZAR.ad}</a>
        </span>
      )}
    </p>
  )}
  <hr class="su-hatti" aria-hidden="true" />
  {ozet && (
    ozCevap
      ? <p class="sayfa-ozet oz-cevap" role="doc-abstract">{ozet}</p>
      : <p class="sayfa-ozet">{ozet}</p>
  )}
</div>

<style>
  /* Künye satırı mono katmanda (DESIGN.md §6): ölçüm/kayıt estetiği */
  .sayfa-kunye {
    margin-top: 0.8rem;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--metin-soluk);
    text-transform: uppercase;
  }

  .sayfa-kunye a { color: var(--baglanti); }

  .kunye-ayrac { color: var(--cizgi); }
</style>
