---
// Üst menü — TEK KAYNAK (FAZ A-ÖN birleştirmesi, 2026-07-21):
// - tema="aydinlik" (varsayılan): içerik sayfaları — krem sticky bar +
//   satır-içi linkler + menü butonu + TamEkranMenu katmanı.
// - tema="koyu": landing — gece denizi sahnesinde yüzen şerit; landing'in
//   eski statik header'ı buraya birebir taşındı (görsel değişmezlik A-ÖN
//   şartı). Koyu dalda menü butonu/TamEkranMenu RENDER EDİLMEZ; FAZ A
//   (menü reformu) bu dala da tek kaynaktan işleyecek.
// Davranış /s/menu.js'te.
import TamEkranMenu from './TamEkranMenu.astro';

interface Props {
  tema?: 'aydinlik' | 'koyu';
}
const { tema = 'aydinlik' } = Astro.props;

const ogeler = [
  { ad: 'Harita', yol: '/harita/' },
  { ad: 'Havzalar', yol: '/havzalar/' },
  { ad: 'Rehberler', yol: '/rehberler/' },
  { ad: 'Su Kanunu', yol: '/su-kanunu/' },
  { ad: 'Durumum', yol: '/durumum/' },
  { ad: 'Hangi Kurum', yol: '/hangi-kurum/' },
  { ad: 'Vakalar', yol: '/vaka/' },
  { ad: 'Hakkında', yol: '/hakkinda/' },
];
// "Deneyim" 23.07'de menüden KALKTI: /deneyim/ rotası kapandı (301 → /),
// sahne akışı ana sayfaya taşındı. Tek kaynak burasıdır.
// Landing (koyu dal) Vakalar ve Durumum linklerini taşımıyor; koyu dal listesi
// tek kaynaktan süzülür. Mobil panel (TamEkranMenu) tam listeyi zaten verir.
const koyuOgeler = ogeler.filter(
  (o) => o.yol !== '/vaka/' && o.yol !== '/durumum/' && o.yol !== '/hangi-kurum/',
);
const simdiki = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
---
{tema === 'koyu' ? (
  <Fragment>
    <header class="koyu" data-menu-dis>
      <span class="marka-koyu">Su Haritası</span>
      <nav class="ust-nav" aria-label="Site menüsü">
        {koyuOgeler.map((o) => (
          <a href={o.yol}>{o.ad}</a>
        ))}
      </nav>
      {/* FAZ A dar-şerit tetikleyicisi: yalnız ≤640px'te görünür (masaüstü
          landing görünümü değişmez); paneli /s/menu.js yönetir. */}
      <button
        class="sv-menu-ac sv-menu-ac-koyu"
        type="button"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="sv-menu"
      >menü</button>
    </header>

    <TamEkranMenu />
  </Fragment>
) : (
  <Fragment>
    <header class="ust">
      <nav aria-label="Site menüsü">
        <a class="marka" href="/">su haritası</a>
        <ul>
          {ogeler.map((o) => (
            <li>
              <a
                href={o.yol}
                aria-current={simdiki.startsWith(o.yol) ? 'page' : undefined}
              >{o.ad}</a>
            </li>
          ))}
        </ul>
        <button
          class="sv-menu-ac"
          type="button"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="sv-menu"
        >menü</button>
      </nav>
    </header>

    <TamEkranMenu />
  </Fragment>
)}

<style>
  /* ——— KOYU tema (landing): eski public/index.html header CSS'i birebir.
     Renk değişkenleri sayfanın :root'undan gelir (landing paleti). ——— */
  header.koyu {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    /* HATA DÜZELTMESİ (FAZ A denetiminde yakalandı; canlıda da mevcut):
       kardeş <main> translateY(-6vh) ile header'ın üstüne binip nav
       linklerinin/tetikleyicinin tıklamasını yutuyordu (masaüstünde 5/5
       link engelliydi — elementFromPoint kanıtı raporda). Görsel etkisi
       sıfır; yalnız isabet/boya sırası düzelir. */
    position: relative;
    z-index: 3;
  }

  .marka-koyu {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--metin-soluk);
  }

  .ust-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.2vw, 1.6rem);
    flex-wrap: wrap;
  }

  .ust-nav a {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    text-decoration: none;
    padding: 0.3rem 0;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .ust-nav a:hover {
    color: var(--kopuk);
    border-bottom-color: rgba(79, 195, 208, 0.5);
  }

  .ust-nav a:focus-visible {
    outline: 2px solid var(--akuamarin);
    outline-offset: 3px;
  }

  /* Giriş koreografisi kancaları: body.giris'i landing JS'i takar (scoped
     kapsam dışı olduğundan :global). belir keyframe'i burada tanımlı ki
     Astro scoped ad yeniden-yazımı tutarlı kalsın. */
  :global(body.giris) .marka-koyu {
    animation: belir 0.5s 0.15s cubic-bezier(0.33, 1, 0.68, 1) both;
  }

  :global(body.giris) .ust-nav {
    animation: belir 0.6s 0.28s cubic-bezier(0.33, 1, 0.68, 1) both;
  }

  @keyframes belir {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ——— AYDINLIK tema (içerik sayfaları) — DOKUNULMADI ——— */
  .ust {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid var(--cizgi);
    background: var(--zemin);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* 40px+ kaydırınca (sayfa.js sentineli): yarı saydam krem + blur */
  .ust:global(.sv-yuzer) {
    background: rgba(237, 243, 247, 0.9);
    box-shadow: 0 1px 14px rgba(19, 42, 63, 0.06);
  }

  @supports (backdrop-filter: blur(1px)) {
    .ust:global(.sv-yuzer) {
      background: rgba(237, 243, 247, 0.74);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  }

  /* '.ust nav' (çıplak 'nav' DEĞİL): scoped cid koyu daldaki .ust-nav'a da
     düşer; çıplak seçici landing şeridini 3.6rem'e büyütüyordu (A-ÖN
     doğrulamasında yakalandı). Bildirimler aynı — aydınlık görünüm değişmez. */
  .ust nav {
    max-width: 64rem;
    margin: 0 auto;
    height: 3.6rem;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .marka {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.3rem;
    color: var(--metin);
    text-decoration: none;
    white-space: nowrap;
  }

  .ust ul {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.4vw, 1.7rem);
    list-style: none;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ust ul a {
    display: inline-block;
    padding: 0.35rem 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .ust ul a:hover { color: var(--metin); }

  .ust ul a[aria-current="page"] {
    color: var(--metin);
    border-bottom-color: var(--su-400);
  }

  .sv-menu-ac {
    border: 0;
    background: none;
    padding: 0.35rem 0;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .sv-menu-ac:hover { color: var(--su-700); }

  /* Koyu dal tetikleyicisi: masaüstünde YOK (landing masaüstü değişmez);
     stiller landing paletiyle açık yazılır (--sans/--su-700 landing
     :root'unda tanımsız — kırık var() bırakılmaz). */
  .sv-menu-ac-koyu {
    display: none;
    font-family: "Manrope", system-ui, sans-serif;
    color: var(--metin-soluk);
  }

  .sv-menu-ac-koyu:hover { color: var(--kopuk, #A8DDE0); }

  .sv-menu-ac-koyu:focus-visible {
    outline: 2px solid var(--akuamarin, #4FC3D0);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    /* ——— FAZ A MOBİL REFORMU (tek gerçek kaynak: mock
       cikti/denetim/faz2/faz2-sakarya-mobil-menumock.jpeg) ———
       Kapalı durum = tek dar şerit: marka solda + MENÜ sağda; hedef
       85px ±4 (5.3rem = 84.8px). Satır-içi linkler yalnız GÖRSEL
       katmandan çekilir (display:none) — DOM'da gerçek <a> olarak
       dururlar (JS'siz crawl edilebilir); gezinme yüzeyi tam-ekran
       panel (TamEkranMenu, /s/menu.js). */
    .ust nav {
      height: 5.3rem;
      padding-top: 0;
      padding-bottom: 0;
      flex-wrap: nowrap;
    }

    .ust ul { display: none; }

    /* Dokunma hedefi ≥44px (DESIGN.md §12): tetikleyici + marka */
    .sv-menu-ac,
    .marka {
      padding-top: 0.95rem;
      padding-bottom: 0.95rem;
    }

    .sv-menu-ac { min-height: 44px; min-width: 44px; }

    /* Koyu dal (landing) aynı kalıp: linkler görsel katmandan çekilir,
       MENÜ tetikleyicisi görünür; şerit 85px ±4. */
    header.koyu {
      height: 5.3rem;
      flex-wrap: nowrap;
      align-items: center;
    }

    header.koyu .ust-nav { display: none; }

    .sv-menu-ac-koyu {
      display: block;
      min-height: 44px;
      min-width: 44px;
      padding-top: 0.95rem;
      padding-bottom: 0.95rem;
    }

    .marka-koyu {
      padding-top: 0.95rem;
      padding-bottom: 0.95rem;
    }
  }

</style>
