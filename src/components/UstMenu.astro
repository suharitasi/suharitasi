---
// Üst menü çubuğu: landing hariç tüm içerik sayfalarında.
// Tam ekran katman ayrı bileşendedir (TamEkranMenu — /harita/ ile ortak);
// davranış /s/menu.js'te.
import TamEkranMenu from './TamEkranMenu.astro';

const ogeler = [
  { ad: 'Harita', yol: '/harita/' },
  { ad: 'Havzalar', yol: '/havzalar/' },
  { ad: 'Rehberler', yol: '/rehberler/' },
  { ad: 'Su Kanunu', yol: '/su-kanunu/' },
  { ad: 'Hakkında', yol: '/hakkinda/' },
];
const simdiki = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
---
<header class="ust">
  <nav aria-label="Site menüsü">
    <a class="marka" href="/">su haritası</a>
    <ul>
      {ogeler.map((o) => (
        <li>
          <a
            href={o.yol}
            aria-current={simdiki.startsWith(o.yol) ? 'page' : undefined}
          >{o.ad}</a>
        </li>
      ))}
    </ul>
    <button
      class="sv-menu-ac"
      type="button"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="sv-menu"
    >menü</button>
  </nav>
</header>

<TamEkranMenu />

<style>
  .ust {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid var(--cizgi);
    background: var(--zemin);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* 40px+ kaydırınca (sayfa.js sentineli): yarı saydam krem + blur */
  .ust:global(.sv-yuzer) {
    background: rgba(243, 238, 226, 0.9);
    box-shadow: 0 1px 14px rgba(35, 46, 43, 0.06);
  }

  @supports (backdrop-filter: blur(1px)) {
    .ust:global(.sv-yuzer) {
      background: rgba(243, 238, 226, 0.74);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  }

  nav {
    max-width: 64rem;
    margin: 0 auto;
    height: 3.6rem;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .marka {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.3rem;
    color: var(--metin);
    text-decoration: none;
    white-space: nowrap;
  }

  .ust ul {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.4vw, 1.7rem);
    list-style: none;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ust ul a {
    display: inline-block;
    padding: 0.35rem 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .ust ul a:hover { color: var(--metin); }

  .ust ul a[aria-current="page"] {
    color: var(--metin);
    border-bottom-color: var(--akuamarin);
  }

  .sv-menu-ac {
    border: 0;
    background: none;
    padding: 0.35rem 0;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .sv-menu-ac:hover { color: var(--su-700); }

  @media (max-width: 640px) {
    nav { height: auto; padding-top: 0.8rem; padding-bottom: 0.8rem; flex-wrap: wrap; }
  }

</style>
