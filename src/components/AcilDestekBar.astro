---
// ACİL DESTEK BARI — site geneli sabit (sticky) dönüşüm barı (13.09.2026).
//
// Amaç: her sayfada tek dokunuşla arama / WhatsApp / hızlı danışma.
// TBB NOTU: metinler aksiyona iter ama SAHTE VAAT içermez ("davanı kazanırız"
// gibi ifade YOK). Karar kullanıcınındır.
// Ölçüm: tüm bağlantılar data-olay taşır (/olay sayacı).
// Çakışma: bu bar sabit alt şerittir; eski tekil WhatsApp düğmesi kaldırıldı.
import { TELEFON } from '../data/site';
---
<div class="adb" role="region" aria-label="Acil hukuki destek">
  <p class="adb-metin">Acil hukuki destek</p>
  <div class="adb-eylem">
    <a class="adb-btn adb-tel" href={`tel:${TELEFON.tel}`} data-olay="telefon">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
      <span>Telefon</span>
    </a>
    <a class="adb-btn adb-wa" href="/whatsapp/" rel="nofollow noopener" data-olay="whatsapp">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
      <span>WhatsApp</span>
    </a>
    <a class="adb-btn adb-form" href="/hizli-danisma/" data-olay="iletisim-form">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z"/><path d="M14 2v6h6"/><path d="M9 13h6"/><path d="M9 17h6"/></svg>
      <span>Hızlı danışma</span>
    </a>
  </div>
</div>

<style>
  /* Sabit bar içeriği örtmesin: her sayfada gövdeye alt pay. */
  :global(body) { padding-bottom: 68px; }

  .adb {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 52;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.55rem clamp(0.8rem, 3vw, 1.5rem);
    background: var(--deniz, #0A2740);
    border-top: 2px solid var(--akuamarin, #57BAE0);
    box-shadow: 0 -6px 24px rgba(10, 39, 64, 0.28);
  }

  .adb-metin {
    font-family: var(--serif, Georgia, serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: #fff;
    white-space: nowrap;
  }

  .adb-eylem { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; }

  .adb-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1rem;
    font-family: var(--sans, "Manrope", system-ui, sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition: background-color 140ms var(--e-akinti, ease), transform 140ms var(--e-suzul, ease);
  }

  .adb-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .adb-wa svg { fill: currentColor; stroke: none; }

  .adb-tel { background: var(--akuamarin, #57BAE0); color: var(--deniz, #0A2740); border-color: transparent; }
  .adb-wa { background: #0f6b38; color: #fff; border-color: transparent; }
  .adb-form { background: transparent; color: #fff; }

  .adb-btn:hover { transform: translateY(-1px); }
  .adb-tel:hover { background: #7ccdea; }
  .adb-wa:hover { background: #23a25a; }
  .adb-form:hover { background: rgba(255, 255, 255, 0.14); }
  .adb-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  @media (max-width: 640px) {
    .adb { gap: 0.5rem; padding: 0.5rem; }
    .adb-metin { display: none; }
    .adb-btn { flex: 1 1 0; justify-content: center; padding: 0 0.5rem; font-size: 0.8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .adb-btn { transition: none; }
    .adb-btn:hover { transform: none; }
  }
</style>
