---
// "Cevap önce, dayanak sonra" (CLAUDE.md) — başlıktan hemen sonra çıkan
// damıtılmış öz cevap kutusu. Mevcut blockquote diliyle uyumlu: sol akuamarin
// çizgi + hafif su-tonlu zemin; ayırt edilir ama abartısız. Emoji/ikon yok.
// Build-time statik (kopyalanma direnci ilkesi). İçerik props ile gelir —
// bileşen metin ÜRETMEZ, yalnız sunar.
interface Props {
  metin: string;
  // Görünür callout etiketi (ör. "Kanun özeti"). Verilmezse yalnız kutu
  // render edilir (mevcut davranış korunur). LLM/RAG istemcilerinin kutuyu
  // tanım olarak çekmesini kolaylaştırır; metni DEĞİŞTİRMEZ.
  etiket?: string;
}
const { metin, etiket } = Astro.props;
---
<div class="oz-kap">
  {etiket && <p class="oz-etiket">{etiket}</p>}
  <p class="oz-cevap" role="doc-abstract">{metin}</p>
</div>

<style>
  .oz-kap { margin: 0 0 1.8rem; }

  .oz-etiket {
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--su-700);
    margin-bottom: 0.4rem;
  }

  .oz-cevap {
    margin: 0;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--su-400);
    background: rgba(46, 126, 160, 0.06);
    font-size: 1.06rem;
    line-height: 1.6;
    color: var(--metin);
    max-width: 66ch;
    /* Metin duvarı değil, tek nefeslik özet: hafifçe öne çıkar */
    font-weight: 500;
  }

  @media print {
    .oz-cevap { background: none; }
  }
</style>
