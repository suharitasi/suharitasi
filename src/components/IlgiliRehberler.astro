---
// Sayfa sonu "İlgili rehberler": okuru çıkmaz sokakta bırakmayan tek blok.
// Slug'lar derleme sırasında doğrulanır — olmayan slug build'i düşürür,
// sessizce kaybolmaz.
import { getCollection } from 'astro:content';

interface Props {
  slugler: string[];
  // Kendi sayfasının slug'ı: yanlışlıkla kendine link verilmesini engeller.
  haric?: string;
}

const { slugler, haric } = Astro.props;
const hepsi = await getCollection('rehberler');

const kartlar = slugler
  .filter((s) => s !== haric)
  .map((s) => {
    const g = hepsi.find((r) => r.id === s);
    if (!g) {
      throw new Error(
        `IlgiliRehberler: "${s}" adlı rehber yok (kaynak: ${haric ?? 'bilinmiyor'}).`
      );
    }
    return g;
  });

const kicker = (k) => (k === 'surec' ? 'Rehber · Süreç' : 'Rehber · Uyuşmazlık');
---
{kartlar.length > 0 && (
  <nav class="ilgili" aria-label="İlgili rehberler">
    <h2>İlgili rehberler</h2>
    <ul>
      {kartlar.map((g) => (
        <li>
          <a class={`kart-${g.data.kume}`} href={`/rehberler/${g.id}/`}>
            <span class="ilgili-kicker">{kicker(g.data.kume)}</span>
            <span class="ilgili-baslik">{g.data.baslik}</span>
            <span class="ilgili-ozet">{g.data.ozet}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .ilgili { margin-top: 2.8rem; }

  .ilgili h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.9rem;
  }

  .ilgili ul { list-style: none; display: grid; gap: 0.8rem; }

  /* Kart kimliği (DESIGN.md §8): üst hairline + kicker + hover tür tonu */
  .ilgili a {
    display: block;
    padding: 1rem 1.2rem;
    text-decoration: none;
    color: inherit;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    transition: transform 240ms var(--e-suzul), background-color 240ms var(--e-akinti);
  }

  .ilgili a.kart-surec { border-top: 2px solid var(--yesil-kara); }
  .ilgili a.kart-uyusmazlik { border-top: 2px solid var(--kehribar); }

  .ilgili a:hover { transform: translateY(-2px); }
  .ilgili a.kart-surec:hover { background: rgba(44, 85, 112, 0.07); }
  .ilgili a.kart-uyusmazlik:hover { background: rgba(192, 136, 58, 0.08); }
  .ilgili a:active { transform: translateY(0) scale(0.985); transition-duration: 120ms; }

  .ilgili-kicker {
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .kart-surec .ilgili-kicker { color: var(--yesil-kara); }
  .kart-uyusmazlik .ilgili-kicker { color: var(--kehribar-metin); }

  .ilgili-baslik {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--metin);
  }

  .ilgili a:hover .ilgili-baslik { color: var(--su-700); }

  .ilgili-ozet {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--metin-soluk);
    /* Özetler uzun; iki satırda kes — blok listesi ritmi bozulmasın. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .ilgili a { transition: none; }
    .ilgili a:hover, .ilgili a:active { transform: none; }
  }
</style>
