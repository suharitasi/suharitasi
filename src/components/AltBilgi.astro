---
// Üç kolonlu footer: bölümler / veri-yöntem / künye.
// Mevcut "Arslan Hukuk Bürosu güvencesiyle" imza satırına DOKUNULMAZ —
// en altta, olduğu gibi durur (kullanıcı kararı).
// TBB uyumu: künye bilgilendirmedir; davet veya hizmet vaadi yoktur.
import { ARAC } from '../data/arac-adlari.js';
import { YAZAR, EPOSTA } from '../data/site';

// site-architecture "orphan page yasağı" + footer sütunlama kuralı.
// ÖLÇÜM: footer 8 bölümün yalnız 5'ini taşıyordu; en yüksek niyetli üç
// hedef (Durumum, Hangi Kurum, Vakalar) ve 81 il hub'ı footer'da HİÇ yoktu.
// Mevcut "Bölümler" sütunu AYNEN korunur (onaylı metin, sıra dahil);
// eksikler YENİ bir sütuna eklenir — hiçbir bağlantı kaldırılmadı.
const bolumler = [
  { ad: 'Su Hukuku', yol: '/su-hukuku/' },
  { ad: 'Mevzuat', yol: '/mevzuat/' },
  { ad: 'Nehirler', yol: '/nehirler/' },
  { ad: 'Göller', yol: '/goller/' },
  { ad: 'Veriler', yol: '/veri/' },
  { ad: 'Sözlük', yol: '/sozluk/' },
  { ad: 'Ara', yol: '/ara/' },
  { ad: 'Hakkında', yol: '/hakkinda/' },
  { ad: 'Gizlilik', yol: '/gizlilik/' },
];

const niyetKapilari = [
  // FAZ 1 (v5.2): bağ hedefi aynı; etiket yeni görünür adla güncellendi.
  { ad: ARAC.teblig.ad, yol: ARAC.teblig.yol },
  { ad: ARAC.tarla.ad, yol: ARAC.tarla.yol },
  { ad: ARAC.ceza.ad, yol: ARAC.ceza.yol },
  { ad: 'Riskim ne?', yol: '/su-riski-endeksi/' },
  { ad: 'Kısıt var mı?', yol: '/kuyu-kisit-sorgu/' },
  { ad: 'Hesapla', yol: '/hesaplayicilar/' },
  { ad: 'Hızlı Danışma', yol: '/hizli-danisma/' },
  { ad: 'Kuyu Ruhsatı — iller', yol: '/kuyu-ruhsati/' },
];
---
<footer class="alt">
  <div class="alt-kolonlar">
    <nav class="alt-kolon" aria-label="Site bölümleri">
      <p class="alt-baslik">Bölümler</p>
      <ul>
        {bolumler.map((b) => (
          <li><a href={b.yol}>{b.ad}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="alt-kolon" aria-label="Ne yapmam gerekiyor">
      <p class="alt-baslik">Ne yapmam gerekiyor</p>
      <ul>
        {niyetKapilari.map((b) => (
          <li><a href={b.yol}>{b.ad}</a></li>
        ))}
      </ul>
    </nav>

    <div class="alt-kolon">
      <p class="alt-baslik">Veri ve yöntem</p>
      <p class="alt-metin">
        Sayısal veriler DSİ ve SYGM'nin kamuya açık kaynaklarından derlenir ve
        her alanda kaynağıyla birlikte sunulur. Doğrulanamayan veri
        "veri yok" olarak işaretlenir.
      </p>
      <p class="alt-metin">
        <a href="/hakkinda/#veri-kaynagi-politikasi">Yöntem ve kaynak politikası</a>
      </p>
    </div>

    <div class="alt-kolon">
      <p class="alt-baslik">Künye</p>
      <p class="alt-metin">
        Hukuki içerik: {YAZAR.ad} —{' '}
        <a href={YAZAR.buroUrl} target="_blank" rel="noopener">{YAZAR.buro}</a>
      </p>
      <p class="alt-metin">
        <a href={`mailto:${EPOSTA}`} data-olay="eposta">{EPOSTA}</a>
      </p>
    </div>
  </div>

  <p class="alt-imza">
    <a href={YAZAR.buroUrl} target="_blank" rel="noopener">
      suharitasi.com · Arslan Hukuk Bürosu güvencesiyle · 2026
    </a>
  </p>
</footer>

<style>
  footer.alt {
    border-top: 1px solid var(--cizgi);
    margin-top: clamp(3rem, 8vh, 5rem);
    padding: clamp(2rem, 5vh, 2.8rem) clamp(1.25rem, 4vw, 2rem) 1.4rem;
    color: var(--metin-soluk);
  }

  .alt-kolonlar {
    max-width: 64rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 720px) {
    .alt-kolonlar { grid-template-columns: repeat(2, 1fr); gap: 1.6rem; }
    /* Faz D (08.09.2026, D5 ölçümü): sabit WhatsApp düğmesi (44px, sağ alt)
       430px'te imza satırını kapatıyordu — dar ekranda footer'a düğme
       yüksekliği + boşluk kadar alt pay. Masaüstünde kesişme ölçülmedi. */
    footer.alt { padding-bottom: calc(1.4rem + 44px + 1rem); }
  }

  .alt-baslik {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--metin);
    margin-bottom: 0.7rem;
  }

  .alt-kolon ul { list-style: none; }

  .alt-kolon li { margin: 0.15rem 0; }

  .alt-kolon a {
    color: var(--metin-soluk); text-decoration: none;
    /* CRO (WCAG 2.5.8): footer bağlantıları ≥44px dokunma yüksekliği.
       Satır aralığı görsel olarak korunur (gap yerine hedef büyür). */
    display: inline-flex; align-items: center; min-height: 44px;
  }

  .alt-kolon a:hover { color: var(--metin); text-decoration: underline; }

  .alt-metin {
    font-size: 0.84rem;
    line-height: 1.65;
    margin: 0.3rem 0;
    max-width: 40ch;
  }

  .alt-imza {
    max-width: 64rem;
    margin: clamp(1.8rem, 4vh, 2.4rem) auto 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--cizgi);
    text-align: center;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }

  .alt-imza a {
    color: var(--metin-soluk);
    text-decoration: none;
    /* CRO (WCAG 2.5.8): imza bağlantısı da ≥44px hedef. */
    display: inline-flex; align-items: center; min-height: 44px;
    /* K31 (27.08): sözlük dışı `ease` → DESIGN.md §9 renk durumu eğrisi. */
    transition: color 0.2s var(--e-akinti, cubic-bezier(0.45, 0.05, 0.55, 0.95));
  }

  .alt-imza a:hover { color: var(--metin); }
</style>
