---
// HAKKINDA (v0 yapısı, M7 süzgeciyle) — v0'daki "15+ yıl / 500+ dosya /
// %98 memnuniyet" UYDURMA → YAZILMADI. Yerine build'de SAYILAN gerçek
// envanter: havza (content koleksiyonu), il (il-profil üreticisi),
// rehber (content koleksiyonu). Elle sayı girilmez.
// Maddeler v0'dan; YAZAR bilgisi künye kaynağından (site.ts, tek kaynak).
import { YAZAR } from '../../data/site';
import { tumIlProfilleri } from '../../data/il-profil.js';

const havzaSayisi = Object.keys(import.meta.glob('../../content/havzalar/*.md')).length;
const rehberSayisi = Object.keys(import.meta.glob('../../content/rehberler/*.md')).length;
const ilSayisi = tumIlProfilleri().length;
if (!havzaSayisi || !rehberSayisi || !ilSayisi) {
  throw new Error('anasayfa Hakkında: envanter sayımı boş döndü — veri kaynağı kontrol edilmeli.');
}
---
<section class="v2-bolum v2-hakkinda" id="hakkinda" aria-label="Hakkında">
  <div class="v2-ic">
    <div class="v2-hakkinda-izgara">
      <div>
        <p class="v2-bolum-kicker">Hakkında</p>
        <h2>Suyun hukukunu bilen bir avukatla çalışın</h2>
        {/* v0 paragrafının ilk iki cümlesi aynen; v0'ın "yıllardır YALNIZCA
            su hukuku" beyanı künyeyle çelişir (su hukuku + idari yargı +
            şirketler) — son cümle künye gerçeğiyle (A2-5, rapora yazıldı). */}
        <p>Su; bir hak, bir kaynak ve çoğu zaman bir anlaşmazlık konusudur.
          Bu alandaki mevzuat karmaşık, süreçler ise çoğunlukla teknik bilgi
          gerektirir. {YAZAR.ad} — {YAZAR.buro}: {YAZAR.uzmanlik} Bu
          portaldaki hukuki içerik ve mevzuat analizleri kendisi tarafından
          hazırlanmaktadır.</p>
        {/* v0: CheckCircle2 ikonlu maddeler (A2-6, inline SVG) */}
        <ul>
          {['Su hukuku ve yeraltı suyu mevzuatında uzmanlık',
            'DSİ ve idari kurum süreçlerinde deneyim',
            'Bireysel çiftçiden kurumsal işletmeye kadar temsil'].map((m) => (
            <li>
              <svg class="v2-check" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                   stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
              </svg>
              {m}
            </li>
          ))}
        </ul>
      </div>
      <div class="v2-sayilar">
        <div class="v2-sayi"><strong>{havzaSayisi}</strong><span>havza künyesi</span></div>
        <div class="v2-sayi"><strong>{ilSayisi}</strong><span>il profili</span></div>
        <div class="v2-sayi"><strong>{rehberSayisi}</strong><span>rehber</span></div>
      </div>
    </div>
  </div>
</section>
