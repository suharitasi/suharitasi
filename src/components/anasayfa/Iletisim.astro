---
// İLETİŞİM (v0, M7 süzgeciyle) — statik site, sunucu yok: form JS ile
// mailto: gövdesine çevrilir (encodeURIComponent). Harici form servisi YOK.
// JS kapalı: form gizlenir, doğrudan mailto linki görünür (noscript).
// M7: telefon künyede DOĞRULANAMADI → telefon bloğu KONMADI.
//     "İstanbul" konumu sitede DOĞRULANAMADI → konum bloğu KONMADI.
//     (İkisi de rapora/kuyruğa yazıldı.)
import { EPOSTA, YAZAR } from '../../data/site';
---
<section class="v2-bolum v2-iletisim" id="iletisim" aria-label="İletişim">
  <div class="v2-ic">
    <div class="v2-iletisim-izgara">
      <div>
        {/* v0 yapısı: kicker+h2+intro solda (kıyas A2-3; metin v0'dan,
            "İlk görüşme ücretsizdir" hero CTA'sıyla tutarlı) */}
        <p class="v2-bolum-kicker">İletişim</p>
        <h2>Su ile ilgili sorunuzu bize bırakın</h2>
        <p class="v2-intro">Kuyu, sondaj, ruhsat ya da tahsis; durumunuzu
          kısaca yazın, en kısa sürede size dönelim. İlk görüşme ücretsizdir.</p>
      <div class="v2-iletisim-bilgi">
        <p>E-posta: <a href={`mailto:${EPOSTA}`}>{EPOSTA}</a></p>
        <p>{YAZAR.buro} — <a href={YAZAR.buroUrl} rel="noopener">arslanhukuk.tr</a></p>
        <p>Mesajınız doğrudan e-posta olarak iletilir; form bir sunucuya
          veri göndermez.</p>
      </div>
      </div>
      <form class="v2-form" id="v2-form">
        <label>Adınız
          <input type="text" name="ad" autocomplete="name" required />
        </label>
        <label>E-posta adresiniz
          <input type="email" name="eposta" autocomplete="email" required />
        </label>
        <label>Mesajınız
          <textarea name="mesaj" rows="5" required></textarea>
        </label>
        <button type="submit">E-posta ile gönder</button>
      </form>
    </div>
  </div>
</section>

<noscript>
  <style>
    /* JS kapalı: form çalışamaz → gizlenir; soldaki doğrudan mailto kalır. */
    .v2-form { display: none; }
  </style>
</noscript>

<script>
  // Form → mailto gövdesi. Sunucu yok; alanlar encodeURIComponent ile konur.
  const form = document.getElementById('v2-form');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = new FormData(form);
    const konu = encodeURIComponent(`Ön görüşme talebi — ${v.get('ad')}`);
    const govde = encodeURIComponent(
      `Ad: ${v.get('ad')}\nE-posta: ${v.get('eposta')}\n\n${v.get('mesaj')}`
    );
    location.href = `mailto:bilgi@suharitasi.com?subject=${konu}&body=${govde}`;
  });
</script>
