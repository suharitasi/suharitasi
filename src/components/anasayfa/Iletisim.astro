---
// İLETİŞİM (v0, M7 süzgeciyle). 10.10.2026 (brif 1.5): mailto gövdesi
// kaldırıldı; form hızlı danışma ile aynı sunucu işlevine (/danisma, KV,
// ~180 gün) gider; KVKK onayı ve tuzak alanı eklendi. Harici form servisi YOK.
// JS kapalı: form gizlenir, doğrudan mailto linki görünür (noscript).
// M7: telefon künyede DOĞRULANAMADI → telefon bloğu KONMADI.
//     "İstanbul" konumu sitede DOĞRULANAMADI → konum bloğu KONMADI.
//     (İkisi de rapora/kuyruğa yazıldı.)
import { EPOSTA, YAZAR } from '../../data/site';
import OnayBekliyor from '../OnayBekliyor.astro';
---
<section class="v2-bolum v2-iletisim" id="iletisim" aria-label="İletişim">
  <div class="v2-ic">
    <div class="v2-iletisim-izgara">
      <div>
        {/* v0 yapısı: kicker+h2+intro solda (kıyas A2-3; metin v0'dan,
            "İlk görüşme ücretsizdir" hero CTA'sıyla tutarlı) */}
        <p class="v2-bolum-kicker">İletişim</p>
        <h2>Su ile ilgili sorunuzu bize bırakın</h2>
        <p class="v2-intro">Kuyu, sondaj, ruhsat ya da tahsis; durumunuzu
          kısaca yazın, en kısa sürede size dönelim. İlk görüşme ücretsizdir.</p>
      {/* v0 yapısı: ikon kutulu iletişim satırları (A2-5). Telefon ve konum
          M7 gereği YOK (doğrulanamadı) — yalnız gerçek kanallar. */}
      <div class="v2-iletisim-bilgi">
        <a class="v2-kanal" href={`mailto:${EPOSTA}`}>
          <span class="v2-kanal-ikon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <path d="m3 7 9 6 9-6"/>
            </svg>
          </span>
          {EPOSTA}
        </a>
        <a class="v2-kanal" href={YAZAR.buroUrl} rel="noopener">
          <span class="v2-kanal-ikon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3 4 7v2h16V7l-8-4Z"/><path d="M6 11v6"/>
              <path d="M12 11v6"/><path d="M18 11v6"/><path d="M4 21h16"/>
            </svg>
          </span>
          {YAZAR.buro}
        </a>
        <p class="v2-kanal-not">Mesajınız sitenin kendi form hizmetine iletilir
          (hızlı danışma formuyla aynı yol); yalnız size dönüş için kullanılır ve
          en geç 180 gün sonra kendiliğinden silinir. Ayrıntı:
          <a href="/gizlilik/">Gizlilik ve KVKK</a>.</p>
        <OnayBekliyor kaynak="İletişim formu beyanı ve onay metni (brif 1.5)" />
      </div>
      </div>
      {/* v0 alan adları/etiketleri/placeholder'ları; gönderim MAILTO kalır
          (A2 ÖZEL). Telefon = ziyaretçinin kendi numarası (form alanı,
          uydurma değil). */}
      <form class="v2-form" id="v2-form" data-olay-form="iletisim-form" data-danisma-form>
        <label>Ad Soyad
          <input type="text" name="ad" autocomplete="name" required
                 placeholder="Adınız ve soyadınız" />
        </label>
        <div class="v2-form-iki">
          <label>Telefon
            <input type="tel" name="telefon" autocomplete="tel" required
                   placeholder="05xx xxx xx xx" />
          </label>
          <label>E-posta (isteğe bağlı)
            <input type="email" name="eposta" autocomplete="email"
                   placeholder="ornek@eposta.com" />
          </label>
        </div>
        <label>Durumunuz
          <textarea name="mesaj" rows="4" required
                    placeholder="Örn. Kuyu ruhsatı başvurumu nasıl yapabilirim?"></textarea>
        </label>
        <div class="v2-tuzak" aria-hidden="true">Bu alanı boş bırakın
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <label class="v2-onay">
          <input type="checkbox" name="onay" required />
          <span><a href="/gizlilik/">Gizlilik ve KVKK aydınlatma metnini</a> okudum;
            iletişim bilgilerimin yalnız bu talebe dönüş amacıyla işlenmesine onay
            veriyorum.</span>
        </label>
        <button type="submit">Mesajı Gönder</button>
        <p class="v2-durum" data-danisma-durum aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

{/* P3 W3C onarımı: JS kapalıyken form gizleme kuralı gövdede <noscript><style>
    olamayacağı için /assets/noscript.css'e taşındı (o dosya yalnız JS kapalı
    iken, menü noscript'i üzerinden yüklenir). */}

<script type="module" src="/s/danisma.js" is:inline></script>

<style>
  .v2-tuzak { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .v2-onay { display: flex !important; flex-direction: row !important; align-items: flex-start; gap: 0.6rem; font-size: 0.86rem; }
  .v2-onay input { width: auto; margin-top: 0.25rem; }
  .v2-durum { margin: 0.6rem 0 0; font-size: 0.9rem; min-height: 1.2em; }
  .v2-durum.ok { color: var(--su-700); }
  .v2-durum.hata { color: var(--kehribar); }
</style>
