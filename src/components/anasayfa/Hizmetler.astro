---
// HİZMETLER (v0) — 6 kart, üçlü ızgara. İkon: sitede paket tabanlı ikon
// sistemi yok → inline SVG (paket KURULMADI, M5). Hedefi olmayan kart
// LİNKSİZ <div> kalır (brief kuralı; rapora yazıldı).
// M7b: metinler hizmet tanımıdır, hukuki hüküm içermez.
import { HIZMETLER } from '../../data/anasayfa-v2.js';

// Basit stroke ikonlar (Lucide çizgi dili; elle çizildi, paket yok).
const IKONLAR = {
  // v0 lucide seti — elle inline SVG (M5: paket yok). Anlamlar birebir:
  // FileCheck2 · Drill · Waves · Scale · Landmark · ShieldAlert
  kuyu: '<path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m3 15 2 2 4-4"/>',
  sondaj: '<path d="M10 4h6a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-6"/><path d="M4 6h6v4H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z"/><path d="M18 7h3"/><path d="M13 10v3l-2 7h-2l-1-7"/><path d="M7 21h6"/>',
  tahsis: '<path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>',
  uyusmazlik: '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  idari: '<path d="M3 22h18"/><path d="M6 18v-7"/><path d="M10 18v-7"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="m12 2 9 5H3l9-5Z"/>',
  kuruyan: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z"/><path d="M12 8v4"/><path d="M12 16h.01"/>',
};
---
<section class="v2-bolum v2-hizmetler" id="hizmetler" aria-label="Hizmetler">
  <div class="v2-ic">
    {/* v0: ortalı başlık bloğu + intro (kıyas A2-3; metinler v0'dan) */}
    <div class="v2-bolum-bas">
      <p class="v2-bolum-kicker">Hizmetler</p>
      <h2>Su ile ilgili her hukuki ihtiyaç tek çatı altında</h2>
      <p class="v2-intro">Başvurudan davaya, danışmanlıktan uyuşmazlık çözümüne
        kadar su hukukunun tüm alanlarında yanınızdayız.</p>
    </div>
    <div class="v2-hiz-izgara">
      {HIZMETLER.map((h) => {
        const Icerik = (
          <>
            {/* v0: ikon kutusu 3rem rounded-xl bg-primary/10; kart hover'da
                dolu primary (A2-6) */}
            <span class="v2-kart-ikon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                   set:html={IKONLAR[h.ikon]}></svg>
            </span>
            <h3>{h.ad}</h3>
            <p>{h.metin}</p>
            {h.hedef && <span class="v2-kart-git">Rehberi oku →</span>}
          </>
        );
        return h.hedef
          ? <a class="v2-kart" href={h.hedef}>{Icerik}</a>
          : <div class="v2-kart">{Icerik}</div>;
      })}
    </div>
  </div>
</section>
