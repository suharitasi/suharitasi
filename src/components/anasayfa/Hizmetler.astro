---
// HİZMETLER (v0) — 6 kart, üçlü ızgara. İkon: sitede paket tabanlı ikon
// sistemi yok → inline SVG (paket KURULMADI, M5). Hedefi olmayan kart
// LİNKSİZ <div> kalır (brief kuralı; rapora yazıldı).
// M7b: metinler hizmet tanımıdır, hukuki hüküm içermez.
import { HIZMETLER } from '../../data/anasayfa-v2.js';

// Basit stroke ikonlar (Lucide çizgi dili; elle çizildi, paket yok).
const IKONLAR = {
  kuyu: '<circle cx="12" cy="5" r="2"/><path d="M12 7v13"/><path d="M8 20h8"/><path d="M5 9c1.5 1.2 3 1.2 4.5 0"/><path d="M14.5 9c1.5 1.2 3 1.2 4.5 0"/>',
  sondaj: '<path d="M12 3v10"/><path d="m8 9 4 4 4-4"/><path d="M4 17c2 1.6 4 1.6 6 0s4-1.6 6 0 3 1.3 4 .8"/>',
  tahsis: '<path d="M12 3c3 3.6 5 6.4 5 9a5 5 0 0 1-10 0c0-2.6 2-5.4 5-9Z"/><path d="M7 21h10"/>',
  uyusmazlik: '<path d="M8 4v10"/><path d="M16 4v10"/><path d="M4 8h8"/><path d="M12 8h8"/><path d="M6 18c1.4 1.2 2.8 1.2 4.2 0"/><path d="M13.8 18c1.4 1.2 2.8 1.2 4.2 0"/>',
  idari: '<path d="M12 3 4 7v2h16V7l-8-4Z"/><path d="M6 11v6"/><path d="M12 11v6"/><path d="M18 11v6"/><path d="M4 21h16"/>',
  kuruyan: '<path d="M12 4c2.4 2.9 4 5.2 4 7.2"/><path d="M8.6 8.4C7.6 9.9 7 11.3 7 12.6a5 5 0 0 0 9 3"/><path d="m4 4 16 16"/>',
};
---
<section class="v2-bolum v2-hizmetler" id="hizmetler" aria-label="Hizmetler">
  <div class="v2-ic">
    <p class="v2-bolum-kicker">Hizmetler</p>
    <h2>Su hukukunun her aşamasında yanınızda</h2>
    <div class="v2-hiz-izgara">
      {HIZMETLER.map((h) => {
        const Icerik = (
          <>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true" set:html={IKONLAR[h.ikon]}></svg>
            <h3>{h.ad}</h3>
            <p>{h.metin}</p>
            {h.hedef && <span class="v2-kart-git">Rehberi oku →</span>}
          </>
        );
        return h.hedef
          ? <a class="v2-kart" href={h.hedef}>{Icerik}</a>
          : <div class="v2-kart">{Icerik}</div>;
      })}
    </div>
  </div>
</section>
