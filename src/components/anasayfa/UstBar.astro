---
// ANA SAYFAYA ÖZEL üst bar (v0 spesifikasyonu). Paylaşılan UstMenu'ye
// DOKUNULMADI (M8) — bu bileşen yalnız index'te kullanılır.
// Masaüstü: Hizmetler · Süreç · Veriler(▾) · Hakkında · İletişim + Randevu Al.
// Veriler: hover/focus-within CSS'le açılır (JS'siz de çalışır); JS yalnız
// aria-expanded + Esc kapatma ekler (emil: giriş 200ms güçlü ease-out,
// çıkış 150ms — K-1 etkileşim sınıfı).
// Mobil: hamburger; panel tam liste + Veriler listesi AÇIK hâlde.
// JS kapalı (mobil): <noscript> stiliyle panel açık liste olarak görünür.
// Logo dosyası yok (FAZ 1.6) → metin marka.
import { VERI_ROTALARI } from '../../data/anasayfa-v2.js';
---
<header class="v2-ustbar" id="v2-ustbar">
  <a class="v2-marka" href="/">Su Hukuku <small>· suharitasi.com</small></a>

  <nav class="v2-nav" aria-label="Ana sayfa bölümleri">
    <ul>
      <li><a href="#hizmetler">Hizmetler</a></li>
      <li><a href="#surec">Süreç</a></li>
      <li class="v2-veri" id="v2-veri">
        <button type="button" class="v2-veri-dugme" aria-expanded="false"
                aria-controls="v2-veri-liste">
          Veriler <span class="ok-asagi" aria-hidden="true">▾</span>
        </button>
        <ul class="v2-veri-liste" id="v2-veri-liste">
          {VERI_ROTALARI.map((r) => (
            <li><a href={r.yol}>{r.ad}</a></li>
          ))}
        </ul>
      </li>
      <li><a href="#hakkinda">Hakkında</a></li>
      <li><a href="#iletisim">İletişim</a></li>
    </ul>
  </nav>

  <a class="v2-randevu v2-randevu-ust" href="#iletisim">Randevu Al</a>

  <button type="button" class="v2-menu-dugme" id="v2-menu-dugme"
          aria-expanded="false" aria-controls="v2-mobil-panel"
          aria-label="Menüyü aç">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>
</header>

<nav class="v2-mobil-panel" id="v2-mobil-panel" aria-label="Menü">
  <ul>
    <li><a href="#hizmetler">Hizmetler</a></li>
    <li><a href="#surec">Süreç</a></li>
    <li>
      <span class="v2-mobil-baslik">Veriler</span>
      <ul class="v2-mobil-veri">
        {VERI_ROTALARI.map((r) => (
          <li><a href={r.yol}>{r.ad}</a></li>
        ))}
      </ul>
    </li>
    <li><a href="#hakkinda">Hakkında</a></li>
    <li><a href="#iletisim">İletişim</a></li>
    <li><a href="#iletisim">Randevu Al</a></li>
  </ul>
</nav>

<noscript>
  <style>
    /* JS kapalı: mobilde panel açık liste olarak görünür, linkler çalışır. */
    @media (max-width: 1023px) {
      .v2-mobil-panel { display: block; position: static; max-height: none; }
      .v2-menu-dugme { display: none; }
    }
    /* JS kapalı: bar şeffaf kalamaz (kaydi sınıfı yok) — koyu sabit zemin. */
    .v2-ustbar { background: rgba(8, 32, 47, 0.92); }
  </style>
</noscript>

<script>
  // Kaydırma > 40px: bar zemin kazanır (v0).
  const bar = document.getElementById('v2-ustbar');
  function barGuncelle() { bar.classList.toggle('kaydi', scrollY > 40); }
  addEventListener('scroll', () => requestAnimationFrame(barGuncelle), { passive: true });
  barGuncelle();

  // Veriler: aria-expanded eşitleme + Esc kapatma (açılışı CSS yürütür).
  const veri = document.getElementById('v2-veri');
  const veriDugme = veri.querySelector('.v2-veri-dugme');
  function veriDurum(acik) {
    veri.classList.toggle('acik', acik);
    veriDugme.setAttribute('aria-expanded', String(acik));
  }
  veriDugme.addEventListener('click', () => veriDurum(!veri.classList.contains('acik')));
  veri.addEventListener('mouseenter', () => veriDugme.setAttribute('aria-expanded', 'true'));
  veri.addEventListener('mouseleave', () => veriDurum(false));
  veri.addEventListener('focusin', () => veriDugme.setAttribute('aria-expanded', 'true'));
  veri.addEventListener('focusout', (e) => {
    if (!veri.contains(e.relatedTarget)) veriDurum(false);
  });

  // Mobil panel
  const menuDugme = document.getElementById('v2-menu-dugme');
  const panel = document.getElementById('v2-mobil-panel');
  function panelDurum(acik) {
    panel.classList.toggle('acik', acik);
    menuDugme.setAttribute('aria-expanded', String(acik));
    menuDugme.setAttribute('aria-label', acik ? 'Menüyü kapat' : 'Menüyü aç');
  }
  menuDugme.addEventListener('click', () => panelDurum(!panel.classList.contains('acik')));
  panel.addEventListener('click', (e) => {
    if (e.target.closest('a')) panelDurum(false); // bölüme atlayınca kapan
  });

  // Esc: açık ne varsa kapat (emil: klavye eylemi — animasyonsuz, anında).
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (veri.classList.contains('acik') || veri.matches(':focus-within')) {
      veriDurum(false);
      veriDugme.blur();
    }
    if (panel.classList.contains('acik')) { panelDurum(false); menuDugme.focus(); }
  });
</script>
