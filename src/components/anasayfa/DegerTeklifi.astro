---
// DEĞER TEKLİFİ — 3 KART (04.10.2026, Faz 4 vitrin/CRO).
// Acı noktası → çözüm çerçevesi; her kart ilgili otonom yeteneğe bağlanır.
// UYDURMA YASAĞI: iddialar gerçek yeteneklerle sınırlı (istatistiksel
// projeksiyon, eşik aşımında alarm, Zenodo DOI). "ML" gibi abartı YOK.
const KARTLAR = [
  {
    ikon: 'trend',
    kicker: 'Tahminsel analitik',
    acisi: 'Kuraklık sürpriz olmasın.',
    ad: 'Yarını bugünden görün',
    metin:
      'GRACE uydu verisi ve günlük baraj doluluğundan 6 aylık su/kuraklık ' +
      'projeksiyonu. Her değer tahmin aralığıyla; ölçümden ayrı etiketli.',
    hedef: '/tahmin/',
    cta: 'Projeksiyonları gör',
  },
  {
    ikon: 'zil',
    kicker: 'Otonom alarm',
    acisi: 'Kritik seviyeyi kaçırmayın.',
    ad: 'Eşik aşıldığında haber verir',
    metin:
      'Havzanız için doluluk eşiği kurun; eşik aşıldığında otomatik e-posta. ' +
      'Kurulum yarım dakika; IP adresiniz saklanmaz (KVKK).',
    hedef: '/alarm/',
    cta: 'Alarm kur',
  },
  {
    ikon: 'muhur',
    kicker: 'Akademik otorite',
    acisi: 'Kaynağı gösterilmeyen veri işe yaramaz.',
    ad: 'Atıf yapılabilir, tescilli veri',
    metin:
      'Zenodo DOI ve Schema.org Dataset ile mühürlü; kaynağı künyeli. Otonom ' +
      'aylık hidroloji ve kuraklık raporları veriden üretilir.',
    hedef: '/veri/raporlar/',
    cta: 'Raporları oku',
  },
];
const IKONLAR = {
  trend: '<path d="M3 17l6-6 4 4 7-7"/><path d="M14 8h6v6"/>',
  zil: '<path d="M6 9a6 6 0 1 1 12 0c0 5 2 6 2 6H4s2-1 2-6"/><path d="M10 20a2 2 0 0 0 4 0"/>',
  muhur: '<path d="M12 3l7 3v6c0 4.4-3 7.4-7 9-4-1.6-7-4.6-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
};
---
<section class="v2-deger" aria-label="Değer teklifi">
  <div class="v2-ic">
    <div class="v2-deger-bas">
      <p class="v2-deger-kicker">Neden Su Haritası</p>
      <h2>Karar anında ihtiyacınız olan üç şey</h2>
    </div>
    <div class="v2-deger-izgara">
      {KARTLAR.map((k) => (
        <a class="v2-deger-kart" href={k.hedef}>
          <span class="v2-deger-ikon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                 set:html={IKONLAR[k.ikon as keyof typeof IKONLAR]}></svg>
          </span>
          <p class="v2-deger-acisi">{k.acisi}</p>
          <h3>{k.ad}</h3>
          <p class="v2-deger-metin">{k.metin}</p>
          <span class="v2-deger-git">{k.kicker} · {k.cta} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .v2-deger { padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2rem); background: var(--zemin, #fff); }
  .v2-deger-bas { max-width: 60ch; margin-bottom: 1.6rem; }
  .v2-deger-kicker {
    margin: 0 0 0.5rem;
    font-family: var(--mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--su-700, #0c4a6e);
  }
  .v2-deger-bas h2 {
    margin: 0;
    font-family: var(--serif, Georgia, serif);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    color: var(--metin, #0f172a);
  }
  .v2-deger-izgara { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (max-width: 1023px) { .v2-deger-izgara { grid-template-columns: 1fr; } }
  .v2-deger-kart {
    display: flex;
    flex-direction: column;
    min-height: 44px;
    padding: 1.4rem 1.3rem;
    background: var(--zemin-kart, #f8fafc);
    border: 1px solid var(--cizgi, #e2e8f0);
    border-top: 3px solid var(--su-400, #2e7ea0);
    border-radius: 8px;
    text-decoration: none;
    color: var(--metin, #0f172a);
    transition: transform 200ms var(--e-suzul, ease), border-color 200ms var(--e-suzul, ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .v2-deger-kart:hover { transform: translateY(-2px); border-color: var(--su-700, #0c4a6e); }
  }
  .v2-deger-ikon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.8rem;
    border-radius: 8px;
    background: rgba(46, 126, 160, 0.12);
    color: var(--su-700, #0c4a6e);
  }
  .v2-deger-ikon svg { width: 1.4rem; height: 1.4rem; }
  .v2-deger-acisi { margin: 0 0 0.35rem; font-size: 0.82rem; font-weight: 600; color: #8a1f17; }
  .v2-deger-kart h3 { margin: 0; font-family: var(--serif, Georgia, serif); font-weight: 500; font-size: 1.25rem; line-height: 1.25; }
  .v2-deger-metin { margin: 0.5rem 0 0; font-size: 0.9rem; line-height: 1.6; color: #475569; }
  .v2-deger-git {
    margin-top: auto;
    padding-top: 0.9rem;
    font-family: var(--mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--su-700, #0c4a6e);
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-deger-kart { transition: none; }
    .v2-deger-kart:hover { transform: none; }
  }
</style>
