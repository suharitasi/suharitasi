    border-color: #e05757;
    background: rgba(45, 15, 15, 0.75);
  }
  .v2-otorite-rozet strong {
    font-weight: 700;
    color: #ffffff;
  }
  .v2-rozet-nokta {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }
  .v2-rozet-nokta.yesil { background: #10b981; box-shadow: 0 0 6px #10b981; }
  .v2-rozet-nokta.mavi { background: #0284c7; box-shadow: 0 0 6px #0284c7; }
  .v2-rozet-nokta.sari { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; }
  .v2-rozet-nokta.kirmizi { background: #ef4444; box-shadow: 0 0 6px #ef4444; }
</style>
