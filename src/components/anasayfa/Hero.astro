---
// HERO — "SAHA KADRAJI" (hero-gorsel briefi, 28.07.2026; frontend-design
// skill'iyle karar verildi; ölçüm + gerekçe: cikti/denetim/hero/ raporu).
//
// TEŞHİS (ölçüldü, canlı 1440): H1 72px ve başlık bloğu sahnenin %19'unu
// ORTASINDA örtüyordu (Ş1-Ş2); video 1469×918 render = 832×464 kaynağın
// ×1,77 upscale'i (K2 ihlali — "işçiler net değil"in ikinci nedeni).
//
// KARAR: metin görüntünün üstünden İNER. Akış (brief'in istediği):
//   1) üst bant: rozet + H1 + alt satır + CTA — düz koyu zemin üzerinde
//   2) film şeridi: 6 poster küçük karede yan yana = sahnelerin BİRLEŞİK
//      hali (K1: poster, video değil; K2: downscale keskindir, upscale yok)
//   3) KADRAJ: aktif sahnenin videosu NATIVE 832×464 (asla büyütülmez)
//   4) kadraj YANINDA 6 soru listesi — aktif sahnenin sorusu vurgulu;
//      "metin sahneyle birlikte değişir, sahneyi kapatmaz"
// MOTOR K-1 SÜRELERİYLE KORUNUR (FAZ A 3800ms → 5000ms sahne, 1400ms
// geçiş); tek video oynar (K-3/K1). Damla atmosferi korunur (Görünürlük
// kuralı) — hero zemininde, metnin/kadrajın üstünde değil.
//
// SORU↔SAHNE EŞLEMESİ (sunum sırası kararı; metin/hedef DEĞİŞMEZ, K3):
// sahnenin konusu sorunun konusuyla örtüşür; eşleşme build'de doğrulanır.
import { SORULAR_V2 } from '../../data/anasayfa-v2.js';
import { HERO_H1, HERO_ALT } from '../../data/anasayfa-satis.js';

const { sahneVeri } = Astro.props;

// sahne id → sorunun AYIRT EDİCİ parçası (metinler anasayfa-v2.js'te tek
// kaynak; eşleşmeyen sahne build'i düşürür — sessiz kopukluk yasak).
const ESLEME = {
  sondaj: 'Sondaj ile alakalı',
  akifer: 'su nerelerde çıkabilir',
  baraj: 'nerede su var',
  sehir: 'ruhsatı başvurusu nasıl',
  hukuk: 'cezası aldım',
  'gol-kasabasi': 'kurudu',
};
const sahneler = sahneVeri.map((s) => {
  const soru = SORULAR_V2.find((q) => q.soru.includes(ESLEME[s.id] ?? ' '));
  if (!soru) throw new Error(`Hero: "${s.id}" sahnesine eşlenen soru bulunamadı.`);
  return { ...s, soru };
});
if (new Set(sahneler.map((s) => s.soru.soru)).size !== sahneler.length) {
  throw new Error('Hero: iki sahne aynı soruya eşlendi — eşleme birebir olmalı.');
}

// v0 deterministik damla formülü — DEĞİŞMEDİ (kopyalanma direnci + diff
// sadeliği; atmosfer K-1).
function rand(seed) {
  const x = Math.sin(seed * 999.13) * 43758.5453;
  return x - Math.floor(x);
}
const DAMLALAR = Array.from({ length: 90 }, (_, i) => {
  const r1 = rand(i * 3 + 1);
  const r2 = rand(i * 3 + 2);
  const r3 = rand(i * 3 + 3);
  const aci = ((r1 - 0.5) * 24 * Math.PI) / 180;
  const dx = Math.sin(aci) * (70 + r2 * 90);
  const peak = -300 * (0.7 + r3 * 0.5);
  const size = 3 + r2 * 4;
  return {
    dx: dx.toFixed(1),
    peak: peak.toFixed(0),
    w: size.toFixed(1),
    h: (size * 1.6).toFixed(1),
    dur: (1.1 + r1 * 0.9).toFixed(2),
    delay: (r3 * 1.6).toFixed(2),
    o: (0.6 + r2 * 0.4).toFixed(2),
    cok: i >= 30,
  };
});
---
<section class="v2-hero" aria-label="Açılış">
  <!-- 1) Üst bant: metin DÜZ zemin üzerinde (Ş1-Ş2 çözümü) -->
  <div class="v2-baslik">
        <div class="v2-otorite-bandi" aria-label="Resmi Tescil ve Yetki Rozetleri">
      <a href="https://doi.org/10.5281/zenodo.23002678" target="_blank" rel="noopener noreferrer" class="v2-otorite-rozet" title="CERN / OpenAIRE Uluslararası Kalıcı Tescil">
        <span class="v2-rozet-nokta yesil"></span>
        <span><strong>CERN Tescilli Bilimsel Veri</strong> <small style="opacity:0.75; font-size:0.72rem;">(Zenodo DOI)</small></span>
      </a>
      <a href="https://www.wikidata.org/wiki/Q141582057" target="_blank" rel="noopener noreferrer" class="v2-otorite-rozet" title="Google ve Küresel Yapay Zeka Ağı Varlık Kaydı">
        <span class="v2-rozet-nokta mavi"></span>
        <span><strong>Google & AI Onaylı Varlık</strong> <small style="opacity:0.75; font-size:0.72rem;">(Wikidata)</small></span>
      </a>
      <a href="/acik-veri/" class="v2-otorite-rozet" title="Kurumsal ve Bireysel Entegrasyon İçin Canlı API">
        <span class="v2-rozet-nokta sari"></span>
        <span><strong>Veri Altyapısı & Canlı API</strong> <small style="opacity:0.75; font-size:0.72rem;">(Entegre Edin)</small></span>
      </a>
      <a href="/kuyu-karar-motoru/" class="v2-otorite-rozet vurgu" title="167 Sayılı YAS İzin, Ruhsat ve Ceza Ön Analiz Motoru">
        <span class="v2-rozet-nokta kirmizi"></span>
        <span><strong>Kuyu İzin & Ruhsat Sihirbazı</strong> <small style="opacity:0.75; font-size:0.72rem;">(167 Sayılı Kanun)</small></span>
      </a>
    </div>
  </div>

  <!-- 2) Film şeridi: 6 sahnenin BİRLEŞİK hali (poster, K1) -->
  <div class="v2-serit" id="v2-posterler" role="group" aria-label="Sahneler">
    {sahneler.map((s, i) => (
      <button type="button" class:list={['v2-serit-kare', { aktif: i === 0 }]}
              data-sira={i} aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={`Sahne: ${s.label}`}>
        <img src={s.still} alt="" width="832" height="464"
             loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      </button>
    ))}
  </div>

  <!-- 3) Kadraj (native 832×464, K2) + 4) yanında soru listesi -->
  <div class="v2-sahne-alan">
    <figure class="v2-kadraj">
      <!-- Atmosfer (K-1): fıskiye kadraj DİBİNDEN — sondaj temasıyla
           örtüşür; CTA/metin bölgesine taşmaz (mobil karede ölçüldü) -->
      <div class="v2-su" aria-hidden="true">
        {DAMLALAR.map((d) => (
          <i class:list={['v2-damla', 'sh-spray', { cok: d.cok }]}
             style={`--dx:${d.dx}px; --peak:${d.peak}px; --dur:${d.dur}s; --delay:${d.delay}s; --w:${d.w}px; --h:${d.h}px; --o:${d.o}`}></i>
        ))}
        <i class="v2-kopuk sh-mist"></i>
      </div>
      <div class="v2-videolar" id="v2-videolar">
        <img class="v2-kadraj-poster" id="v2-kadraj-poster" src={sahneler[0].still}
             alt="" width="832" height="464" decoding="async" />
        {/* emil-design-eng + apple-design (27.09.2026): TÜM sahneler
            preload="none" — sayfa açılışında video ağı/bandı tüketilmez;
            yalnız motor bir sahneyi etkinleştirdiğinde yüklenir. İlk video da
            dahil (eski `preload="metadata"` kalıntısı kaldırıldı). */}
        {sahneler.map((s) => (
          <video muted playsinline loop preload="none" data-src={s.clip}
                 data-sahne={s.id} width="832" height="464"></video>
        ))}
      </div>
      <figcaption class="v2-kadraj-etiket">
        <span class="v2-cizgiler" id="v2-cizgiler" aria-hidden="true">
          {sahneler.map((s, i) => (
            <span class:list={['v2-cizgi', { aktif: i === 0 }]}></span>
          ))}
        </span>
        <span class="v2-kadraj-ad" id="v2-kadraj-ad">{sahneler[0].label}</span>
      </figcaption>
    </figure>

    <nav class="v2-sorular" id="v2-sorular" aria-label="Sık sorulan sorular">
      {sahneler.map((s, i) => (
        <a class:list={['v2-soru', { aktif: i === 0 }]} data-sira={i} href={s.soru.hedef}>
          {s.soru.soru}
        </a>
      ))}
    </nav>
  </div>

  <a class="v2-asagi" href="#hizmetler" aria-label="Aşağı in">
    <svg class="v2-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </a>
</section>

<script>
  /* SAHNE MOTORU — K-1 süreleri AYNEN (5000/1400/3800), tek video (K1).
     Yeni: şerit karesi + soru vurgusu + kadraj adı aktif sahneyle senkron;
     şerit karesine tıklayınca o sahneye atlanır, döngü oradan sürer.
     reduced-motion: video yüklenmez, kadrajda poster durur. */
  const AZALT = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videolar = [...document.querySelectorAll('#v2-videolar video')];
  const cizgiler = [...document.querySelectorAll('#v2-cizgiler .v2-cizgi')];
  const kareler = [...document.querySelectorAll('.v2-serit-kare')];
  const sorular = [...document.querySelectorAll('#v2-sorular .v2-soru')];
  const kadrajAd = document.getElementById('v2-kadraj-ad');
  const acilisPoster = document.getElementById('v2-kadraj-poster');

  /* Süreler TEK KAYNAK: DESIGN.md §3 + hareket.css token'ları. Kodda sabit
     yalnız son çare yedeğidir; CSS önce okunur (token uygulanmış sayılır). */
  const kokStil = getComputedStyle(document.documentElement);
  const tokenMs = (ad, varsayilan) => {
    const v = parseFloat(kokStil.getPropertyValue(ad));
    return Number.isFinite(v) ? v : varsayilan;
  };

  const SAHNE_SURE = tokenMs('--sahne-sure', 5000);  // ATMOSFER (K-1)
  const GECIS = tokenMs('--sahne-gecis', 1400);      // ATMOSFER (K-1)
  const FAZ_A = tokenMs('--sahne-faz-a', 3800);      // ATMOSFER (K-1)
  const ON_YUKLE = 1000;

  // Duraklatma zamanlayıcıları: kare değişiminde eskiler temizlenir ki
  // hızlı tıklamada eski video yanlışlıkla duraklatılmasın (kesintisizlik).
  const duraklatTimer = new Map();

  function yukle(v) {
    if (!v.getAttribute('src') && v.dataset.src) {
      v.setAttribute('src', v.dataset.src);
      v.load();
    }
  }

  function etkinlestir(i) {
    videolar.forEach((v, j) => {
      if (j === i) {
        yukle(v);
        if (duraklatTimer.has(v)) { clearTimeout(duraklatTimer.get(v)); duraklatTimer.delete(v); }
        v.currentTime = 0;
        v.play().catch(() => {});
        v.classList.add('aktif');
      } else {
        v.classList.remove('aktif');
        // Geçiş bitince durdur (kaynak tasarrufu); süre = GECIS token'ı.
        if (duraklatTimer.has(v)) clearTimeout(duraklatTimer.get(v));
        duraklatTimer.set(v, setTimeout(() => {
          if (!v.classList.contains('aktif')) v.pause();
          duraklatTimer.delete(v);
        }, GECIS));
      }
    });
    cizgiler.forEach((c, j) => c.classList.toggle('aktif', j === i));
    kareler.forEach((k, j) => {
      k.classList.toggle('aktif', j === i);
      k.setAttribute('aria-pressed', j === i ? 'true' : 'false');
    });
    sorular.forEach((q, j) => q.classList.toggle('aktif', j === i));
    if (kadrajAd && kareler[i]) {
      kadrajAd.textContent = (kareler[i].getAttribute('aria-label') || '').replace('Sahne: ', '');
    }
  }

  /* SAHNE MOTORU (apple-design + emil-design-eng, 27.09.2026):
     setInterval → rAF zamanlayıcı. Kazanımlar:
       (1) sekme gizlenince VE hero görünmezken durur (pil/CPU tasarrufu),
       (2) kareye tıklama zamanı KESİNTİSİZ yeniden başlatır — bekleyen
           ön-yükleme/duraklatma zamanlayıcıları temizlenir,
       (3) süreler CSS token'ından okunur (kodda sabit kalmaz),
       (4) görsel geçiş CSS cross-fade kalır: .aktif sınıfı mevcut opaklıktan
           devam eder → tıklama anında sıçrama yok (interruptible). */
  if (!AZALT && videolar.length) {
    let sira = 0;
    let baslangic = 0;
    let rafKimlik = 0;
    let calisiyor = false;
    let baslayabilir = false;   // FAZ A tamamlanmadan döngü kurulmaz
    let gorunur = true;         // IntersectionObserver gelmeden varsayılan
    let onYukleTimer = 0;

    function tik(t) {
      if (!calisiyor) return;
      const gecen = t - baslangic;
      if (gecen >= SAHNE_SURE) {
        sira = (sira + 1) % videolar.length;
        baslangic = t;
        etkinlestir(sira);
      } else if (gecen >= SAHNE_SURE - GECIS - ON_YUKLE) {
        // Sıradakini ~1sn önce ısıt (yalnız bir kez; yukle() idempotent).
        yukle(videolar[(sira + 1) % videolar.length]);
      }
      rafKimlik = requestAnimationFrame(tik);
    }

    function donguBaslat() {
      if (calisiyor || !baslayabilir || !gorunur || document.hidden) return;
      calisiyor = true;
      baslangic = performance.now();
      rafKimlik = requestAnimationFrame(tik);
    }

    function donguDurdur() {
      calisiyor = false;
      cancelAnimationFrame(rafKimlik);
    }

    function kareSec(i) {
      sira = Number.isFinite(i) ? i : 0;
      clearTimeout(onYukleTimer);
      if (acilisPoster) acilisPoster.classList.add('gizli');
      etkinlestir(sira);
      if (calisiyor) baslangic = performance.now();  // kesintisiz devam
      else donguBaslat();
    }

    kareler.forEach((k) => k.addEventListener('click', () => {
      kareSec(Number(k.dataset.sira) || 0);
    }));

    // FAZ A: ilk sahne gecikmeli başlar; ikinci video vaktinde ısıtılır.
    setTimeout(() => {
      baslayabilir = true;
      kareSec(0);
      onYukleTimer = setTimeout(() => yukle(videolar[1 % videolar.length]),
                                SAHNE_SURE - ON_YUKLE);
    }, FAZ_A);

    // Hayat döngüsü: gizli sekme ve görünmez hero motoru durdurur.
    addEventListener('visibilitychange', () => {
      if (document.hidden) donguDurdur();
      else donguBaslat();
    });
    addEventListener('pagehide', donguDurdur);

    if ('IntersectionObserver' in window) {
      gorunur = false;
      const gozcu = new IntersectionObserver((girisler) => {
        for (const g of girisler) {
          gorunur = g.isIntersecting;
          if (gorunur && !document.hidden) donguBaslat();
          else donguDurdur();
        }
      }, { threshold: 0.25 });
      const heroKok = document.querySelector('.v2-hero');
      if (heroKok) gozcu.observe(heroKok);
    }
  }
</script>

<style>
  /* 17 Skills Marketing & CRO: Above-The-Fold Otorite Bandı */
  .v2-otorite-bandi {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    align-items: center;
  }
