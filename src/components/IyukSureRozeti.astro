---
// İYUK m. 7 — 60 GÜNLÜK İDARİ DAVA AÇMA SÜRESİ · DİNAMİK KIRMIZI ROZET (22.09.2026).
//
// Tebliğ tarihi seçildiği anda kalan gün sayısını canlı hesaplar ve kırmızı
// uyarı rozetini gösterir; süre azaldıkça rozet belirginleşir, süre dolduysa
// ayrı bir "geçti" durumuna geçer. Saf istemci (harici kütüphane/sunucu YOK).
// Bilgilendirme amaçlıdır; hukuki görüş değildir. TBB m.55: hizmet vaadi yok.
//
// KULLANIM:
//   <IyukSureRozeti hedef="km-teblig" />        → mevcut tarih alanına bağlanır
//   <IyukSureRozeti kendiGirdi etiket="..." />  → kendi tarih alanını basar
interface Props {
  hedef?: string;      // bağlanılacak mevcut input id'si (varsa)
  kendiGirdi?: boolean; // sayfada tarih alanı yoksa true
  etiket?: string;     // kendiGirdi=true iken alan etiketi
}
const { hedef = '', kendiGirdi = false, etiket = 'Ceza/tebliğ tarihi' } = Astro.props;
---
<div class="isr" data-isr data-isr-hedef={hedef} data-isr-girdi={kendiGirdi ? '1' : '0'}>
  {kendiGirdi && (
    <label class="isr-alan">
      <span>{etiket}</span>
      <input type="date" id="isr-tarih" class="isr-tarih" />
    </label>
  )}
  <p class="isr-rozet" data-isr-rozet hidden role="status" aria-live="polite"></p>
</div>

<script>
  const GUN = 60;

  function kalanGun(teblig: string): { kalan: number; son: Date } | null {
    if (!teblig) return null;
    const d = new Date(teblig + 'T00:00:00');
    if (Number.isNaN(d.getTime())) return null;
    const son = new Date(d.getTime());
    son.setDate(son.getDate() + GUN);
    const bugun = new Date();
    bugun.setHours(0, 0, 0, 0);
    return { kalan: Math.ceil((son.getTime() - bugun.getTime()) / 86400000), son };
  }

  function kur(kap: HTMLElement) {
    const hedefId = kap.getAttribute('data-isr-hedef') || '';
    const hedef = (hedefId ? document.getElementById(hedefId) : null)
      || kap.querySelector('.isr-tarih');
    const rozet = kap.querySelector('[data-isr-rozet]') as HTMLElement | null;
    if (!hedef || !rozet) return;

    const ciz = () => {
      const deger = (hedef as HTMLInputElement).value || '';
      const k = kalanGun(deger);
      rozet.classList.remove('isr-acil', 'isr-gecti');
      if (!k) {
        rozet.hidden = true;
        rozet.textContent = '';
        return;
      }
      const bitis = k.son.toLocaleDateString('tr-TR');
      if (k.kalan >= 0) {
        rozet.textContent = `İdari dava açma süreniz (İYUK m.7): ${k.kalan} gün kaldı · son gün ${bitis}.`;
        if (k.kalan <= 15) rozet.classList.add('isr-acil');
      } else {
        rozet.textContent = `60 günlük idari dava açma süresi dolmuş görünüyor (son gün ${bitis}). Olağanüstü yollar değerlendirilmelidir.`;
        rozet.classList.add('isr-gecti');
      }
      rozet.hidden = false;
    };

    (hedef as HTMLElement).addEventListener('input', ciz);
    (hedef as HTMLElement).addEventListener('change', ciz);
    ciz();
  }

  document.querySelectorAll<HTMLElement>('[data-isr]').forEach(kur);
</script>

<style>
  .isr { margin: 0.9rem 0 0; }
  .isr-alan { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.9rem; max-width: 20rem; }
  .isr-alan input { font: inherit; padding: 0.6rem 0.7rem; min-height: 44px; border: 1px solid var(--cizgi); background: var(--zemin-kart); color: var(--metin); }
  .isr-rozet {
    display: inline-block;
    margin: 0.5rem 0 0;
    padding: 0.5rem 0.9rem;
    background: #b3261e;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    border-left: 4px solid #7a1811;
    max-width: 74ch;
  }
  .isr-rozet.isr-acil {
    background: #7a1811;
    box-shadow: 0 0 0 2px rgba(179, 38, 30, 0.35);
  }
  .isr-rozet.isr-gecti { background: #4a0d09; }
</style>
