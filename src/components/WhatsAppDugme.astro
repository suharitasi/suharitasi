---
// WhatsAppDugme.astro — sabit WhatsApp bağlantısı (Faz D, 08.09.2026;
// rapor/08-09-gsc-ticari-whatsapp.md §D). Kullanıcı talimatı: her sayfada,
// kaymayan ve kaybolmayan bir yerde; kapatılamaz; e-posta yok.
//
// TASARIM KARARLARI (brief D1–D4):
// - Renk SU-DİLİ paletinden; WhatsApp yeşili YOK (K34 palet disiplini).
//   Aydınlık iç sayfalarda DERİN (--su-700) zemin + beyaz metin (7,6:1);
//   koyu adalarda (ana sayfa / harita / pilotlar) `koyu` prop'u: KÖPÜK
//   zemin + DİP metin (12,4:1). Tanınırlık simge + "WhatsApp" etiketi
//   ikisiyle birlikte; çağrı dili yok, animasyon yok.
// - Bağlantı aynı-köken `/whatsapp/` yoluna gider; canlıda Pages Function
//   (functions/whatsapp.js, karar-kapatma Faz B) tıklamayı sayar ve 302 ile
//   wa.me'ye yönlendirir; `_redirects` aynı kuralı yedek olarak taşır. JS'siz
//   çalışır; satır içi script yok. Numara görünür metinde yok; Faz C kararıyla
//   yalnız JSON-LD Organization.telephone alanında (yapılandırılmış veri).
// - Dokunma hedefi ≥44px; odak halkası DESIGN.md §9 sözlüğü (aydınlıkta
//   DERİN 2px/offset 3px, koyuda KÖPÜK — K30).
// - z-index 50: menü barı (60) ve mobil menü paneli (59) ALTINDA, içerik
//   üstünde; "içeriğe atla" (999) etkilenmez.
// - Simge: Simple Icons "WhatsApp" yolu (CC0), sade tek renk, currentColor.
export interface Props { koyu?: boolean }
const { koyu = false } = Astro.props;
---
<a class:list={['wa-dugme', { 'wa-koyu': koyu }]} href="/whatsapp/" rel="nofollow noopener" aria-label="WhatsApp ile iletişim" data-olay="whatsapp">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
  </svg>
  <span>WhatsApp</span>
</a>

<style>
  .wa-dugme {
    position: fixed;
    right: clamp(0.9rem, 2vw, 1.4rem);
    bottom: clamp(0.9rem, 2vw, 1.4rem);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0 1rem 0 0.85rem;
    background: var(--su-700, #0C5A7C);
    color: #fff;
    font-family: var(--sans, "Manrope", system-ui, sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 2px;
    transition: background-color 120ms var(--e-akinti, cubic-bezier(0.45, 0.05, 0.55, 0.95));
  }
  .wa-dugme svg { width: 20px; height: 20px; flex: none; fill: currentColor; }
  .wa-dugme:hover { background: var(--deniz, #0A2740); }
  .wa-dugme:focus-visible { outline: 2px solid var(--su-700, #0C5A7C); outline-offset: 3px; }

  /* Koyu adalar: ana sayfa (v0 paleti), /harita/ (atlas adası), pilotlar. */
  .wa-koyu { background: var(--kopuk, #DBEAF4); color: var(--deniz, #0A2740); border-color: transparent; }
  .wa-koyu:hover { background: var(--akuamarin, #57BAE0); }
  .wa-koyu:focus-visible { outline-color: var(--kopuk, #DBEAF4); }

  @media print { .wa-dugme { display: none; } }
</style>
