---
// İL İŞLEM KUTUSU — /kuyu-ruhsati/{il}/ yerel landing sayfasının alt bloğu.
// (13.09.2026, "81 İl × İşlem" altyapısı.)
//
// Bir il için: yetkili merci (DSİ bölge + su idaresi), DSİ'ye bağlı işlemler
// (kurum + mevzuat dayanağı), kısıt/kapatma durumu (il eşlemesi YAPILMAZ —
// doğrulanmadı) ve ceza itiraz mercii. Veri src/data/islem-matrisi.js'ten;
// hiçbir hukuki iddia burada üretilmez.
import { DSI_ISLEMLERI } from '../data/islem-matrisi.js';

interface Props {
  il: string;
  bolgeler: { no: string; merkez: string }[];
  suIdaresi: string | null;
}

const { il, bolgeler, suIdaresi } = Astro.props;

const bolgeMetni = bolgeler.length
  ? bolgeler.map((b) => `DSİ ${b.no}. Bölge Müdürlüğü (merkez: ${b.merkez})`).join(' · ')
  : null;
---
<section class="il-islem" aria-label={`${il} için işlemler ve yetkili merciler`}>
  <h2>{il} için işlemler ve yetkili merciler</h2>

  <p class="il-merci">
    {bolgeMetni
      ? <>Yeraltı suyu ve kuyu işlemlerinde yetkili merci <strong>{bolgeMetni}</strong>.</>
      : <span class="veri-yok">DSİ bölge eşlemesi doğrulanmadı.</span>}
    {suIdaresi && <> Su ve kanalizasyon işlemlerinde: <strong>{suIdaresi}</strong>.</>}
  </p>

  <div class="il-tablo-kaydir">
    <table>
      <caption>{il} — DSİ yetkili su işlemleri ve mevzuat dayanağı.</caption>
      <thead>
        <tr><th scope="col">İşlem</th><th scope="col">Yetkili kurum</th><th scope="col">Mevzuat dayanağı</th></tr>
      </thead>
      <tbody>
        {DSI_ISLEMLERI.map((i) => (
          <tr>
            <th scope="row">{i.ad}</th>
            <td>{i.kurumlar.map((k) => k.kisaltma ?? k.ad).join(', ')}</td>
            <td>{i.mevzuatDayanagi ?? i.dayanak}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="il-kutular">
    <div class="il-kutu">
      <h3>Kısıt ve kapatma durumu</h3>
      <p>
        Resmî Gazete'de yayımlanmış tahsise kapatma/kısıt ilanlarını{' '}
        <a href="/kapatma-kaydi/">kapatma kaydı sorgusunda</a> tarayabilirsiniz.
        Bu ilanların hangi ile ait olduğu <strong>doğrulanmadı</strong>; bu sayfa
        il eşlemesi yapmaz (yokluk kanıt değildir).
      </p>
    </div>
    <div class="il-kutu">
      <h3>Ceza ve itiraz mercii</h3>
      <p>
        Belgesiz kuyu veya belge dışı kullanımda idari para cezasını{' '}
        <strong>mahallî mülkî amir ({il} Valiliği / ilçe kaymakamlığı)</strong> verir.
        İşlemin dayanağı ve yetkili idare doğru kurulmadığında{' '}
        <strong>idari yargıda iptal davası</strong> açılabilir. Ayrıntı:{' '}
        <a href="/rehberler/ruhsatsiz-kuyu-cezalari/">ruhsatsız kuyu cezaları</a>.
      </p>
    </div>
  </div>

  <p class="il-matris-link">
    <a href="/islem-matrisi/">→ 20 su işleminin tamamı ve yetkili kurum matrisi</a>
  </p>
</section>

<style>
  .il-islem { margin-top: 2.6rem; }

  .il-islem h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.25;
    margin-bottom: 0.7rem;
  }

  .il-merci { max-width: 70ch; margin-bottom: 1rem; }

  .il-tablo-kaydir { overflow-x: auto; }

  .il-islem table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    min-width: 40rem;
  }

  .il-islem caption {
    caption-side: top;
    text-align: left;
    font-size: 0.78rem;
    color: var(--metin-soluk);
    padding-bottom: 0.5rem;
  }

  .il-islem th,
  .il-islem td {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0.65rem;
    border-bottom: 1px solid var(--cizgi);
  }

  .il-islem thead th {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--metin-soluk);
    background: var(--zemin-kart);
    border-bottom: 2px solid var(--su-700);
    white-space: nowrap;
  }

  .il-islem tbody th { font-family: var(--serif); font-size: 0.96rem; font-weight: 500; width: 30%; }

  .il-kutular {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
    margin-top: 1.2rem;
  }

  .il-kutu {
    padding: 0.9rem 1.1rem;
    background: var(--zemin-kart);
    border: 1px solid var(--cizgi);
    border-left: 3px solid var(--su-400);
  }

  .il-kutu h3 {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
  }

  .il-kutu p { font-size: 0.92rem; }

  .il-matris-link { margin-top: 1.1rem; font-size: 0.92rem; }

  @media (max-width: 640px) {
    .il-kutular { grid-template-columns: 1fr; }
  }
</style>
