# suharitasi.com — sunucu kimlik bilgileri ŞABLONU
# Bu dosyayı .env adıyla KOPYALA ve değerleri doldur:  cp .env.example .env
# .env gitignore'dadır; repoya ASLA girmez. Bu şablonda gerçek değer YOKTUR.

# EPİAŞ Şeffaflık Platformu üyeliği (KULLANICI DOLDURACAK)
# Kayıt: https://kayit.epias.com.tr — üyelik e-postası ve şifresi.
EPIAS_USER=
EPIAS_PASS=

# Cloudflare Pages deploy hook (opsiyonel; talimat: README-BARAJ.md)
# Boşsa cron yalnız git push yapar — Pages git'e bağlıysa push zaten build tetikler.
CF_DEPLOY_HOOK=
