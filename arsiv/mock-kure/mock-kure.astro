---
// SU KÜRESİ — WebGL (FAZ 2). İzole /mock-kure/ sayfası.
// 6 sahne videosu tek ATLAS dokusunda (3×2) DÖNEN KÜRENİN YÜZEYİNİ oluşturur.
// 7 soru HER genişlikte yörüngede uçuşur. ?v=1 kuşak (varsayılan), ?v=2 sarmal.
// DOKUNULMAZ: ana sayfa/menü/301. Video KESİLMEZ (her sahne 0-1 UV tam dilime).
// three dinamik import; WebGL yoksa poster + saf-CSS yörünge fallback.
import { SORULAR } from '../data/anasayfa-sorular.js';

// Brief soru sırası (SABİT); kaynak anasayfa-sorular.js (DOKUNULMAZ), burada dizilir.
const BRIEF_SIRA = [
  'Su nerelerde çıkar?',
  'Kuyu ruhsatı almak için ne yapmalıyım?',
  'Ruhsatsız kuyu cezası aldım, ne yapmalıyım?',
  'Kuyum kurudu — aynı ruhsatla taşıyabilir miyim?',
  'Su verimliliği belgesi almak zorunda mıyım?',
  'Bölgemde yeraltı suyu azalıyor mu?',
  'Barajlarımızda ne kadar su var?',
];
const SORU = BRIEF_SIRA.map((t) => {
  const s = SORULAR.find((x) => x.soru === t);
  if (!s) throw new Error(`mock-kure: brief sırasındaki soru yok: "${t}"`);
  return s;
});

const AR = 832 / 464;           // 1.7931 (ffprobe ölçümü)
const marka = 'Su, yerin altında konuşur.';   // mevcut mock/ana sayfa cümlesi.

// Yörünge keyframe'leri (elips; container'a transform YOK → çip↔canvas z-interleave).
// Konum var(--a)/var(--b) ile viewport'a bağlı; cos/sin burada sabit üretilir.
// Ön yarı (y>0, alt): opacity 1 / scale 1 / z 3. Arka: opacity→0.85 / scale 0.90 / z 1.
function keyframeUret(ad) {
  const N = 24;
  let g = `@keyframes ${ad} {\n`;
  for (let s = 0; s <= N; s++) {
    const p = s / N, th = 2 * Math.PI * p;
    const cx = Math.cos(th).toFixed(4), sy = Math.sin(th).toFixed(4);
    const t01 = (Math.sin(th) + 1) / 2;         // 0 üst(arka) → 1 alt(ön)
    const op = (0.85 + 0.15 * t01).toFixed(3);
    const sc = (0.90 + 0.10 * t01).toFixed(3);
    const z = Math.sin(th) >= 0 ? 3 : 1;
    g += `  ${(p * 100).toFixed(2)}% { transform: translate(calc(-50% + var(--a) * ${cx}), calc(-50% + var(--b) * ${sy})) scale(${sc}); opacity: ${op}; z-index: ${z}; }\n`;
  }
  return g + '}\n';
}
const orbitKeyframes = keyframeUret('kure-orbit');
---
<!doctype html>
<html lang="tr" data-v="1">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title>Su küresi — WebGL mock</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,500;1,500&family=Manrope:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap&subset=latin-ext" rel="stylesheet" />
<style set:html={orbitKeyframes}></style>
<style>
  :root {
    --krem: #E9F0F4; --murekkep-900: #132A3F; --su-700: #0C5A7C; --su-400: #2E7EA0;
    --deniz: #0A2740; --akuamarin: #57BAE0; --kopuk: #DBEAF4; --cizgi: rgba(19,42,63,0.14);
    --serif: "Cormorant", Georgia, serif; --sans: "Manrope", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
    --e-akinti: cubic-bezier(0.45,0.05,0.55,0.95);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    background: radial-gradient(120% 80% at 50% -10%, #0d3050 0%, var(--deniz) 60%, #06192b 100%);
    color: var(--kopuk); font-family: var(--sans);
    min-height: 100dvh; display: flex; flex-direction: column; overflow-x: hidden;
  }
  a { color: inherit; }
  a:focus-visible { outline: 2px solid var(--akuamarin); outline-offset: 3px; }

  .marka { text-align: center; padding: clamp(1.2rem,3.5vh,2.4rem) 1rem 0; }
  .marka .kicker { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--akuamarin); }
  .marka h1 { font-family: var(--serif); font-weight: 500; font-style: italic; font-size: clamp(1.6rem,3.2vw,2.4rem); margin-top: 0.5rem; color: var(--kopuk); }

  .sahne { flex: 1; position: relative; display: grid; place-items: center; padding: clamp(1rem,4vh,2.4rem) 1rem; }

  /* Küre kabı: 2R×2R. canvas + poster fallback dolar. z:2 (arka çip z1 altında, ön z3 üstünde). */
  .kure-kap {
    position: relative; z-index: 2;
    width: calc(var(--R) * 2); height: calc(var(--R) * 2);
  }
  .kure-kap canvas { display: block; width: 100%; height: 100%; }
  /* Fallback (WebGL yok): poster daire içinde + derinlik gradyanı. */
  .kure-poster {
    position: absolute; inset: 0; border-radius: 50%;
    object-fit: cover; width: 100%; height: 100%;
    background: radial-gradient(120% 120% at 50% 8%, var(--su-400), var(--su-700) 42%, var(--deniz));
    box-shadow: inset 0 0 0 1px rgba(87,186,224,0.30);
    display: none;
  }
  html.webgl-yok .kure-poster { display: block; }
  html.webgl-yok .kure-kap canvas { display: none; }

  /* ——— YÖRÜNGE — her genişlikte (container'da TRANSFORM YOK) ——— */
  .yorunge {
    position: absolute; left: 50%; top: 50%;
    width: 0; height: 0;            /* .sahne merkezi = küre merkezi; çipler translate ile */
    pointer-events: none;
  }
  .soru {
    pointer-events: auto; position: absolute; left: 50%; top: 50%;
    width: var(--kutuW);
    text-decoration: none; color: var(--murekkep-900);
    background: rgba(233,240,244,0.90); border: 1px solid var(--cizgi);
    border-left: 2px solid var(--su-400); border-radius: 2px;
    padding: 0.5rem 0.7rem;
    font-family: var(--serif); font-size: 1rem; line-height: 1.16;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    box-shadow: 0 6px 18px rgba(6,25,43,0.28);
    animation: kure-orbit var(--tur) linear infinite;
    animation-delay: calc(var(--tur) / -7 * var(--i));
    will-change: transform, opacity;
  }
  .soru:hover { background: var(--kopuk); }
  .yorunge:hover .soru, .yorunge:focus-within .soru { animation-play-state: paused; }

  /* ——— YERLEŞİM (ADIM 3) — a=VW/2−kutuW/2−8 → yatay taşma imkânsız ——— */
  @media (max-width: 767px) {
    :root { --kutuW: 168px; --tur: 34s;
      --a: calc(50vw - 84px - 8px);
      --R: calc(0.37 * 100vw);
      --b: calc((50vw - 84px - 8px) * 1.9); }
    .soru { -webkit-line-clamp: 4; font-size: 0.94rem; }
  }
  @media (min-width: 768px) and (max-width: 1199px) {
    :root { --kutuW: 220px; --tur: 42s;
      --a: calc(50vw - 110px - 8px);
      --b: calc((50vw - 110px - 8px) * 0.46);
      --R: min(37vw, calc(50vw - 110px - 8px - 110px)); }
  }
  @media (min-width: 1200px) {
    :root { --kutuW: 260px; --tur: 42s;
      --a: calc(50vw - 130px - 8px);
      --b: calc((50vw - 130px - 8px) * 0.46);
      --R: min(min(29vh, 320px), calc(50vw - 130px - 8px - 150px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .yorunge { position: static; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; width: auto; height: auto; margin-top: 1.4rem; pointer-events: auto; }
    .soru { position: static; animation: none !important; transform: none !important; opacity: 1 !important; width: min(320px, 88vw); }
    .sahne { display: flex; flex-direction: column; align-items: center; }
  }
</style>
</head>
<body>
  <header class="marka">
    <p class="kicker">Su Haritası</p>
    <h1>{marka}</h1>
  </header>

  <main class="sahne">
    <div class="kure-kap">
      <canvas id="kure-canvas" aria-hidden="true"></canvas>
      <img class="kure-poster" src="/deneyim/video/atlas-6-poster.jpg" alt="" aria-hidden="true" />
    </div>

    <nav class="yorunge" aria-label="Sık sorulan sorular">
      {SORU.map((s, i) => (
        <a class="soru" href={s.hedef} style={`--i:${i}`}>{s.soru}</a>
      ))}
    </nav>
  </main>

<script>
  const kok = document.documentElement;
  const params = new URLSearchParams(location.search);
  const varyant = params.get('v') === '2' ? 2 : 1;
  if (varyant === 2) kok.setAttribute('data-v', '2');
  const AR = 832 / 464;
  const azHareket = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* <768: b/R runtime ayarı — (i) elips çevresi/7 ≥ kutuH+12 (b'yi 8px artır),
     (ii) küre+yörünge 667'de kaydırmasız (b,R oranlı küçült). kutuW değişmez. */
  function mobilAyar() {
    if (!matchMedia('(max-width: 767px)').matches) {
      kok.style.removeProperty('--a'); kok.style.removeProperty('--b'); kok.style.removeProperty('--R');
      return;
    }
    const vw = innerWidth, vh = innerHeight;
    const kutuW = 168;
    let a = vw / 2 - kutuW / 2 - 8;
    let R = 0.37 * vw;
    let b = a * 1.9;
    const soru = document.querySelector('.soru');
    const kutuH = soru ? soru.getBoundingClientRect().height : 96;
    // (i) elips çevresi (Ramanujan) / 7 ≥ kutuH+12
    const cevre = (aa, bb) => Math.PI * (3 * (aa + bb) - Math.sqrt((3 * aa + bb) * (aa + 3 * bb)));
    let guard = 0;
    while (cevre(a, b) / 7 < (kutuH + 12) && guard++ < 200) b += 8;
    // (ii) toplam dikey = 2b + kutuH + marka/padding; 667'ye sığmazsa b,R oranlı küçült
    const ust = (document.querySelector('.marka')?.offsetHeight || 90) + 40;
    let toplam = 2 * b + kutuH + ust;
    if (toplam > vh) {
      const k = (vh - kutuH - ust) / (2 * b);
      b *= k; R *= k;
    }
    kok.style.setProperty('--a', a + 'px');
    kok.style.setProperty('--b', b + 'px');
    kok.style.setProperty('--R', R + 'px');
  }
  mobilAyar();
  addEventListener('resize', mobilAyar);

  /* ——— WebGL küre (three dinamik import) ——— */
  const canvas = document.getElementById('kure-canvas');
  function fallback(neden) {
    kok.classList.add('webgl-yok');
    console.error('[mock-kure] WebGL küre çizilemedi, poster + CSS yörünge fallback:', neden);
  }

  (async () => {
    // WebGL var mı?
    let gl = null;
    try { gl = canvas.getContext('webgl2') || canvas.getContext('webgl'); } catch (e) {}
    if (!gl) return fallback('getContext null');

    let THREE;
    try { THREE = await import('three'); }
    catch (e) { return fallback('three import: ' + e.message); }

    // Atlas video
    const video = document.createElement('video');
    video.src = '/deneyim/video/atlas-6.mp4';
    video.muted = true; video.loop = true; video.playsInline = true; video.crossOrigin = 'anonymous';
    video.preload = 'auto';
    const p = video.play();
    if (p && p.catch) p.catch((e) => console.error('[mock-kure] atlas video play reddedildi:', e.message));

    const tex = new THREE.VideoTexture(video);
    tex.minFilter = THREE.LinearFilter; tex.magFilter = THREE.LinearFilter;
    tex.generateMipmaps = false;
    tex.wrapS = THREE.ClampToEdge ?? THREE.ClampToEdgeWrapping;
    tex.wrapT = THREE.ClampToEdge ?? THREE.ClampToEdgeWrapping;
    // three 0.185 renk uzayı: sRGB kaynak.
    if ('SRGBColorSpace' in THREE) tex.colorSpace = THREE.SRGBColorSpace;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: !matchMedia('(max-width:767px)').matches, alpha: true });
    if ('SRGBColorSpace' in THREE) renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.setClearColor(0x000000, 0);
    const dpr = matchMedia('(max-width:767px)').matches ? Math.min(1.5, devicePixelRatio) : Math.min(2, devicePixelRatio);
    renderer.setPixelRatio(dpr);

    const scene = new THREE.Scene();
    // Ortografik: birim küre kabı tam doldurur.
    const cam = new THREE.OrthographicCamera(-1.06, 1.06, 1.06, -1.06, 0.1, 10);
    cam.position.set(0, 0, 3); cam.lookAt(0, 0, 0);

    const phi = Math.PI / (6 * AR);          // v1 kuşak yarı-açısı
    const rho = (2 * Math.PI / 3) / AR;       // v2 sarmal satır yarı-açısı
    const c = (h) => new THREE.Color(h);
    const mat = new THREE.ShaderMaterial({
      uniforms: {
        map: { value: tex }, variant: { value: varyant },
        phi: { value: phi }, rho: { value: rho },
        cMid: { value: c('#0C5A7C') }, cDeep: { value: c('#0A2740') },
      },
      vertexShader: `varying vec3 vP; void main(){ vP = normalize(position); gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }`,
      fragmentShader: `
        precision highp float;
        uniform sampler2D map; uniform int variant; uniform float phi; uniform float rho;
        uniform vec3 cMid; uniform vec3 cDeep; varying vec3 vP;
        #define PI 3.141592653589793
        void main(){
          vec3 n = normalize(vP);
          float lat = asin(clamp(n.y,-1.0,1.0));
          float lon = atan(n.z, n.x); if(lon < 0.0) lon += 2.0*PI;
          bool inB = false; vec2 uv = vec2(0.0);
          if(variant == 1){
            if(abs(lat) <= phi){
              float sl = floor(lon/(PI/3.0));
              float lu = (lon - sl*(PI/3.0))/(PI/3.0);
              float lv = (lat+phi)/(2.0*phi);
              float col = mod(sl,3.0);
              float top = sl < 3.0 ? 1.0 : 0.0;
              uv = vec2((col+lu)/3.0, top*0.5 + lv*0.5); inB = true;
            }
          } else {
            if(abs(lat) <= rho){
              float sl = floor(lon/(2.0*PI/3.0));
              float lu = (lon - sl*(2.0*PI/3.0))/(2.0*PI/3.0);
              bool north = lat >= 0.0;
              float lv = north ? (lat/rho) : ((lat+rho)/rho);
              uv = vec2((sl+lu)/3.0, north ? (0.5 + lv*0.5) : (lv*0.5)); inB = true;
            }
          }
          vec3 col;
          if(inB){ col = texture2D(map, uv).rgb; }
          else {
            float edge = variant == 1 ? phi : rho;
            float f = clamp((abs(lat)-edge)/(PI/2.0-edge), 0.0, 1.0);
            col = mix(cMid, cDeep, f);
          }
          vec3 L = normalize(vec3(0.4,0.7,0.6));
          float lit = 0.72 + 0.28*max(dot(n,L),0.0);
          gl_FragColor = vec4(col*lit, 1.0);
        }`,
    });

    const geo = new THREE.SphereGeometry(1, 160, 120);
    const mesh = new THREE.Mesh(geo, mat);
    mesh.rotation.z = 0.12;   // hafif eksen eğimi
    scene.add(mesh);
    scene.add(new THREE.AmbientLight(0xffffff, 0.4));
    const dir = new THREE.DirectionalLight(0xffffff, 0.8); dir.position.set(0.4,0.7,0.6); scene.add(dir);

    function boyut() {
      const r = canvas.getBoundingClientRect();
      renderer.setSize(r.width, r.height, false);
    }
    boyut(); addEventListener('resize', boyut);

    renderer.domElement.addEventListener('webglcontextlost', (e) => { e.preventDefault(); fallback('context lost'); });

    const T = 60000;   // 1 tur 60sn
    let t0 = null;
    function ciz(ts) {
      if (t0 === null) t0 = ts;
      mesh.rotation.y = ((ts - t0) / T) * Math.PI * 2;   // reduced-motion'da da küre döner (brief)
      renderer.render(scene, cam);
      requestAnimationFrame(ciz);
    }
    requestAnimationFrame(ciz);

    if (azHareket) {
      // Küre döner ama video ilk karede DURUR (brief reduced-motion).
      video.addEventListener('loadeddata', () => { try { video.pause(); video.currentTime = 0; } catch (e) {} }, { once: true });
    }
  })();
</script>
</body>
</html>
